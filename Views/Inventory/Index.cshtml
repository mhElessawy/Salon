@model IEnumerable<Salon.Models.Product>
@{
    ViewData["Title"] = "المنتجات";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h1><i class="fas fa-boxes me-2"></i>المنتجات</h1></div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fas fa-plus me-1"></i> إضافة منتج</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="search-bar mb-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم..." />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
        </form>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>اسم المنتج</th>
                        <th>المورد</th>
                        <th>الفئة</th>
                        <th>سعر الشراء</th>
                        <th>سعر البيع</th>
                        <th>الكمية</th>
                        <th>تاريخ الانتهاء</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد منتجات مسجلة</td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        bool isLowStock = p.StockQuantity <= p.MinStockLevel;
                        bool isExpiring = p.ExpiryDate.HasValue && p.ExpiryDate.Value <= DateTime.Today.AddDays(30);
                        <tr class="@(isExpiring ? "table-warning" : "")">
                            <td><strong>@p.Name</strong></td>
                            <td>@(p.Supplier?.Name ?? "-")</td>
                            <td>@(p.Category ?? "-")</td>
                            <td>@p.PurchasePrice.ToString("N3") د.ك</td>
                            <td>@p.SalePrice.ToString("N3") د.ك</td>
                            <td>
                                <span class="badge @(isLowStock ? "bg-danger" : "bg-success")">@p.StockQuantity</span>
                            </td>
                            <td>@(p.ExpiryDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>
                                <a href="@Url.Action("Movements", new { productId = p.Id })" class="btn btn-sm btn-outline-info me-1" title="سجل الحركات"><i class="fas fa-history"></i></a>
                                <a href="@Url.Action("Edit", new { id = p.Id })" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        onclick="confirmDelete(@p.Id, '@Html.Raw(p.Name.Replace("'", "\\'"))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف المنتج:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}