@model IEnumerable<Salon.Models.Product>
@{
    ViewData["Title"] = "المخزون";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-boxes me-2"></i>المخزون</h1>
        <p>إدارة المنتجات والمخزون</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة منتج
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="search-bar mb-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو الباركود..." />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
        </form>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم المنتج</th>
                        <th>الفئة</th>
                        <th>سعر البيع</th>
                        <th>الكمية</th>
                        <th>تاريخ الانتهاء</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد منتجات مسجلة</td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        var isExpiring = p.ExpiryDate.HasValue && p.ExpiryDate.Value <= DateTime.Today.AddDays(30);
                        var isLowStock = p.StockQuantity <= p.MinStockLevel;
                        <tr class="@(isExpiring ? "table-warning" : "")">
                            <td>@p.Id</td>
                            <td><strong>@p.Name</strong></td>
                            <td>@(p.Category ?? "-")</td>
                            <td>@p.SalePrice.ToString("N3") د.ك</td>
                            <td>
                                <span class="badge @(isLowStock ? "bg-danger" : "bg-success")">
                                    @p.StockQuantity @p.Unit
                                </span>
                            </td>
                            <td>@(p.ExpiryDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>
                                @if (isExpiring) { <span class="badge bg-warning text-dark">قريب من الانتهاء</span> }
                                else if (isLowStock) { <span class="badge bg-danger">مخزون منخفض</span> }
                                else { <span class="badge bg-success">جيد</span> }
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = p.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('هل تريد حذف هذا المنتج؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
