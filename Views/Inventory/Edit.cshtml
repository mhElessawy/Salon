@model Salon.Models.Product
@{
    ViewData["Title"] = "تعديل المنتج";
}

<div class="page-header">
    <h1><i class="fas fa-edit me-2"></i>تعديل المنتج</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Barcode" class="form-label"></label>
                    <input asp-for="Barcode" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Unit" class="form-label"></label>
                    <input asp-for="Unit" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PurchasePrice" class="form-label"></label>
                    <input asp-for="PurchasePrice" type="number" step="0.001" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SalePrice" class="form-label"></label>
                    <input asp-for="SalePrice" type="number" step="0.001" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="StockQuantity" class="form-label"></label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="MinStockLevel" class="form-label"></label>
                    <input asp-for="MinStockLevel" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpiryDate" class="form-label"></label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>
