@model List<Salon.Models.StockMovement>
@{
    ViewData["Title"] = "تقرير استهلاك الموظفين";

    var grouped = Model
        .GroupBy(m => new { Id = m.EmployeeId, Name = m.Employee?.FullName ?? "غير محدد" })
        .OrderBy(g => g.Key.Name)
        .ToList();

    int totalRecords  = Model.Count;
    int totalQty      = Model.Sum(m => m.Quantity);
    int totalEmployees = grouped.Count;
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 style="font-size:20px;"><i class="fas fa-user-tag me-2" style="color:#6f42c1"></i>تقرير استهلاك الموظفين</h1>
        <small class="text-muted">سجل المواد المسحوبة من المخزون لكل موظف</small>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-print me-1"></i> طباعة
    </button>
</div>

@* ===== فلاتر ===== *@
<div class="card mb-3 no-print">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">الموظف</label>
                <select name="employeeId" asp-items="@ViewBag.Employees" class="form-select form-select-sm">
                    <option value="">-- الكل --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">المنتج</label>
                <select name="productId" asp-items="@ViewBag.Products" class="form-select form-select-sm">
                    <option value="">-- الكل --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">من تاريخ</label>
                <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">إلى تاريخ</label>
                <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="fas fa-filter me-1"></i> فلتر
                </button>
                <a href="@Url.Action("ConsumeReport")" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-times"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@* ===== ملخص ===== *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center h-100" style="border-top:4px solid #6f42c1">
            <div class="card-body py-3">
                <div style="font-size:32px;font-weight:700;color:#6f42c1">@totalEmployees</div>
                <div class="text-muted small">موظف</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center h-100" style="border-top:4px solid #fd7e14">
            <div class="card-body py-3">
                <div style="font-size:32px;font-weight:700;color:#fd7e14">@totalQty</div>
                <div class="text-muted small">إجمالي الكميات المسحوبة</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center h-100" style="border-top:4px solid #17a2b8">
            <div class="card-body py-3">
                <div style="font-size:32px;font-weight:700;color:#17a2b8">@totalRecords</div>
                <div class="text-muted small">عدد السحبات</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="fas fa-box-open fa-3x mb-3 opacity-25"></i>
            <p>لا توجد سجلات استهلاك بالفلاتر المحددة</p>
        </div>
    </div>
}
else
{
    @* ===== جدول مجمع حسب الموظف ===== *@
    foreach (var group in grouped)
    {
        var empTotal = group.Sum(m => m.Quantity);

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background:#f0ebff; border-right:4px solid #6f42c1;">
                <span style="font-weight:700; font-size:15px;">
                    <i class="fas fa-user me-2" style="color:#6f42c1"></i>@group.Key.Name
                </span>
                <span class="badge" style="background:#6f42c1; font-size:13px;">
                    إجمالي: @empTotal قطعة
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>المنتج</th>
                            <th class="text-center">الكمية</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in group.OrderByDescending(x => x.MovementDate))
                        {
                            <tr>
                                <td>@m.MovementDate.ToString("yyyy/MM/dd")</td>
                                <td>@(m.Product?.Name ?? "-")</td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark">@m.Quantity</span>
                                </td>
                                <td class="text-muted small">@m.Notes</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="2" class="text-end">مجموع @group.Key.Name:</td>
                            <td class="text-center">
                                <span class="badge" style="background:#6f42c1">@empTotal</span>
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }

    @* ===== إجمالي عام ===== *@
    <div class="card" style="border:2px solid #6f42c1">
        <div class="card-body py-3 text-center">
            <span style="font-size:16px;font-weight:700;">
                إجمالي الكميات المسحوبة:
                <span style="color:#6f42c1;font-size:22px;"> @totalQty قطعة</span>
                في @totalRecords سحبة
            </span>
        </div>
    </div>
}

@section Styles {
<style>
@@media print {
    .no-print, .sidebar, .topbar, .page-header button { display: none !important; }
    .card { box-shadow: none !important; border: 1px solid #ddd !important; }
    body { font-size: 12px; }
}
</style>
}
