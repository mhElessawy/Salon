@model Salon.Models.PurchaseRequest
@{
    ViewData["Title"] = "طلب شراء جديد";
}

<div class="page-header">
    <h1><i class="fas fa-shopping-cart me-2"></i>طلب شراء جديد</h1>
    <p>يُرسل الطلب لموافقة المدير قبل الشراء</p>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">الموظف <span class="text-danger">*</span></label>
                    <select name="EmployeeId" asp-items="ViewBag.Employees" class="form-select" required>
                        <option value="">-- اختر الموظف --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">تاريخ الطلب</label>
                    <input type="date" name="RequestDate" class="form-control" value="@Model.RequestDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold">العهدة <span class="text-danger">*</span></label>
                    <select name="CustodyId" id="custodySelect" class="form-select" required>
                        <option value="">-- اختر العهدة --</option>
                        @foreach (Salon.Models.Custody c in (IEnumerable<Salon.Models.Custody>)ViewBag.Custodies)
                        {
                            <option value="@c.Id" data-emp="@c.EmployeeId">
                                @(c.Employee?.FullName) — عهدة بتاريخ @c.CustodyDate.ToString("yyyy/MM/dd") — المتاح: @c.AvailableForRequest.ToString("N3") د.ك (من أصل @c.Amount.ToString("N3"))
                            </option>
                        }
                    </select>
                    <div class="form-text">تظهر فقط عهد الموظف المختار أعلاه</div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold">المنتجات المطلوبة <span class="text-danger">*</span></label>
                    <table class="table table-sm" id="itemsTable">
                        <thead>
                            <tr>
                                <th>المنتج</th>
                                <th style="width:140px;">الكمية</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            <tr>
                                <td><input type="text" name="itemName" class="form-control" placeholder="اسم المنتج" /></td>
                                <td><input type="number" name="itemQty" class="form-control" value="1" min="1" /></td>
                                <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeItemRow(this)"><i class="fas fa-trash"></i></button></td>
                            </tr>
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="addItemRow()">
                        <i class="fas fa-plus me-1"></i> إضافة منتج
                    </button>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">القيمة التقديرية <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="number" step="0.001" min="0.001" name="EstimatedAmount" class="form-control" required />
                        <span class="input-group-text">د.ك</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">المورد (اختياري)</label>
                    <select name="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                        <option value="">-- غير محدد --</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label fw-bold">سبب الشراء <span class="text-danger">*</span></label>
                    <textarea name="Reason" class="form-control" rows="2" required></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">ملاحظات</label>
                    <textarea name="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="fas fa-paper-plane me-1"></i> إرسال طلب الشراء</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function addItemRow() {
            var tbody = document.getElementById('itemsBody');
            var row = document.createElement('tr');
            row.innerHTML = '<td><input type="text" name="itemName" class="form-control" placeholder="اسم المنتج" /></td>' +
                '<td><input type="number" name="itemQty" class="form-control" value="1" min="1" /></td>' +
                '<td><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeItemRow(this)"><i class="fas fa-trash"></i></button></td>';
            tbody.appendChild(row);
        }

        function removeItemRow(btn) {
            var tbody = document.getElementById('itemsBody');
            if (tbody.rows.length > 1) {
                btn.closest('tr').remove();
            }
        }

        function filterCustodyOptions() {
            var empId = document.querySelector('select[name="EmployeeId"]').value;
            var custodySelect = document.getElementById('custodySelect');
            var hasVisibleSelected = false;
            for (var i = 0; i < custodySelect.options.length; i++) {
                var opt = custodySelect.options[i];
                if (!opt.value) continue;
                var matches = !empId || opt.getAttribute('data-emp') === empId;
                opt.hidden = !matches;
                opt.disabled = !matches;
                if (matches && opt.selected) hasVisibleSelected = true;
            }
            if (!hasVisibleSelected) custodySelect.value = '';
        }

        document.querySelector('select[name="EmployeeId"]').addEventListener('change', filterCustodyOptions);
        filterCustodyOptions();
    </script>
}
