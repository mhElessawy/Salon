@model   IEnumerable<Salon.Models.PurchaseRequest>
@{
    ViewData["Title"] = "طلبات الشراء";
    bool isManager = (bool)(ViewBag.IsManager ?? false);
    bool isCashier = (bool)(ViewBag.IsCashier ?? false);
    bool canApprove = (bool)(ViewBag.CanApprove ?? false);
    int pendingCount = (int)ViewBag.PendingCount;
    int approvedCount = (int)ViewBag.ApprovedCount;
    decimal completedTotal = (decimal)ViewBag.CompletedTotal;

    string StatusBadge(string status) => status switch
    {
        "بانتظار موافقة المدير" => "bg-warning text-dark",
        "تمت الموافقة - بانتظار الشراء" => "bg-info text-dark",
        "معتمدة" => "bg-success",
        "مرفوض" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-shopping-cart me-2"></i>طلبات الشراء</h1>
        <p>شراء منتجات من عهدة الموظف — يتطلب موافقة المدير ثم مطابقة الكاشير للفاتورة</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Custody")" class="btn btn-outline-secondary">
            <i class="fas fa-hand-holding me-1"></i> عهد الموظفين
        </a>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> طلب شراء جديد
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #d97706 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-clock me-1" style="color:#d97706;"></i>بانتظار موافقة المدير</div>
                <div class="fw-bold fs-4" style="color:#d97706;">@pendingCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #0ea5e9 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-truck me-1" style="color:#0ea5e9;"></i>بانتظار الشراء / المطابقة</div>
                <div class="fw-bold fs-4" style="color:#0ea5e9;">@approvedCount</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #198754 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-check-circle me-1 text-success"></i>إجمالي المشتريات المعتمدة</div>
                <div class="fw-bold fs-4 text-success">@completedTotal.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">الموظف:</label>
            <select name="employeeId" class="form-select" style="max-width:220px;" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (SelectListItem emp in ViewBag.Employees)
                {
                    var selected = emp.Value == (ViewBag.EmployeeId?.ToString() ?? "");
                    <option value="@emp.Value" selected="@(selected ? "selected" : null)">@emp.Text</option>
                }
            </select>
            <label class="form-label mb-0">الحالة:</label>
            <select name="status" class="form-select" style="max-width:240px;" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                <option value="بانتظار موافقة المدير" selected="@(ViewBag.Status == "بانتظار موافقة المدير" ? "selected" : null)">بانتظار موافقة المدير</option>
                <option value="تمت الموافقة - بانتظار الشراء" selected="@(ViewBag.Status == "تمت الموافقة - بانتظار الشراء" ? "selected" : null)">تمت الموافقة - بانتظار الشراء</option>
                <option value="معتمدة" selected="@(ViewBag.Status == "معتمدة" ? "selected" : null)">معتمدة</option>
                <option value="مرفوض" selected="@(ViewBag.Status == "مرفوض" ? "selected" : null)">مرفوض</option>
            </select>
            @if (ViewBag.EmployeeId != null || !string.IsNullOrEmpty(ViewBag.Status))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">إعادة تعيين</a>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الموظف</th>
                        <th>تاريخ الطلب</th>
                        <th>المنتجات</th>
                        <th>القيمة التقديرية</th>
                        <th>المورد</th>
                        <th>متبقي العهدة</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">لا توجد طلبات شراء</td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        var rowId = "pr-" + p.Id;
                        <tr>
                            <td>@p.Id</td>
                            <td>@(p.Employee?.FullName ?? "-")</td>
                            <td>@p.RequestDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                <a href="javascript:void(0)" onclick="toggleDetails('@rowId')" class="text-decoration-none">
                                    @p.ItemsSummary <i class="fas fa-chevron-down small text-muted"></i>
                                </a>
                            </td>
                            <td><strong class="text-danger">@p.EstimatedAmount.ToString("N3") د.ك</strong></td>
                            <td>@(p.Supplier?.Name ?? "-")</td>
                            <td>
                                @if (p.Custody != null)
                                {
                                    <span class="@(p.Custody.RemainingAmount > 0 ? "text-warning fw-bold" : "text-muted")">@p.Custody.RemainingAmount.ToString("N3") د.ك</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><span class="badge @StatusBadge(p.Status)">@p.Status</span></td>
                            <td class="text-nowrap">
                                @if (p.Status == "بانتظار موافقة المدير" && canApprove)
                                {
                                    <form method="post" asp-action="Approve" style="display:inline;"
                                          onsubmit="return confirm('الموافقة على طلب الشراء؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-xs btn-success me-1" title="موافقة">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-xs btn-outline-danger me-1" title="رفض الطلب"
                                            onclick="openRejectModal(@p.Id)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                                @if (p.Status == "تمت الموافقة - بانتظار الشراء" && isCashier)
                                {
                                    <button type="button" class="btn btn-xs btn-primary me-1 js-cashier-btn" title="مطابقة واستلام"
                                            data-cashier-id="@p.Id"
                                            data-cashier-emp="@(p.Employee?.FullName ?? "-")"
                                            data-cashier-estimated="@p.EstimatedAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-cashier-remaining="@((p.Custody?.RemainingAmount ?? 0).ToString("F3", System.Globalization.CultureInfo.InvariantCulture))">
                                        <i class="fas fa-clipboard-check"></i> مطابقة واستلام
                                    </button>
                                }
                                @if (isManager)
                                {
                                    <button type="button" class="btn btn-xs btn-outline-secondary js-delete-btn" title="حذف"
                                            data-delete-id="@p.Id"
                                            data-delete-emp="@(p.Employee?.FullName ?? "-")"
                                            data-delete-completed="@(p.Status == "معتمدة" ? "1" : "0")">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                        <tr class="d-none" id="@rowId">
                            <td colspan="9" class="bg-light">
                                <div class="p-2">
                                    <div class="row g-3 small">
                                        <div class="col-md-6">
                                            <strong>المنتجات المطلوبة:</strong>
                                            <ul class="mb-0 mt-1">
                                                @foreach (var item in p.Items)
                                                {
                                                    <li>@item.ProductName — الكمية: @item.Quantity</li>
                                                }
                                            </ul>
                                            @if (p.Custody != null)
                                            {
                                                <div class="mt-2 text-muted">
                                                    <strong>العهدة:</strong> بتاريخ @p.Custody.CustodyDate.ToString("yyyy/MM/dd") —
                                                    الأصل @p.Custody.Amount.ToString("N3") د.ك —
                                                    المتبقي حالياً @p.Custody.RemainingAmount.ToString("N3") د.ك
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-6">
                                            <div><strong>سبب الشراء:</strong> @p.Reason</div>
                                            @if (!string.IsNullOrEmpty(p.Notes))
                                            {
                                                <div><strong>ملاحظات:</strong> @p.Notes</div>
                                            }
                                            @if (p.Status == "مرفوض")
                                            {
                                                <div class="text-danger mt-1"><i class="fas fa-comment-slash me-1"></i><strong>سبب الرفض:</strong> @p.RejectionReason</div>
                                            }
                                            @if (p.ApprovedAt.HasValue)
                                            {
                                                <div class="text-success mt-1"><i class="fas fa-check-circle me-1"></i>اعتمدها: @p.ApprovedByName — @p.ApprovedAt.Value.ToString("HH:mm  yyyy/MM/dd")</div>
                                            }
                                            @if (p.Status == "معتمدة")
                                            {
                                                <div class="mt-2 p-2 rounded" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                                                    <div><strong>رقم الفاتورة:</strong> @p.InvoiceNumber</div>
                                                    <div><strong>المبلغ الفعلي:</strong> <span class="text-success fw-bold">@p.ActualAmount?.ToString("N3") د.ك</span></div>
                                                    <div><strong>طريقة الشراء:</strong> @p.PurchaseMethod</div>
                                                    <div><strong>راجعها:</strong> @p.ReviewedByName — @p.ReviewedAt?.ToString("HH:mm  yyyy/MM/dd")</div>
                                                    @if (!string.IsNullOrEmpty(p.InvoicePhotoPath))
                                                    {
                                                        <div class="mt-1"><a href="@p.InvoicePhotoPath" target="_blank"><i class="fas fa-image me-1"></i>عرض صورة الفاتورة</a></div>
                                                    }
                                                    @if (p.SupplierInvoice != null)
                                                    {
                                                        <div class="mt-2 pt-2" style="border-top:1px dashed #bbf7d0;">
                                                            <div><strong>ذمة المورد:</strong> المدفوع @p.SupplierInvoice.PaidAmount.ToString("N3") / المتبقي @p.SupplierInvoice.RemainingAmount.ToString("N3") د.ك — <span class="badge bg-secondary">@p.SupplierInvoice.Status</span></div>
                                                            <a href="@Url.Action("Index", "SupplierInvoices")" class="small">عرض في فواتير الموردين الآجلة</a>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal رفض طلب الشراء -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#dc3545;color:#fff;">
                <h5 class="modal-title"><i class="fas fa-times-circle me-2"></i>رفض طلب الشراء</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectForm" method="post" asp-action="Reject">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectRequestId" />
                <div class="modal-body">
                    <label class="form-label fw-bold">سبب الرفض <span class="text-danger">*</span></label>
                    <textarea name="reason" id="rejectReason" class="form-control" rows="3" required placeholder="اكتب سبب رفض طلب الشراء..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger px-4"><i class="fas fa-times me-1"></i> رفض الطلب</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (isCashier)
{
    <!-- Modal مطابقة واستلام (اعتماد وتسجيل) -->
    <div class="modal fade" id="cashierModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#0d6efd;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-clipboard-check me-2"></i>مطابقة واستلام</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="cashierForm" method="post" asp-action="CashierReview" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="cashierRequestId" />
                    <div class="modal-body">
                        <div class="mb-3 p-3 rounded" style="background:#f0f9ff;border:1px solid #bae6fd;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">الموظف</span>
                                <strong id="cashierEmpName" class="fs-6"></strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted">القيمة التقديرية</span>
                                <strong id="cashierEstimated" class="fs-6 text-warning"></strong>
                                <span class="text-muted small">د.ك</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2" id="cashierCustodyRemainingRow">
                                <span class="text-muted">المتبقي في العهدة</span>
                                <strong id="cashierCustodyRemaining" class="fs-6 text-success"></strong>
                                <span class="text-muted small">د.ك</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">طريقة الشراء</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="purchaseMethod" id="pmCustody" value="نقدًا من العهدة" checked>
                                    <label class="form-check-label" for="pmCustody">نقدًا من العهدة</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="purchaseMethod" id="pmDeferred" value="آجل من المورد">
                                    <label class="form-check-label" for="pmDeferred">آجل من المورد</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم الفاتورة <span class="text-danger">*</span></label>
                            <input type="text" name="invoiceNumber" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">المورد <span class="text-danger d-none" id="cashierSupplierRequiredMark">*</span></label>
                            <select name="supplierId" id="cashierSupplierId" class="form-select">
                                <option value="">-- غير محدد --</option>
                                @foreach (SelectListItem sup in (IEnumerable<SelectListItem>)ViewBag.Suppliers)
                                {
                                    <option value="@sup.Value">@sup.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">المبلغ الفعلي <span class="text-danger">*</span></label>
                            <input type="number" step="0.001" min="0.001" name="actualAmount" id="cashierActualAmount" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">صورة الفاتورة (اختياري)</label>
                            <input type="file" name="invoicePhoto" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label fw-bold">ملاحظات</label>
                            <textarea name="notes" class="form-control" rows="2"></textarea>
                        </div>

                        <div id="cashierInstallmentsSection" class="d-none mt-3 p-3 rounded" style="background:#fff7ed;border:1px solid #fed7aa;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">دفعات السداد للمورد</label>
                                <button type="button" class="btn btn-xs btn-outline-warning" id="cashierAddInstallmentBtn">
                                    <i class="fas fa-plus"></i> إضافة دفعة
                                </button>
                            </div>
                            <div id="cashierInstallmentsRows"></div>
                            <div class="small mt-1 d-flex justify-content-between">
                                <span>إجمالي الدفعات: <strong id="cashierInstallmentsTotal">0.000</strong> د.ك</span>
                                <span id="cashierInstallmentsWarning" class="text-danger d-none">مجموع الدفعات لا يساوي المبلغ الفعلي</span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-check-double me-1"></i> اعتماد وتسجيل</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (isManager)
{
    <!-- Modal تأكيد حذف طلب الشراء -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="mb-3">
                    <i class="fas fa-trash-alt text-danger" style="font-size:3rem;"></i>
                </div>
                <h4 class="fw-bold mb-2">تأكيد الحذف</h4>
                <p class="text-muted mb-1">هل تريد حذف طلب شراء الموظف:</p>
                <p class="fw-bold fs-5 mb-2" id="deleteEmpName"></p>
                <p class="text-danger small mb-2 d-none" id="deleteExpenseWarning">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    هذا الطلب معتمَد وله مصروف مسجَّل على الصندوق — هيتحذف المصروف معاه أيضاً
                </p>
                <p class="text-danger small mb-4">لا يمكن التراجع عن هذا الإجراء</p>
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                    <form id="deleteForm" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash me-1"></i> حذف
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleDetails(rowId) {
            document.getElementById(rowId).classList.toggle('d-none');
        }

        function openRejectModal(id) {
            document.getElementById('rejectRequestId').value = id;
            document.getElementById('rejectReason').value = '';
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }

        function openCashierModal(id, empName, estimated, custodyRemaining) {
            document.getElementById('cashierRequestId').value = id;
            document.getElementById('cashierEmpName').textContent = empName;
            document.getElementById('cashierEstimated').textContent = estimated.toFixed(3);
            document.getElementById('cashierCustodyRemaining').textContent = custodyRemaining.toFixed(3);
            document.getElementById('pmCustody').checked = true;
            document.getElementById('cashierInstallmentsRows').innerHTML = '';
            updatePurchaseMethodUI();
            new bootstrap.Modal(document.getElementById('cashierModal')).show();
        }

        document.querySelectorAll('.js-cashier-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openCashierModal(
                    parseInt(btn.dataset.cashierId, 10),
                    btn.dataset.cashierEmp,
                    parseFloat(btn.dataset.cashierEstimated),
                    parseFloat(btn.dataset.cashierRemaining)
                );
            });
        });

        function isDeferredSelected() {
            return document.getElementById('pmDeferred').checked;
        }

        function updatePurchaseMethodUI() {
            var deferred = isDeferredSelected();
            document.getElementById('cashierActualAmount').removeAttribute('max');
            document.getElementById('cashierCustodyRemainingRow').classList.toggle('d-none', deferred);
            document.getElementById('cashierInstallmentsSection').classList.toggle('d-none', !deferred);
            document.getElementById('cashierSupplierRequiredMark').classList.toggle('d-none', !deferred);
            var supplierSelect = document.getElementById('cashierSupplierId');
            if (deferred) supplierSelect.setAttribute('required', 'required');
            else supplierSelect.removeAttribute('required');
            updateInstallmentsTotal();
        }

        document.getElementById('pmCustody').addEventListener('change', updatePurchaseMethodUI);
        document.getElementById('pmDeferred').addEventListener('change', updatePurchaseMethodUI);

        function addInstallmentRow() {
            var container = document.getElementById('cashierInstallmentsRows');
            var row = document.createElement('div');
            row.className = 'row g-2 mb-2 align-items-center cashier-installment-row';
            row.innerHTML =
                '<div class="col-5"><input type="number" step="0.001" min="0.001" name="installmentAmount" class="form-control form-control-sm" placeholder="المبلغ" /></div>' +
                '<div class="col-5"><input type="date" name="installmentDueDate" class="form-control form-control-sm" /></div>' +
                '<div class="col-2"><button type="button" class="btn btn-xs btn-outline-danger js-remove-installment"><i class="fas fa-times"></i></button></div>';
            container.appendChild(row);
            row.querySelector('.js-remove-installment').addEventListener('click', function () {
                row.remove();
                updateInstallmentsTotal();
            });
            row.querySelector('input[name="installmentAmount"]').addEventListener('input', updateInstallmentsTotal);
        }

        document.getElementById('cashierAddInstallmentBtn').addEventListener('click', addInstallmentRow);

        function updateInstallmentsTotal() {
            var amounts = document.querySelectorAll('#cashierInstallmentsRows input[name="installmentAmount"]');
            var total = 0;
            amounts.forEach(function (input) { total += parseFloat(input.value) || 0; });
            document.getElementById('cashierInstallmentsTotal').textContent = total.toFixed(3);
            var actual = parseFloat(document.getElementById('cashierActualAmount').value) || 0;
            var hasRows = amounts.length > 0;
            var mismatch = isDeferredSelected() && hasRows && Math.abs(total - actual) > 0.001;
            document.getElementById('cashierInstallmentsWarning').classList.toggle('d-none', !mismatch);
        }

        document.getElementById('cashierActualAmount').addEventListener('input', updateInstallmentsTotal);

        document.getElementById('cashierForm').addEventListener('submit', function (e) {
            if (!isDeferredSelected()) return;
            var amounts = document.querySelectorAll('#cashierInstallmentsRows input[name="installmentAmount"]');
            if (amounts.length === 0) return; // بدون دفعات = دفعة واحدة بكامل المبلغ تلقائياً
            var total = 0;
            amounts.forEach(function (input) { total += parseFloat(input.value) || 0; });
            var actual = parseFloat(document.getElementById('cashierActualAmount').value) || 0;
            if (Math.abs(total - actual) > 0.001) {
                e.preventDefault();
                alert('مجموع الدفعات يجب أن يساوي المبلغ الفعلي');
            }
        });

        function confirmDelete(id, empName, isCompleted) {
            document.getElementById('deleteEmpName').textContent = empName;
            document.getElementById('deleteExpenseWarning').classList.toggle('d-none', !isCompleted);
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        document.querySelectorAll('.js-delete-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                confirmDelete(
                    parseInt(btn.dataset.deleteId, 10),
                    btn.dataset.deleteEmp,
                    btn.dataset.deleteCompleted === '1'
                );
            });
        });
    </script>
    <style>
        .btn-xs {
            padding: 0.15rem 0.4rem;
            font-size: 0.75rem;
        }
    </style>
}