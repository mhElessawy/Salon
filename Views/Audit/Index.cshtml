@model IEnumerable<Salon.Models.AuditLog>
@{
    ViewData["Title"] = "سجل الأنشطة";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    int total = ViewBag.Total;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-history me-2"></i>سجل الأنشطة</h1>
        <small class="text-muted">إجمالي السجلات: @total</small>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">المستخدم</label>
                <input type="text" name="userName" value="@ViewBag.UserName" class="form-control form-control-sm" placeholder="اسم المستخدم..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small">الوحدة</label>
                <select name="module" class="form-select form-select-sm">
                    <option value="">-- الكل --</option>
                    @foreach (var m in (List<string>)ViewBag.Modules)
                    {
                        if (ViewBag.Module == m)
                        {
                            <option value="@m" selected>@m</option>
                        }
                        else
                        {
                            <option value="@m">@m</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">الإجراء</label>
                <select name="action" class="form-select form-select-sm">
                    <option value="">-- الكل --</option>
                    @foreach (var a in (List<string>)ViewBag.Actions)
                    {
                        if (ViewBag.Action == a)
                        {
                            <option value="@a" selected>@a</option>
                        }
                        else
                        {
                            <option value="@a">@a</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">من تاريخ</label>
                <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">إلى تاريخ</label>
                <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-times"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>التاريخ والوقت</th>
                        <th>المستخدم</th>
                        <th>الإجراء</th>
                        <th>الوحدة</th>
                        <th>التفاصيل</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">لا توجد سجلات</td></tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <span class="text-muted small">@log.CreatedAt.ToString("yyyy/MM/dd")</span><br/>
                                <strong>@log.CreatedAt.ToString("HH:mm:ss")</strong>
                            </td>
                            <td>
                                <i class="fas fa-user-circle text-secondary me-1"></i>
                                @log.UserName
                            </td>
                            <td>
                                @{
                                    string badgeClass = log.Action switch {
                                        "إضافة"       => "bg-success",
                                        "تعديل"       => "bg-warning text-dark",
                                        "حذف"         => "bg-danger",
                                        "صرف"         => "bg-primary",
                                        "موافقة"      => "bg-info text-dark",
                                        "تسجيل دخول" => "bg-secondary",
                                        _             => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@log.Action</span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@log.Module</span></td>
                            <td class="text-muted">@(log.Description ?? "-")</td>
                            <td class="text-muted small">@(log.IpAddress ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-center">
        <ul class="pagination pagination-sm">
            @if (page > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { userName = ViewBag.UserName, module = ViewBag.Module, action = ViewBag.Action, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, page = page - 1 })">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            }
            @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { userName = ViewBag.UserName, module = ViewBag.Module, action = ViewBag.Action, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, page = p })">@p</a>
                </li>
            }
            @if (page < totalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { userName = ViewBag.UserName, module = ViewBag.Module, action = ViewBag.Action, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, page = page + 1 })">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
}