@model IEnumerable<Salon.Models.Supplier>
@{
    ViewData["Title"] = "الموردين";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div><h1><i class="fas fa-truck me-2"></i>الموردين</h1></div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fas fa-plus me-1"></i> إضافة مورد</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="search-bar mb-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو الهاتف..." />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
        </form>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead><tr><th>اسم المورد</th><th>الهاتف</th><th>البريد</th><th>العنوان</th><th>الإجراءات</th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">لا يوجد موردين مسجلين</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.Name</strong></td>
                            <td>@(s.Phone ?? "-")</td>
                            <td>@(s.Email ?? "-")</td>
                            <td>@(s.Address ?? "-")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = s.Id })" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        onclick="confirmDelete(@s.Id, '@Html.Raw(s.Name.Replace("'", "\\'"))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف المورد:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}