@{
    ViewData["Title"] = "الإعدادات";
}

<div class="page-header">
    <h1><i class="fas fa-cog me-2"></i>الإعدادات</h1>
    <p>إعدادات النظام العامة</p>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">إعدادات الصالون</div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">اسم الصالون</label>
                        <input type="text" class="form-control" value="نظام معهد موس" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">العملة</label>
                        <select class="form-select">
                            <option selected>دينار كويتي (د.ك)</option>
                            <option>ريال سعودي (ر.س)</option>
                            <option>درهم إماراتي (د.إ)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">رقم الهاتف</label>
                        <input type="tel" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">العنوان</label>
                        <textarea class="form-control" rows="2"></textarea>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="alert('تم حفظ الإعدادات')">
                        <i class="fas fa-save me-1"></i> حفظ
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">روابط سريعة</div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Email")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-envelope me-2 text-primary"></i>إعدادات البريد الإلكتروني</span>
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <a href="@Url.Action("Database")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-database me-2 text-success"></i>إدارة قاعدة البيانات</span>
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <a href="@Url.Action("UserCards")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-id-card me-2 text-warning"></i>بطاقات المستخدمين</span>
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <a href="@Url.Action("Training")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-book me-2 text-info"></i>دليل التدريب</span>
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <a href="@Url.Action("Packages")" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-cube me-2 text-danger"></i>اختبار نظام الباقات</span>
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
