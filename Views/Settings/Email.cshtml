@{
    ViewData["Title"] = "إعدادات البريد الإلكتروني";
}

<div class="page-header">
    <h1><i class="fas fa-envelope-open me-2"></i>إعدادات البريد الإلكتروني</h1>
</div>

<div class="card">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">خادم SMTP</label>
                    <input type="text" class="form-control" placeholder="smtp.gmail.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">المنفذ (Port)</label>
                    <input type="number" class="form-control" value="587" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">استخدام SSL</label>
                    <select class="form-select">
                        <option>نعم</option>
                        <option>لا</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">كلمة المرور</label>
                    <input type="password" class="form-control" />
                </div>
            </div>
            <div class="mt-4">
                <button type="button" class="btn btn-primary me-2" onclick="alert('تم حفظ إعدادات البريد')">
                    <i class="fas fa-save me-1"></i> حفظ
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="alert('تم إرسال رسالة اختبار')">
                    <i class="fas fa-paper-plane me-1"></i> اختبار الإرسال
                </button>
            </div>
        </form>
    </div>
</div>
