@{
    ViewData["Title"] = "طلب سلفة";
}

<div class="page-header">
    <h1>
        <i class="fas fa-hand-paper me-2"></i>
        @ViewData["Title"]
    </h1>
    <p class="text-muted">سيتم مراجعة طلبك من قِبَل المدير والموافقة عليه</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
            <i class="fas fa-info-circle fs-5"></i>
            <span>بعد إرسال الطلب سيتحول إلى حالة <strong>بانتظار موافقة المدير</strong> حتى يوافق عليه أو يرفضه</span>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">الموظف <span class="text-danger">*</span></label>
                    <select name="EmployeeId" asp-items="@ViewBag.Employees" class="form-select" required>
                        <option value="">-- اختر الموظف --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">المبلغ (د.ك) <span class="text-danger">*</span></label>
                    <input type="number" name="Amount" step="0.001" min="0.001" class="form-control" required placeholder="0.000" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">التاريخ</label>
                    <input type="date" name="AdvanceDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">السبب</label>
                    <input type="text" name="Reason" class="form-control" placeholder="سبب طلب السلفة..." />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">ملاحظات</label>
                    <textarea name="Notes" class="form-control" rows="2" placeholder="أي ملاحظات إضافية..."></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-success px-4">
                    <i class="fas fa-paper-plane me-1"></i>
                    إرسال الطلب
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-right me-1"></i> رجوع
                </a>
            </div>
        </form>
    </div>
</div>
