@model Salon.Models.EmployeeAdvance
@{
    ViewData["Title"] = "سداد سلفة";
    decimal remaining = Model.Amount - Model.AmountPaid;
}

<div class="page-header">
    <h1><i class="fas fa-hand-holding-usd me-2"></i>سداد سلفة مباشر</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>تفاصيل السلفة</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr><th>الموظف</th><td><strong>@(Model.Employee?.FullName ?? "-")</strong></td></tr>
                    <tr><th>المبلغ الأصلي</th><td>@Model.Amount.ToString("N3") د.ك</td></tr>
                    <tr><th>المدفوع سابقاً</th><td class="text-success">@Model.AmountPaid.ToString("N3") د.ك</td></tr>
                    <tr><th>المتبقي</th><td class="text-danger fw-bold">@remaining.ToString("N3") د.ك</td></tr>
                    <tr><th>السبب</th><td>@(Model.Reason ?? "-")</td></tr>
                    <tr><th>التاريخ</th><td>@Model.AdvanceDate.ToString("yyyy/MM/dd")</td></tr>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <form asp-action="PayDirect" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">مبلغ الدفعة (د.ك)</label>
                        <div class="input-group">
                            <input type="number" name="payAmount" step="0.001" min="0.001"
                                   max="@remaining.ToString("F3")"
                                   value="@remaining.ToString("F3")"
                                   class="form-control form-control-lg" required />
                            <span class="input-group-text">د.ك</span>
                        </div>
                        <div class="form-text">الحد الأقصى: @remaining.ToString("N3") د.ك</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success"
                                onclick="return confirm('تأكيد تسجيل الدفعة؟')">
                            <i class="fas fa-check me-1"></i> تأكيد السداد
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-right me-1"></i> رجوع
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
