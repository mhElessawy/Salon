@model Salon.Models.EmployeeAdvance
@{
    ViewData["Title"] = "سداد سلفة";
    decimal remaining = Model.Amount - Model.AmountPaid;
}

<div class="page-header">
    <h1><i class="fas fa-hand-holding-usd me-2"></i>سداد سلفة مباشر</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>تفاصيل السلفة</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr><th>الموظف</th><td><strong>@(Model.Employee?.FullName ?? "-")</strong></td></tr>
                    <tr><th>المبلغ الأصلي</th><td>@Model.Amount.ToString("N3") د.ك</td></tr>
                    <tr><th>المدفوع سابقاً</th><td class="text-success">@Model.AmountPaid.ToString("N3") د.ك</td></tr>
                    <tr><th>المتبقي</th><td class="text-danger fw-bold">@remaining.ToString("N3") د.ك</td></tr>
                    <tr><th>السبب</th><td>@(Model.Reason ?? "-")</td></tr>
                    <tr><th>التاريخ</th><td>@Model.AdvanceDate.ToString("yyyy/MM/dd")</td></tr>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <form asp-action="PayDirect" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">مبلغ الدفعة (د.ك)</label>
                        <div class="input-group">
                            <input type="number" name="payAmount" step="0.001" min="0.001"
                                   max="@remaining.ToString("F3")"
                                   value="@remaining.ToString("F3")"
                                   class="form-control form-control-lg" required />
                            <span class="input-group-text">د.ك</span>
                        </div>
                        <div class="form-text">الحد الأقصى: @remaining.ToString("N3") د.ك</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">طريقة الدفع</label>
                        <select name="paymentMethod" id="paymentMethod" class="form-select form-select-lg" onchange="toggleTransferRef()">
                            <option value="نقدي">💵 نقدي</option>
                            <option value="تحويل بنكي">🏦 تحويل بنكي</option>
                        </select>
                    </div>
                    <div class="mb-3 d-none" id="transferRefGroup">
                        <label class="form-label fw-bold">رقم مرجع التحويل <span class="text-danger">*</span></label>
                        <input type="text" name="transferReference" id="transferReference" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-success" onclick="openConfirmPayModal()">
                            <i class="fas fa-check me-1"></i> تأكيد السداد
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-right me-1"></i> رجوع
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal تأكيد تسجيل الدفعة -->
<div class="modal fade" id="confirmPayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content text-center p-5">
            <div class="mb-3">
                <i class="fas fa-hand-holding-usd text-success" style="font-size:4rem;"></i>
            </div>
            <h3 class="fw-bold mb-3">تأكيد تسجيل الدفعة؟</h3>
            <p class="text-muted mb-1">المبلغ</p>
            <p class="fw-bold display-6 text-success mb-3" id="confirmPayAmount"></p>
            <p class="text-muted mb-4">طريقة الدفع: <strong id="confirmPayMethod"></strong></p>
            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary btn-lg px-4" data-bs-dismiss="modal">تراجع</button>
                <button type="button" class="btn btn-success btn-lg px-4" id="confirmPaySubmitBtn">
                    <i class="fas fa-check me-1"></i> تأكيد السداد
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleTransferRef() {
            var isBank = document.getElementById('paymentMethod').value === 'تحويل بنكي';
            document.getElementById('transferRefGroup').classList.toggle('d-none', !isBank);
            document.getElementById('transferReference').required = isBank;
        }

        function openConfirmPayModal() {
            var form = document.querySelector('form');
            if (!form.reportValidity()) return;

            var amount = parseFloat(document.querySelector('input[name="payAmount"]').value) || 0;
            var method = document.getElementById('paymentMethod').value;
            document.getElementById('confirmPayAmount').textContent = amount.toFixed(3) + ' د.ك';
            document.getElementById('confirmPayMethod').textContent = method;
            new bootstrap.Modal(document.getElementById('confirmPayModal')).show();
        }

        document.getElementById('confirmPaySubmitBtn').addEventListener('click', function () {
            document.querySelector('form').submit();
        });
    </script>
}