@model  Salon.Models.EmployeeAdvance
@{
    ViewData["Title"] = "التراجع عن سداد";
    decimal remaining = Model.Amount - Model.AmountPaid;
}

<div class="page-header">
    <h1><i class="fas fa-undo-alt me-2"></i>التراجع عن سداد سلفة</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header"><strong>تفاصيل السلفة</strong></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr><th>الموظف</th><td><strong>@(Model.Employee?.FullName ?? "-")</strong></td></tr>
                    <tr><th>المبلغ الأصلي</th><td>@Model.Amount.ToString("N3") د.ك</td></tr>
                    <tr><th>المدفوع حالياً</th><td class="text-success">@Model.AmountPaid.ToString("N3") د.ك</td></tr>
                    <tr><th>المتبقي حالياً</th><td class="text-danger fw-bold">@remaining.ToString("N3") د.ك</td></tr>
                    <tr><th>السبب</th><td>@(Model.Reason ?? "-")</td></tr>
                    <tr><th>التاريخ</th><td>@Model.AdvanceDate.ToString("yyyy/MM/dd")</td></tr>
                </table>
            </div>
        </div>

        <div class="alert alert-warning small">
            <i class="fas fa-exclamation-triangle me-1"></i>
            هذا الإجراء ينقص المبلغ المحدد من "المدفوع" ويعيده ديناً على الموظف، ويحذف أو ينقص
            تلقائياً قيود الإيداع المرتبطة بهذه السلفة في الصندوق (الأحدث أولاً) بما يعادل مبلغ التراجع.
        </div>

        <div class="card">
            <div class="card-body">
                <form asp-action="UndoPayment" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">المبلغ المراد التراجع عنه (د.ك)</label>
                        <div class="input-group">
                            <input type="number" name="undoAmount" step="0.001" min="0.001"
                                   max="@Model.AmountPaid.ToString(" F3")"
                                   value="@Model.AmountPaid.ToString(" F3")"
                                   class="form-control form-control-lg" required />
                            <span class="input-group-text">د.ك</span>
                        </div>
                        <div class="form-text">الحد الأقصى: @Model.AmountPaid.ToString("N3") د.ك (إجمالي المدفوع)</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-warning" onclick="openConfirmUndoModal()">
                            <i class="fas fa-undo-alt me-1"></i> تأكيد التراجع
                        </button>
                        <a href="@Url.Action(" Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-right me-1"></i> رجوع
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal تأكيد التراجع عن الدفعة -->
<div class="modal fade" id="confirmUndoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content text-center p-5">
            <div class="mb-3">
                <i class="fas fa-undo-alt text-warning" style="font-size:4rem;"></i>
            </div>
            <h3 class="fw-bold mb-3">تأكيد التراجع عن الدفعة؟</h3>
            <p class="text-muted mb-1">المبلغ</p>
            <p class="fw-bold display-6 text-warning mb-3" id="confirmUndoAmount"></p>
            <p class="text-muted mb-4">سيصبح هذا المبلغ ديناً على الموظف مرة أخرى</p>
            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary btn-lg px-4" data-bs-dismiss="modal">تراجع</button>
                <button type="button" class="btn btn-warning btn-lg px-4" id="confirmUndoSubmitBtn">
                    <i class="fas fa-check me-1"></i> تأكيد
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openConfirmUndoModal() {
        var form = document.querySelector('form');
        if (!form.reportValidity()) return;

        var amount = parseFloat(document.querySelector('input[name="undoAmount"]').value) || 0;
        document.getElementById('confirmUndoAmount').textContent = amount.toFixed(3) + ' د.ك';
        new bootstrap.Modal(document.getElementById('confirmUndoModal')).show();
    }

    document.getElementById('confirmUndoSubmitBtn').addEventListener('click', function () {
        document.querySelector('form').submit();
    });
</script>
}