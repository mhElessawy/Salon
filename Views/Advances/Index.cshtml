@model IEnumerable<Salon.Models.EmployeeAdvanceSummaryViewModel>
@{
    ViewData["Title"] = "سلف الموظفين";
    string[] arabicMonths = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
                               "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    decimal pendingTotal = (decimal)ViewBag.PendingTotal;
    decimal approvedTotal = (decimal)ViewBag.ApprovedTotal;
    int pendingCount = (int)ViewBag.PendingCount;
    int approvedCount = (int)ViewBag.ApprovedCount;
    bool isManager = (bool)(ViewBag.IsManager ?? false);
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-hand-holding-usd me-2"></i>سلف الموظفين</h1>
        <p>ملخص السلف لكل موظف</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-@(isManager ? "primary" : "success")">
        <i class="fas fa-@(isManager ? "plus" : "paper-plane") me-1"></i>
        @(isManager ? "إضافة سلفة" : "طلب سلفة")
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #f59e0b !important; border-right-width:4px !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">السلف المعلقة</div>
                        <div class="fw-bold fs-4 text-warning">@pendingCount</div>
                        <div class="small text-muted">سلفة</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#fef3c7;">
                        <i class="fas fa-clock text-warning fs-5"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="fw-bold text-warning">@pendingTotal.ToString("N3")</span>
                    <span class="text-muted small"> د.ك</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #10b981 !important; border-right-width:4px !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">السلف الموافق عليها</div>
                        <div class="fw-bold fs-4 text-success">@approvedCount</div>
                        <div class="small text-muted">سلفة</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#d1fae5;">
                        <i class="fas fa-check-circle text-success fs-5"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="fw-bold text-success">@approvedTotal.ToString("N3")</span>
                    <span class="text-muted small"> د.ك</span>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isManager && pendingCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-3 shadow-sm mb-3">
        <i class="fas fa-clock fs-4 text-warning"></i>
        <div>
            <strong>لديك @pendingCount طلب سلفة بانتظار موافقتك</strong>
            <div class="small text-muted">إجمالي المبالغ المعلقة: @pendingTotal.ToString("N3") د.ك</div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم الموظف..." style="max-width:300px;" />
            <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> بحث</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">إعادة تعيين</a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle me-2"></i> لا توجد سلف مسجلة
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var summary in Model)
        {
            var cardId = "emp-" + summary.Employee.Id;
            var hasRemaining = summary.TotalRemaining > 0;
            var empPending = summary.Advances.Where(a => a.Status == "معلق").Sum(a => a.Amount);
            var empApproved = summary.Advances.Where(a => a.Status == "موافق عليها").Sum(a => a.Amount);

            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0" style="cursor:pointer;"
                     onclick="toggleDetails('@cardId')" title="اضغط لعرض التفاصيل">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold mb-0">@summary.Employee.FullName</h5>
                                <small class="text-muted">@summary.Advances.Count سلفة</small>
                            </div>
                            <span class="badge @(hasRemaining ? "bg-warning text-dark" : "bg-success") fs-6">
                                @(hasRemaining ? "لديه رصيد" : "مسدد")
                            </span>
                        </div>
                        <!-- معلقة / موافق عليها -->
                        <div class="row text-center g-2 mb-2">
                            <div class="col-6">
                                <div class="rounded p-2" style="background:#fef3c7;">
                                    <div class="small text-muted">معلقة</div>
                                    <div class="fw-bold text-warning">@empPending.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded p-2" style="background:#d1fae5;">
                                    <div class="small text-muted">موافق عليها</div>
                                    <div class="fw-bold text-success">@empApproved.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                        </div>
                        <div class="row text-center g-2">
                            <div class="col-4">
                                <div class="bg-light rounded p-2">
                                    <div class="small text-muted">إجمالي السلف</div>
                                    <div class="fw-bold text-primary">@summary.TotalAmount.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded p-2">
                                    <div class="small text-muted">المدفوع</div>
                                    <div class="fw-bold text-success">@summary.TotalDeducted.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded p-2">
                                    <div class="small text-muted">المتبقي</div>
                                    <div class="fw-bold @(hasRemaining ? "text-danger" : "text-success")">
                                        @summary.TotalRemaining.ToString("N3")
                                    </div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                        </div>
                        @if (summary.TotalAmount > 0)
                        {
                            var pct = (int)Math.Min(100, summary.TotalDeducted / summary.TotalAmount * 100);
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>نسبة السداد</span>
                                    <span>@pct%</span>
                                </div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar @(pct == 100 ? "bg-success" : "bg-warning")"
                                         style="width:@pct%"></div>
                                </div>
                            </div>
                        }
                        <div class="mt-2 text-center">
                            <small class="text-muted" id="toggle-hint-@cardId">
                                <i class="fas fa-chevron-down me-1"></i> اضغط لعرض التفاصيل
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- تفاصيل الموظف -->
            <div class="col-12 d-none" id="@cardId">
                <div class="card border-primary shadow">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="fas fa-list me-2"></i>تفاصيل سلف: <strong>@summary.Employee.FullName</strong>
                        </h6>
                        <button type="button" class="btn btn-sm btn-outline-light"
                                onclick="event.stopPropagation(); toggleDetails('@cardId')">
                            <i class="fas fa-times"></i> إغلاق
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- جدول السلف -->
                            <div class="col-lg-7">
                                <h6 class="fw-bold border-bottom pb-2">
                                    <i class="fas fa-money-bill-wave me-1 text-primary"></i> السلف
                                </h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>التاريخ</th>
                                                <th>المبلغ</th>
                                                <th>المخصوم</th>
                                                <th>المتبقي</th>
                                                <th>الحالة</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var adv in summary.Advances)
                                            {
                                                var remaining = adv.Amount - adv.DeductedAmount;
                                                <tr>
                                                    <td>@adv.AdvanceDate.ToString("yyyy/MM/dd")</td>
                                                    <td class="fw-bold">@adv.Amount.ToString("N3") <small class="text-muted">د.ك</small></td>
                                                    <td>
                                                        @if (adv.DeductedAmount > 0)
                                                        {
                                                            <span class="text-success">@adv.DeductedAmount.ToString("N3") <small class="text-muted">د.ك</small></span>
                                                        }
                                                        else
                                                        {

                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (remaining > 0)
                                                        {
                                                            <span class="text-danger fw-bold">@remaining.ToString("N3") <small class="text-muted">د.ك</small></span>
                                                        }
                                                        else
                                                        {

                                                            <span class="badge bg-success">مسدد</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge @(adv.Status == "مسددة" ? "bg-success" : adv.Status == "موافق عليها" ? "bg-primary" : "bg-warning text-dark")">
                                                            @adv.Status
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (adv.Status == "معلق" && isManager)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-success"
                                                                    onclick="event.stopPropagation(); openApproveModal(@adv.Id, '@Html.Raw(summary.Employee.FullName)', '@adv.Amount.ToString("N3")')"
                                                                    title="موافقة">
                                                                <i class="fas fa-check"></i> موافقة
                                                            </button>
                                                        }
                                                        else if (adv.Status == "معلق" && !isManager)
                                                        {
                                                            <span class="badge bg-warning text-dark">
                                                                <i class="fas fa-clock me-1"></i>انتظار
                                                            </span>
                                                        }
                                                        @if (isManager)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-outline-danger ms-1"
                                                                    onclick="event.stopPropagation(); confirmDelete(@adv.Id, '@summary.Employee.FullName')"
                                                                    title="حذف">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                                @if (!string.IsNullOrEmpty(adv.Reason))
                                                {
                                                    <tr class="table-light">
                                                        <td colspan="6" class="small text-muted py-1">
                                                            <i class="fas fa-comment me-1"></i>@adv.Reason
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- خصومات الرواتب -->
                            <div class="col-lg-5">
                                <h6 class="fw-bold border-bottom pb-2">
                                    <i class="fas fa-calendar-check me-1 text-success"></i> المدفوعات من الرواتب
                                </h6>
                                @if (!summary.SalaryDeductions.Any())
                                {
                                    <p class="text-muted text-center py-3">
                                        <i class="fas fa-info-circle me-1"></i> لا توجد مدفوعات بعد
                                    </p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>الشهر</th>
                                                    <th>المخصوم</th>
                                                    <th>تاريخ الصرف</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var sal in summary.SalaryDeductions)
                                                {
                                                    <tr>
                                                        <td>@arabicMonths[sal.Month] @sal.Year</td>
                                                        <td class="fw-bold text-success">
                                                            @sal.Amount.ToString("N3") <small class="text-muted">د.ك</small>
                                                        </td>
                                                        <td>@(sal.PaidDate.HasValue? sal.PaidDate.Value.ToString("yyyy/MM/dd") : "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-light fw-bold">
                                                <tr>
                                                    <td>الإجمالي</td>
                                                    <td class="text-success">
                                                        @summary.SalaryDeductions.Sum(s => s.Amount).ToString("N3") <small class="text-muted">د.ك</small>
                                                    </td>
                                                    <td></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal الموافقة على السلفة -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#198754;color:#fff;">
                <h5 class="modal-title">
                    <i class="fas fa-check-circle me-2"></i>الموافقة على طلب السلفة
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 p-3 rounded" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">الموظف</span>
                        <strong id="approveEmpName" class="fs-6"></strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="text-muted">المبلغ</span>
                        <strong id="approveAmount" class="fs-5 text-success"></strong>
                        <span class="text-muted small">د.ك</span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">طريقة الدفع <span class="text-danger">*</span></label>
                    <select id="approvePaymentSelect" class="form-select form-select-lg">
                        <option value="نقدي">💵 نقدي</option>
                        <option value="تحويل بنكي">🏦 تحويل بنكي</option>
                        <option value="شيك">📄 شيك</option>
                        <option value="كنت">💳 كنت</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <form id="approveForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentMethod" id="approvePaymentInput" value="نقدي" />
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fas fa-check me-1"></i> موافقة وصرف
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal تأكيد الحذف -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="mb-3">
                <i class="fas fa-trash-alt text-danger" style="font-size:3rem;"></i>
            </div>
            <h4 class="fw-bold mb-2">تأكيد الحذف</h4>
            <p class="text-muted mb-1">هل تريد حذف سلفة الموظف:</p>
            <p class="fw-bold fs-5 mb-4" id="deleteEmpName"></p>
            <p class="text-danger small mb-4">لا يمكن التراجع عن هذا الإجراء</p>
            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                <form id="deleteForm" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash me-1"></i> حذف
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDetails(cardId) {
            const detailRow = document.getElementById(cardId);
            const hint = document.getElementById('toggle-hint-' + cardId);
            const isHidden = detailRow.classList.contains('d-none');

            detailRow.classList.toggle('d-none', !isHidden);

            if (hint) {
                hint.innerHTML = isHidden
                    ? '<i class="fas fa-chevron-up me-1"></i> اضغط للإخفاء'
                    : '<i class="fas fa-chevron-down me-1"></i> اضغط لعرض التفاصيل';
            }

            if (isHidden) {
                setTimeout(() => detailRow.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
            }
        }

        function confirmDelete(id, empName) {
            document.getElementById('deleteEmpName').textContent = empName;
            document.getElementById('deleteForm').action = '/Advances/Delete/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        function openApproveModal(id, empName, amount) {
            document.getElementById('approveEmpName').textContent = empName;
            document.getElementById('approveAmount').textContent = amount;
            document.getElementById('approveForm').action = '/Advances/Approve/' + id;
            document.getElementById('approvePaymentSelect').value = 'نقدي';
            document.getElementById('approvePaymentInput').value = 'نقدي';
            document.getElementById('approvePaymentSelect').onchange = function () {
                document.getElementById('approvePaymentInput').value = this.value;
            };
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        }
    </script>
    <style>
        .btn-xs {
            padding: 0.15rem 0.4rem;
            font-size: 0.75rem;
        }
    </style>
}