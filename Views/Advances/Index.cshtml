@section Scripts {
    <script>
        function toggleDetails(cardId) {
            const detailRow = document.getElementById(cardId);
            const hint = document.getElementById('toggle-hint-' + cardId);
            const isHidden = detailRow.classList.contains('d-none');

            detailRow.classList.toggle('d-none', !isHidden);

            if (hint) {
                hint.innerHTML = isHidden
                    ? '<i class="fas fa-chevron-up me-1"></i> اضغط للإخفاء'
                    : '<i class="fas fa-chevron-down me-1"></i> اضغط لعرض التفاصيل';
            }

            if (isHidden) {
                setTimeout(() => detailRow.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
            }
        }

        function confirmDelete(id, empName) {
            document.getElementById('deleteEmpName').textContent = empName;
            document.getElementById('deleteForm').action = '/Advances/Delete/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        function confirmCancel(id, empName) {
            document.getElementById('cancelEmpName').textContent = empName;
            document.getElementById('cancelForm').action = '/Advances/Cancel/' + id;
            new bootstrap.Modal(document.getElementById('cancelModal')).show();
        }

        function setReviewMode(mode) {
            const id = document.getElementById('reviewForm').dataset.id;
            document.getElementById('approveSection').classList.toggle('d-none', mode !== 'approve');
            document.getElementById('rejectSection').classList.toggle('d-none', mode !== 'reject');
            document.querySelectorAll('#reviewModal .nav-link').forEach(el => el.classList.toggle('active', el.dataset.mode === mode));

            const btn = document.getElementById('reviewSubmitBtn');
            if (mode === 'approve') {
                btn.className = 'btn btn-success px-4';
                btn.innerHTML = '<i class="fas fa-check me-1"></i> موافقة';
                document.getElementById('reviewForm').action = '/Advances/Approve/' + id;
            } else {
                btn.className = 'btn btn-danger px-4';
                btn.innerHTML = '<i class="fas fa-times me-1"></i> رفض';
                document.getElementById('reviewForm').action = '/Advances/Reject/' + id;
            }
        }

        function openReviewModal(id, empName, amount, reason) {
            document.getElementById('reviewForm').dataset.id = id;
            document.getElementById('reviewEmpName').textContent = empName;
            document.getElementById('reviewAmount').textContent = amount;
            document.getElementById('reviewReasonDisplay').textContent = reason || '-';
            setReviewMode('approve');
            new bootstrap.Modal(document.getElementById('reviewModal')).show();
        }

        function openDisburseModal(id, empName, amount, reason, managerName, decisionAt) {
            document.getElementById('disburseEmpName').textContent = empName;
            document.getElementById('disburseAmount').textContent = amount;
            document.getElementById('disburseReason').textContent = reason || '-';
            document.getElementById('disburseManager').textContent = managerName || '-';
            document.getElementById('disburseDecisionAt').textContent = decisionAt || '-';
            document.getElementById('disburseForm').action = '/Advances/Disburse/' + id;
            new bootstrap.Modal(document.getElementById('disburseModal')).show();
        }

        function openTransferModal(id, empName, amount) {
            document.getElementById('transferEmpName').textContent = empName;
            document.getElementById('transferAmount').textContent = amount;
            document.getElementById('transferForm').action = '/Advances/ConfirmTransfer/' + id;
            new bootstrap.Modal(document.getElementById('transferModal')).show();
        }
    </script>
    <style>
        .btn-xs {
            padding: 0.15rem 0.4rem;
            font-size: 0.75rem;
        }
    </style>
}