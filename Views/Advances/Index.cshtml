@model IEnumerable<Salon.Models.EmployeeAdvance>
@{
    ViewData["Title"] = "سلف الموظفين";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-dollar-sign me-2"></i>سلف الموظفين</h1>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة سلفة
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="search-bar mb-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم الموظف..." />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
        </form>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>المبلغ الأصلي</th>
                        <th>المدفوع</th>
                        <th>المتبقي</th>
                        <th>التاريخ</th>
                        <th>السبب</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد سلف مسجلة</td></tr>
                    }
                    @foreach (var a in Model)
                    {
                        decimal remaining = a.Amount - a.AmountPaid;
                        <tr>
                            <td><strong>@(a.Employee?.FullName ?? "-")</strong></td>
                            <td>@a.Amount.ToString("N3") د.ك</td>
                            <td class="text-success">@a.AmountPaid.ToString("N3") د.ك</td>
                            <td class="@(remaining > 0 ? "text-danger fw-bold" : "text-muted")">
                                @remaining.ToString("N3") د.ك
                            </td>
                            <td>@a.AdvanceDate.ToString("yyyy/MM/dd")</td>
                            <td>@(a.Reason ?? "-")</td>
                            <td>
                                @{
                                    var badgeClass = a.Status switch
                                    {
                                        "مسددة" => "bg-success",
                                        "مدفوعة جزئياً" => "bg-info text-dark",
                                        "موافق عليها" => "bg-primary",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @badgeClass">@a.Status</span>
                            </td>
                            <td>
                                @if (a.Status == "معلق")
                                {
                                    <form asp-action="Approve" asp-route-id="@a.Id" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            <i class="fas fa-check"></i> موافقة
                                        </button>
                                    </form>
                                }
                                @if (a.Status != "مسددة")
                                {
                                    <a href="@Url.Action("PayDirect", new { id = a.Id })"
                                       class="btn btn-sm btn-outline-primary me-1" title="سداد مباشر">
                                        <i class="fas fa-hand-holding-usd"></i> سداد
                                    </a>
                                }
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('هل تريد حذف السلفة؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>