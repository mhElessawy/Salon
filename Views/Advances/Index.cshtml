@model IEnumerable<Salon.Models.EmployeeAdvanceSummaryViewModel>
@{
    ViewData["Title"] = "سلف الموظفين";
    string[] arabicMonths = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
                               "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    decimal pendingTotal = (decimal)ViewBag.PendingTotal;
    decimal approvedTotal = (decimal)ViewBag.ApprovedTotal;
    decimal cashierQueueTotal = (decimal)ViewBag.CashierQueueTotal;
    decimal bankQueueTotal = (decimal)ViewBag.BankQueueTotal;
    int pendingCount = (int)ViewBag.PendingCount;
    int approvedCount = (int)ViewBag.ApprovedCount;
    int cashierQueueCount = (int)ViewBag.CashierQueueCount;
    int bankQueueCount = (int)ViewBag.BankQueueCount;
    bool isManager = (bool)(ViewBag.IsManager ?? false);
    bool isCashier = (bool)(ViewBag.IsCashier ?? false);
    bool canRepay = (bool)(ViewBag.CanRepay ?? true);
    int? myEmployeeId = ViewBag.MyEmployeeId as int?;

    var statusBadgeClasses = new Dictionary<string, string>
    {
        ["بانتظار موافقة المدير"] = "bg-warning text-dark",
        ["مرفوض"] = "bg-danger",
        ["معتمد - بانتظار صرف الكاشير"] = "bg-info text-dark",
        ["معتمد - بانتظار التحويل البنكي"] = "bg-info text-dark",
        ["تم الصرف"] = "bg-primary",
        ["تم التحويل"] = "bg-primary",
        ["مسددة"] = "bg-success",
        ["ملغي"] = "bg-secondary",
    };
    string BadgeClass(string status) => statusBadgeClasses.TryGetValue(status, out var c) ? c : "bg-secondary";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-hand-holding-usd me-2"></i>سلف الموظفين</h1>
        <p>ملخص السلف لكل موظف</p>
    </div>
    <div class="d-flex gap-2">
        @if (isManager)
        {
            <form method="post" asp-action="ReconcileHistoricalDeductions" onsubmit="return confirm('سيتم مطابقة السلف مع الرواتب المصروفة وتحديث المبالغ المدفوعة. متابعة؟');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary" title="مطابقة مبالغ السلف المخصومة من الرواتب مع سجلات السلف">
                    <i class="fas fa-sync me-1"></i> إصلاح بيانات السلف المدفوعة
                </button>
            </form>
        }
        <a href="@Url.Action("Create")" class="btn btn-@(isManager ? "primary" : "success")">
            <i class="fas fa-@(isManager ? "plus" : "paper-plane") me-1"></i>
            @(isManager ? "إضافة سلفة" : "طلب سلفة")
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #f59e0b !important; border-right-width:4px !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">بانتظار موافقة المدير</div>
                        <div class="fw-bold fs-4 text-warning">@pendingCount</div>
                        <div class="small text-muted">سلفة</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#fef3c7;">
                        <i class="fas fa-clock text-warning fs-5"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="fw-bold text-warning">@pendingTotal.ToString("N3")</span>
                    <span class="text-muted small"> د.ك</span>
                </div>
            </div>
        </div>
    </div>
    @if (isCashier)
    {
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #17a2b8 !important; border-right-width:4px !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small mb-1">بانتظار صرف الكاشير</div>
                            <div class="fw-bold fs-4 text-info">@cashierQueueCount</div>
                            <div class="small text-muted">سلفة</div>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:#cff4fc;">
                            <i class="fas fa-money-bill-wave text-info fs-5"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top">
                        <span class="fw-bold text-info">@cashierQueueTotal.ToString("N3")</span>
                        <span class="text-muted small"> د.ك</span>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (isManager)
    {
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #0d6efd !important; border-right-width:4px !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small mb-1">بانتظار التحويل البنكي</div>
                            <div class="fw-bold fs-4 text-primary">@bankQueueCount</div>
                            <div class="small text-muted">سلفة</div>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:#cfe2ff;">
                            <i class="fas fa-university text-primary fs-5"></i>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-top">
                        <span class="fw-bold text-primary">@bankQueueTotal.ToString("N3")</span>
                        <span class="text-muted small"> د.ك</span>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #10b981 !important; border-right-width:4px !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">سلف منصرفة</div>
                        <div class="fw-bold fs-4 text-success">@approvedCount</div>
                        <div class="small text-muted">سلفة</div>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;background:#d1fae5;">
                        <i class="fas fa-check-circle text-success fs-5"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top">
                    <span class="fw-bold text-success">@approvedTotal.ToString("N3")</span>
                    <span class="text-muted small"> د.ك</span>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isManager && pendingCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-3 shadow-sm mb-3">
        <i class="fas fa-clock fs-4 text-warning"></i>
        <div>
            <strong>لديك @pendingCount طلب سلفة بانتظار موافقتك</strong>
            <div class="small text-muted">إجمالي المبالغ: @pendingTotal.ToString("N3") د.ك</div>
        </div>
    </div>
}
@if (isCashier && cashierQueueCount > 0)
{
    <div class="alert alert-info d-flex align-items-center gap-3 shadow-sm mb-3">
        <i class="fas fa-money-bill-wave fs-4 text-info"></i>
        <div>
            <strong>لديك @cashierQueueCount سلفة بانتظار الصرف النقدي</strong>
            <div class="small text-muted">إجمالي المبالغ: @cashierQueueTotal.ToString("N3") د.ك</div>
        </div>
    </div>
}
@if (isManager && bankQueueCount > 0)
{
    <div class="alert alert-primary d-flex align-items-center gap-3 shadow-sm mb-3">
        <i class="fas fa-university fs-4 text-primary"></i>
        <div>
            <strong>لديك @bankQueueCount تحويل بنكي بانتظار التنفيذ</strong>
            <div class="small text-muted">إجمالي المبالغ: @bankQueueTotal.ToString("N3") د.ك</div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم الموظف..." style="max-width:300px;" />
            <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> بحث</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">إعادة تعيين</a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle me-2"></i> لا توجد سلف مسجلة
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var summary in Model)
        {
            var cardId = "emp-" + summary.Employee.Id;
            var hasRemaining = summary.TotalRemaining > 0;
            var empPending = summary.Advances.Where(a => a.Status == "بانتظار موافقة المدير").Sum(a => a.Amount);
            var empRealized = summary.Advances.Where(a => a.Amount > 0 && (a.Status == "تم الصرف" || a.Status == "تم التحويل" || a.Status == "مسددة")).Sum(a => a.Amount);

            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0" style="cursor:pointer;"
                     onclick="toggleDetails('@cardId')" title="اضغط لعرض التفاصيل">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold mb-0">@summary.Employee.FullName</h5>
                                <small class="text-muted">@summary.Advances.Count سلفة</small>
                            </div>
                            <span class="badge @(hasRemaining ? "bg-warning text-dark" : "bg-success") fs-6">
                                @(hasRemaining ? "لديه رصيد" : "مسدد")
                            </span>
                        </div>
                        <div class="row text-center g-2 mb-2">
                            <div class="col-6">
                                <div class="rounded p-2" style="background:#fef3c7;">
                                    <div class="small text-muted">بانتظار الموافقة</div>
                                    <div class="fw-bold text-warning">@empPending.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded p-2" style="background:#d1fae5;">
                                    <div class="small text-muted">منصرفة</div>
                                    <div class="fw-bold text-success">@empRealized.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                        </div>
                        <div class="row text-center g-2">
                            <div class="col-4">
                                <div class="bg-light rounded p-2">
                                    <div class="small text-muted">إجمالي السلف</div>
                                    <div class="fw-bold text-primary">@summary.TotalAmount.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded p-2">
                                    <div class="small text-muted">المدفوع</div>
                                    <div class="fw-bold text-success">@summary.TotalDeducted.ToString("N3")</div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded p-2">
                                    <div class="small text-muted">المتبقي</div>
                                    <div class="fw-bold @(hasRemaining ? "text-danger" : "text-success")">
                                        @summary.TotalRemaining.ToString("N3")
                                    </div>
                                    <div class="small text-muted">د.ك</div>
                                </div>
                            </div>
                        </div>
                        @if (summary.TotalAmount > 0)
                        {
                            var pct = (int)Math.Min(100, summary.TotalDeducted / summary.TotalAmount * 100);
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>نسبة السداد</span>
                                    <span>@pct%</span>
                                </div>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar @(pct == 100 ? "bg-success" : "bg-warning")"
                                         style="width:@pct%"></div>
                                </div>
                            </div>
                        }
                        <div class="mt-2 text-center">
                            <small class="text-muted" id="toggle-hint-@cardId">
                                <i class="fas fa-chevron-down me-1"></i> اضغط لعرض التفاصيل
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- تفاصيل الموظف -->
            <div class="col-12 d-none" id="@cardId">
                <div class="card border-primary shadow">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">
                            <i class="fas fa-list me-2"></i>تفاصيل سلف: <strong>@summary.Employee.FullName</strong>
                        </h6>
                        <button type="button" class="btn btn-sm btn-outline-light"
                                onclick="event.stopPropagation(); toggleDetails('@cardId')">
                            <i class="fas fa-times"></i> إغلاق
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- جدول السلف -->
                            <div class="col-lg-7">
                                <h6 class="fw-bold border-bottom pb-2">
                                    <i class="fas fa-money-bill-wave me-1 text-primary"></i> السلف
                                </h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>التاريخ</th>
                                                <th>المبلغ</th>
                                                <th>المخصوم</th>
                                                <th>المتبقي</th>
                                                <th>الحالة</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var adv in summary.Advances)
                                            {
                                                var remaining = adv.Amount - adv.DeductedAmount;
                                                bool isOwner = myEmployeeId.HasValue && adv.EmployeeId == myEmployeeId.Value;
                                                // نص JSON آمن للتضمين داخل onclick — Razor يُهرّب علامات الاقتباس تلقائياً
                                                // (بدون Html.Raw) فتبقى قيمة السمة صحيحة ويفك المتصفح الترميز قبل تنفيذ الجافاسكربت.
                                                var empNameJs = System.Text.Json.JsonSerializer.Serialize(summary.Employee.FullName);
                                                var reasonJs = System.Text.Json.JsonSerializer.Serialize(adv.Reason ?? "-");
                                                var managerNameJs = System.Text.Json.JsonSerializer.Serialize(adv.ManagerName ?? "-");
                                                <tr>
                                                    <td>@adv.AdvanceDate.ToString("yyyy/MM/dd")</td>
                                                    <td class="fw-bold">@adv.Amount.ToString("N3") <small class="text-muted">د.ك</small></td>
                                                    <td>
                                                        @if (adv.DeductedAmount > 0)
                                                        {
                                                            <span class="text-success">@adv.DeductedAmount.ToString("N3") <small class="text-muted">د.ك</small></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (remaining > 0)
                                                        {
                                                            <span class="text-danger fw-bold">@remaining.ToString("N3") <small class="text-muted">د.ك</small></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success">مسدد</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge @BadgeClass(adv.Status)">
                                                            @adv.Status
                                                        </span>
                                                        @if (adv.Status == "مرفوض" && !string.IsNullOrEmpty(adv.RejectionReason))
                                                        {
                                                            <div class="small text-muted mt-1">@adv.RejectionReason</div>
                                                        }
                                                    </td>
                                                    <td class="text-nowrap">
                                                        @if (adv.Status == "بانتظار موافقة المدير" && isManager)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-primary"
                                                                    onclick="event.stopPropagation(); openReviewModal(@adv.Id, @empNameJs, '@adv.Amount.ToString("N3")', @reasonJs)"
                                                                    title="مراجعة">
                                                                <i class="fas fa-eye"></i> مراجعة
                                                            </button>
                                                        }
                                                        @if (adv.Status == "بانتظار موافقة المدير" && (isManager || isOwner))
                                                        {
                                                            <button type="button" class="btn btn-xs btn-outline-secondary ms-1"
                                                                    onclick="event.stopPropagation(); confirmCancel(@adv.Id, @empNameJs)"
                                                                    title="إلغاء الطلب">
                                                                <i class="fas fa-ban"></i> إلغاء
                                                            </button>
                                                        }
                                                        @if (adv.Status == "معتمد - بانتظار صرف الكاشير" && isCashier)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-success"
                                                                    onclick="event.stopPropagation(); openDisburseModal(@adv.Id, @empNameJs, '@adv.Amount.ToString("N3")', @reasonJs, @managerNameJs, '@(adv.DecisionAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")')"
                                                                    title="تسليم المبلغ">
                                                                <i class="fas fa-hand-holding-usd"></i> تم تسليم المبلغ
                                                            </button>
                                                        }
                                                        @if (adv.Status == "معتمد - بانتظار التحويل البنكي" && isManager)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-primary"
                                                                    onclick="event.stopPropagation(); openTransferModal(@adv.Id, @empNameJs, '@adv.Amount.ToString("N3")')"
                                                                    title="تنفيذ التحويل">
                                                                <i class="fas fa-university"></i> تم التحويل
                                                            </button>
                                                        }
                                                        @if ((adv.Status == "تم الصرف" || adv.Status == "تم التحويل") && remaining > 0 && isCashier && canRepay)
                                                        {
                                                            <a href="@Url.Action("PayDirect", new { id = adv.Id })"
                                                               class="btn btn-xs btn-outline-success ms-1"
                                                               onclick="event.stopPropagation();"
                                                               title="سداد مباشر">
                                                                <i class="fas fa-money-check-alt"></i> سداد
                                                            </a>
                                                        }
                                                        @if ((adv.Status == "تم الصرف" || adv.Status == "تم التحويل" || adv.Status == "مسددة") && adv.DeductedAmount > 0 && isManager)
                                                        {
                                                            <a href="@Url.Action("UndoPayment", new { id = adv.Id })"
                                                               class="btn btn-xs btn-outline-warning ms-1"
                                                               onclick="event.stopPropagation();"
                                                               title="التراجع عن سداد">
                                                                <i class="fas fa-undo-alt"></i> تراجع عن سداد
                                                            </a>
                                                        }
                                                        @if (isManager)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-outline-danger ms-1"
                                                                    onclick="event.stopPropagation(); confirmDelete(@adv.Id, @empNameJs)"
                                                                    title="حذف">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                                @if (!string.IsNullOrEmpty(adv.Reason))
                                                {
                                                    <tr class="table-light">
                                                        <td colspan="6" class="small text-muted py-1">
                                                            <i class="fas fa-comment me-1"></i>@adv.Reason
                                                        </td>
                                                    </tr>
                                                }
                                                @if (adv.Status == "تم الصرف")
                                                {
                                                    <tr class="table-light">
                                                        <td colspan="6" class="small text-muted py-1">
                                                            <i class="fas fa-user-check me-1"></i>صرفها الكاشير: @(adv.CashierName ?? "-") | @(adv.DisbursedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                                                        </td>
                                                    </tr>
                                                }
                                                @if (adv.Status == "تم التحويل")
                                                {
                                                    <tr class="table-light">
                                                        <td colspan="6" class="small text-muted py-1">
                                                            <i class="fas fa-university me-1"></i>نفّذها: @(adv.TransferredByName ?? "-") | مرجع: @(adv.TransferReference ?? "-") | @(adv.DisbursedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- خصومات الرواتب -->
                            <div class="col-lg-5">
                                <h6 class="fw-bold border-bottom pb-2">
                                    <i class="fas fa-calendar-check me-1 text-success"></i> المدفوعات من الرواتب
                                </h6>
                                @if (!summary.SalaryDeductions.Any())
                                {
                                    <p class="text-muted text-center py-3">
                                        <i class="fas fa-info-circle me-1"></i> لا توجد مدفوعات بعد
                                    </p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>الشهر</th>
                                                    <th>المخصوم</th>
                                                    <th>تاريخ الصرف</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var sal in summary.SalaryDeductions)
                                                {
                                                    <tr>
                                                        <td>@arabicMonths[sal.Month] @sal.Year</td>
                                                        <td class="fw-bold text-success">
                                                            @sal.Amount.ToString("N3") <small class="text-muted">د.ك</small>
                                                        </td>
                                                        <td>@(sal.PaidDate.HasValue? sal.PaidDate.Value.ToString("yyyy/MM/dd") : "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-light fw-bold">
                                                <tr>
                                                    <td>الإجمالي</td>
                                                    <td class="text-success">
                                                        @summary.SalaryDeductions.Sum(s => s.Amount).ToString("N3") <small class="text-muted">د.ك</small>
                                                    </td>
                                                    <td></td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal مراجعة طلب السلفة (موافقة / رفض) -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="reviewForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="background:#0f3460;color:#fff;">
                    <h5 class="modal-title">
                        <i class="fas fa-eye me-2"></i>مراجعة طلب السلفة
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 p-3 rounded" style="background:#f7f8fa;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">الموظف</span>
                            <strong id="reviewEmpName" class="fs-6"></strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-muted">المبلغ</span>
                            <strong id="reviewAmount" class="fs-5 text-success"></strong>
                            <span class="text-muted small">د.ك</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-muted">السبب</span>
                            <span id="reviewReasonDisplay" class="text-end"></span>
                        </div>
                    </div>

                    <ul class="nav nav-pills nav-fill mb-3">
                        <li class="nav-item">
                            <button type="button" class="nav-link active" data-mode="approve" onclick="setReviewMode('approve')">
                                <i class="fas fa-check me-1"></i> موافقة
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" data-mode="reject" onclick="setReviewMode('reject')">
                                <i class="fas fa-times me-1"></i> رفض
                            </button>
                        </li>
                    </ul>

                    <div id="approveSection">
                        <label class="form-label fw-bold">طريقة الصرف <span class="text-danger">*</span></label>
                        <select name="paymentMethod" class="form-select form-select-lg">
                            <option value="نقدي">💵 نقدي (يذهب لطابور الكاشير)</option>
                            <option value="تحويل بنكي">🏦 تحويل بنكي (يذهب لطابور التحويل)</option>
                        </select>
                    </div>
                    <div id="rejectSection" class="d-none">
                        <label class="form-label fw-bold">سبب الرفض</label>
                        <textarea name="reason" class="form-control" rows="2" placeholder="اكتب سبب الرفض..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                    <button type="submit" id="reviewSubmitBtn" class="btn btn-success px-4">
                        <i class="fas fa-check me-1"></i> موافقة
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

