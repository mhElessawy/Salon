@model IEnumerable<Salon.Models.EmployeeAdvance>
@{
    ViewData["Title"] = "سلف الموظفين";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-dollar-sign me-2"></i>سلف الموظفين</h1>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة سلفة
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="search-bar mb-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث باسم الموظف..." />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
        </form>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>المبلغ الأصلي</th>
                        <th>المخصوم</th>
                        <th>المتبقي</th>
                        <th>التاريخ</th>
                        <th>السبب</th>
                        <th>طريقة الدفع</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">لا توجد سلف مسجلة</td></tr>
                    }
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><strong>@(a.Employee?.FullName ?? "-")</strong></td>
                            <td>@a.Amount.ToString("N3") د.ك</td>
                            <td>
                                @if (a.DeductedAmount > 0)
                                {
                                    <span class="text-danger">@a.DeductedAmount.ToString("N3") د.ك</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @{var remaining = a.Amount - a.DeductedAmount;}
                                @if (remaining > 0)
                                {
                                    <span class="text-warning fw-bold">@remaining.ToString("N3") د.ك</span>
                                }
                                else
                                {
                                    <span class="text-success">مسدد بالكامل</span>
                                }
                            </td>
                            <td>@a.AdvanceDate.ToString("yyyy/MM/dd")</td>
                            <td>@(a.Reason ?? "-")</td>
                            <td><span class="badge bg-secondary">@a.PaymentMethod</span></td>
                            <td>
                                <span class="badge @(a.Status == "مسددة" ? "bg-success" : a.Status == "موافق عليها" ? "bg-primary" : "bg-warning text-dark")">
                                    @a.Status
                                </span>
                            </td>
                            <td>
                                @if (a.Status == "معلق")
                                {
                                    <form asp-action="Approve" asp-route-id="@a.Id" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            <i class="fas fa-check"></i> موافقة
                                        </button>
                                    </form>
                                }
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmDelete(@a.Id, '@(a.Employee?.FullName ?? "")')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal تأكيد الحذف -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="mb-3">
                <i class="fas fa-trash-alt text-danger" style="font-size:3rem;"></i>
            </div>
            <h4 class="fw-bold mb-2">تأكيد الحذف</h4>
            <p class="text-muted mb-1">هل تريد حذف سلفة الموظف:</p>
            <p class="fw-bold fs-5 mb-4" id="deleteEmpName"></p>
            <p class="text-danger small mb-4">لا يمكن التراجع عن هذا الإجراء</p>
            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                <form id="deleteForm" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash me-1"></i> حذف
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmDelete(id, empName) {
    document.getElementById('deleteEmpName').textContent = empName;
    document.getElementById('deleteForm').action = '/Advances/Delete/' + id;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>
}
