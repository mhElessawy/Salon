@model List<Salon.Models.DailyRevenueRow>
@{
    ViewData["Title"] = "تقرير الإيرادات حسب الفترة";
    var employees = ViewBag.Employees as IEnumerable<Salon.Models.Employee> ?? Enumerable.Empty<Salon.Models.Employee>();
    int? selectedEmployeeId = ViewBag.SelectedEmployeeId;
    string? selectedSaleType = ViewBag.SelectedSaleType as string;
    string? userDept = ViewBag.UserDept as string;
    bool isDeptUser = userDept == "حلاقة" || userDept == "مساج";

    decimal totalRevenue = ViewBag.TotalRevenue is decimal tr ? tr : 0m;
    decimal totalCash = ViewBag.TotalCash is decimal tc ? tc : 0m;
    decimal totalKnet = ViewBag.TotalKnet is decimal tk ? tk : 0m;
    decimal totalEmployeeDebt = ViewBag.TotalEmployeeDebt is decimal ted ? ted : 0m;
    decimal totalOwnerDebt = ViewBag.TotalOwnerDebt is decimal tod ? tod : 0m;
    int totalCount = ViewBag.TotalCount is int tct ? tct : 0;

    decimal bestDayAmount = ViewBag.BestDayAmount is decimal bda ? bda : 0m;
    string bestDayDate = ViewBag.BestDayDate as string ?? "-";
    decimal worstDayAmount = ViewBag.WorstDayAmount is decimal wda ? wda : 0m;
    string worstDayDate = ViewBag.WorstDayDate as string ?? "-";
    decimal avgRevenue = ViewBag.AvgDailyRevenue is decimal avr ? avr : 0m;
    double avgCount = ViewBag.AvgDailyCount is double avc ? avc : 0.0;
    string reportNumber = ViewBag.ReportNumber as string ?? "RPT-";
}

@* ======= PRINT STYLES ======= *@
<style>
    @@media print {
        .no-print { display: none !important; }
        body { direction: rtl; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }

    .rev-stat {
        background: #fff;
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
    }
    .rev-stat-icon {
        width: 52px; height: 52px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    .rev-stat-label { font-size: .78rem; color: #6b7280; margin-bottom: 2px; }
    .rev-stat-value { font-size: 1.35rem; font-weight: 700; line-height: 1.1; }

    .bottom-stat {
        background: #fff;
        border-radius: 14px;
        padding: 18px 22px;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        display: flex; align-items: center; gap: 14px;
    }
    .bottom-stat-icon {
        width: 46px; height: 46px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; flex-shrink: 0;
    }
    .bottom-stat-label { font-size: .78rem; color: #6b7280; }
    .bottom-stat-value { font-size: 1.2rem; font-weight: 700; }
    .bottom-stat-sub { font-size: .78rem; color: #6b7280; }

    .rev-table thead th {
        background: #f8fafc;
        font-size: .82rem;
        font-weight: 600;
        color: #374151;
        border-bottom: 2px solid #e5e7eb;
        white-space: nowrap;
        padding: 10px 14px;
    }
    .rev-table tbody td {
        padding: 10px 14px;
        font-size: .88rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .rev-table tbody tr:hover { background: #f8fafc; }
    .rev-table tfoot td {
        padding: 10px 14px;
        font-weight: 700;
        font-size: .9rem;
        background: #f0f9ff;
        border-top: 2px solid #bae6fd;
    }
    .page-size-select { width: auto; display: inline-block; }
    .pagination-info { font-size: .83rem; color: #6b7280; }
</style>

@* ======= HEADER ======= *@
<div class="d-flex justify-content-between align-items-start mb-3 no-print flex-wrap gap-2">
    <div>
        <h1 class="h4 mb-0 fw-bold"><i class="fas fa-scissors me-2" style="color:var(--primary)"></i>تقرير الإيرادات حسب الفترة</h1>
        <p class="text-muted small mb-0">عرض ملخص الإيرادات اليومية خلال الفترة المحددة</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button onclick="window.print()" class="btn btn-dark btn-sm">
            <i class="fas fa-print me-1"></i>طباعة
        </button>
        <button onclick="exportToExcel()" class="btn btn-success btn-sm">
            <i class="fas fa-file-excel me-1"></i>Excel
        </button>
        <button onclick="window.print()" class="btn btn-danger btn-sm">
            <i class="fas fa-file-pdf me-1"></i>PDF
        </button>
    </div>
</div>

@* ======= FILTERS ======= *@
<div class="card mb-3 no-print">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1 small">من تاريخ</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                    <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:160px;" />
                </div>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1 small">إلى تاريخ</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                    <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:160px;" />
                </div>
            </div>
            @if (!isDeptUser)
            {
                <div class="col-auto">
                    <label class="form-label mb-1 small">الفلتر</label>
                    <select name="saleType" class="form-select form-select-sm" style="max-width:130px;">
                        <option value="">الكل</option>
                        <option value="حلاقة" selected="@(selectedSaleType == "حلاقة")">✂️ حلاقة</option>
                        <option value="مساج" selected="@(selectedSaleType == "مساج")">🌿 مساج</option>
                        <option value="منتجات" selected="@(selectedSaleType == "منتجات")">📦 منتجات</option>
                    </select>
                </div>
            }
            <div class="col-auto">
                <label class="form-label mb-1 small">الكاشير</label>
                <select name="employeeId" class="form-select form-select-sm" style="max-width:160px;">
                    <option value="">الكل</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id" selected="@(selectedEmployeeId == emp.Id)">@emp.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1 small">رقم التقرير</label>
                <input type="text" value="@reportNumber" class="form-control form-control-sm" readonly style="max-width:160px;background:#f8fafc;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-search me-1"></i>بحث
                </button>
            </div>
        </form>
    </div>
</div>

@* ======= SUMMARY CARDS ======= *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-2">
        <div class="rev-stat">
            <div class="rev-stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <div class="rev-stat-label">إجمالي الإيرادات</div>
                <div class="rev-stat-value" style="color:#16a34a;">@totalRevenue.ToString("N3")</div>
                <div class="rev-stat-label">د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="rev-stat">
            <div class="rev-stat-icon" style="background:#dbeafe;color:#2563eb;">
                <i class="fas fa-money-bill-wave"></i>
            </div>
            <div>
                <div class="rev-stat-label">كاش</div>
                <div class="rev-stat-value" style="color:#2563eb;">@totalCash.ToString("N3")</div>
                <div class="rev-stat-label">د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="rev-stat">
            <div class="rev-stat-icon" style="background:#e0f2fe;color:#0284c7;">
                <i class="fas fa-credit-card"></i>
            </div>
            <div>
                <div class="rev-stat-label">كي نت</div>
                <div class="rev-stat-value" style="color:#0284c7;">@totalKnet.ToString("N3")</div>
                <div class="rev-stat-label">د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="rev-stat">
            <div class="rev-stat-icon" style="background:#ffedd5;color:#ea580c;">
                <i class="fas fa-user-tag"></i>
            </div>
            <div>
                <div class="rev-stat-label">دين موظفين</div>
                <div class="rev-stat-value" style="color:#ea580c;">@totalEmployeeDebt.ToString("N3")</div>
                <div class="rev-stat-label">د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="rev-stat">
            <div class="rev-stat-icon" style="background:#fce7f3;color:#db2777;">
                <i class="fas fa-building"></i>
            </div>
            <div>
                <div class="rev-stat-label">على حساب الإدارة</div>
                <div class="rev-stat-value" style="color:#db2777;">@totalOwnerDebt.ToString("N3")</div>
                <div class="rev-stat-label">د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="rev-stat">
            <div class="rev-stat-icon" style="background:#d1fae5;color:#059669;">
                <i class="fas fa-receipt"></i>
            </div>
            <div>
                <div class="rev-stat-label">عدد الفواتير</div>
                <div class="rev-stat-value" style="color:#059669;">@totalCount</div>
                <div class="rev-stat-label">فاتورة</div>
            </div>
        </div>
    </div>
</div>

@* ======= TABLE ======= *@
<div class="card mb-3">
    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2 no-print">
            <h6 class="fw-bold mb-0"><i class="fas fa-table me-2 text-primary"></i>تفصيل الإيرادات اليومية</h6>
        </div>
        <div class="table-responsive">
            <table class="table rev-table mb-0" id="revenueTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>التاريخ</th>
                        <th>إجمالي الإيرادات (د.ك)</th>
                        <th>كاش (د.ك)</th>
                        <th>كي نت (د.ك)</th>
                        <th>دين موظفين (د.ك)</th>
                        <th>على حساب الإدارة (د.ك)</th>
                        <th>عدد الفواتير</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @{ int rowNum = 0; }
                    @foreach (var row in Model)
                    {
                        rowNum++;
                        <tr>
                            <td class="text-muted">@rowNum</td>
                            <td><strong>@row.Date.ToString("yyyy/MM/dd")</strong></td>
                            <td><strong style="color:#16a34a;">@row.Total.ToString("N3")</strong></td>
                            <td style="color:#2563eb;">@row.Cash.ToString("N3")</td>
                            <td style="color:#0284c7;">@row.Knet.ToString("N3")</td>
                            <td style="color:#ea580c;">@(row.EmployeeDebt > 0 ? row.EmployeeDebt.ToString("N3") : "-")</td>
                            <td style="color:#db2777;">@(row.OwnerDebt > 0 ? row.OwnerDebt.ToString("N3") : "-")</td>
                            <td><span class="badge bg-secondary">@row.Count</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2">الإجمالي</td>
                        <td style="color:#16a34a;">@totalRevenue.ToString("N3")</td>
                        <td style="color:#2563eb;">@totalCash.ToString("N3")</td>
                        <td style="color:#0284c7;">@totalKnet.ToString("N3")</td>
                        <td style="color:#ea580c;">@(totalEmployeeDebt > 0 ? totalEmployeeDebt.ToString("N3") : "-")</td>
                        <td style="color:#db2777;">@(totalOwnerDebt > 0 ? totalOwnerDebt.ToString("N3") : "-")</td>
                        <td>@totalCount</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @* Pagination *@
        <div class="d-flex justify-content-between align-items-center px-3 py-2 no-print border-top" id="paginationBar">
            <div class="d-flex align-items-center gap-2 pagination-info">
                <span>عرض</span>
                <select class="form-select form-select-sm page-size-select" id="pageSizeSelect" onchange="changePage(1)">
                    <option value="30">30</option>
                    <option value="50">50</option>
                    <option value="100" selected>100</option>
                    <option value="9999">الكل</option>
                </select>
                <span id="paginationText"></span>
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="paginationLinks"></ul>
            </nav>
        </div>
    </div>
</div>

@* ======= BOTTOM STATS ======= *@
@if (Model.Any())
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="bottom-stat">
                <div class="bottom-stat-icon" style="background:#dbeafe;color:#2563eb;">
                    <i class="fas fa-calculator"></i>
                </div>
                <div>
                    <div class="bottom-stat-label">متوسط عدد الفواتير يومياً</div>
                    <div class="bottom-stat-value" style="color:#2563eb;">@avgCount.ToString("N2")</div>
                    <div class="bottom-stat-sub">فاتورة</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bottom-stat">
                <div class="bottom-stat-icon" style="background:#dcfce7;color:#16a34a;">
                    <i class="fas fa-arrow-trend-up"></i>
                </div>
                <div>
                    <div class="bottom-stat-label">أفضل يوم</div>
                    <div class="bottom-stat-value" style="color:#16a34a;">@bestDayAmount.ToString("N3") <small style="font-size:.7rem;">د.ك</small></div>
                    <div class="bottom-stat-sub">@bestDayDate</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bottom-stat">
                <div class="bottom-stat-icon" style="background:#fee2e2;color:#dc2626;">
                    <i class="fas fa-arrow-trend-down"></i>
                </div>
                <div>
                    <div class="bottom-stat-label">أقل يوم</div>
                    <div class="bottom-stat-value" style="color:#dc2626;">@worstDayAmount.ToString("N3") <small style="font-size:.7rem;">د.ك</small></div>
                    <div class="bottom-stat-sub">@worstDayDate</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bottom-stat">
                <div class="bottom-stat-icon" style="background:#f3e8ff;color:#7c3aed;">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <div class="bottom-stat-label">متوسط دخل اليوم</div>
                    <div class="bottom-stat-value" style="color:#7c3aed;">@avgRevenue.ToString("N3") <small style="font-size:.7rem;">د.ك</small></div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    // ======= PAGINATION =======
    const allRows = Array.from(document.querySelectorAll('#tableBody tr'));
    let currentPage = 1;

    function getPageSize() {
        return parseInt(document.getElementById('pageSizeSelect').value);
    }

    function renderTable() {
        const pageSize = getPageSize();
        const total = allRows.length;
        const totalPages = pageSize >= 9999 ? 1 : Math.ceil(total / pageSize);
        if (currentPage > totalPages) currentPage = totalPages || 1;

        const start = (currentPage - 1) * pageSize;
        const end = Math.min(start + pageSize, total);

        allRows.forEach((r, i) => {
            r.style.display = (pageSize >= 9999 || (i >= start && i < end)) ? '' : 'none';
        });

        document.getElementById('paginationText').textContent =
            total === 0 ? 'لا توجد بيانات' : `${start + 1} - ${end} من ${total}`;

        // build page links
        const ul = document.getElementById('paginationLinks');
        ul.innerHTML = '';
        if (totalPages <= 1) return;

        const addLi = (label, page, disabled, active) => {
            const li = document.createElement('li');
            li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
            const a = document.createElement('a');
            a.className = 'page-link';
            a.href = '#';
            a.innerHTML = label;
            a.onclick = e => { e.preventDefault(); if (!disabled) changePage(page); };
            li.appendChild(a);
            ul.appendChild(li);
        };

        addLi('<i class="fas fa-chevron-right"></i>', currentPage - 1, currentPage === 1, false);

        let lo = Math.max(1, currentPage - 2), hi = Math.min(totalPages, currentPage + 2);
        if (lo > 1) { addLi('1', 1, false, false); if (lo > 2) addLi('...', null, true, false); }
        for (let p = lo; p <= hi; p++) addLi(p, p, false, p === currentPage);
        if (hi < totalPages) { if (hi < totalPages - 1) addLi('...', null, true, false); addLi(totalPages, totalPages, false, false); }

        addLi('<i class="fas fa-chevron-left"></i>', currentPage + 1, currentPage === totalPages, false);
    }

    function changePage(p) { currentPage = p; renderTable(); }

    document.addEventListener('DOMContentLoaded', renderTable);

    // ======= EXCEL EXPORT =======
    function exportToExcel() {
        let csv = '﻿#,التاريخ,إجمالي الإيرادات,كاش,كي نت,دين موظفين,على حساب الإدارة,عدد الفواتير\n';
        allRows.forEach(row => {
            const cells = row.querySelectorAll('td');
            csv += Array.from(cells).map(c => '"' + c.textContent.trim().replace(/"/g, '""') + '"').join(',') + '\n';
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'revenue-@ViewBag.From-@ViewBag.To.csv';
        a.click();
    }
</script>
}
