@model IEnumerable<Salon.Models.EmployeeEvalSummary>
@{
    ViewData["Title"] = "تقييم الموظفين";
    string? userDept = ViewBag.UserDept as string;
    bool isDeptUser = userDept == "حلاقة" || userDept == "مساج";
    int rank = 0;
}

<div class="page-header">
    <h1><i class="fas fa-user-check me-2"></i>تقييم الموظفين</h1>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1">من:</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">إلى:</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a href="@Url.Action("EvaluationList")" class="btn btn-secondary btn-sm ms-1"><i class="fas fa-undo"></i> إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-card green">
            <div class="stat-label">إجمالي الإيرادات</div>
            <div class="stat-value">@(((decimal)ViewBag.TotalRevenue).ToString("N3")) د.ك</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-right: 4px solid #fd7e14; background:#fff7f0;">
            <div class="stat-label">إجمالي الهدايا</div>
            <div class="stat-value" style="color:#fd7e14;">@(((decimal)ViewBag.TotalGifts).ToString("N3")) د.ك</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-label">إجمالي الفواتير</div>
            <div class="stat-value">@ViewBag.TotalSales</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="border-right: 4px solid #6f42c1; background:#f8f5ff;">
            <div class="stat-label">عدد الموظفين</div>
            <div class="stat-value" style="color:#6f42c1;">@Model.Count()</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم الموظف</th>
                        <th>القسم</th>
                        <th>عدد الفواتير</th>
                        <th>إجمالي الإيرادات</th>
                        <th>متوسط الفاتورة</th>
                        <th>إجمالي الهدايا</th>
                        <th>أيام الحضور</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(e => e.TotalRevenue))
                    {
                        rank++;
                        var dept = item.Employee.Department;
                        string badgeColor = dept == "حلاقة" ? "bg-secondary" : dept == "مساج" ? "" : "bg-dark";
                        string badgeStyle = dept == "مساج" ? "background:#6f42c1;" : "";
                        <tr>
                            <td>@rank</td>
                            <td><strong>@item.Employee.FullName</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(dept))
                                {
                                    <span class="badge @badgeColor" style="@badgeStyle">@dept</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@item.SalesCount</td>
                            <td><strong>@item.TotalRevenue.ToString("N3") د.ك</strong></td>
                            <td>@item.AvgPerSale.ToString("N3") د.ك</td>
                            <td>
                                @if (item.TotalGifts > 0)
                                {
                                    <span class="text-warning fw-bold">@item.TotalGifts.ToString("N3") د.ك</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success">@item.AttendanceDays يوم</span>
                            </td>
                            <td>
                                <a href="@Url.Action("EmployeeEvaluation", new { employeeId = item.Employee.Id, from = ViewBag.From, to = ViewBag.To })"
                                   class="btn btn-outline-primary btn-sm" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                لا توجد بيانات في هذه الفترة
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
