@inject Salon.Services.IPermissionService PermSvc
@{
    ViewData["Title"] = "التقارير";
    var accessibleModules = await PermSvc.GetAccessibleModulesAsync();
    bool canSee(string m) => accessibleModules.Contains(m);
}

<div class="page-header">
    <h1><i class="fas fa-chart-line me-2"></i>التقارير</h1>
    <p>الوصول إلى جميع تقارير النظام</p>
</div>

<div class="row g-3">
    @* ── الصف الأول ── *@
    @if (canSee("BarberDaily"))
    {
        <div class="col-md-4">
            <a href="@Url.Action("Index", "BarberDaily")" class="text-decoration-none">
                <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                    <div class="card-body text-center p-4">
                        <div class="mb-3" style="font-size:48px; color:#1a1a2e;"><i class="fas fa-cut"></i></div>
                        <h5>تقرير الأداء اليومي</h5>
                        <p class="text-muted small">تقرير يومي تفصيلي لإيرادات الموظفين (حلاقة / مساج) وحركة الكاش</p>
                    </div>
                </div>
            </a>
        </div>
    }
    <div class="col-md-4">
        <a href="@Url.Action("Revenue")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#16a34a;"><i class="fas fa-chart-column"></i></div>
                    <h5>تقرير الإيرادات حسب الفترة</h5>
                    <p class="text-muted small">ملخص الإيرادات اليومية مع تفصيل طرق الدفع</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("EmployeeRevenue")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#0284c7;"><i class="fas fa-users"></i></div>
                    <h5>تقرير الإيراد حسب الموظف</h5>
                    <p class="text-muted small">إيرادات وعمولات وصافي كل موظف مع السلف والخصومات والإكراميات</p>
                </div>
            </div>
        </a>
    </div>

    @* ── الصف الثاني ── *@
    <div class="col-md-4">
        <a href="@Url.Action("ProfitLoss")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#15803d;"><i class="fas fa-scale-balanced"></i></div>
                    <h5>تقرير الأرباح والخسائر الشهري</h5>
                    <p class="text-muted small">ملخص شامل للمبيعات والمصروفات والرواتب وصافي الربح لأداء الشهر</p>
                </div>
            </div>
        </a>
    </div>
    @if (canSee("DailyClosure"))
    {
        <div class="col-md-4">
            <a href="@Url.Action("Closures")" class="text-decoration-none">
                <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                    <div class="card-body text-center p-4">
                        <div class="mb-3" style="font-size:48px; color:#F7941D;"><i class="fas fa-calendar-days"></i></div>
                        <h5>تقرير الإغلاقات اليومية</h5>
                        <p class="text-muted small">حالة اعتماد إغلاق كل يوم مع فروقات الصندوق و KNET</p>
                    </div>
                </div>
            </a>
        </div>
    }
    <div class="col-md-4">
        <a href="@Url.Action("CashMovement")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#6f42c1;"><i class="fas fa-cash-register"></i></div>
                    <h5>تقرير حركة الصندوق</h5>
                    <p class="text-muted small">جميع المصروفات والإيداعات مجمعة مع فلتر النوع والتاريخ</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("BankMovement")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#0ea5e9;"><i class="fas fa-university"></i></div>
                    <h5>تقرير حركة البنك</h5>
                    <p class="text-muted small">مبيعات الكي نت والحركات غير النقدية مجمعة مع فلتر النوع والتاريخ</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("InventoryReport")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#0891b2;"><i class="fas fa-boxes"></i></div>
                    <h5>تقرير المخزون</h5>
                    <p class="text-muted small">مبيعات واستهلاك المنتجات مع الكميات والإيرادات خلال فترة</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("Refunds")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#dc2626;"><i class="fas fa-undo-alt"></i></div>
                    <h5>تقرير الاستردادات</h5>
                    <p class="text-muted small">جميع مبالغ الفواتير المستردة (كلياً أو جزئياً) مع السبب وطريقة الاسترداد</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("Expenses")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#dc3545;"><i class="fas fa-file-invoice-dollar"></i></div>
                    <h5>تقرير المصروفات</h5>
                    <p class="text-muted small">تقرير تفصيلي لجميع المصروفات خلال فترة محددة</p>
                </div>
            </div>
        </a>
    </div>

    @* ── باقي التقارير ── *@
    <div class="col-md-4">
        <a href="@Url.Action("Reports", "Attendance")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#17a2b8;"><i class="fas fa-calendar-check"></i></div>
                    <h5>تقارير الحضور</h5>
                    <p class="text-muted small">سجلات حضور وانصراف الموظفين</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("Report", "Advances")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#e83e8c;"><i class="fas fa-hand-holding-usd"></i></div>
                    <h5>تقرير السلف</h5>
                    <p class="text-muted small">تقرير تفصيلي لسلف الموظفين والمبالغ المسددة والمتبقية</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("EvaluationList")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#fd7e14;"><i class="fas fa-users-cog"></i></div>
                    <h5>تقييم الموظفين</h5>
                    <p class="text-muted small">قائمة بجميع الموظفين مع حضورهم ومبيعاتهم</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("EmployeeEvaluation")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#6f42c1;"><i class="fas fa-user-check"></i></div>
                    <h5>تقييم موظف واحد</h5>
                    <p class="text-muted small">تقرير تفصيلي لحضور ومبيعات موظف بعينه</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("Report", "Custody")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#6f42c1;"><i class="fas fa-hand-holding"></i></div>
                    <h5>تقرير العهد</h5>
                    <p class="text-muted small">عهد الموظفين المسلَّمة نقداً أو عن طريق لينك</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="@Url.Action("SalesByCustomer")" class="text-decoration-none">
            <div class="card h-100" style="transition:transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform=''">
                <div class="card-body text-center p-4">
                    <div class="mb-3" style="font-size:48px; color:#0284c7;"><i class="fas fa-user-tag"></i></div>
                    <h5>المبيعات على حسب العملاء</h5>
                    <p class="text-muted small">إجمالي مبيعات كل عميل مع عدد الزيارات وطرق الدفع</p>
                </div>
            </div>
        </a>
    </div>
</div>