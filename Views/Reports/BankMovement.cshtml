@model List<Salon.Models.CashMovementReportItem>
@{
    ViewData["Title"] = "تقرير حركة البنك";
    string selectedDept = ViewBag.SelectedDept ?? "";
    decimal totalMasrouf = ViewBag.TotalMasrouf is decimal tm ? tm : 0m;
    decimal totalSulfa = ViewBag.TotalSulfa is decimal ts2 ? ts2 : 0m;
    decimal totalRatib = ViewBag.TotalRatib is decimal tr ? tr : 0m;
    decimal totalExpenses = ViewBag.TotalExpenses is decimal te ? te : 0m;
    decimal totalDeposits = ViewBag.TotalDeposits is decimal td ? td : 0m;
    decimal totalKNet = ViewBag.TotalKNet is decimal tkn ? tkn : 0m;
    decimal totalWithdrawals = ViewBag.TotalWithdrawals is decimal tw ? tw : 0m;
    decimal bankBalance = ViewBag.BankBalance is decimal bb ? bb : 0m;
    decimal openingBalance = ViewBag.OpeningBalance is decimal ob ? ob : 0m;
    string selectedType = ViewBag.SelectedType ?? "";

    // كل الحركات هنا غير نقدية بالفعل (اتفلترت من الكنترولر)، فالرصيد الجاري بسيط:
    // مصروف/سلفة/راتب/سحب بتخصم، وكي نت/إيداع بتضيف
    string[] debitTypes = { "مصروف", "سلفة", "راتب", "سحب" };
    string[] creditTypes = { "كي نت", "إيداع" };

    var ascItems = Model.OrderBy(i => i.Date).ThenBy(i => i.Type).ToList();
    var itemBalance = new Dictionary<Salon.Models.CashMovementReportItem, decimal>();
    decimal runBal = openingBalance;
    foreach (var itm in ascItems)
    {
        if (debitTypes.Contains(itm.Type))
            runBal -= itm.Amount;
        else if (creditTypes.Contains(itm.Type))
            runBal += itm.Amount;
        itemBalance[itm] = runBal;
    }
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-university me-2"></i>تقرير حركة البنك</h1>
        <p>المصروفات والسلف والمرتبات والمبيعات والإيداعات والسحوبات غير النقدية خلال الفترة المحددة</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (!string.IsNullOrEmpty(selectedDept))
        {
            <span class="badge fs-6 px-3 py-2" style="background:@(selectedDept == "حلاقة" ? "#dbeafe" : "#f3e8ff"); color:@(selectedDept == "حلاقة" ? "#1d4ed8" : "#7c3aed");">
                <i class="fas fa-filter me-1"></i>@selectedDept
            </span>
        }
        <a href="@Url.Action("Index", "Reports")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-right me-1"></i> التقارير
        </a>
    </div>
</div>

@* ── فلاتر البحث ── *@
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">من تاريخ</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">إلى تاريخ</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">نوع الحركة</label>
                <select name="type" class="form-select">
                    <option value="" selected="@(selectedType == "" ? "selected" : null)">الكل</option>
                    <option value="مصروف" selected="@(selectedType == "مصروف" ? "selected" : null)">المصروفات</option>
                    <option value="كي نت" selected="@(selectedType == "كي نت" ? "selected" : null)">مبيعات الكي نت</option>
                    <option value="إيداع" selected="@(selectedType == "إيداع" ? "selected" : null)">الإيداعات</option>
                    <option value="سحب" selected="@(selectedType == "سحب" ? "selected" : null)">السحوبات</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">قسم المبيعات</label>
                <select name="dept" class="form-select">
                    <option value="" selected="@(selectedDept == "" ? "selected" : null)">الكل</option>
                    <option value="حلاقة" selected="@(selectedDept == "حلاقة" ? "selected" : null)">مبيعات الحلاقة</option>
                    <option value="مساج" selected="@(selectedDept == "مساج" ? "selected" : null)">مبيعات المساج</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> بحث
                </button>
            </div>
        </form>
    </div>
</div>

@* ── بطاقات الملخص ── *@

@* رصيد قبل الفترة *@
<div class="row g-3 mb-2">
    <div class="col-12">
        <div class="text-muted fw-semibold small mb-1 px-1">
            <i class="fas fa-box-open me-1" style="color:#64748b;"></i> الرصيد قبل الفترة
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #64748b !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#475569;"><i class="fas fa-box-open"></i></div>
                <div class="text-muted small">رصيد البنك قبل @ViewBag.From</div>
                <div class="fw-bold fs-6 mt-1" style="color:#475569;">@openingBalance.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

@* صف الدخل *@
<div class="row g-3 mb-2">
    <div class="col-12">
        <div class="text-muted fw-semibold small mb-1 px-1">
            <i class="fas fa-plus-circle text-success me-1"></i> الدخل
        </div>
    </div>
    <div class="col-6 col-md-6">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #0ea5e9 !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#0ea5e9;"><i class="fas fa-credit-card"></i></div>
                <div class="text-muted small">مبيعات الكي نت</div>
                <div class="fw-bold fs-6 mt-1" style="color:#0ea5e9;">@totalKNet.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-6">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #10b981 !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#10b981;"><i class="fas fa-money-bill-wave"></i></div>
                <div class="text-muted small">الإيداعات (بطاقة / تحويل)</div>
                <div class="fw-bold fs-6 mt-1" style="color:#10b981;">@totalDeposits.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

@* صف المصروفات *@
<div class="row g-3 mb-2">
    <div class="col-12">
        <div class="text-muted fw-semibold small mb-1 px-1">
            <i class="fas fa-minus-circle text-danger me-1"></i> المصروفات
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #ef4444 !important;">
            <div class="card-body p-3">
                <div class="text-danger mb-1" style="font-size:24px;"><i class="fas fa-receipt"></i></div>
                <div class="text-muted small">مصروفات عامة</div>
                <div class="fw-bold fs-6 text-danger mt-1">@totalMasrouf.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #f59e0b !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#b45309;"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="text-muted small">سلف الموظفين</div>
                <div class="fw-bold fs-6 mt-1" style="color:#b45309;">@totalSulfa.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #6f42c1 !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#6f42c1;"><i class="fas fa-money-bill-wave"></i></div>
                <div class="text-muted small">المرتبات</div>
                <div class="fw-bold fs-6 mt-1" style="color:#6f42c1;">@totalRatib.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

@if (totalWithdrawals > 0)
{
    <div class="row g-3 mb-2">
        <div class="col-6 col-md-4">
            <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #dc2626 !important;">
                <div class="card-body p-3">
                    <div class="mb-1" style="font-size:24px; color:#dc2626;"><i class="fas fa-hand-holding-usd"></i></div>
                    <div class="text-muted small">السحوبات (لينك)</div>
                    <div class="fw-bold fs-6 mt-1" style="color:#dc2626;">@totalWithdrawals.ToString("N3") <small>د.ك</small></div>
                </div>
            </div>
        </div>
    </div>
}

@{
    decimal totalExpensesWithWithdrawals = totalExpenses + totalWithdrawals;
}
<div class="alert alert-danger py-2 px-3 mb-3 d-flex justify-content-between align-items-center">
    <span><i class="fas fa-equals me-1"></i> إجمالي المصروفات (مصروفات + سلف + مرتبات + سحوبات)</span>
    <strong>@totalExpensesWithWithdrawals.ToString("N3") د.ك</strong>
</div>

@* رصيد البنك الرئيسي *@
<div class="card mb-4 border-2" style="border-color:@(bankBalance >= 0 ? "#0ea5e9" : "#dc2626") !important; background:@(bankBalance >= 0 ? "#eff6ff" : "#fff0f0");">
    <div class="card-body p-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="fw-bold" style="color:@(bankBalance >= 0 ? "#0ea5e9" : "#dc2626"); font-size:1rem;">
                    <i class="fas fa-university me-2"></i>رصيد البنك
                </div>
                <div class="text-muted" style="font-size:12px;">
                    رصيد قبل الفترة (@openingBalance.ToString("N3")) + مبيعات كي نت (@totalKNet.ToString("N3")) + إيداعات (@totalDeposits.ToString("N3"))
                    − مصروفات (@totalExpenses.ToString("N3")) − سحوبات (@totalWithdrawals.ToString("N3"))
                </div>
            </div>
            <div class="col-auto">
                <span class="fw-bold" style="font-size:1.8rem; color:@(bankBalance >= 0 ? "#0ea5e9" : "#dc2626");">
                    @bankBalance.ToString("N3") <small style="font-size:1rem;">د.ك</small>
                </span>
            </div>
        </div>
    </div>
</div>

@* ── جدول الحركات ── *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list me-2"></i>سجل الحركات (@Model.Count حركة)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                لا توجد حركات بنكية في هذه الفترة
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>التاريخ</th>
                            <th>النوع</th>
                            <th>البيان</th>
                            <th>الفئة / المصدر</th>
                            <th>طريقة الدفع</th>
                            <th>ملاحظات</th>
                            <th class="text-end">المبلغ (د.ك)</th>
                            <th class="text-end" style="background:#eff6ff;">رصيد البنك (د.ك)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int row = 0;
                        }
                        @foreach (var item in Model)
                        {
                            row++;
                            bool isDebit = debitTypes.Contains(item.Type);
                            bool isKNet = item.Type == "كي نت";
                            decimal bal = itemBalance.TryGetValue(item, out decimal b) ? b : 0m;

                            string rowBg = isKNet ? "background:#f0f9ff;" : item.Type == "سحب" ? "background:#fff5f5;" : "";
                            <tr style="@rowBg">
                                <td class="text-muted small">@row</td>
                                <td>@(isKNet? item.Date.ToString("yyyy/MM/dd") : item.Date.ToString("yyyy/MM/dd hh:mm tt"))</td>
                                <td>
                                    @switch (item.Type)
                                    {
                                        case "مصروف":
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">
                                                <i class="fas fa-minus-circle me-1"></i>مصروف
                                            </span>
                                            break;
                                        case "سلفة":
                                            <span class="badge px-2 py-1" style="background:rgba(245,158,11,0.12); color:#b45309;">
                                                <i class="fas fa-hand-holding-usd me-1"></i>سلفة
                                            </span>
                                            break;
                                        case "راتب":
                                            <span class="badge px-2 py-1" style="background:rgba(111,66,193,0.12); color:#6f42c1;">
                                                <i class="fas fa-money-bill-wave me-1"></i>راتب
                                            </span>
                                            break;
                                        case "كي نت":
                                            <span class="badge px-2 py-1" style="background:rgba(14,165,233,0.12); color:#0ea5e9;">
                                                <i class="fas fa-credit-card me-1"></i>كي نت
                                            </span>
                                            break;
                                        case "سحب":
                                            <span class="badge px-2 py-1" style="background:rgba(220,38,38,0.12); color:#dc2626;">
                                                <i class="fas fa-hand-holding-usd me-1"></i>سحب
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                                <i class="fas fa-plus-circle me-1"></i>إيداع
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>@item.Description</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Category) ? "-" : item.Category)</td>
                                <td class="text-muted small">@(isKNet ? "-" : item.PaymentMethod)</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</td>
                                <td class="text-end fw-semibold"
                                    style="color:@(isDebit ? "#dc2626" : "#16a34a");">
                                    @(isDebit ? "-" : "+")@item.Amount.ToString("N3")
                                </td>
                                <td class="text-end fw-bold" style="background:#eff6ff; font-size:0.9em; color:@(bal >= 0 ? "#0ea5e9" : "#dc2626");">
                                    @bal.ToString("N3")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="7" class="text-end text-muted">رصيد البنك قبل الفترة</td>
                            <td class="text-end" style="color:#475569;">@openingBalance.ToString("N3")</td>
                            <td class="text-end" style="background:#eff6ff; color:#475569;">@openingBalance.ToString("N3")</td>
                        </tr>
                        @if (totalMasrouf > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted">المصروفات العامة</td>
                                <td class="text-end text-danger">-@totalMasrouf.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalSulfa > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted">السلف</td>
                                <td class="text-end" style="color:#b45309;">-@totalSulfa.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalRatib > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted">المرتبات</td>
                                <td class="text-end" style="color:#6f42c1;">-@totalRatib.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalWithdrawals > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted">السحوبات</td>
                                <td class="text-end text-danger">-@totalWithdrawals.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalKNet > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted">مبيعات الكي نت</td>
                                <td class="text-end" style="color:#0ea5e9;">+@totalKNet.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalDeposits > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted">الإيداعات</td>
                                <td class="text-end text-success">+@totalDeposits.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        <tr style="background:#eff6ff;">
                            <td colspan="7" class="text-end fw-bold" style="color:#0ea5e9;">
                                <i class="fas fa-university me-1"></i> رصيد البنك (رصيد قبل الفترة + كي نت + إيداعات − مصروفات − سحوبات)
                            </td>
                            <td class="text-end fw-bold" style="color:@(bankBalance >= 0 ? "#0ea5e9" : "#dc2626"); font-size:1.05em;">
                                @bankBalance.ToString("N3")
                            </td>
                            <td class="text-end fw-bold" style="background:#dbeafe; color:@(bankBalance >= 0 ? "#0ea5e9" : "#dc2626"); font-size:1.05em;">
                                @bankBalance.ToString("N3")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>