@model IEnumerable<Salon.Models.Sale>
@using Salon.Models
@using System.Collections.Generic
@{
    ViewData["Title"] = "تقرير المبيعات";
    var employees = ViewBag.Employees as IEnumerable<Salon.Models.Employee> ?? Enumerable.Empty<Salon.Models.Employee>();
    var customers = ViewBag.Customers as IEnumerable<Salon.Models.Customer> ?? Enumerable.Empty<Salon.Models.Customer>();
    int? selectedEmployee = ViewBag.SelectedEmployeeId;
    int? selectedCustomer = ViewBag.SelectedCustomerId;
    string? selectedType = ViewBag.SelectedSaleType;
    string? userDept = ViewBag.UserDept as string;

    bool isHaircut = userDept == "حلاقة";
    bool isMassage = userDept == "مساج";
    bool isDeptUser = isHaircut || isMassage;

    string? selectedPaymentMethod = ViewBag.SelectedPaymentMethod as string;

    var expensesInRange = ViewBag.ExpensesInRange as List<Expense> ?? new List<Expense>();
    var salariesInRange = ViewBag.SalariesInRange as List<Salary> ?? new List<Salary>();
    var depositsInRange = ViewBag.DepositsInRange as List<Deposit> ?? new List<Deposit>();
    decimal totalExpensesAmount = ViewBag.TotalExpensesAmount is decimal tea ? tea : 0m;
    decimal totalSalariesAmount = ViewBag.TotalSalariesAmount is decimal tsa ? tsa : 0m;
    decimal totalCombinedExpenses = ViewBag.TotalCombinedExpenses is decimal tce ? tce : 0m;
    decimal totalDepositsAmount = ViewBag.TotalDepositsAmount is decimal tda ? tda : 0m;
    decimal netProfit = ((decimal)(ViewBag.TotalSales ?? 0m)) + totalDepositsAmount - totalCombinedExpenses;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="fas fa-chart-bar me-2"></i>تقرير المبيعات</h1>
    <button onclick="window.print()" class="btn btn-dark btn-sm no-print">
        <i class="fas fa-print me-1"></i> طباعة
    </button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1">من:</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">إلى:</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">النوع:</label>
                <select id="saleTypeSelect" name="saleType" class="form-select" style="max-width:160px;">
                    <option value="">الكل</option>
                    @if (!isMassage)
                    {
                        <option value="حلاقة" @@(selectedType= ="حلاقة" ? "selected" : "" )>حلاقة</option>
                    }
                    @if (!isHaircut)
                    {
                        <option value="مساج" @@(selectedType= ="مساج" ? "selected" : "" )>مساج</option>
                    }
                    <option value="منتجات" @@(selectedType= ="منتجات" ? "selected" : "" )>منتجات</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">طريقة الدفع:</label>
                <select name="paymentMethod" class="form-select" style="max-width:200px;">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedPaymentMethod))">-- الكل --</option>
                    <option value="كاش" selected="@(selectedPaymentMethod == "كاش")">💵 كاش</option>
                    <option value="كي نت" selected="@(selectedPaymentMethod == "كي نت")">💳 كي نت</option>
                    <option value="كي نت و كاش" selected="@(selectedPaymentMethod == "كي نت و كاش")">↔ كاش + كي نت</option>
                    <option value="دين على العميل" selected="@(selectedPaymentMethod == "دين على العميل")">👤 دين على العميل</option>
                    <option value="دين على الموظف" selected="@(selectedPaymentMethod == "دين على الموظف")">👷 دين على الموظف</option>
                    <option value="دين على صاحب المكان" selected="@(selectedPaymentMethod == "دين على صاحب المكان")">🏠 دين على صاحب المكان</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">الموظف:</label>
                <select id="employeeSelect" name="employeeId" class="form-select" style="max-width:200px;">
                    <option value="">الكل</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id"
                                data-dept="@(emp.Department ?? "")"
                                @@(selectedEmployee= =emp.Id ? "selected" : "" )>@emp.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">العميل:</label>
                <select id="customerSelect" name="customerId" class="form-select" style="max-width:200px;">
                    <option value="">الكل</option>
                    @foreach (var cust in customers)
                    {
                        <option value="@cust.Id"
                                data-dept="@(cust.Department ?? "")"
                                @@(selectedCustomer= =cust.Id ? "selected" : "" )>@cust.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a href="@Url.Action("Sales")" class="btn btn-secondary btn-sm ms-1"><i class="fas fa-undo"></i> إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-card green">
            <div class="stat-label">إجمالي المبيعات (مكتملة)</div>
            <div class="stat-value">@ViewBag.TotalSales?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-label">عدد الفواتير (مكتملة)</div>
            <div class="stat-value">@ViewBag.TotalCount</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card red">
            <div class="stat-label">إجمالي المصاريف</div>
            <div class="stat-value">@(totalCombinedExpenses.ToString("N3")) د.ك</div>
            @if (totalExpensesAmount > 0 || totalSalariesAmount > 0)
            {
                <div class="small mt-1" style="color:#fca5a5;">
                    @if (totalExpensesAmount > 0)
                    {
                        <span>مصروفات: @totalExpensesAmount.ToString("N3")</span>
                    }
                    @if (totalSalariesAmount > 0)
                    {
                        <span class="ms-2">مرتبات: @totalSalariesAmount.ToString("N3")</span>
                    }
                </div>
            }
        </div>
    </div>
    @if (totalDepositsAmount > 0)
    {
        <div class="col-md-3">
            <div class="stat-card" style="border-right:4px solid #16a34a;">
                <div class="stat-label">الإيداعات</div>
                <div class="stat-value" style="color:#16a34a;">@totalDepositsAmount.ToString("N3") د.ك</div>
            </div>
        </div>
    }
    <div class="col-md-3">
        <div class="stat-card orange">
            <div class="stat-label">صافي الربح</div>
            <div class="stat-value">@netProfit.ToString("N3") د.ك</div>
        </div>
    </div>
    @if (!isMassage)
    {
        <div class="col-md-2">
            <div class="stat-card" style="border-right: 4px solid #6c757d; background:#f8f9fa;">
                <div class="stat-label">حلاقة (مكتملة)</div>
                <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalHaircut?.ToString("N3") د.ك</div>
            </div>
        </div>
    }
    @if (!isHaircut)
    {
        <div class="col-md-2">
            <div class="stat-card" style="border-right: 4px solid #6f42c1; background:#f8f9fa;">
                <div class="stat-label">مساج (مكتملة)</div>
                <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalMassage?.ToString("N3") د.ك</div>
            </div>
        </div>
    }
    <div class="col-md-2">
        <div class="stat-card" style="border-right: 4px solid #fd7e14; background:#f8f9fa;">
            <div class="stat-label">منتجات</div>
            <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalProducts?.ToString("N3") د.ك</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #0891b2;">
            <div class="stat-label">إجمالي الكاش</div>
            <div class="stat-value" style="color:#0891b2;">@ViewBag.TotalCash?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #059669;">
            <div class="stat-label">إجمالي الكي نت</div>
            <div class="stat-value" style="color:#059669;">@ViewBag.TotalKnet?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #fd7e14;">
            <div class="stat-label">دين على الموظف</div>
            <div class="stat-value" style="color:#fd7e14;">@ViewBag.TotalEmployeeDebt?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #7c3aed;">
            <div class="stat-label">دين على صاحب المكان</div>
            <div class="stat-value" style="color:#7c3aed;">@ViewBag.TotalOwnerDebt?.ToString("N3") د.ك</div>
        </div>
    </div>
    @if ((decimal)(ViewBag.TotalCancelled ?? 0m) > 0)
    {
        <div class="col-md-2">
            <div class="stat-card" style="border-right:4px solid #dc2626;">
                <div class="stat-label">إجمالي الملغاة (@ViewBag.TotalCancelledCount فاتورة)</div>
                <div class="stat-value" style="color:#dc2626;">@ViewBag.TotalCancelled?.ToString("N3") د.ك</div>
            </div>
        </div>
    }
</div>

<div class="card print-area">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        @if (!isDeptUser)
                        {
                            <th>النوع</th>
                        }
                        <th>العميل</th>
                        <th>الموظف</th>
                        <th>التاريخ</th>
                        <th>الصافي</th>
                        <th>الدفع</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.InvoiceNumber</td>
                            @if (!isDeptUser)
                            {
                                <td>
                                    @if (s.SaleType == "حلاقة")
                                    {
                                        <span class="badge bg-secondary">حلاقة</span>
                                    }
                                    else if (s.SaleType == "مساج")
                                    {
                                        <span class="badge" style="background:#6f42c1;">مساج</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fd7e14;">منتجات</span>
                                    }
                                </td>
                            }
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@s.SaleDate.ToString("yyyy/MM/dd")</td>
                            <td><strong>@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>@s.PaymentMethod</td>
                            <td><span class="badge @(s.Status == "مكتمل" ? "bg-success" : "bg-danger")">@s.Status</span></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="@(isDeptUser ? 7 : 8)" class="text-center text-muted py-4">لا توجد مبيعات في هذه الفترة</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ─── قسم المصاريف ─── *@
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-file-invoice-dollar me-2 text-danger"></i>تقرير المصاريف</h5>
        <div class="d-flex gap-3 align-items-center">
            @if (totalExpensesAmount > 0)
            {
                <span class="small text-muted">مصروفات: <strong>@totalExpensesAmount.ToString("N3") د.ك</strong></span>
            }
            @if (totalSalariesAmount > 0)
            {
                <span class="small text-muted">مرتبات: <strong>@totalSalariesAmount.ToString("N3") د.ك</strong></span>
            }
            <span class="badge bg-danger fs-6">الإجمالي: @totalCombinedExpenses.ToString("N3") د.ك</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!expensesInRange.Any() && !salariesInRange.Any() && !depositsInRange.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                لا توجد مصاريف أو إيداعات في هذه الفترة
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>النوع</th>
                            <th>البيان</th>
                            <th>الفئة / الموظف</th>
                            <th>المبلغ</th>
                            <th>طريقة الدفع</th>
                            <th>التاريخ</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exp in expensesInRange)
                        {
                            <tr>
                                <td><span class="badge bg-warning text-dark"><i class="fas fa-receipt me-1"></i>مصروف</span></td>
                                <td>@exp.Description</td>
                                <td class="text-muted">@(exp.Category ?? "-")</td>
                                <td><strong class="text-danger">@exp.Amount.ToString("N3") د.ك</strong></td>
                                <td>@exp.PaymentMethod</td>
                                <td>@exp.ExpenseDate.ToString("yyyy/MM/dd")</td>
                                <td class="text-muted small">@exp.Notes</td>
                            </tr>
                        }
                        @foreach (var sal in salariesInRange)
                        {
                            <tr style="background:#fff5f5;">
                                <td><span class="badge bg-danger"><i class="fas fa-money-check-alt me-1"></i>مرتب</span></td>
                                <td>مرتب @sal.Month/@sal.Year</td>
                                <td>@sal.Employee?.FullName</td>
                                <td><strong class="text-danger">@sal.NetSalary.ToString("N3") د.ك</strong></td>
                                <td>نقدي</td>
                                <td>@sal.PaidDate?.ToString("yyyy/MM/dd")</td>
                                <td class="text-muted small">@sal.Notes</td>
                            </tr>
                        }
                        @foreach (var dep in depositsInRange)
                        {
                            <tr style="background:#f0fdf4;">
                                <td><span class="badge" style="background:#16a34a;"><i class="fas fa-money-bill-wave me-1"></i>إيداع</span></td>
                                <td>@dep.Description</td>
                                <td class="text-muted">@(dep.Source ?? "-")</td>
                                <td><strong class="text-success">@dep.Amount.ToString("N3") د.ك</strong></td>
                                <td>-</td>
                                <td>@dep.DepositDate.ToString("yyyy/MM/dd")</td>
                                <td class="text-muted small">@dep.Notes</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-dark fw-bold">
                        <tr>
                            <td colspan="3" class="text-end">إجمالي المصاريف</td>
                            <td class="text-danger">@totalCombinedExpenses.ToString("N3") د.ك</td>
                            <td colspan="3"></td>
                        </tr>
                        @if (totalDepositsAmount > 0)
                        {
                            <tr style="background:#166534;color:#fff;">
                                <td colspan="3" class="text-end">إجمالي الإيداعات</td>
                                <td>@totalDepositsAmount.ToString("N3") د.ك</td>
                                <td colspan="3"></td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var typeSelect = document.getElementById('saleTypeSelect');
            var empSelect  = document.getElementById('employeeSelect');
            var custSelect = document.getElementById('customerSelect');
            var userDept   = '@Html.Raw(userDept ?? "")';

            function filterByType(type) {
                // For dept users with no type selected, default filtering to their dept
                var effectiveType = type || (userDept === 'حلاقة' || userDept === 'مساج' ? userDept : '');
                filterOptions(empSelect,  effectiveType);
                filterOptions(custSelect, effectiveType);
            }

            function filterOptions(select, type) {
                var options = select.querySelectorAll('option[data-dept]');
                options.forEach(function (opt) {
                    var dept = opt.getAttribute('data-dept');
                    var visible = !type || type === 'منتجات' || !dept || dept === type;
                    opt.hidden = !visible;
                    if (!visible && opt.selected) select.value = '';
                });
            }

            typeSelect.addEventListener('change', function () {
                filterByType(this.value);
            });

            filterByType(typeSelect.value);
        })();
    </script>
}