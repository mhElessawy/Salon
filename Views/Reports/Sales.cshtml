@model IEnumerable<Salon.Models.Sale>
@{
    ViewData["Title"] = "تقرير المبيعات";
    var employees    = ViewBag.Employees as IEnumerable<Salon.Models.Employee> ?? Enumerable.Empty<Salon.Models.Employee>();
    var customers    = ViewBag.Customers as IEnumerable<Salon.Models.Customer> ?? Enumerable.Empty<Salon.Models.Customer>();
    int?    selectedEmployee = ViewBag.SelectedEmployeeId;
    int?    selectedCustomer = ViewBag.SelectedCustomerId;
    string? selectedType     = ViewBag.SelectedSaleType;
    string? userDept         = ViewBag.UserDept as string;

    bool isHaircut = userDept == "حلاقة";
    bool isMassage = userDept == "مساج";
    bool isDeptUser = isHaircut || isMassage;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="fas fa-chart-bar me-2"></i>تقرير المبيعات</h1>
    <button onclick="window.print()" class="btn btn-dark btn-sm no-print">
        <i class="fas fa-print me-1"></i> طباعة
    </button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1">من:</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">إلى:</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">النوع:</label>
                <select id="saleTypeSelect" name="saleType" class="form-select" style="max-width:160px;">
                    <option value="">الكل</option>
                    @if (!isMassage)
                    {
                        <option value="حلاقة" @@(selectedType == "حلاقة" ? "selected" : "")>حلاقة</option>
                    }
                    @if (!isHaircut)
                    {
                        <option value="مساج" @@(selectedType == "مساج" ? "selected" : "")>مساج</option>
                    }
                    <option value="منتجات" @@(selectedType == "منتجات" ? "selected" : "")>منتجات</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">الموظف:</label>
                <select id="employeeSelect" name="employeeId" class="form-select" style="max-width:200px;">
                    <option value="">الكل</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id"
                                data-dept="@(emp.Department ?? "")"
                                @@(selectedEmployee == emp.Id ? "selected" : "")>@emp.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">العميل:</label>
                <select id="customerSelect" name="customerId" class="form-select" style="max-width:200px;">
                    <option value="">الكل</option>
                    @foreach (var cust in customers)
                    {
                        <option value="@cust.Id"
                                data-dept="@(cust.Department ?? "")"
                                @@(selectedCustomer == cust.Id ? "selected" : "")>@cust.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a href="@Url.Action("Sales")" class="btn btn-secondary btn-sm ms-1"><i class="fas fa-undo"></i> إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat-card green">
            <div class="stat-label">إجمالي المبيعات (مكتملة)</div>
            <div class="stat-value">@ViewBag.TotalSales?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card blue">
            <div class="stat-label">عدد الفواتير (مكتملة)</div>
            <div class="stat-value">@ViewBag.TotalCount</div>
        </div>
    </div>
    @if (!isMassage)
    {
        <div class="col-md-2">
            <div class="stat-card" style="border-right: 4px solid #6c757d; background:#f8f9fa;">
                <div class="stat-label">حلاقة (مكتملة)</div>
                <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalHaircut?.ToString("N3") د.ك</div>
            </div>
        </div>
    }
    @if (!isHaircut)
    {
        <div class="col-md-2">
            <div class="stat-card" style="border-right: 4px solid #6f42c1; background:#f8f9fa;">
                <div class="stat-label">مساج (مكتملة)</div>
                <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalMassage?.ToString("N3") د.ك</div>
            </div>
        </div>
    }
    <div class="col-md-2">
        <div class="stat-card" style="border-right: 4px solid #fd7e14; background:#f8f9fa;">
            <div class="stat-label">منتجات</div>
            <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalProducts?.ToString("N3") د.ك</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #0891b2;">
            <div class="stat-label">إجمالي الكاش</div>
            <div class="stat-value" style="color:#0891b2;">@ViewBag.TotalCash?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #059669;">
            <div class="stat-label">إجمالي الكي نت</div>
            <div class="stat-value" style="color:#059669;">@ViewBag.TotalKnet?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #fd7e14;">
            <div class="stat-label">دين على الموظف</div>
            <div class="stat-value" style="color:#fd7e14;">@ViewBag.TotalEmployeeDebt?.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="stat-card" style="border-right:4px solid #7c3aed;">
            <div class="stat-label">دين على صاحب المكان</div>
            <div class="stat-value" style="color:#7c3aed;">@ViewBag.TotalOwnerDebt?.ToString("N3") د.ك</div>
        </div>
    </div>
    @if ((decimal)(ViewBag.TotalCancelled ?? 0m) > 0)
    {
        <div class="col-md-2">
            <div class="stat-card" style="border-right:4px solid #dc2626;">
                <div class="stat-label">إجمالي الملغاة (@ViewBag.TotalCancelledCount فاتورة)</div>
                <div class="stat-value" style="color:#dc2626;">@ViewBag.TotalCancelled?.ToString("N3") د.ك</div>
            </div>
        </div>
    }
</div>

<div class="card print-area">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        @if (!isDeptUser)
                        {
                            <th>النوع</th>
                        }
                        <th>العميل</th>
                        <th>الموظف</th>
                        <th>التاريخ</th>
                        <th>الصافي</th>
                        <th>الدفع</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.InvoiceNumber</td>
                            @if (!isDeptUser)
                            {
                                <td>
                                    @if (s.SaleType == "حلاقة")
                                    {
                                        <span class="badge bg-secondary">حلاقة</span>
                                    }
                                    else if (s.SaleType == "مساج")
                                    {
                                        <span class="badge" style="background:#6f42c1;">مساج</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fd7e14;">منتجات</span>
                                    }
                                </td>
                            }
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@s.SaleDate.ToString("yyyy/MM/dd")</td>
                            <td><strong>@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>@s.PaymentMethod</td>
                            <td><span class="badge @(s.Status == "مكتمل" ? "bg-success" : "bg-danger")">@s.Status</span></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="@(isDeptUser ? 7 : 8)" class="text-center text-muted py-4">لا توجد مبيعات في هذه الفترة</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var typeSelect = document.getElementById('saleTypeSelect');
        var empSelect  = document.getElementById('employeeSelect');
        var custSelect = document.getElementById('customerSelect');
        var userDept   = '@Html.Raw(userDept ?? "")';

        function filterByType(type) {
            // For dept users with no type selected, default filtering to their dept
            var effectiveType = type || (userDept === 'حلاقة' || userDept === 'مساج' ? userDept : '');
            filterOptions(empSelect,  effectiveType);
            filterOptions(custSelect, effectiveType);
        }

        function filterOptions(select, type) {
            var options = select.querySelectorAll('option[data-dept]');
            options.forEach(function (opt) {
                var dept = opt.getAttribute('data-dept');
                var visible = !type || type === 'منتجات' || !dept || dept === type;
                opt.hidden = !visible;
                if (!visible && opt.selected) select.value = '';
            });
        }

        typeSelect.addEventListener('change', function () {
            filterByType(this.value);
        });

        filterByType(typeSelect.value);
    })();
</script>
}