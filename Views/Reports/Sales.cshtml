@model IEnumerable<Salon.Models.Sale>
@using Salon.Models
@{
    ViewData["Title"] = "تقرير المبيعات";
    var employees    = ViewBag.Employees as IEnumerable<Salon.Models.Employee> ?? Enumerable.Empty<Salon.Models.Employee>();
    var customers    = ViewBag.Customers as IEnumerable<Salon.Models.Customer> ?? Enumerable.Empty<Salon.Models.Customer>();
    var expensesList = ViewBag.ExpensesList as IEnumerable<Expense> ?? Enumerable.Empty<Expense>();
    int?    selectedEmployee = ViewBag.SelectedEmployeeId;
    int?    selectedCustomer = ViewBag.SelectedCustomerId;
    string? selectedType     = ViewBag.SelectedSaleType;
    string? userDept         = ViewBag.UserDept as string;

    bool isHaircut  = userDept == "حلاقة";
    bool isMassage  = userDept == "مساج";
    bool isDeptUser = isHaircut || isMassage;
}

<div class="page-header">
    <h1><i class="fas fa-chart-bar me-2"></i>تقرير المبيعات</h1>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1">من:</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">إلى:</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">النوع:</label>
                <select id="saleTypeSelect" name="saleType" class="form-select" style="max-width:160px;">
                    <option value="">الكل</option>
                    @if (!isMassage)
                    {
                        <option value="حلاقة" @@(selectedType == "حلاقة" ? "selected" : "")>حلاقة</option>
                    }
                    @if (!isHaircut)
                    {
                        <option value="مساج" @@(selectedType == "مساج" ? "selected" : "")>مساج</option>
                    }
                    <option value="منتجات" @@(selectedType == "منتجات" ? "selected" : "")>منتجات</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">الموظف:</label>
                <select id="employeeSelect" name="employeeId" class="form-select" style="max-width:200px;">
                    <option value="">الكل</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id"
                                data-dept="@(emp.Department ?? "")"
                                @@(selectedEmployee == emp.Id ? "selected" : "")>@emp.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">العميل:</label>
                <select id="customerSelect" name="customerId" class="form-select" style="max-width:200px;">
                    <option value="">الكل</option>
                    @foreach (var cust in customers)
                    {
                        <option value="@cust.Id"
                                data-dept="@(cust.Department ?? "")"
                                @@(selectedCustomer == cust.Id ? "selected" : "")>@cust.FullName</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
                <a href="@Url.Action("Sales")" class="btn btn-secondary btn-sm ms-1"><i class="fas fa-undo"></i> إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

<div class="stat-cards mb-4">
    <div class="stat-card green">
        <div class="stat-card-header">
            <span class="stat-label">إجمالي المبيعات</span>
            <div class="stat-icon green"><i class="fas fa-dollar-sign"></i></div>
        </div>
        <div class="stat-value">@ViewBag.TotalSales?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card red">
        <div class="stat-card-header">
            <span class="stat-label">المصروفات</span>
            <div class="stat-icon red"><i class="fas fa-shopping-bag"></i></div>
        </div>
        <div class="stat-value">@ViewBag.TotalExpenses?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #9f1239;">
        <div class="stat-card-header">
            <span class="stat-label">السلف</span>
            <div class="stat-icon" style="background:#9f1239;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-hand-holding-usd"></i></div>
        </div>
        <div class="stat-value" style="color:#9f1239;">@ViewBag.TotalAdvances?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-card-header">
            <span class="stat-label">صافي الربح</span>
            <div class="stat-icon orange"><i class="fas fa-chart-line"></i></div>
        </div>
        <div class="stat-value">@ViewBag.NetProfit?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card blue">
        <div class="stat-card-header">
            <span class="stat-label">عدد الفواتير</span>
            <div class="stat-icon blue"><i class="fas fa-file-invoice"></i></div>
        </div>
        <div class="stat-value">@ViewBag.TotalCount</div>
    </div>
</div>

<div class="stat-cards mb-4">
    @if (!isMassage)
    {
        <div class="stat-card" style="border-right:4px solid #6c757d;background:#f8f9fa;">
            <div class="stat-card-header">
                <span class="stat-label">حلاقة</span>
                <div class="stat-icon" style="background:#6c757d;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-cut"></i></div>
            </div>
            <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalHaircut?.ToString("N3") د.ك</div>
        </div>
    }
    @if (!isHaircut)
    {
        <div class="stat-card" style="border-right:4px solid #6f42c1;background:#f8f9fa;">
            <div class="stat-card-header">
                <span class="stat-label">مساج</span>
                <div class="stat-icon" style="background:#6f42c1;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-spa"></i></div>
            </div>
            <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalMassage?.ToString("N3") د.ك</div>
        </div>
    }
    <div class="stat-card" style="border-right:4px solid #fd7e14;background:#f8f9fa;">
        <div class="stat-card-header">
            <span class="stat-label">منتجات</span>
            <div class="stat-icon" style="background:#fd7e14;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-box"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.2rem;">@ViewBag.TotalProducts?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #0891b2;">
        <div class="stat-card-header">
            <span class="stat-label">كاش</span>
            <div class="stat-icon" style="background:#0891b2;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-money-bill-wave"></i></div>
        </div>
        <div class="stat-value">@ViewBag.CashTotal?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #059669;">
        <div class="stat-card-header">
            <span class="stat-label">كي نت</span>
            <div class="stat-icon" style="background:#059669;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-credit-card"></i></div>
        </div>
        <div class="stat-value">@ViewBag.KnetTotal?.ToString("N3") د.ك</div>
    </div>
</div>

<div class="stat-cards mb-4">
    <div class="stat-card" style="border-right:4px solid #dc2626;">
        <div class="stat-card-header">
            <span class="stat-label">دين على العميل</span>
            <div class="stat-icon" style="background:#dc2626;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-user"></i></div>
        </div>
        <div class="stat-value" style="color:#dc2626;">@ViewBag.CustomerDebt?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #b45309;">
        <div class="stat-card-header">
            <span class="stat-label">دين على الموظف</span>
            <div class="stat-icon" style="background:#b45309;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-hard-hat"></i></div>
        </div>
        <div class="stat-value" style="color:#b45309;">@ViewBag.EmployeeDebt?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #7c3aed;">
        <div class="stat-card-header">
            <span class="stat-label">دين على صاحب المكان</span>
            <div class="stat-icon" style="background:#7c3aed;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-building"></i></div>
        </div>
        <div class="stat-value" style="color:#7c3aed;">@ViewBag.OwnerDebt?.ToString("N3") د.ك</div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        @if (!isDeptUser)
                        {
                            <th>النوع</th>
                        }
                        <th>العميل</th>
                        <th>الموظف</th>
                        <th>التاريخ</th>
                        <th>الصافي</th>
                        <th>الدفع</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.InvoiceNumber</td>
                            @if (!isDeptUser)
                            {
                                <td>
                                    @if (s.SaleType == "حلاقة")
                                    {
                                        <span class="badge bg-secondary">حلاقة</span>
                                    }
                                    else if (s.SaleType == "مساج")
                                    {
                                        <span class="badge" style="background:#6f42c1;">مساج</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fd7e14;">منتجات</span>
                                    }
                                </td>
                            }
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@s.SaleDate.ToString("yyyy/MM/dd")</td>
                            <td><strong>@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>@s.PaymentMethod</td>
                            <td><span class="badge @(s.Status == "مكتمل" ? "bg-success" : "bg-danger")">@s.Status</span></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="@(isDeptUser ? 7 : 8)" class="text-center text-muted py-4">لا توجد مبيعات في هذه الفترة</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (expensesList.Any())
{
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-shopping-bag me-2"></i>تفاصيل المصروفات — @expensesList.Count() بند</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>البيان</th>
                            <th>الفئة</th>
                            <th>طريقة الدفع</th>
                            <th>المبلغ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exp in expensesList)
                        {
                            <tr>
                                <td>@exp.ExpenseDate.ToString("yyyy/MM/dd")</td>
                                <td>@exp.Description</td>
                                <td>@(exp.Category ?? "-")</td>
                                <td>@(exp.PaymentMethod ?? "-")</td>
                                <td><strong class="text-danger">@exp.Amount.ToString("N3") د.ك</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">الإجمالي:</td>
                            <td class="text-danger">@expensesList.Sum(e => e.Amount).ToString("N3") د.ك</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    (function () {
        var typeSelect = document.getElementById('saleTypeSelect');
        var empSelect  = document.getElementById('employeeSelect');
        var custSelect = document.getElementById('customerSelect');
        var userDept   = '@Html.Raw(userDept ?? "")';

        function filterByType(type) {
            // For dept users with no type selected, default filtering to their dept
            var effectiveType = type || (userDept === 'حلاقة' || userDept === 'مساج' ? userDept : '');
            filterOptions(empSelect,  effectiveType);
            filterOptions(custSelect, effectiveType);
        }

        function filterOptions(select, type) {
            var options = select.querySelectorAll('option[data-dept]');
            options.forEach(function (opt) {
                var dept = opt.getAttribute('data-dept');
                var visible = !type || type === 'منتجات' || !dept || dept === type;
                opt.hidden = !visible;
                if (!visible && opt.selected) select.value = '';
            });
        }

        typeSelect.addEventListener('change', function () {
            filterByType(this.value);
        });

        filterByType(typeSelect.value);
    })();
</script>
}