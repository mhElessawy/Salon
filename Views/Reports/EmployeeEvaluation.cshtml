@{
    ViewData["Title"] = "تقييم موظف";
    var employees = ViewBag.Employees as IEnumerable<Salon.Models.Employee> ?? Enumerable.Empty<Salon.Models.Employee>();
    int? selectedEmployeeId = ViewBag.SelectedEmployeeId;
    Salon.Models.Employee? selectedEmp = ViewBag.SelectedEmployee as Salon.Models.Employee;
    var sales = ViewBag.Sales as IEnumerable<Salon.Models.Sale> ?? Enumerable.Empty<Salon.Models.Sale>();
    var attendances = ViewBag.Attendances as IEnumerable<Salon.Models.Attendance> ?? Enumerable.Empty<Salon.Models.Attendance>();
    string? userDept = ViewBag.UserDept as string;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="fas fa-user-tie me-2"></i>تقييم موظف</h1>
    <a href="@Url.Action("EvaluationList", new { from = ViewBag.From, to = ViewBag.To })" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-list me-1"></i>عرض قائمة الكل
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1">الموظف:</label>
                <select name="employeeId" class="form-select">
                    <option value="">-- اختر موظفاً --</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id" @@(selectedEmployeeId == emp.Id ? "selected" : "")>
                            @emp.FullName @(emp.Department != null ? "(" + emp.Department + ")" : "")
                        </option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">من:</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">إلى:</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:170px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> عرض</button>
                <a href="@Url.Action("EmployeeEvaluation")" class="btn btn-secondary btn-sm ms-1"><i class="fas fa-undo"></i> إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

@if (selectedEmp == null)
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="fas fa-user-circle fa-4x mb-3 d-block" style="opacity:0.3;"></i>
            <h5>اختر موظفاً للعرض</h5>
            <p class="mb-0">حدد موظفاً من القائمة أعلاه ثم اضغط "عرض" لمشاهدة تفاصيل التقييم</p>
        </div>
    </div>
}
else
{
    var dept = selectedEmp.Department;
    string deptBadgeColor = dept == "حلاقة" ? "bg-secondary" : dept == "مساج" ? "" : "bg-dark";
    string deptBadgeStyle = dept == "مساج" ? "background:#6f42c1;" : "";

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white"
                     style="width:56px;height:56px;font-size:1.5rem;flex-shrink:0;">
                    <i class="fas fa-user"></i>
                </div>
                <div>
                    <h4 class="mb-1">@selectedEmp.FullName</h4>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        @if (!string.IsNullOrEmpty(dept))
                        {
                            <span class="badge @deptBadgeColor" style="@deptBadgeStyle">@dept</span>
                        }
                        @if (!string.IsNullOrEmpty(selectedEmp.JobTitle))
                        {
                            <span class="text-muted">@selectedEmp.JobTitle</span>
                        }
                        <small class="text-muted">
                            <i class="fas fa-calendar-alt me-1"></i>تاريخ التعيين: @selectedEmp.HireDate.ToString("yyyy/MM/dd")
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="stat-card blue">
                <div class="stat-label">عدد الفواتير</div>
                <div class="stat-value">@ViewBag.SalesCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card green">
                <div class="stat-label">إجمالي الإيرادات</div>
                <div class="stat-value">@(((decimal)ViewBag.TotalRevenue).ToString("N3")) د.ك</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-right: 4px solid #fd7e14; background:#fff7f0;">
                <div class="stat-label">إجمالي الإكراميات</div>
                <div class="stat-value" style="color:#fd7e14;">@(((decimal)ViewBag.TotalGifts).ToString("N3")) د.ك</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card" style="border-right: 4px solid #28a745; background:#f0fff4;">
                <div class="stat-label">أيام الحضور</div>
                <div class="stat-value" style="color:#28a745;">@ViewBag.AttendanceDays يوم</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-file-invoice me-2"></i>المبيعات والفواتير</h6>
            <span class="badge bg-primary">@ViewBag.SalesCount فاتورة</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>رقم الفاتورة</th>
                            <th>التاريخ</th>
                            <th>نوع الفاتورة</th>
                            <th>المبلغ</th>
                            <th>إكرامية الموظف</th>
                            <th>طريقة الدفع</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in sales)
                        {
                            <tr>
                                <td>@s.InvoiceNumber</td>
                                <td>@s.SaleDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (s.SaleType == "حلاقة")
                                    {
                                        <span class="badge bg-secondary">حلاقة</span>
                                    }
                                    else if (s.SaleType == "مساج")
                                    {
                                        <span class="badge" style="background:#6f42c1;">مساج</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#fd7e14;">@s.SaleType</span>
                                    }
                                </td>
                                <td><strong>@s.NetAmount.ToString("N3") د.ك</strong></td>
                                <td>
                                    @if (s.EmployeeGift.HasValue && s.EmployeeGift > 0)
                                    {
                                        <span class="text-warning fw-bold">@s.EmployeeGift.Value.ToString("N3") د.ك</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@s.PaymentMethod</td>
                                <td>
                                    <span class="badge @(s.Status == "مكتمل" ? "bg-success" : "bg-danger")">@s.Status</span>
                                </td>
                            </tr>
                        }
                        @if (!sales.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    لا توجد فواتير في هذه الفترة
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-calendar-check me-2"></i>سجل الحضور</h6>
            <span class="badge bg-success">@ViewBag.AttendanceDays يوم حضور</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>التاريخ</th>
                            <th>وقت الحضور</th>
                            <th>وقت الانصراف</th>
                            <th>الحالة</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in attendances)
                        {
                            <tr>
                                <td>@a.AttendanceDate.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (a.CheckIn.HasValue)
                                    {
                                        @(new DateTime(2000, 1, 1).Add(a.CheckIn.Value).ToString("hh:mm tt"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (a.CheckOut.HasValue)
                                    {
                                        @(new DateTime(2000, 1, 1).Add(a.CheckOut.Value).ToString("hh:mm tt"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        string statusClass = a.Status == "حاضر" ? "bg-success"
                                            : a.Status == "غائب" ? "bg-danger"
                                            : a.Status == "إجازة" ? "bg-info"
                                            : "bg-secondary";
                                    }
                                    <span class="badge @statusClass">@a.Status</span>
                                </td>
                                <td class="text-muted">@(a.Notes ?? "-")</td>
                            </tr>
                        }
                        @if (!attendances.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fas fa-calendar-times fa-2x mb-2 d-block"></i>
                                    لا توجد سجلات حضور في هذه الفترة
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}