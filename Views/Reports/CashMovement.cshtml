@model List<Salon.Models.CashMovementReportItem>
@{
    ViewData["Title"] = "تقرير حركة الصندوق";
    decimal totalExpenses = ViewBag.TotalExpenses;
    decimal totalDeposits = ViewBag.TotalDeposits;
    decimal netBalance = ViewBag.NetBalance;
    string selectedType = ViewBag.SelectedType ?? "";
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-cash-register me-2"></i>تقرير حركة الصندوق</h1>
        <p>جميع المصروفات والإيداعات خلال الفترة المحددة</p>
    </div>
    <a href="@Url.Action("Index", "Reports")" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-right me-1"></i> التقارير
    </a>
</div>

@* ── فلاتر البحث ── *@
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">من تاريخ</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">إلى تاريخ</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">نوع الحركة</label>
                <select name="type" class="form-select">
                    <option value="" selected="@(selectedType == "" ? "selected" : null)">الكل</option>
                    <option value="مصروف" selected="@(selectedType == "مصروف" ? "selected" : null)">المصروفات فقط</option>
                    <option value="إيداع" selected="@(selectedType == "إيداع" ? "selected" : null)">الإيداعات فقط</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> بحث
                </button>
            </div>
        </form>
    </div>
</div>

@* ── بطاقات الإجماليات ── *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-danger mb-1" style="font-size:28px;"><i class="fas fa-receipt"></i></div>
                <div class="text-muted small">إجمالي المصروفات</div>
                <div class="fw-bold fs-5 text-danger">@totalExpenses.ToString("N3") د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-success mb-1" style="font-size:28px;"><i class="fas fa-money-bill-wave"></i></div>
                <div class="text-muted small">إجمالي الإيداعات</div>
                <div class="fw-bold fs-5 text-success">@totalDeposits.ToString("N3") د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:28px; color:@(netBalance >= 0 ? "#0d6efd" : "#dc3545");">
                    <i class="fas fa-balance-scale"></i>
                </div>
                <div class="text-muted small">الصافي (إيداعات - مصروفات)</div>
                <div class="fw-bold fs-5" style="color:@(netBalance >= 0 ? "#0d6efd" : "#dc3545");">
                    @netBalance.ToString("N3") د.ك
                </div>
            </div>
        </div>
    </div>
</div>

@* ── جدول الحركات ── *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list me-2"></i>سجل الحركات (@Model.Count حركة)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                لا توجد حركات في هذه الفترة
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>التاريخ</th>
                            <th>النوع</th>
                            <th>البيان</th>
                            <th>الفئة / المصدر</th>
                            <th>ملاحظات</th>
                            <th class="text-end">المبلغ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int row = 0; }
                        @foreach (var item in Model)
                        {
                            row++;
                            bool isExpense = item.Type == "مصروف";
                            <tr>
                                <td class="text-muted small">@row</td>
                                <td>@item.Date.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (isExpense)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">
                                            <i class="fas fa-minus-circle me-1"></i>مصروف
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                            <i class="fas fa-plus-circle me-1"></i>إيداع
                                        </span>
                                    }
                                </td>
                                <td>@item.Description</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Category) ? "-" : item.Category)</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</td>
                                <td class="text-end fw-semibold @(isExpense ? "text-danger" : "text-success")">
                                    @(isExpense ? "-" : "+")@item.Amount.ToString("N3")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="6" class="text-end">إجمالي المصروفات</td>
                            <td class="text-end text-danger">@totalExpenses.ToString("N3")</td>
                        </tr>
                        <tr>
                            <td colspan="6" class="text-end">إجمالي الإيداعات</td>
                            <td class="text-end text-success">@totalDeposits.ToString("N3")</td>
                        </tr>
                        <tr class="table-secondary">
                            <td colspan="6" class="text-end">الصافي</td>
                            <td class="text-end @(netBalance >= 0 ? "text-primary" : "text-danger")">
                                @netBalance.ToString("N3") د.ك
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
