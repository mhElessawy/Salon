@model  List<Salon.Models.CashMovementReportItem>
@{
    ViewData["Title"] = "تقرير حركة الصندوق";
    decimal totalExpenses    = ViewBag.TotalExpenses;
    decimal totalDeposits    = ViewBag.TotalDeposits;
    decimal totalSales       = ViewBag.TotalSales is decimal ts ? ts : 0m;
    decimal totalWithdrawals = ViewBag.TotalWithdrawals is decimal tw ? tw : 0m;
    decimal netBalance       = ViewBag.NetBalance;
    string selectedType      = ViewBag.SelectedType ?? "";

    string[] expenseTypes = { "مصروف", "سلفة", "راتب" };
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-cash-register me-2"></i>تقرير حركة الصندوق</h1>
        <p>المصروفات والسلف والمرتبات والإيداعات خلال الفترة المحددة</p>
    </div>
    <a href="@Url.Action("Index", "Reports")" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-right me-1"></i> التقارير
    </a>
</div>

@* ── فلاتر البحث ── *@
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">من تاريخ</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">إلى تاريخ</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">نوع الحركة</label>
                <select name="type" class="form-select">
                    <option value="" selected="@(selectedType == "" ? "selected" : null)">الكل</option>
                    <option value="مصروف" selected="@(selectedType == "مصروف" ? "selected" : null)">المصروفات (مصروفات + سلف + مرتبات)</option>
                    <option value="إيداع" selected="@(selectedType == "إيداع" ? "selected" : null)">الإيداعات اليدوية فقط</option>
                    <option value="مبيعات" selected="@(selectedType == "مبيعات" ? "selected" : null)">مبيعات الفواتير فقط</option>
                    <option value="سحب" selected="@(selectedType == "سحب" ? "selected" : null)">السحوبات فقط</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> بحث
                </button>
            </div>
        </form>
    </div>
</div>

@* ── بطاقات الإجماليات ── *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-danger mb-1" style="font-size:28px;"><i class="fas fa-receipt"></i></div>
                <div class="text-muted small mb-1">إجمالي المصروفات</div>
                <div class="text-muted" style="font-size:11px;">(مصروفات + سلف + مرتبات)</div>
                <div class="fw-bold fs-5 text-danger mt-1">@totalExpenses.ToString("N3") د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:28px; color:#dc2626;"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="text-muted small">السحوبات</div>
                <div class="fw-bold fs-5 mt-1" style="color:#dc2626;">@totalWithdrawals.ToString("N3") د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-success mb-1" style="font-size:28px;"><i class="fas fa-money-bill-wave"></i></div>
                <div class="text-muted small">الإيداعات اليدوية</div>
                <div class="fw-bold fs-5 text-success mt-1">@totalDeposits.ToString("N3") د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:28px; color:#0891b2;"><i class="fas fa-file-invoice-dollar"></i></div>
                <div class="text-muted small">مبيعات الفواتير</div>
                <div class="text-muted" style="font-size:11px;">(تُعدّ إيداعات)</div>
                <div class="fw-bold fs-5 mt-1" style="color:#0891b2;">@totalSales.ToString("N3") د.ك</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:28px; color:@(netBalance >= 0 ? "#0d6efd" : "#dc3545");">
                    <i class="fas fa-balance-scale"></i>
                </div>
                <div class="text-muted small">الصافي</div>
                <div class="fw-bold fs-5 mt-1" style="color:@(netBalance >= 0 ? "#0d6efd" : "#dc3545");">
                    @netBalance.ToString("N3") د.ك
                </div>
            </div>
        </div>
    </div>
</div>

@* ── جدول الحركات ── *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list me-2"></i><span data-i18n-en="Movement Log">سجل الحركات</span> (@Model.Count <span data-i18n-en="Movement">حركة</span>)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                لا توجد حركات في هذه الفترة
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>التاريخ</th>
                            <th>النوع</th>
                            <th>البيان</th>
                            <th>الفئة / المصدر</th>
                            <th>ملاحظات</th>
                            <th class="text-end">المبلغ (د.ك)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int row = 0; }
                        @foreach (var item in Model)
                        {
                            row++;
                            bool isExpenseGroup = expenseTypes.Contains(item.Type);
                            bool isSale = item.Type == "مبيعات";
                            bool isWithdrawal = item.Type == "سحب";
                            <tr style="@(isSale ? "background:#f0faff;" : isWithdrawal ? "background:#fff5f5;" : "")">
                                <td class="text-muted small">@row</td>
                                <td>@(item.Type == "مبيعات" ? item.Date.ToString("yyyy/MM/dd") : item.Date.ToString("yyyy/MM/dd hh:mm tt"))</td>
                                <td>
                                    @switch (item.Type)
                                    {
                                        case "مصروف":
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">
                                                <i class="fas fa-minus-circle me-1"></i>مصروف
                                            </span>
                                            break;
                                        case "سلفة":
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1" style="color:#b45309 !important;">
                                                <i class="fas fa-hand-holding-usd me-1"></i>سلفة
                                            </span>
                                            break;
                                        case "راتب":
                                            <span class="badge bg-purple bg-opacity-10 px-2 py-1" style="background:rgba(111,66,193,0.1); color:#6f42c1;">
                                                <i class="fas fa-money-bill-wave me-1"></i>راتب
                                            </span>
                                            break;
                                        case "مبيعات":
                                            <span class="badge px-2 py-1" style="background:rgba(8,145,178,0.12); color:#0891b2;">
                                                <i class="fas fa-file-invoice-dollar me-1"></i>مبيعات
                                            </span>
                                            break;
                                        case "سحب":
                                            <span class="badge px-2 py-1" style="background:rgba(220,38,38,0.12); color:#dc2626;">
                                                <i class="fas fa-hand-holding-usd me-1"></i>سحب
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                                <i class="fas fa-plus-circle me-1"></i>إيداع
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>@item.Description</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Category) ? "-" : item.Category)</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</td>
                                <td class="text-end fw-semibold @(isExpenseGroup || isWithdrawal ? "text-danger" : isSale ? "" : "text-success")"
                                    style="@(isSale ? "color:#0891b2;" : isWithdrawal ? "color:#dc2626;" : "")">
                                    @(isExpenseGroup || isWithdrawal ? "-" : "+")@item.Amount.ToString("N3")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        @{
                            decimal tMasrouf  = Model.Where(i => i.Type == "مصروف").Sum(i => i.Amount);
                            decimal tSulfa    = Model.Where(i => i.Type == "سلفة").Sum(i => i.Amount);
                            decimal tRatib    = Model.Where(i => i.Type == "راتب").Sum(i => i.Amount);
                            decimal tSales    = Model.Where(i => i.Type == "مبيعات").Sum(i => i.Amount);
                            decimal tSahb     = Model.Where(i => i.Type == "سحب").Sum(i => i.Amount);
                        }
                        @if (tMasrouf > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">المصروفات العامة</td>
                                <td class="text-end text-danger">@tMasrouf.ToString("N3")</td>
                            </tr>
                        }
                        @if (tSulfa > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">السلف</td>
                                <td class="text-end text-danger">@tSulfa.ToString("N3")</td>
                            </tr>
                        }
                        @if (tRatib > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">المرتبات</td>
                                <td class="text-end text-danger">@tRatib.ToString("N3")</td>
                            </tr>
                        }
                        <tr class="table-danger">
                            <td colspan="6" class="text-end fw-bold">إجمالي المصروفات</td>
                            <td class="text-end text-danger fw-bold">@totalExpenses.ToString("N3")</td>
                        </tr>
                        @if (tSahb > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">السحوبات</td>
                                <td class="text-end" style="color:#dc2626;">@tSahb.ToString("N3")</td>
                            </tr>
                        }
                        @if (totalDeposits > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">الإيداعات اليدوية</td>
                                <td class="text-end text-success">@totalDeposits.ToString("N3")</td>
                            </tr>
                        }
                        @if (tSales > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">مبيعات الفواتير</td>
                                <td class="text-end" style="color:#0891b2;">@tSales.ToString("N3")</td>
                            </tr>
                        }
                        <tr class="table-success">
                            <td colspan="6" class="text-end fw-bold">إجمالي الدخل (إيداعات + مبيعات)</td>
                            <td class="text-end text-success fw-bold">@(totalDeposits + tSales).ToString("N3")</td>
                        </tr>
                        <tr style="background:#fff0f0;">
                            <td colspan="6" class="text-end fw-bold" style="color:#dc2626;">إجمالي المصروف (مصروفات + سحوبات)</td>
                            <td class="text-end fw-bold" style="color:#dc2626;">@(totalExpenses + tSahb).ToString("N3")</td>
                        </tr>
                        <tr class="table-secondary">
                            <td colspan="6" class="text-end fw-bold">الصافي</td>
                            <td class="text-end fw-bold @(netBalance >= 0 ? "text-primary" : "text-danger")">
                                @netBalance.ToString("N3") د.ك
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>