@model List<Salon.Models.CashMovementReportItem>
@{
    ViewData["Title"] = "تقرير حركة الصندوق";
    string selectedDept = ViewBag.SelectedDept ?? "";
    decimal totalMasrouf = ViewBag.TotalMasrouf is decimal tm ? tm : 0m;
    decimal totalSulfa = ViewBag.TotalSulfa is decimal ts2 ? ts2 : 0m;
    decimal totalRatib = ViewBag.TotalRatib is decimal tr ? tr : 0m;
    decimal totalExpenses = ViewBag.TotalExpenses is decimal te ? te : 0m;
    decimal totalDeposits = ViewBag.TotalDeposits is decimal td ? td : 0m;
    decimal totalCashSales = ViewBag.TotalCashSales is decimal tcs ? tcs : 0m;
    decimal totalKNet = ViewBag.TotalKNet is decimal tkn ? tkn : 0m;
    decimal totalWithdrawals = ViewBag.TotalWithdrawals is decimal tw ? tw : 0m;
    decimal cashBalance = ViewBag.CashBalance is decimal cb ? cb : 0m;
    string selectedType = ViewBag.SelectedType ?? "";

    // الأنواع التي تُخصم من رصيد الكاش
    string[] debitTypes = { "مصروف", "سلفة", "راتب", "سحب" };
    // الكي نت لا يدخل في حساب رصيد الكاش
    string[] cashCreditTypes = { "مبيعات كاش", "إيداع" };

    // رصيد كاش جاري بعد كل حركة (يستثني الكي نت)
    var ascItems = Model.OrderBy(i => i.Date).ThenBy(i => i.Type).ToList();
    var itemBalance = new Dictionary<Salon.Models.CashMovementReportItem, decimal>();
    decimal runBal = 0m;
    foreach (var itm in ascItems)
    {
        if (debitTypes.Contains(itm.Type))
            runBal -= itm.Amount;
        else if (cashCreditTypes.Contains(itm.Type))
            runBal += itm.Amount;
        // كي نت لا يؤثر على رصيد الكاش
        itemBalance[itm] = runBal;
    }
}

<div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-cash-register me-2"></i>تقرير حركة الصندوق</h1>
        <p>المصروفات والسلف والمرتبات والمبيعات والإيداعات خلال الفترة المحددة</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (!string.IsNullOrEmpty(selectedDept))
        {
            <span class="badge fs-6 px-3 py-2" style="background:@(selectedDept == "حلاقة" ? "#dbeafe" : "#f3e8ff"); color:@(selectedDept == "حلاقة" ? "#1d4ed8" : "#7c3aed");">
                <i class="fas fa-filter me-1"></i>@selectedDept
            </span>
        }
        <a href="@Url.Action("Index", "Reports")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-right me-1"></i> التقارير
        </a>
    </div>
</div>

@* ── فلاتر البحث ── *@
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">من تاريخ</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">إلى تاريخ</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">نوع الحركة</label>
                <select name="type" class="form-select">
                    <option value="" selected="@(selectedType == "" ? "selected" : null)">الكل</option>
                    <option value="مصروف" selected="@(selectedType == "مصروف" ? "selected" : null)">المصروفات</option>
                    <option value="كاش" selected="@(selectedType == "كاش" ? "selected" : null)">مبيعات الكاش</option>
                    <option value="كي نت" selected="@(selectedType == "كي نت" ? "selected" : null)">مبيعات الكي نت</option>
                    <option value="إيداع" selected="@(selectedType == "إيداع" ? "selected" : null)">الإيداعات</option>
                    <option value="سحب" selected="@(selectedType == "سحب" ? "selected" : null)">السحوبات</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">قسم المبيعات</label>
                <select name="dept" class="form-select">
                    <option value="" selected="@(selectedDept == "" ? "selected" : null)">الكل</option>
                    <option value="حلاقة" selected="@(selectedDept == "حلاقة" ? "selected" : null)">مبيعات الحلاقة</option>
                    <option value="مساج" selected="@(selectedDept == "مساج" ? "selected" : null)">مبيعات المساج</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> بحث
                </button>
            </div>
        </form>
    </div>
</div>

@* ── بطاقات الملخص ── *@

@* صف المصروفات *@
<div class="row g-3 mb-2">
    <div class="col-12">
        <div class="text-muted fw-semibold small mb-1 px-1">
            <i class="fas fa-minus-circle text-danger me-1"></i> المصروفات
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #ef4444 !important;">
            <div class="card-body p-3">
                <div class="text-danger mb-1" style="font-size:24px;"><i class="fas fa-receipt"></i></div>
                <div class="text-muted small">مصروفات عامة</div>
                <div class="fw-bold fs-6 text-danger mt-1">@totalMasrouf.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #f59e0b !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#b45309;"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="text-muted small">سلف الموظفين</div>
                <div class="fw-bold fs-6 mt-1" style="color:#b45309;">@totalSulfa.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #6f42c1 !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#6f42c1;"><i class="fas fa-money-bill-wave"></i></div>
                <div class="text-muted small">المرتبات</div>
                <div class="fw-bold fs-6 mt-1" style="color:#6f42c1;">@totalRatib.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

@* خط فاصل وإجمالي المصروفات *@
<div class="alert alert-danger py-2 px-3 mb-3 d-flex justify-content-between align-items-center">
    <span><i class="fas fa-equals me-1"></i> إجمالي المصروفات (مصروفات + سلف + مرتبات)</span>
    <strong>@totalExpenses.ToString("N3") د.ك</strong>
</div>

@* صف الدخل *@
<div class="row g-3 mb-2">
    <div class="col-12">
        <div class="text-muted fw-semibold small mb-1 px-1">
            <i class="fas fa-plus-circle text-success me-1"></i> الدخل
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #16a34a !important;">
            <div class="card-body p-3">
                <div class="text-success mb-1" style="font-size:24px;"><i class="fas fa-cash-register"></i></div>
                <div class="text-muted small">مبيعات الكاش</div>
                <div class="fw-bold fs-6 text-success mt-1">@totalCashSales.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #0ea5e9 !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#0ea5e9;"><i class="fas fa-credit-card"></i></div>
                <div class="text-muted small">مبيعات الكي نت</div>
                <div class="text-muted" style="font-size:11px;">(خارج رصيد الكاش)</div>
                <div class="fw-bold fs-6 mt-1" style="color:#0ea5e9;">@totalKNet.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center border-0 shadow-sm h-100" style="border-right:4px solid #10b981 !important;">
            <div class="card-body p-3">
                <div class="mb-1" style="font-size:24px; color:#10b981;"><i class="fas fa-money-bill-wave"></i></div>
                <div class="text-muted small">الإيداعات</div>
                <div class="fw-bold fs-6 mt-1" style="color:#10b981;">@totalDeposits.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

@* رصيد الكاش الرئيسي *@
<div class="card mb-4 border-2" style="border-color:@(cashBalance >= 0 ? "#1d4ed8" : "#dc2626") !important; background:@(cashBalance >= 0 ? "#eff6ff" : "#fff0f0");">
    <div class="card-body p-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="fw-bold" style="color:@(cashBalance >= 0 ? "#1d4ed8" : "#dc2626"); font-size:1rem;">
                    <i class="fas fa-wallet me-2"></i>رصيد الكاش
                </div>
                <div class="text-muted" style="font-size:12px;">
                    مبيعات كاش (@totalCashSales.ToString("N3")) + إيداعات (@totalDeposits.ToString("N3"))
                    − مصروفات (@totalExpenses.ToString("N3")) − سحوبات (@totalWithdrawals.ToString("N3"))
                </div>
            </div>
            <div class="col-auto">
                <span class="fw-bold" style="font-size:1.8rem; color:@(cashBalance >= 0 ? "#1d4ed8" : "#dc2626");">
                    @cashBalance.ToString("N3") <small style="font-size:1rem;">د.ك</small>
                </span>
            </div>
        </div>
        @if (totalKNet > 0)
        {
            <hr class="my-2" />
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small"><i class="fas fa-credit-card me-1" style="color:#0ea5e9;"></i>الكي نت (مستقل - لا يدخل في رصيد الكاش)</span>
                <span class="fw-bold" style="color:#0ea5e9;">@totalKNet.ToString("N3") د.ك</span>
            </div>
        }
    </div>
</div>

@* ── جدول الحركات ── *@
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list me-2"></i>سجل الحركات (@Model.Count حركة)</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-inbox fa-3x mb-3 d-block opacity-25"></i>
                لا توجد حركات في هذه الفترة
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>التاريخ</th>
                            <th>النوع</th>
                            <th>البيان</th>
                            <th>الفئة / المصدر</th>
                            <th>ملاحظات</th>
                            <th class="text-end">المبلغ (د.ك)</th>
                            <th class="text-end" style="background:#eff6ff;">رصيد الكاش (د.ك)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int row = 0;
                        }
                        @foreach (var item in Model)
                        {
                            row++;
                            bool isDebit = debitTypes.Contains(item.Type);
                            bool isCashSale = item.Type == "مبيعات كاش";
                            bool isKNet = item.Type == "كي نت";
                            bool isDeposit = item.Type == "إيداع";
                            bool isWithdrawal = item.Type == "سحب";
                            decimal bal = itemBalance.TryGetValue(item, out decimal b) ? b : 0m;

                            string rowBg = isKNet ? "background:#f0f9ff;" :
                            isWithdrawal ? "background:#fff5f5;" :
                            isCashSale ? "background:#f0fdf4;" : "";
                            <tr style="@rowBg">
                                <td class="text-muted small">@row</td>
                                <td>@(isCashSale || isKNet ? item.Date.ToString("yyyy/MM/dd") : item.Date.ToString("yyyy/MM/dd hh:mm tt"))</td>
                                <td>
                                    @switch (item.Type)
                                    {
                                        case "مصروف":
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">
                                                <i class="fas fa-minus-circle me-1"></i>مصروف
                                            </span>
                                            break;
                                        case "سلفة":
                                            <span class="badge px-2 py-1" style="background:rgba(245,158,11,0.12); color:#b45309;">
                                                <i class="fas fa-hand-holding-usd me-1"></i>سلفة
                                            </span>
                                            break;
                                        case "راتب":
                                            <span class="badge px-2 py-1" style="background:rgba(111,66,193,0.12); color:#6f42c1;">
                                                <i class="fas fa-money-bill-wave me-1"></i>راتب
                                            </span>
                                            break;
                                        case "مبيعات كاش":
                                            <span class="badge px-2 py-1" style="background:rgba(22,163,74,0.12); color:#16a34a;">
                                                <i class="fas fa-cash-register me-1"></i>كاش
                                            </span>
                                            break;
                                        case "كي نت":
                                            <span class="badge px-2 py-1" style="background:rgba(14,165,233,0.12); color:#0ea5e9;">
                                                <i class="fas fa-credit-card me-1"></i>كي نت
                                            </span>
                                            break;
                                        case "سحب":
                                            <span class="badge px-2 py-1" style="background:rgba(220,38,38,0.12); color:#dc2626;">
                                                <i class="fas fa-hand-holding-usd me-1"></i>سحب
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">
                                                <i class="fas fa-plus-circle me-1"></i>إيداع
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>@item.Description</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Category) ? "-" : item.Category)</td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)</td>
                                <td class="text-end fw-semibold"
                                    style="color:@(isDebit ? "#dc2626" : isKNet ? "#0ea5e9" : "#16a34a");">
                                    @(isDebit ? "-" : "+")@item.Amount.ToString("N3")
                                </td>
                                <td class="text-end fw-bold" style="background:#eff6ff; font-size:0.9em; color:@(isKNet ? "#6b7280" : bal >= 0 ? "#1d4ed8" : "#dc2626");">
                                    @(isKNet ? "—" : bal.ToString("N3"))
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        @{
                            decimal tMasrouf = Model.Where(i => i.Type == "مصروف").Sum(i => i.Amount);
                            decimal tSulfa = Model.Where(i => i.Type == "سلفة").Sum(i => i.Amount);
                            decimal tRatib = Model.Where(i => i.Type == "راتب").Sum(i => i.Amount);
                            decimal tSahb = Model.Where(i => i.Type == "سحب").Sum(i => i.Amount);
                        }
                        @if (tMasrouf > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">المصروفات العامة</td>
                                <td class="text-end text-danger">-@tMasrouf.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (tSulfa > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">السلف</td>
                                <td class="text-end" style="color:#b45309;">-@tSulfa.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (tRatib > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">المرتبات</td>
                                <td class="text-end" style="color:#6f42c1;">-@tRatib.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        <tr class="table-danger">
                            <td colspan="6" class="text-end fw-bold">إجمالي المصروفات</td>
                            <td class="text-end text-danger fw-bold">-@totalExpenses.ToString("N3")</td>
                            <td></td>
                        </tr>
                        @if (tSahb > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">السحوبات</td>
                                <td class="text-end text-danger">-@tSahb.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalCashSales > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">مبيعات الكاش</td>
                                <td class="text-end text-success">+@totalCashSales.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalKNet > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">مبيعات الكي نت (مستقل)</td>
                                <td class="text-end" style="color:#0ea5e9;">+@totalKNet.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        @if (totalDeposits > 0)
                        {
                            <tr>
                                <td colspan="6" class="text-end text-muted">الإيداعات</td>
                                <td class="text-end text-success">+@totalDeposits.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                        <tr style="background:#eff6ff;">
                            <td colspan="6" class="text-end fw-bold" style="color:#1d4ed8;">
                                <i class="fas fa-wallet me-1"></i> رصيد الكاش (كاش + إيداعات − مصروفات − سحوبات)
                            </td>
                            <td class="text-end fw-bold" style="color:@(cashBalance >= 0 ? "#1d4ed8" : "#dc2626"); font-size:1.05em;">
                                @cashBalance.ToString("N3")
                            </td>
                            <td class="text-end fw-bold" style="background:#dbeafe; color:@(cashBalance >= 0 ? "#1d4ed8" : "#dc2626"); font-size:1.05em;">
                                @cashBalance.ToString("N3")
                            </td>
                        </tr>
                        @if (totalKNet > 0)
                        {
                            <tr style="background:#f0f9ff;">
                                <td colspan="6" class="text-end fw-semibold" style="color:#0ea5e9;">
                                    <i class="fas fa-credit-card me-1"></i> الكي نت (مستقل)
                                </td>
                                <td class="text-end fw-bold" style="color:#0ea5e9;">@totalKNet.ToString("N3")</td>
                                <td></td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>