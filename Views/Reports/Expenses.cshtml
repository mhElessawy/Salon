@* ======= BOTTOM STATS ======= *@
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="bottom-stat">
            <div class="bottom-stat-icon" style="background:#fee2e2;color:#dc2626;">
                <i class="fas fa-list"></i>
            </div>
            <div>
                <div class="bottom-stat-label" data-i18n-en="Total Items">إجمالي البنود</div>
                <div class="bottom-stat-value" style="color:#dc2626;">@totalItems</div>
                <div class="bottom-stat-sub">
                    <span data-i18n-en="expenses">مصروفات</span>: @expenseCount |
                    <span data-i18n-en="salaries">مرتبات</span>: @salaryCount
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bottom-stat">
            <div class="bottom-stat-icon" style="background:#ffedd5;color:#ea580c;">
                <i class="fas fa-arrow-trend-up"></i>
            </div>
            <div>
                <div class="bottom-stat-label" data-i18n-en="Highest Single Expense">أعلى مصروف واحد</div>
                <div class="bottom-stat-value" style="color:#ea580c;">@maxExpense.ToString("N3") <small style="font-size:.7rem;" data-i18n-en="K.D.">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bottom-stat">
            <div class="bottom-stat-icon" style="background:#ede9fe;color:#7c3aed;">
                <i class="fas fa-tag"></i>
            </div>
            <div>
                <div class="bottom-stat-label" data-i18n-en="Top Category">أعلى فئة مصاريف</div>
                <div class="bottom-stat-value" style="color:#7c3aed;font-size:1rem;">@topCategory</div>
                <div class="bottom-stat-sub" data-i18n-en="by amount">بالمبلغ</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bottom-stat">
            <div class="bottom-stat-icon" style="background:#dcfce7;color:#16a34a;">
                <i class="fas fa-calculator"></i>
            </div>
            <div>
                <div class="bottom-stat-label" data-i18n-en="Avg. Expense/Item">متوسط المصروف/بند</div>
                <div class="bottom-stat-value" style="color:#16a34a;">
                    @(expenseCount > 0 ? (totalExp / expenseCount).ToString("N3") : "0.000")
                    <small style="font-size:.7rem;" data-i18n-en="K.D.">د.ك</small>
                </div>
            </div>
        </div>
    </div>
</div>

@* ======= TABS (admin only) / Direct table (dept user) ======= *@
@if (isDeptUser)
{
    await RenderExpTable(Model.ToList(), salaries, false);
}
else
{
    @* Admin: full tabs *@
    <ul class="nav nav-tabs mb-3 no-print" id="expensesTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="all-tab" data-bs-toggle="tab" data-bs-target="#all-pane" type="button" role="tab">
                <i class="fas fa-layer-group me-1"></i><span data-i18n-en="All">الكل</span>
                <span class="badge bg-danger ms-1">@totalComb.ToString("N3")</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="barber-tab" data-bs-toggle="tab" data-bs-target="#barber-pane" type="button" role="tab">
                <i class="fas fa-cut me-1"></i><span data-i18n-en="Barber">حلاقة</span>
                <span class="badge ms-1" style="background:#1a1a2e;">@barberComb.ToString("N3")</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="massage-tab" data-bs-toggle="tab" data-bs-target="#massage-pane" type="button" role="tab">
                <i class="fas fa-spa me-1"></i><span data-i18n-en="Massage">مساج</span>
                <span class="badge bg-info ms-1">@massageComb.ToString("N3")</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="expensesTabContent">
        <div class="tab-pane fade show active" id="all-pane" role="tabpanel">
            @{
                await RenderExpTable(Model.ToList(), salaries, true);
            }
        </div>
        <div class="tab-pane fade" id="barber-pane" role="tabpanel">
            @{
                await RenderExpTable(barberExpenses, barberSalaries, false);
            }
        </div>
        <div class="tab-pane fade" id="massage-pane" role="tabpanel">
            @{
                await RenderExpTable(massageExpenses, massageSalaries, false);
            }
        </div>
    </div>
}

@* ── Inline helper ── *@
@functions {
    async Task RenderExpTable(List<Salon.Models.Expense> exp, List<Salon.Models.Salary> sal, bool showDept)
    {
        decimal total = exp.Sum(e => e.Amount) + sal.Sum(s => s.NetSalary);
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center py-2" style="background:#fff5f5;">
                <h6 class="fw-bold mb-0 text-danger">
                    <i class="fas fa-receipt me-2"></i>
                    <span data-i18n-en="Expense Details">تفاصيل المصاريف</span>
                </h6>
                <span class="badge bg-danger">@total.ToString("N3") <span data-i18n-en="K.D.">د.ك</span></span>
            </div>
            <div class="table-responsive">
                <table class="table rev-table mb-0" id="expTable">
                    <thead>
                        <tr>
                            <th data-i18n-en="#">#</th>
                            <th data-i18n-en="Date">التاريخ</th>
                            <th data-i18n-en="Type">النوع</th>
                            <th data-i18n-en="Description">البيان</th>
                            <th data-i18n-en="Category / Employee">الفئة / الموظف</th>
                            @if (showDept)
                            {
                                <th data-i18n-en="Department">القسم</th>
                            }
                            <th data-i18n-en="Payment">طريقة الدفع</th>
                            <th data-i18n-en="Amount (K.D.)">المبلغ (د.ك)</th>
                            <th data-i18n-en="Notes">ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!exp.Any() && !sal.Any())
                        {
                            <tr>
                                <td colspan="@(showDept ? 9 : 8)" class="text-center text-muted py-4">
                                    <span data-i18n-en="No expenses in this period">لا توجد مصاريف في هذه الفترة</span>
                                </td>
                            </tr>
                        }
                        @{
                            int ri = 0;
                        }
                        @foreach (var e in exp)
                        {
                            ri++;
                            <tr>
                                <td class="text-muted">@ri</td>
                                <td>@e.ExpenseDate.ToString("yyyy/MM/dd")</td>
                                <td><span class="exp-dept-badge" style="background:#fef3c7;color:#92400e;"><i class="fas fa-receipt me-1"></i><span data-i18n-en="Expense">مصروف</span></span></td>
                                <td><strong>@e.Description</strong></td>
                                <td><span class="text-muted small">@(e.Category ?? "-")</span></td>
                                @if (showDept)
                                {
                                    <td>
                                        @if (e.Department == "حلاقة")
                                        {
                                            <span class="exp-dept-badge" style="background:#1a1a2e;color:#fff;">✂ <span data-i18n-en="Barber">حلاقة</span></span>
                                        }
                                        else if (e.Department == "مساج")
                                        {

                                            <span class="exp-dept-badge" style="background:#0891b2;color:#fff;">🌿 <span data-i18n-en="Massage">مساج</span></span>
                                        }
                                        else
                                        {

                                            <span class="exp-dept-badge" style="background:#e2e8f0;color:#475569;"><span data-i18n-en="Shared">مشترك</span></span>
                                        }
                                    </td>
                                }
                                <td><span class="text-muted small">@e.PaymentMethod</span></td>
                                <td><strong class="text-danger">@e.Amount.ToString("N3")</strong></td>
                                <td class="text-muted small">@e.Notes</td>
                            </tr>
                        }
                        @foreach (var s in sal)
                        {
                            ri++;
                            <tr style="background:#faf5ff;">
                                <td class="text-muted">@ri</td>
                                <td>@s.PaidDate?.ToString("yyyy/MM/dd")</td>
                                <td><span class="exp-dept-badge" style="background:#ede9fe;color:#7c3aed;"><i class="fas fa-money-check-alt me-1"></i><span data-i18n-en="Salary">مرتب</span></span></td>
                                <td><strong data-i18n-en="Salary">مرتب</strong> @s.Month/@s.Year</td>
                                <td><strong>@(s.Employee?.FullName ?? "-")</strong></td>
                                @if (showDept)
                                {
                                    <td>
                                        @{
                                            var dept = s.Employee?.Department;
                                        }
                                        @if (dept == "حلاقة")
                                        {
                                            <span class="exp-dept-badge" style="background:#1a1a2e;color:#fff;">✂ <span data-i18n-en="Barber">حلاقة</span></span>
                                        }
                                        else if (dept == "مساج")
                                        {

                                            <span class="exp-dept-badge" style="background:#0891b2;color:#fff;">🌿 <span data-i18n-en="Massage">مساج</span></span>
                                        }
                                        else
                                        {

                                            <span class="exp-dept-badge" style="background:#e2e8f0;color:#475569;">@(dept ?? "-")</span>
                                        }
                                    </td>
                                }
                                <td><span class="text-muted small">@(s.PaymentMethod ?? "نقدي")</span></td>
                                <td><strong style="color:#7c3aed;">@s.NetSalary.ToString("N3")</strong></td>
                                <td class="text-muted small">@s.Notes</td>
                            </tr>
                        }
                    </tbody>
                    @if (exp.Any() || sal.Any())
                    {
                        <tfoot>
                            <tr>
                                <td colspan="@(showDept ? 7 : 6)" data-i18n-en="Total">الإجمالي</td>
                                <td class="text-danger">@total.ToString("N3")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function exportExpensesCSV() {
            const rows = document.querySelectorAll('#expTable tbody tr, #expTable thead tr');
            let csv = '﻿';
            rows.forEach(row => {
                const cells = Array.from(row.querySelectorAll('td,th'));
                csv += cells.map(c => '"' + c.innerText.trim().replace(/"/g, '""') + '"').join(',') + '\n';
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'expenses-@(ViewBag.From)-@(ViewBag.To).csv';
            a.click();
        }
    </script>
}