@model IEnumerable<Salon.Models.Expense>
@using Salon.Models
@using System.Collections.Generic
@{
    ViewData["Title"] = "تقرير المصاريف";

    var salaries = ViewBag.Salaries as List<Salary> ?? new List<Salary>();
    decimal totalExp = ViewBag.TotalExpenses is decimal te ? te : 0m;
    decimal totalSal = ViewBag.TotalSalaries is decimal ts ? ts : 0m;
    decimal totalComb = ViewBag.TotalCombined is decimal tc ? tc : 0m;

    var barberExpenses = ViewBag.BarberExpenses as List<Expense> ?? new List<Expense>();
    var barberSalaries = ViewBag.BarberSalaries as List<Salary> ?? new List<Salary>();
    decimal barberExp = ViewBag.TotalBarberExpenses is decimal be ? be : 0m;
    decimal barberSal = ViewBag.TotalBarberSalaries is decimal bs ? bs : 0m;
    decimal barberComb = ViewBag.TotalBarberCombined is decimal bc ? bc : 0m;

    var massageExpenses = ViewBag.MassageExpenses as List<Expense> ?? new List<Expense>();
    var massageSalaries = ViewBag.MassageSalaries as List<Salary> ?? new List<Salary>();
    decimal massageExp = ViewBag.TotalMassageExpenses is decimal me2 ? me2 : 0m;
    decimal massageSal = ViewBag.TotalMassageSalaries is decimal ms ? ms : 0m;
    decimal massageComb = ViewBag.TotalMassageCombined is decimal mcc ? mcc : 0m;

    decimal sharedComb = totalComb - barberComb - massageComb;

    string? userDept = ViewBag.UserDept as string;
    bool isDeptUser = ViewBag.IsDeptUser is bool b && b;

    // Stats
    int totalItems = Model.Count() + salaries.Count;
    decimal maxExpense = Model.Any() ? Model.Max(e => e.Amount) : 0m;
    string topCategory = Model.Any()
        ? Model.Where(e => !string.IsNullOrEmpty(e.Category))
               .GroupBy(e => e.Category!)
               .OrderByDescending(g => g.Sum(x => x.Amount))
               .Select(g => g.Key).FirstOrDefault() ?? "-"
        : "-";
    int expenseCount = Model.Count();
    int salaryCount = salaries.Count;
}

@* ======= STYLES ======= *@
<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            direction: rtl;
        }

        .print-header {
            display: block !important;
        }

        .app-wrapper, .main-content, .page-content {
            display: block !important;
            min-height: 0 !important;
            height: auto !important;
            overflow: visible !important;
            margin: 0 !important;
        }

        .card:not(.no-exist) {
            display: block !important;
            box-shadow: none !important;
            border: 1px solid #dee2e6 !important;
        }

        .card-header, .card-body {
            display: block !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .rev-stat, .bottom-stat {
            box-shadow: none !important;
            border: 1px solid #e5e7eb;
        }

        * {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }

    .print-header {
        display: none;
    }

    .rev-stat {
        background: #fff;
        border-radius: 14px;
        padding: 14px 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        display: flex;
        align-items: center;
        gap: 12px;
        height: 100%;
    }

    .rev-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .rev-stat-label {
        font-size: .74rem;
        color: #6b7280;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rev-stat-value {
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.2;
        word-break: break-all;
    }

    .bottom-stat {
        background: #fff;
        border-radius: 14px;
        padding: 18px 22px;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .bottom-stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .bottom-stat-label {
        font-size: .78rem;
        color: #6b7280;
    }

    .bottom-stat-value {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .bottom-stat-sub {
        font-size: .78rem;
        color: #6b7280;
    }

    .rev-table thead th {
        background: #f8fafc;
        font-size: .82rem;
        font-weight: 600;
        color: #374151;
        border-bottom: 2px solid #e5e7eb;
        white-space: nowrap;
        padding: 10px 14px;
    }

    .rev-table tbody td {
        padding: 9px 14px;
        font-size: .88rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .rev-table tbody tr:hover {
        background: #f8fafc;
    }

    .rev-table tfoot td {
        padding: 10px 14px;
        font-weight: 700;
        font-size: .9rem;
        background: #fff5f5;
        border-top: 2px solid #fecaca;
    }

    .exp-dept-badge {
        font-size: 10px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 10px;
        display: inline-block;
    }
</style>

@* ======= PRINT HEADER ======= *@
<div class="print-header text-center mb-3">
    <h4 class="fw-bold" data-i18n-en="Expenses Report">تقرير المصاريف</h4>
    <p class="mb-0">
        <span data-i18n-en="Period:">الفترة:</span> @ViewBag.From <span data-i18n-en="to">إلى</span> @ViewBag.To
        @if (isDeptUser)
        {
            <span>&nbsp;|&nbsp;</span>
        
            <span>@userDept</span>
        }
    </p>
</div>

@* ======= HEADER ======= *@
<div class="d-flex justify-content-between align-items-start mb-3 no-print flex-wrap gap-2">
    <div>
        <h1 class="h4 mb-0 fw-bold">
            <i class="fas fa-file-invoice-dollar me-2" style="color:#dc2626;"></i>
            <span data-i18n-en="Expenses Report">تقرير المصاريف</span>
        </h1>
        <p class="text-muted small mb-0">
            <span data-i18n-en="Detailed expenses and salaries for the selected period">تفصيل المصروفات والمرتبات خلال الفترة المحددة</span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button onclick="window.print()" class="btn btn-dark btn-sm">
            <i class="fas fa-print me-1"></i><span data-i18n-en="Print">طباعة</span>
        </button>
        <button onclick="exportExpensesCSV()" class="btn btn-success btn-sm">
            <i class="fas fa-file-excel me-1"></i>Excel
        </button>
    </div>
</div>

@* ======= FILTERS ======= *@
<div class="card mb-3 no-print">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1 small" data-i18n-en="From Date">من تاريخ</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                    <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:160px;" />
                </div>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1 small" data-i18n-en="To Date">إلى تاريخ</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                    <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:160px;" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-search me-1"></i><span data-i18n-en="Search">بحث</span>
                </button>
            </div>
        </form>
    </div>
</div>

@* ======= SUMMARY CARDS ======= *@
