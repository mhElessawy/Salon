@model IEnumerable<Salon.Models.Expense>
@using Salon.Models
@using System.Collections.Generic
@{
    ViewData["Title"] = "تقرير المصاريف";
    var salaries = ViewBag.Salaries as List<Salary> ?? new List<Salary>();
    decimal totalExpenses = ViewBag.TotalExpenses is decimal te ? te : 0m;
    decimal totalSalaries = ViewBag.TotalSalaries is decimal ts ? ts : 0m;
    decimal totalCombined = ViewBag.TotalCombined is decimal tc ? tc : 0m;
}

<div class="page-header">
    <h1><i class="fas fa-file-invoice-dollar me-2"></i>تقرير المصاريف</h1>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">من:</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:170px;" />
            <label class="form-label mb-0">إلى:</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:170px;" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card red">
            <div class="stat-label">إجمالي المصاريف (مصروفات + مرتبات)</div>
            <div class="stat-value">@totalCombined.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="border-right:4px solid #fd7e14;">
            <div class="stat-label">المصروفات فقط</div>
            <div class="stat-value" style="color:#fd7e14;">@totalExpenses.ToString("N3") د.ك</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="border-right:4px solid #7c3aed;">
            <div class="stat-label">المرتبات المصروفة</div>
            <div class="stat-value" style="color:#7c3aed;">@totalSalaries.ToString("N3") د.ك</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>النوع</th>
                        <th>البيان</th>
                        <th>الفئة / الموظف</th>
                        <th>المبلغ</th>
                        <th>طريقة الدفع</th>
                        <th>التاريخ</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><span class="badge bg-warning text-dark"><i class="fas fa-receipt me-1"></i>مصروف</span></td>
                            <td>@e.Description</td>
                            <td class="text-muted">@(e.Category ?? "-")</td>
                            <td><strong class="text-danger">@e.Amount.ToString("N3") د.ك</strong></td>
                            <td>@e.PaymentMethod</td>
                            <td>@e.ExpenseDate.ToString("yyyy/MM/dd")</td>
                            <td class="text-muted small">@e.Notes</td>
                        </tr>
                    }
                    @foreach (var sal in salaries)
                    {
                        <tr style="background:#fff5f5;">
                            <td><span class="badge bg-danger"><i class="fas fa-money-check-alt me-1"></i>مرتب</span></td>
                            <td>مرتب @sal.Month/@sal.Year</td>
                            <td>@sal.Employee?.FullName</td>
                            <td><strong class="text-danger">@sal.NetSalary.ToString("N3") د.ك</strong></td>
                            <td>نقدي</td>
                            <td>@sal.PaidDate?.ToString("yyyy/MM/dd")</td>
                            <td class="text-muted small">@sal.Notes</td>
                        </tr>
                    }
                    @if (!Model.Any() && !salaries.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">لا توجد مصاريف في هذه الفترة</td></tr>
                    }
                </tbody>
                @if (Model.Any() || salaries.Any())
                {
                    <tfoot class="table-dark fw-bold">
                        <tr>
                            <td colspan="3" class="text-end">الإجمالي</td>
                            <td class="text-danger">@totalCombined.ToString("N3") د.ك</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>