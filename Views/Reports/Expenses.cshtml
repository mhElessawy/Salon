                    <div class="rev-stat-label" data-i18n-en="K.D.">د.ك</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="rev-stat">
                <div class="rev-stat-icon" style="background:#ffedd5;color:#ea580c;">
                    <i class="fas fa-receipt"></i>
                </div>
                <div>
                    <div class="rev-stat-label" data-i18n-en="Expenses Only">مصروفات فقط</div>
                    <div class="rev-stat-value" style="color:#ea580c;">@totalExp.ToString("N3")</div>
