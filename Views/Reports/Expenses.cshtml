@model IEnumerable<Salon.Models.Expense>
@{
    ViewData["Title"] = "تقرير المصروفات";
}

<div class="page-header">
    <h1><i class="fas fa-file-invoice-dollar me-2"></i>تقرير المصروفات</h1>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">من:</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:170px;" />
            <label class="form-label mb-0">إلى:</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:170px;" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card red">
            <div class="stat-label">إجمالي المصروفات</div>
            <div class="stat-value">@ViewBag.TotalExpenses?.ToString("N3") د.ك</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>البيان</th>
                        <th>الفئة</th>
                        <th>المبلغ</th>
                        <th>طريقة الدفع</th>
                        <th>التاريخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.Description</td>
                            <td>@(e.Category ?? "-")</td>
                            <td><strong>@e.Amount.ToString("N3") د.ك</strong></td>
                            <td>@e.PaymentMethod</td>
                            <td>@e.ExpenseDate.ToString("yyyy/MM/dd")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">لا توجد مصروفات في هذه الفترة</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
