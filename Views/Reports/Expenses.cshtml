                <div class="rev-stat-icon" style="background:#fee2e2;color:#dc2626;">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <div class="rev-stat-label" data-i18n-en="Total (Exp+Sal)">الإجمالي (مصروفات+مرتبات)</div>
                    <div class="rev-stat-value" style="color:#dc2626;">@totalComb.ToString("N3")</div>
                    <div class="rev-stat-label" data-i18n-en="K.D.">د.ك</div>
                </div>
            </div>
