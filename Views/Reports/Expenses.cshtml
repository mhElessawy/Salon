                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="rev-stat">
                <div class="rev-stat-icon" style="background:#ede9fe;color:#7c3aed;">
                    <i class="fas fa-money-check-alt"></i>
                </div>
                <div>
                    <div class="rev-stat-label" data-i18n-en="Salaries Paid">مرتبات مصروفة</div>
