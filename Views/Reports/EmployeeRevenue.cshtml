@* ===== NOTES LEGEND ===== *@
<div class="card no-print mb-3">
    <div class="card-body py-2">
        <small class="text-muted">
            <strong><i class="fas fa-info-circle me-1"></i><span data-i18n-en="Important Notes:">ملاحظات هامة:</span></strong>
            <span data-i18n-en="Commission: If the employee achieves their target, the full revenue is calculated at the higher rate (e.g. 60%) instead of the base rate (e.g. 50%)">
                العمولة: إذا حقق الموظف التارجت تُحتسب كل مبيعاته بنسبة التارجت الأعلى بدلاً من النسبة الأساسية
            </span>
            &nbsp;|&nbsp;
            <span data-i18n-en="Net Employee = Salary + Actual Commission + Gifts − Advances − Deductions − Emp. Debt">
                صافي الموظف = الراتب + العمولة الفعلية + الإكراميات − السلفة − الخصومات − دين الموظف
            </span>
            &nbsp;|&nbsp;
            <span data-i18n-en="Net Shop = Total − Actual Commission">
                صافي المحل = الإجمالي − العمولة الفعلية
            </span>
        </small>
    </div>
</div>

@section Scripts {
    <script>
        function exportToExcel() {
            var table = document.getElementById('empRevenueTable');
            var wb = XLSX.utils.table_to_book(table, { sheet: "Employee Revenue", raw: true });
            XLSX.writeFile(wb, 'employee_revenue_@(ViewBag.From)_@(ViewBag.To).xlsx');
        }

        function openEmpDetail(employeeId) {
            var overlay = document.getElementById('empDetail-' + employeeId);
            if (overlay) {
                overlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeEmpDetail(employeeId) {
            var overlay = document.getElementById('empDetail-' + employeeId);
            if (overlay) {
                overlay.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        document.querySelectorAll('.edm-overlay').forEach(function (overlay) {
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) {
                    overlay.classList.remove('show');
                    document.body.style.overflow = '';
                }
            });
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.edm-overlay.show').forEach(function (overlay) {
                    overlay.classList.remove('show');
                });
                document.body.style.overflow = '';
            }
        });

        function shareReport() {
            if (navigator.share) {
                navigator.share({ title: 'تقرير الإيراد حسب الموظف', url: window.location.href });
            } else if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href);
            }
        }
    </script>
}