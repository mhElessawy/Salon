@model IEnumerable<Salon.Models.Sale>
@using Salon.Models
@{
    ViewData["Title"] = "تقريري اليومي";
    var userDept = ViewBag.UserDept as string;
    var showBarber = userDept != "مساج";
    var showMassage = userDept != "حلاقة";
    var selectedSaleType = ViewBag.SelectedSaleType as string;
    var selectedPayment = ViewBag.SelectedPaymentMethod as string;
    var selectedEmpId = ViewBag.SelectedEmployeeId as int?;
    var employees = ViewBag.Employees as List<Employee> ?? new List<Employee>();
    var selectedDate = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    bool isToday = ViewBag.IsToday is bool b && b;
    var isFiltered = !string.IsNullOrEmpty(selectedSaleType) || !string.IsNullOrEmpty(selectedPayment) || selectedEmpId.HasValue;
}

<div class="page-header">
    <h1><i class="fas fa-file-invoice me-2"></i>تقريري اليومي</h1>
    <p><span data-i18n-en="Summary of">ملخص يوم</span> @ViewBag.Date</p>
</div>

<div class="stat-cards mb-3" style="grid-template-columns:repeat(9,1fr);gap:10px;">
    <div class="stat-card green" style="padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">مبيعات اليوم</span>
            <div class="stat-icon green" style="width:28px;height:28px;font-size:13px;"><i class="fas fa-dollar-sign"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;">@ViewBag.SalesToday?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card red" style="padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">مصروفات اليوم</span>
            <div class="stat-icon red" style="width:28px;height:28px;font-size:13px;"><i class="fas fa-shopping-bag"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;">@ViewBag.ExpensesToday?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #9f1239;padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">سلف اليوم</span>
            <div class="stat-icon" style="background:#9f1239;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-hand-holding-usd"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;color:#9f1239;">@ViewBag.AdvancesToday?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card orange" style="padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">صافي الربح</span>
            <div class="stat-icon orange" style="width:28px;height:28px;font-size:13px;"><i class="fas fa-chart-line"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;">@ViewBag.NetProfit?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #0891b2;padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">كاش اليوم</span>
            <div class="stat-icon" style="background:#0891b2;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-money-bill-wave"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;">@ViewBag.CashTotal?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #059669;padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">كي نت اليوم</span>
            <div class="stat-icon" style="background:#059669;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-credit-card"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;">@ViewBag.KnetTotal?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #dc2626;padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">دين على العميل</span>
            <div class="stat-icon" style="background:#dc2626;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-user"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;color:#dc2626;">@ViewBag.CustomerDebt?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #b45309;padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">دين على الموظف</span>
            <div class="stat-icon" style="background:#b45309;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-hard-hat"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;color:#b45309;">@ViewBag.EmployeeDebt?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #7c3aed;padding:12px 14px;">
        <div class="stat-card-header" style="margin-bottom:6px;">
            <span class="stat-label" style="font-size:11px;">دين على صاحب العمل</span>
            <div class="stat-icon" style="background:#7c3aed;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-building"></i></div>
        </div>
        <div class="stat-value" style="font-size:1.05rem;color:#7c3aed;">@ViewBag.OwnerDebt?.ToString("N3") د.ك</div>
    </div>
</div>

@if (showBarber || showMassage)
{
    <div class="stat-cards mb-4" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;">
        @if (showBarber)
        {
            <div class="stat-card blue" style="padding:12px 14px;">
                <div class="stat-card-header" style="margin-bottom:6px;">
                    <span class="stat-label" style="font-size:11px;">مبيعات الحلاقة</span>
                    <div class="stat-icon blue" style="width:28px;height:28px;font-size:13px;"><i class="fas fa-cut"></i></div>
                </div>
                <div class="stat-value" style="font-size:1.05rem;">@ViewBag.BarberSales?.ToString("N3") د.ك</div>
            </div>
        }
        @if (showMassage)
        {
            <div class="stat-card" style="border-right:4px solid #7c3aed;padding:12px 14px;">
                <div class="stat-card-header" style="margin-bottom:6px;">
                    <span class="stat-label" style="font-size:11px;">مبيعات المساج</span>
                    <div class="stat-icon" style="background:#7c3aed;color:#fff;border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;font-size:13px;"><i class="fas fa-spa"></i></div>
                </div>
                <div class="stat-value" style="font-size:1.05rem;">@ViewBag.MassageSales?.ToString("N3") د.ك</div>
            </div>
        }
    </div>
}

@{
    var breakdown = ViewBag.PaymentBreakdown as IEnumerable<dynamic>;
    var salesTotalForCheck = (decimal)(ViewBag.SalesToday ?? 0m);
    var cashK   = (decimal)(ViewBag.CashTotal  ?? 0m);
    var knetK   = (decimal)(ViewBag.KnetTotal  ?? 0m);
    var debtK   = (decimal)(ViewBag.DebtTotal  ?? 0m);
    var otherK  = salesTotalForCheck - cashK - knetK - debtK;
    bool hasUnclassified = otherK > 0.001m;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" action="@Url.Action("MyReport")" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">التاريخ</label>
                <div class="input-group input-group-sm">
                    <input type="date" id="dateInput" name="date" value="@selectedDate" class="form-control" style="max-width:160px;" />
                    <button type="button" class="btn btn-outline-secondary" id="todayBtn" title="اليوم">
                        <i class="fas fa-calendar-day"></i>
                    </button>
                </div>
            </div>
            @if (showBarber || showMassage)
            {
                <div class="col-auto">
                    <label class="form-label small fw-semibold mb-1">النوع</label>
                    <select name="saleType" class="form-select form-select-sm" style="min-width:130px;">
                        <option value="" selected="@(string.IsNullOrEmpty(selectedSaleType))">-- الكل --</option>
                        @if (showBarber)
                        {
                            <option value="حلاقة" selected="@(selectedSaleType == "حلاقة")">✂ حلاقة</option>
                        }
                        @if (showMassage)
                        {
                            <option value="مساج" selected="@(selectedSaleType == "مساج")">🌿 مساج</option>
                        }
                    </select>
                </div>
            }

            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">طريقة الدفع</label>
                <select name="paymentMethod" class="form-select form-select-sm" style="min-width:180px;">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedPayment))">-- الكل --</option>
                    <option value="كاش" selected="@(selectedPayment == "كاش")">💵 كاش</option>
                    <option value="كي نت" selected="@(selectedPayment == "كي نت")">💳 كي نت</option>
                    <option value="كي نت و كاش" selected="@(selectedPayment == "كي نت و كاش")">↔ كاش + كي نت</option>
                    <option value="دين على العميل" selected="@(selectedPayment == "دين على العميل")">👤 دين على العميل</option>
                    <option value="دين على الموظف" selected="@(selectedPayment == "دين على الموظف")">👷 دين على الموظف</option>
                    <option value="دين على صاحب المكان" selected="@(selectedPayment == "دين على صاحب المكان")">🏠 دين على صاحب المكان</option>
                </select>
            </div>

            @if (employees.Any())
            {
                <div class="col-auto">
                    <label class="form-label small fw-semibold mb-1">الموظف</label>
                    <select name="employeeId" class="form-select form-select-sm" style="min-width:170px;">
                        <option value="" selected="@(!selectedEmpId.HasValue)">-- كل الموظفين --</option>
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.Id" selected="@(selectedEmpId == emp.Id)">@emp.FullName</option>
                        }
                    </select>
                </div>
            }

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-filter me-1"></i>تصفية
                </button>
                @if (isFiltered)
                {
                    <a href="@Url.Action("MyReport", new { date = selectedDate })" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-times me-1"></i>إلغاء
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title mb-3">
            <i class="fas fa-list me-2"></i><span data-i18n-en="Today's Invoices">فواتير اليوم</span> (@Model.Count())
            @if (isFiltered)
            {
                <span class="badge bg-warning text-dark ms-2 fs-6"><i class="fas fa-filter me-1"></i>مفلتر</span>
            }
        </h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>الموظف</th>
                        <th>العميل</th>
                        <th>النوع</th>
                        <th>الإجمالي</th>
                        <th>الخصم</th>
                        <th>الصافي</th>
                        <th>طريقة الدفع</th>
                        <th>الوقت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.InvoiceNumber</strong></td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>
                                @if (s.SaleType == "حلاقة")
                                {
                                    <span class="badge bg-primary"><i class="fas fa-cut me-1"></i>حلاقة</span>
                                }
                                else if (s.SaleType == "مساج")
                                {
                                    <span class="badge" style="background:#7c3aed;"><i class="fas fa-spa me-1"></i>مساج</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-box me-1"></i>منتجات</span>
                                }
                            </td>
                            <td>@s.TotalAmount.ToString("N3") د.ك</td>
                            <td class="text-danger">
                                @if (s.Discount > 0)
                                {
                                    <span>@s.Discount.ToString("N3") د.ك</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><strong class="text-success">@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>
                                @if (s.PaymentMethod == "كاش")
                                {
                                    <span class="badge bg-success"><i class="fas fa-money-bill-wave me-1"></i>كاش</span>
                                }
                                else if (s.PaymentMethod == "كي نت")
                                {
                                    <span class="badge bg-info text-dark"><i class="fas fa-credit-card me-1"></i>كي نت</span>
                                }
                                else if (s.PaymentMethod == "كي نت و كاش")
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-exchange-alt me-1"></i>كاش + كي نت</span>
                                    <div class="small text-muted mt-1">
                                        @if (s.CashAmount.HasValue && s.CashAmount > 0)
                                        {
                                            <span>كاش: @s.CashAmount.Value.ToString("N3")</span>
                                        }
                                        @if (s.LinkAmount.HasValue && s.LinkAmount > 0)
                                        {
                                            <span class="ms-1">كي نت: @s.LinkAmount.Value.ToString("N3")</span>
                                        }
                                    </div>
                                }
                                else if (s.PaymentMethod == "دين على العميل")
                                {
                                    <span class="badge bg-danger"><i class="fas fa-user me-1"></i>دين / عميل</span>
                                }
                                else if (s.PaymentMethod == "دين على الموظف")
                                {
                                    <span class="badge bg-danger"><i class="fas fa-hard-hat me-1"></i>دين / موظف</span>
                                }
                                else if (s.PaymentMethod == "دين على صاحب المكان")
                                {
                                    <span class="badge bg-danger"><i class="fas fa-building me-1"></i>دين / صاحب المكان</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@s.PaymentMethod</span>
                                }
                            </td>
                            <td class="text-muted small">@s.SaleDate.ToString("hh:mm tt")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                لا توجد فواتير اليوم
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">المجموع:</td>
                            <td>@Model.Sum(s => s.TotalAmount).ToString("N3") د.ك</td>
                            <td class="text-danger">@Model.Sum(s => s.Discount).ToString("N3") د.ك</td>
                            <td class="text-success">@Model.Sum(s => s.NetAmount).ToString("N3") د.ك</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('todayBtn').addEventListener('click', function () {
            var today = new Date().toISOString().slice(0, 10);
            document.getElementById('dateInput').value = today;
            document.getElementById('dateInput').form.submit();
        });
    </script>
}