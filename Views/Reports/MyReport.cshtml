@model IEnumerable<Salon.Models.Sale>
@using Salon.Models
@{
    ViewData["Title"] = "تقريري اليومي";
    var userDept = ViewBag.UserDept as string;
    var showBarber = userDept != "مساج";
    var showMassage = userDept != "حلاقة";
    var selectedSaleType = ViewBag.SelectedSaleType as string;
    var selectedPayment = ViewBag.SelectedPaymentMethod as string;
    var selectedEmpId = ViewBag.SelectedEmployeeId as int?;
    var employees = ViewBag.Employees as List<Employee> ?? new List<Employee>();
    var selectedDate = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    bool isToday = ViewBag.IsToday is bool b && b;
    var isFiltered = !string.IsNullOrEmpty(selectedSaleType) || !string.IsNullOrEmpty(selectedPayment) || selectedEmpId.HasValue;
    var advancesList = ViewBag.AdvancesList as List<EmployeeAdvance> ?? new List<EmployeeAdvance>();
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-file-invoice me-2"></i>تقريري اليومي</h1>
        <p class="mb-0"><span data-i18n-en="Summary of">ملخص يوم</span> @ViewBag.Date</p>
    </div>
    <button onclick="window.print()" class="btn btn-dark btn-sm no-print">
        <i class="fas fa-print me-1"></i> طباعة
    </button>
</div>

<div class="stat-cards mb-4">
    <div class="stat-card green">
        <div class="stat-card-header">
            <span class="stat-label">مبيعات اليوم</span>
            <div class="stat-icon green"><i class="fas fa-dollar-sign"></i></div>
        </div>
        <div class="stat-value">@ViewBag.SalesToday?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card red">
        <div class="stat-card-header">
            <span class="stat-label">مصروفات اليوم</span>
            <div class="stat-icon red"><i class="fas fa-shopping-bag"></i></div>
        </div>
        <div class="stat-value">@ViewBag.ExpensesToday?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card" style="border-right:4px solid #9f1239;">
        <div class="stat-card-header">
            <span class="stat-label">سلف اليوم</span>
            <div class="stat-icon" style="background:#9f1239;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-hand-holding-usd"></i></div>
        </div>
        <div class="stat-value" style="color:#9f1239;">@ViewBag.AdvancesToday?.ToString("N3") د.ك</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-card-header">
            <span class="stat-label">صافي الربح</span>
            <div class="stat-icon orange"><i class="fas fa-chart-line"></i></div>
        </div>
        <div class="stat-value">@ViewBag.NetProfit?.ToString("N3") د.ك</div>
    </div>
</div>

@if (showBarber || showMassage)
{
    <div class="stat-cards mb-4">
        @if (showBarber)
        {
            <div class="stat-card blue">
                <div class="stat-card-header">
                    <span class="stat-label">مبيعات الحلاقة</span>
                    <div class="stat-icon blue"><i class="fas fa-cut"></i></div>
                </div>
                <div class="stat-value">@ViewBag.BarberSales?.ToString("N3") د.ك</div>
            </div>
        }
        @if (showMassage)
        {
            <div class="stat-card purple" style="--card-color:#7c3aed;">
                <div class="stat-card-header">
                    <span class="stat-label">مبيعات المساج</span>
                    <div class="stat-icon" style="background:#7c3aed;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-spa"></i></div>
                </div>
                <div class="stat-value">@ViewBag.MassageSales?.ToString("N3") د.ك</div>
            </div>
        }
        <div class="stat-card" style="border-right:4px solid #0891b2;">
            <div class="stat-card-header">
                <span class="stat-label">كاش اليوم</span>
                <div class="stat-icon" style="background:#0891b2;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-money-bill-wave"></i></div>
            </div>
            <div class="stat-value">@ViewBag.CashTotal?.ToString("N3") د.ك</div>
        </div>
        <div class="stat-card" style="border-right:4px solid #059669;">
            <div class="stat-card-header">
                <span class="stat-label">كي نت اليوم</span>
                <div class="stat-icon" style="background:#059669;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-credit-card"></i></div>
            </div>
            <div class="stat-value">@ViewBag.KnetTotal?.ToString("N3") د.ك</div>
        </div>
        <div class="stat-card" style="border-right:4px solid #fd7e14;">
            <div class="stat-card-header">
                <span class="stat-label">دين على الموظف</span>
                <div class="stat-icon" style="background:#fd7e14;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-user-tag"></i></div>
            </div>
            <div class="stat-value" style="color:#fd7e14;">@ViewBag.EmployeeDebtTotal?.ToString("N3") د.ك</div>
        </div>
        <div class="stat-card" style="border-right:4px solid #7c3aed;">
            <div class="stat-card-header">
                <span class="stat-label">دين على صاحب المكان</span>
                <div class="stat-icon" style="background:#7c3aed;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-building"></i></div>
            </div>
            <div class="stat-value" style="color:#7c3aed;">@ViewBag.OwnerDebtTotal?.ToString("N3") د.ك</div>
        </div>
        @if ((decimal)(ViewBag.CancelledTotal ?? 0m) > 0)
        {
            <div class="stat-card" style="border-right:4px solid #dc2626;">
                <div class="stat-card-header">
                    <span class="stat-label">إجمالي الملغاة (@ViewBag.CancelledCount فاتورة)</span>
                    <div class="stat-icon" style="background:#dc2626;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;"><i class="fas fa-ban"></i></div>
                </div>
                <div class="stat-value" style="color:#dc2626;">@ViewBag.CancelledTotal?.ToString("N3") د.ك</div>
            </div>
        }
    </div>
}

@{
    var breakdown = ViewBag.PaymentBreakdown as IEnumerable<dynamic>;
    var salesTotalForCheck = (decimal)(ViewBag.SalesToday ?? 0m);
    var cashK = (decimal)(ViewBag.CashTotal ?? 0m);
    var knetK = (decimal)(ViewBag.KnetTotal ?? 0m);
    var debtK = (decimal)(ViewBag.DebtTotal ?? 0m);
    var otherK = salesTotalForCheck - cashK - knetK - debtK;
    bool hasUnclassified = otherK > 0.001m;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" action="@Url.Action("MyReport")" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">التاريخ</label>
                <div class="input-group input-group-sm">
                    <input type="date" id="dateInput" name="date" value="@selectedDate" class="form-control" style="max-width:160px;" />
                    <button type="button" class="btn btn-outline-secondary" id="todayBtn" title="اليوم">
                        <i class="fas fa-calendar-day"></i>
                    </button>
                </div>
            </div>
            @if (showBarber || showMassage)
            {
                <div class="col-auto">
                    <label class="form-label small fw-semibold mb-1">النوع</label>
                    <select name="saleType" class="form-select form-select-sm" style="min-width:130px;">
                        <option value="" selected="@(string.IsNullOrEmpty(selectedSaleType))">-- الكل --</option>
                        @if (showBarber)
                        {
                            <option value="حلاقة" selected="@(selectedSaleType == "حلاقة")">✂ حلاقة</option>
                        }
                        @if (showMassage)
                        {
                            <option value="مساج" selected="@(selectedSaleType == "مساج")">🌿 مساج</option>
                        }
                    </select>
                </div>
            }

            <div class="col-auto">
                <label class="form-label small fw-semibold mb-1">طريقة الدفع</label>
                <select name="paymentMethod" class="form-select form-select-sm" style="min-width:180px;">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedPayment))">-- الكل --</option>
                    <option value="كاش" selected="@(selectedPayment == "كاش")">💵 كاش</option>
                    <option value="كي نت" selected="@(selectedPayment == "كي نت")">💳 كي نت</option>
                    <option value="كي نت و كاش" selected="@(selectedPayment == "كي نت و كاش")">↔ كاش + كي نت</option>
                    <option value="دين على العميل" selected="@(selectedPayment == "دين على العميل")">👤 دين على العميل</option>
                    <option value="دين على الموظف" selected="@(selectedPayment == "دين على الموظف")">👷 دين على الموظف</option>
                    <option value="دين على صاحب المكان" selected="@(selectedPayment == "دين على صاحب المكان")">🏠 دين على صاحب المكان</option>
                </select>
            </div>

            @if (employees.Any())
            {
                <div class="col-auto">
                    <label class="form-label small fw-semibold mb-1">الموظف</label>
                    <select name="employeeId" class="form-select form-select-sm" style="min-width:170px;">
                        <option value="" selected="@(!selectedEmpId.HasValue)">-- كل الموظفين --</option>
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.Id" selected="@(selectedEmpId == emp.Id)">@emp.FullName</option>
                        }
                    </select>
                </div>
            }

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fas fa-filter me-1"></i>تصفية
                </button>
                @if (isFiltered)
                {
                    <a href="@Url.Action("MyReport", new { date = selectedDate })" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-times me-1"></i>إلغاء
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card print-area">
    <div class="card-body">
        <h5 class="card-title mb-3">
            <i class="fas fa-list me-2"></i><span data-i18n-en="Today's Invoices">فواتير اليوم</span> (@Model.Count())
            @if (isFiltered)
            {
                <span class="badge bg-warning text-dark ms-2 fs-6"><i class="fas fa-filter me-1"></i>مفلتر</span>
            }
        </h5>
        <div class="table-responsive">
            <table id="invoiceTable" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>الموظف</th>
                        <th>العميل</th>
                        <th>النوع</th>
                        <th>الخدمات</th>
                        <th>الإجمالي</th>
                        <th>الخصم</th>
                        <th>الصافي</th>
                        <th>طريقة الدفع</th>
                        <th>ملاحظات</th>
                        <th>الوقت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var isCancelled = s.Status == "ملغي";
                        <tr style="@(isCancelled ? "background:#fff5f5;opacity:.8;" : "")">
                            <td>
                                <strong style="@(isCancelled ? "text-decoration:line-through;color:#dc2626;" : "")">@s.InvoiceNumber</strong>
                                @if (isCancelled)
                                {
                                    <br />
                            
                                    <span class="badge bg-danger mt-1"><i class="fas fa-ban me-1"></i>ملغي</span>
                                }
                            </td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>
                                @if (s.SaleType == "حلاقة")
                                {
                                    <span class="badge bg-primary"><i class="fas fa-cut me-1"></i>حلاقة</span>
                                }
                                else if (s.SaleType == "مساج")
                                {
                                    <span class="badge" style="background:#7c3aed;"><i class="fas fa-spa me-1"></i>مساج</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-box me-1"></i>منتجات</span>
                                }
                            </td>
                            <td class="small">
                                @if (s.SaleItems != null && s.SaleItems.Any())
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var item in s.SaleItems)
                                        {
                                            <li>@item.ItemName@(item.Quantity > 1 ? $" ×{item.Quantity}" : "")</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@s.TotalAmount.ToString("N3") د.ك</td>
                            <td class="text-danger">
                                @if (s.Discount > 0)
                                {
                                    <span>@s.Discount.ToString("N3") د.ك</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><strong class="@(isCancelled ? "text-danger" : "text-success")">@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>
                                @if (s.PaymentMethod == "كاش")
                                {
                                    <span class="badge bg-success"><i class="fas fa-money-bill-wave me-1"></i>كاش</span>
                                }
                                else if (s.PaymentMethod == "كي نت")
                                {
                                    <span class="badge bg-info text-dark"><i class="fas fa-credit-card me-1"></i>كي نت</span>
                                }
                                else if (s.PaymentMethod == "كي نت و كاش")
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-exchange-alt me-1"></i>كاش + كي نت</span>
                                    <div class="small text-muted mt-1">
                                        @if (s.CashAmount.HasValue && s.CashAmount > 0)
                                        {
                                            <span>كاش: @s.CashAmount.Value.ToString("N3")</span>
                                        }
                                        @if (s.LinkAmount.HasValue && s.LinkAmount > 0)
                                        {
                                            <span class="ms-1">كي نت: @s.LinkAmount.Value.ToString("N3")</span>
                                        }
                                    </div>
                                }
                                else if (s.PaymentMethod == "دين على العميل")
                                {
                                    <span class="badge bg-danger"><i class="fas fa-user me-1"></i>دين / عميل</span>
                                }
                                else if (s.PaymentMethod == "دين على الموظف")
                                {
                                    <span class="badge bg-danger"><i class="fas fa-hard-hat me-1"></i>دين / موظف</span>
                                }
                                else if (s.PaymentMethod == "دين على صاحب المكان")
                                {
                                    <span class="badge bg-danger"><i class="fas fa-building me-1"></i>دين / صاحب المكان</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@s.PaymentMethod</span>
                                }
                            </td>
                            <td class="small text-muted" style="max-width:140px;white-space:pre-wrap;">@s.Notes</td>
                            <td class="text-muted small">@s.SaleDate.ToString("hh:mm tt")</td>
                        </tr>
                    }
                    @foreach (var adv in advancesList)
                    {
                        var advTime = adv.AdvanceDate != default ? adv.AdvanceDate.ToString("hh:mm tt") : adv.CreatedAt.ToString("hh:mm tt");
                        <tr style="background:#fff0f0;">
                            <td><strong class="text-danger">سلفة #@adv.Id</strong></td>
                            <td>@(adv.Employee?.FullName ?? "-")</td>
                            <td class="text-muted">-</td>
                            <td><span class="badge" style="background:#9f1239;"><i class="fas fa-hand-holding-usd me-1"></i>سلفة</span></td>
                            <td class="small text-muted">@(string.IsNullOrEmpty(adv.Reason) ? "-" : adv.Reason)</td>
                            <td class="text-danger fw-bold">@adv.Amount.ToString("N3") د.ك</td>
                            <td class="text-muted">-</td>
                            <td class="text-danger fw-bold">@adv.Amount.ToString("N3") د.ك</td>
                            <td>
                                @if (adv.PaymentMethod == "كاش" || adv.PaymentMethod == "نقدي")
                                {
                                    <span class="badge bg-success"><i class="fas fa-money-bill-wave me-1"></i>@adv.PaymentMethod</span>
                                }
                                else if (adv.PaymentMethod == "كي نت")
                                {
                                    <span class="badge bg-info text-dark"><i class="fas fa-credit-card me-1"></i>كي نت</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@adv.PaymentMethod</span>
                                }
                            </td>
                            <td></td>
                            <td class="text-muted small">@advTime</td>
                        </tr>
                    }
                    @if (!Model.Any() && !advancesList.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                لا توجد فواتير اليوم
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Any() || advancesList.Any())
                {
                    <tfoot class="table-dark fw-bold">
                        <tr>
                            <td colspan="5" class="text-end fs-6">
                                <i class="fas fa-receipt me-1"></i>
                                فواتير: <span class="badge bg-light text-dark fs-6 ms-1">@Model.Count()</span>
                                @if (advancesList.Any())
                                {
                                    <span class="ms-2">سلف: <span class="badge bg-danger fs-6">@advancesList.Count</span></span>
                                }
                            </td>
                            <td class="fs-6">@Model.Sum(s => s.TotalAmount).ToString("N3") <small>د.ك</small></td>
                            <td class="text-warning fs-6">@Model.Sum(s => s.Discount).ToString("N3") <small>د.ك</small></td>
                            <td class="text-success fs-6">@Model.Sum(s => s.NetAmount).ToString("N3") <small>د.ك</small></td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('todayBtn').addEventListener('click', function () {
            var today = new Date().toISOString().slice(0, 10);
            document.getElementById('dateInput').value = today;
            document.getElementById('dateInput').form.submit();
        });

    </script>
}