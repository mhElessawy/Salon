@model Salon.Models.Appointment
@{
    ViewData["Title"] = "حجز موعد جديد";
    bool canSelectDept = ViewBag.CanSelectDept == true;
    string initialDept = ViewBag.InitialDept ?? "حلاقة";
    string todayDateStr = DateTime.Today.ToString("yyyy-MM-dd");
}

@section Styles {
    <style>
        /* ─── page layout ─────────────────────────────── */
        .appt-page {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 70px);
            overflow: hidden;
        }

        .appt-body {
            display: flex;
            flex: 1;
            overflow: hidden;
            gap: 0;
        }

        /* ─── filter bar ──────────────────────────────── */
        .appt-filter {
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

            .appt-filter .filter-title {
                font-weight: 700;
                font-size: 15px;
                color: #333;
                display: flex;
                align-items: center;
                gap: 6px;
                margin-inline-end: auto;
            }

        .date-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .date-nav input[type=date] {
                border: 1px solid #dee2e6;
                border-radius: 8px;
                padding: 5px 10px;
                font-size: 13px;
                font-weight: 600;
                width: 130px;
                cursor: pointer;
            }

        .btn-nav {
            width: 30px;
            height: 30px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 15px;
            color: #555;
            transition: all .15s;
        }

            .btn-nav:hover {
                background: #f0f0f0;
            }

        .filter-select {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 5px 10px;
            font-size: 13px;
            min-width: 120px;
            cursor: pointer;
        }

        .dept-btn {
            border: 1.5px solid #dee2e6;
            border-radius: 8px;
            background: #f8f9fa;
            color: #555;
            padding: 5px 14px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .dept-btn.active {
                border-color: #0d6efd;
                background: #e8f0fe;
                color: #0d6efd;
            }

            .dept-btn:hover:not(.active) {
                background: #efefef;
            }

        /* ─── legend ──────────────────────────────────── */
        .legend-bar {
            display: flex;
            gap: 14px;
            align-items: center;
            padding: 6px 16px;
            background: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
            flex-wrap: wrap;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            font-weight: 600;
            color: #555;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }

        /* ─── calendar section ────────────────────────── */
        .calendar-section {
            flex: 1;
            overflow: auto;
            background: #f4f5f7;
            min-width: 0;
            -webkit-overflow-scrolling: touch;
        }

        .calendar-wrapper {
            position: relative;
        }

        .calendar-loading {
            padding: 60px 20px;
            text-align: center;
            color: #aaa;
        }

        /* ─── calendar table ──────────────────────────── */
        .cal-table {
            border-collapse: collapse;
            width: max-content;
            min-width: 100%;
            background: #fff;
        }

            .cal-table thead tr th {
                position: sticky;
                top: 0;
                z-index: 10;
                background: #f8f9fa;
                padding: 10px 8px;
                text-align: center;
                border: 1px solid #dee2e6;
                font-size: 13px;
                font-weight: 700;
                white-space: nowrap;
            }

                .cal-table thead tr th.time-th {
                    position: sticky;
                    top: 0;
                    right: 0;
                    z-index: 20;
                    min-width: 80px;
                    background: #e9ecef;
                    color: #555;
                }

                .cal-table thead tr th.emp-th {
                    min-width: 120px;
                }

        .emp-th-name {
            font-size: 13px;
            font-weight: 700;
        }

        .emp-th-job {
            font-size: 11px;
            color: #888;
            font-weight: 400;
        }

        .cal-table tbody tr:hover {
            background: rgba(0,0,0,.01);
        }

        .cal-table td.time-cell {
            position: sticky;
            right: 0;
            z-index: 5;
            background: #f8f9fa;
            padding: 6px 10px;
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            color: #444;
            border: 1px solid #dee2e6;
            white-space: nowrap;
            min-width: 80px;
        }

        .cal-table td.slot-cell {
            padding: 4px 6px;
            border: 1px solid #e9ecef;
            text-align: center;
            min-width: 120px;
            height: 46px;
            vertical-align: middle;
            font-size: 11px;
            transition: background .12s;
            cursor: default;
        }

        .slot-available {
            background: #fff;
            cursor: pointer;
            color: #555;
        }

            .slot-available:hover {
                background: #e8f5e9;
            }

            .slot-available.slot-selected {
                background: #c3f0d0 !important;
                border: 2px solid #28a745 !important;
                font-weight: 700;
            }

        .slot-booked {
            background: #fdecea;
            color: #c0392b;
            font-size: 11px;
            font-weight: 600;
        }

        .slot-booked-name {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 3px;
        }

        .slot-break {
            background: #fff8e1;
            color: #856404;
        }

        .slot-outside {
            background: #f5f5f5;
            color: #bbb;
        }

        .avail-text {
            color: #28a745;
            font-size: 11px;
        }

        .slot-selected .avail-text {
            color: #155724;
            font-weight: 700;
        }

        /* ─── details panel ───────────────────────────── */
        .details-panel {
            width: 320px;
            min-width: 290px;
            max-width: 340px;
            flex-shrink: 0;
            background: #fff;
            border-inline-start: 1px solid #e9ecef;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .details-header {
            padding: 12px 16px;
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            font-weight: 700;
            font-size: 14px;
            color: #333;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .details-header .cal-icon {
                width: 30px;
                height: 30px;
                background: linear-gradient(135deg, #f6993f, #e67e22);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-size: 14px;
            }

        .details-body {
            flex: 1;
            overflow-y: auto;
            padding: 12px 14px;
            position: relative;
        }

        .detail-info-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 0;
            font-size: 13px;
            color: #444;
        }

            .detail-info-row .di-icon {
                width: 28px;
                height: 28px;
                background: #f0f4ff;
                border-radius: 7px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #0d6efd;
                font-size: 12px;
                flex-shrink: 0;
            }

        .di-value {
            font-weight: 600;
        }

        .di-label {
            font-size: 11px;
            color: #888;
        }

        .section-divider {
            border: none;
            border-top: 1px solid #f0f0f0;
            margin: 10px 0;
        }

        .panel-section-title {
            font-size: 12px;
            font-weight: 700;
            color: #666;
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* customer search */
        .customer-search-wrap {
            position: relative;
        }

            .customer-search-wrap .search-icon {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                right: 10px;
                color: #aaa;
                font-size: 13px;
                pointer-events: none;
                z-index: 1;
            }

            .customer-search-wrap select {
                padding-right: 32px;
                border-radius: 8px;
                border: 1px solid #dee2e6;
                font-size: 13px;
            }

        /* companions */
        .companion-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px;
            background: #f8f9fa;
            border-radius: 8px;
            margin-bottom: 6px;
            font-size: 13px;
        }

            .companion-item .companion-name {
                flex: 1;
                font-weight: 600;
            }

            .companion-item .btn-remove {
                width: 22px;
                height: 22px;
                background: #fce4e4;
                border: none;
                border-radius: 50%;
                color: #dc3545;
                font-size: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                padding: 0;
            }

                .companion-item .btn-remove:hover {
                    background: #f5b5b5;
                }

        .add-companion-row {
            display: flex;
            gap: 6px;
            margin-top: 6px;
        }

            .add-companion-row select {
                flex: 1;
                font-size: 12px;
                border-radius: 7px;
                border: 1px solid #dee2e6;
            }

            .add-companion-row .btn-add-c {
                width: 30px;
                height: 30px;
                background: #e8f5e9;
                border: 1px solid #28a745;
                border-radius: 7px;
                color: #28a745;
                font-size: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                padding: 0;
                flex-shrink: 0;
            }

                .add-companion-row .btn-add-c:hover {
                    background: #c8f5d8;
                }

        /* packages */
        .package-card {
            border: 1.5px solid #dee2e6;
            border-radius: 10px;
            padding: 10px 12px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all .2s;
        }

            .package-card:hover {
                border-color: #0d6efd;
                background: #f0f6ff;
            }

            .package-card.pkg-selected {
                border-color: #198754;
                background: #e8f5e9;
            }

        .pkg-name {
            font-weight: 700;
            font-size: 13px;
        }

        .pkg-meta {
            font-size: 11px;
            color: #666;
            display: flex;
            gap: 8px;
            margin-top: 4px;
            flex-wrap: wrap;
        }

        .pkg-sessions-badge {
            background: #e8f5e9;
            color: #1a7a42;
            border-radius: 5px;
            padding: 2px 7px;
            font-weight: 700;
            font-size: 11px;
        }

        .pkg-expiry-badge {
            color: #888;
        }

        /* use-pkg btn */
        .btn-use-pkg {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 6px;
            border: 1.5px solid #0d6efd;
            background: #f0f6ff;
            color: #0d6efd;
            cursor: pointer;
            margin-top: 6px;
            transition: all .15s;
        }

            .btn-use-pkg:hover {
                background: #0d6efd;
                color: #fff;
            }

            .btn-use-pkg.active {
                background: #0d6efd;
                color: #fff;
            }

        /* service cards */
        .svc-card {
            background: #fff;
            border: 1.5px solid #e9ecef;
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: border-color .15s, box-shadow .15s;
        }

            .svc-card:hover {
                border-color: #c8d0dd;
                box-shadow: 0 2px 8px rgba(0,0,0,.07);
            }

            .svc-card.from-pkg {
                border-color: #b8d4f5;
                background: #f0f7ff;
            }

        .svc-card-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
            flex-shrink: 0;
            background: linear-gradient(135deg, #667eea, #764ba2);
        }

        .svc-card.from-pkg .svc-card-icon {
            background: linear-gradient(135deg, #0d6efd, #38b2f5);
        }

        .svc-card-body {
            flex: 1;
            min-width: 0;
        }

        .svc-card-name {
            font-weight: 700;
            font-size: 14px;
            color: #222;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .svc-card-emp {
            font-size: 12px;
            color: #777;
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .emp-chip {
            background: #f0f2f5;
            border-radius: 5px;
            padding: 2px 8px;
            font-size: 11px;
            color: #555;
            border: 1px solid #e0e4ea;
        }

        .svc-card-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
            flex-shrink: 0;
        }

        .svc-card-price {
            font-weight: 700;
            color: #198754;
            font-size: 15px;
            white-space: nowrap;
        }

            .svc-card-price.from-pkg {
                color: #0d6efd;
                font-size: 12px;
                background: #e0eeff;
                border-radius: 6px;
                padding: 3px 8px;
            }

        .svc-card-del {
            width: 26px;
            height: 26px;
            background: #fce4e4;
            border: none;
            border-radius: 50%;
            color: #dc3545;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            transition: background .1s;
            flex-shrink: 0;
        }

            .svc-card-del:hover {
                background: #f5b5b5;
            }

        /* panel date/time inputs */
        .panel-dt-row {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 5px 0;
        }

            .panel-dt-row .di-icon {
                flex-shrink: 0;
            }

            .panel-dt-row .panel-dt-inner {
                flex: 1;
            }

            .panel-dt-row .di-label {
                font-size: 11px;
                color: #aaa;
                margin-bottom: 3px;
            }

            .panel-dt-row input[type=date], .panel-dt-row input[type=time] {
                width: 100%;
                font-size: 13px;
                font-weight: 600;
                border: 1.5px solid #dee2e6;
                border-radius: 8px;
                padding: 5px 8px;
                color: #333;
                background: #fff;
                transition: border-color .15s;
                cursor: pointer;
            }

            .panel-dt-row input:focus {
                border-color: #0d6efd;
                outline: none;
            }

        /* companion text input */
        .add-companion-row input[type=text] {
            flex: 1;
            font-size: 13px;
            border-radius: 7px;
            border: 1.5px solid #dee2e6;
            padding: 5px 8px;
            background: #fff;
        }

            .add-companion-row input[type=text]:focus {
                border-color: #28a745;
                outline: none;
            }

        /* add service dropdown */
        .add-svc-wrap {
            position: static;
        }

        .svc-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1.5px solid #c5d5f5;
            border-radius: 12px;
            box-shadow: 0 8px 28px rgba(0,0,0,.15);
            z-index: 200;
            max-height: 280px;
            overflow-y: auto;
        }

            .svc-dropdown.open {
                display: block;
            }

        .svc-dropdown-item {
            padding: 10px 14px;
            cursor: pointer;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #f5f5f5;
            transition: background .1s;
        }

            .svc-dropdown-item:last-child {
                border-bottom: none;
            }

            .svc-dropdown-item:hover {
                background: #f0f6ff;
            }

            .svc-dropdown-item .svc-ddi-price {
                color: #198754;
                font-weight: 700;
                font-size: 13px;
            }

        /* total */
        .total-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 10px;
            background: #f8f9fa;
            border-radius: 8px;
            margin-top: 8px;
            font-size: 13px;
            border: 1px solid #e9ecef;
        }

            .total-bar .total-label {
                font-weight: 600;
                color: #555;
            }

            .total-bar .total-value {
                font-weight: 700;
                color: #198754;
                font-size: 14px;
            }

        /* details footer */
        .details-footer {
            padding: 12px 14px;
            border-top: 1px solid #e9ecef;
            background: #fff;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .btn-save-appt {
            background: linear-gradient(135deg, #f6993f, #e67e22);
            border: none;
            color: #fff;
            font-weight: 700;
            font-size: 14px;
            padding: 10px;
            border-radius: 10px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: opacity .2s;
        }

            .btn-save-appt:hover {
                opacity: .9;
            }

        .btn-cancel-row {
            display: flex;
            gap: 8px;
        }

            .btn-cancel-row .btn {
                flex: 1;
                font-size: 13px;
                border-radius: 8px;
            }

        @@media (max-width: 768px) {
            .appt-body {
                flex-direction: column;
            }
            /* على الموبايل: calendar فوق، details تحت */
            .calendar-section {
                order: 1;
                min-height: 280px;
            }

            .details-panel {
                order: 2;
                width: 100%;
                max-width: 100%;
                border-inline-start: none;
                border-top: 1px solid #e9ecef;
            }
        }
    </style>
}

<form id="bookingForm" asp-action="Create" method="post" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Status" value="مجدول" />
    <input type="hidden" id="hdnAppointmentDate" name="AppointmentDate" value="@todayDateStr T11:00:00" />
    <input type="hidden" id="hdnEndTime" name="EndTime" />
    <input type="hidden" id="hdnEmployeeId" name="EmployeeId" />
    <input type="hidden" id="hdnCustomerId" name="CustomerId" />
    <input type="hidden" id="hdnPackageId" name="CustomerPackageId" />

    <div class="appt-page">

        <!-- ─── Filter Bar ──────────────────────────────────────── -->
        <div class="appt-filter">
            <span class="filter-title">
                <i class="fas fa-calendar-plus text-warning"></i>
                <span data-i18n-en="New Appointment">حجز موعد جديد</span>
            </span>

            <div class="date-nav">
                <button type="button" class="btn-nav" id="btnPrevDate"><i class="fas fa-chevron-right"></i></button>
                <input type="date" id="dateSelect" value="@todayDateStr" />
                <button type="button" class="btn-nav" id="btnNextDate"><i class="fas fa-chevron-left"></i></button>
            </div>

            <select id="empFilterSel" class="filter-select">
                <option value="" data-i18n-en="Select Employee">اختر الموظف</option>
                <option value="" data-i18n-en="All">الكل</option>
            </select>

            <select id="svcFilterSel" class="filter-select" style="display:none;">
                <option value="">اختر الخدمة</option>
            </select>

            @if (canSelectDept)
            {
                <div class="d-flex gap-1">
                    <button type="button" class="dept-btn @(initialDept == "حلاقة" ? "active" : "")" data-dept="حلاقة">
                        <i class="fas fa-cut"></i> <span data-i18n-en="Barbering">حلاقة</span>
                    </button>
                    <button type="button" class="dept-btn @(initialDept == "مساج" ? "active" : "")" data-dept="مساج">
                        <i class="fas fa-spa"></i> <span data-i18n-en="Massage">مساج</span>
                    </button>
                </div>
            }

            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm ms-auto" style="font-size:12px;">
                <i class="fas fa-arrow-right me-1"></i><span data-i18n-en="Appointments">المواعيد</span>
            </a>
        </div>

        <!-- ─── Legend ──────────────────────────────────────────── -->
        <div class="legend-bar">
            <div class="legend-item"><span class="legend-dot" style="background:#28a745;"></span> <span data-i18n-en="Available">متاح</span></div>
            <div class="legend-item"><span class="legend-dot" style="background:#e74c3c;"></span> <span data-i18n-en="Booked">محجوز</span></div>
            <div class="legend-item"><span class="legend-dot" style="background:#f39c12;"></span> <span data-i18n-en="Break">استراحة</span></div>
            <div class="legend-item"><span class="legend-dot" style="background:#adb5bd;"></span> <span data-i18n-en="Off-Duty">خارج الدوام</span></div>
        </div>

        <!-- ─── Body (Calendar + Details) ──────────────────────── -->
        <div class="appt-body">

            <!-- Details Panel - أول في HTML = يمين في RTL flex -->
            <div class="details-panel">
                <div class="details-header">
                    <div class="cal-icon"><i class="fas fa-calendar-alt"></i></div>
                    <span data-i18n-en="Appointment Details">تفاصيل الموعد</span>
                </div>

                <div class="details-body">

                    <!-- التاريخ: input للتنقل السريع -->
                    <div class="panel-dt-row">
                        <div class="di-icon"><i class="fas fa-calendar"></i></div>
                        <div class="panel-dt-inner">
                            <div class="di-label" data-i18n-en="Date">التاريخ</div>
                            <input type="date" id="panelDateInput" value="@todayDateStr" />
                        </div>
                    </div>
                    <!-- الوقت: يُحدَّد من الجدول فقط -->
                    <div class="panel-dt-row">
                        <div class="di-icon"><i class="fas fa-clock"></i></div>
                        <div class="panel-dt-inner">
                            <div class="di-label" data-i18n-en="Time">الوقت</div>
                            <div id="displayTime" style="font-size:13px;font-weight:700;color:#333;padding:5px 0;min-height:26px;">
                                <span id="displayTimeHint" class="text-muted" style="font-weight:400;font-size:12px;" data-i18n-en="Click a cell in the calendar">اضغط على خلية في الجدول</span>
                            </div>
                        </div>
                    </div>

                    <hr class="section-divider" />

                    <!-- Main Customer -->
                    <div class="panel-section-title"><span data-i18n-en="Main Customer">العميل الرئيسي</span></div>
                    <div class="customer-search-wrap mb-2">
                        <i class="fas fa-search search-icon"></i>
                        <select id="customerSelect" class="form-select form-select-sm w-100">
                            <option value="" data-i18n-en="-- Select Customer --">-- اختر العميل --</option>
                        </select>
                    </div>

                    <hr class="section-divider" />

                    <!-- Companions -->
                    <div class="panel-section-title">
                        <span><span data-i18n-en="Companions">المرافقون</span> <span id="companionsCountBadge" class="badge bg-secondary ms-1" style="font-size:10px;">0</span></span>
                        <button type="button" id="btnToggleCompanion" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size:11px;">
                            <i class="fas fa-plus"></i> <span data-i18n-en="Add Companion">إضافة مرافق</span>
                        </button>
                    </div>

                    <div id="companionsListUI"></div>

                    <div id="addCompanionRow" class="add-companion-row" style="display:none;">
                        <input type="text" id="companionNameInput" placeholder="اكتب اسم المرافق..." data-placeholder-ar="اكتب اسم المرافق..." data-placeholder-en="Enter companion name..." maxlength="80" />
                        <button type="button" id="btnConfirmCompanion" class="btn-add-c" title="إضافة">
                            <i class="fas fa-check"></i>
                        </button>
                    </div>

                    <hr class="section-divider" />

                    <!-- Active Packages -->
                    <div id="packagesSection" style="display:none;">
                        <div class="panel-section-title"><span data-i18n-en="Active Packages">الباقات النشطة</span></div>
                        <div id="packagesList"></div>
                        <hr class="section-divider" />
                    </div>

                    <!-- Services -->
                    <div class="panel-section-title" style="position:relative;">
                        <span data-i18n-en="Services">الخدمات</span>
                        <div class="add-svc-wrap">
                            <button type="button" id="btnAddService" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:12px;font-weight:700;">
                                <i class="fas fa-plus"></i> <span data-i18n-en="Add">إضافة</span>
                            </button>
                            <div id="svcDropdown" class="svc-dropdown"></div>
                        </div>
                    </div>
                    <div id="servicesListUI"></div>

                    <!-- Total -->
                    <div class="total-bar" id="totalBar" style="display:none;">
                        <span class="total-label" data-i18n-en="Total Services">إجمالي الخدمات</span>
                        <span class="total-value" id="totalPriceVal">0.000 د.ك</span>
                    </div>

                    <hr class="section-divider" />

                    <!-- Notes -->
                    <div class="panel-section-title"><span data-i18n-en="Notes">ملاحظات</span></div>
                    <textarea name="Notes" class="form-control form-control-sm" rows="2" placeholder="ملاحظات إضافية..." data-placeholder-ar="ملاحظات إضافية..." data-placeholder-en="Additional notes..."></textarea>

                </div><!-- /details-body -->

                <div class="details-footer">
                    <button type="submit" class="btn-save-appt" id="confirmBtn">
                        <i class="fas fa-calendar-check"></i> <span data-i18n-en="Save Appointment">حفظ الموعد</span>
                    </button>
                    <div class="btn-cancel-row">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-times me-1"></i><span data-i18n-en="Cancel">إلغاء</span>
                        </a>
                        <button type="button" id="btnReset" class="btn btn-outline-warning btn-sm">
                            <i class="fas fa-redo me-1"></i><span data-i18n-en="Reset">إعادة تعيين</span>
                        </button>
                    </div>
                </div>
            </div><!-- /details-panel -->
            <!-- Calendar Section - ثاني في HTML = يسار في RTL flex -->
            <div class="calendar-section">
                <div class="calendar-wrapper" id="calendarWrapper">
                    <div class="calendar-loading">
                        <i class="fas fa-spinner fa-spin fa-2x mb-2 d-block"></i>
                        جاري التحميل...
                    </div>
                </div>
            </div>

        </div><!-- /appt-body -->
    </div><!-- /appt-page -->
</form>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // ── State ────────────────────────────────────────────────────────
            let currentDept     = '@Html.Raw(initialDept)';
            let selectedSlot    = null;    // { empId, empName, startTime, endTime, timeLabel }
            let allCustomers    = [];
            let allServices     = [];      // { id, name, price, priceNum, category }
            let companions      = [];      // { id, name }
            let addedServices   = [];      // { id, name, priceNum, price }
            let usedPackageId   = null;
            let packageServiceName = '';
            let cachedCalendar  = { employees: [], timeSlots: [] };

            // ── Language helper ──────────────────────────────────────────────
            function isEn() { return localStorage.getItem('lang') === 'en'; }
            function t(ar, en) { return isEn() ? en : ar; }
            function fixTimeLabel(label) {
                if (!isEn()) return label;
                return label.replace('ص', 'AM').replace('م', 'PM');
            }

            // ── Helpers ──────────────────────────────────────────────────────
            function esc(str) {
                return String(str || '')
                    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
                    .replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
            }

            function dateLabel(dateStr) {
                const d = new Date(dateStr + 'T00:00:00');
                const days = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
                const dd = String(d.getDate()).padStart(2,'0');
                const mm = String(d.getMonth()+1).padStart(2,'0');
                const yyyy = d.getFullYear();
                return days[d.getDay()] + ' - ' + yyyy + '/' + mm + '/' + dd;
            }

            // ── Init ─────────────────────────────────────────────────────────
            async function init() {
                await loadCustomers();
                await loadServices();
                renderCalendar();
                updateDisplayDate();
            }

            async function loadCustomers() {
                const res = await fetch('/Appointments/GetCustomersByDepartment?dept=' + encodeURIComponent(currentDept));
                allCustomers = await res.json();
                const sel = document.getElementById('customerSelect');
                sel.innerHTML = '<option value="">-- اختر العميل --</option>';
                allCustomers.forEach(c => {
                    sel.innerHTML += `<option value="${c.id}" data-phone="${esc(c.phone||'')}">${esc(c.fullName)}</option>`;
                });
            }

            async function loadServices() {
                const res = await fetch('/Appointments/GetServicesByDepartment?dept=' + encodeURIComponent(currentDept));
                const data = await res.json();
                allServices = data.map(s => ({
                    id: s.id, name: s.name,
                    priceNum: parseFloat(s.price) || 0,
                    price: s.price,
                    category: s.category || ''
                }));
                renderServiceDropdown();
            }

            // ── Calendar ─────────────────────────────────────────────────────
            async function renderCalendar() {
                const date = document.getElementById('dateSelect').value;
                const wrapper = document.getElementById('calendarWrapper');
                wrapper.innerHTML = `<div class="calendar-loading"><i class="fas fa-spinner fa-spin fa-2x mb-2 d-block"></i>${t('جاري التحميل...','Loading...')}</div>`;

                try {
                    const res = await fetch(`/Appointments/GetCalendarView?date=${date}&dept=${encodeURIComponent(currentDept)}`);
                    cachedCalendar = await res.json();
                    buildCalendarTable(cachedCalendar.employees, cachedCalendar.timeSlots);
                } catch(e) {
                    wrapper.innerHTML = `<div class="calendar-loading text-danger"><i class="fas fa-exclamation-circle fa-2x mb-2 d-block"></i>${t('خطأ في تحميل البيانات','Error loading data')}</div>`;
                }
            }

            function buildCalendarTable(employees, timeSlots) {
                if (!employees.length) {
                    document.getElementById('calendarWrapper').innerHTML =
                        `<div class="calendar-loading"><i class="fas fa-users fa-2x mb-2 d-block text-muted"></i>${t('لا يوجد موظفون في هذا القسم','No employees in this department')}</div>`;
                    return;
                }

                // تحديد وقت الآن لمنع الحجز في الماضي
                const now = new Date();
                const todayStr = now.toISOString().split('T')[0];
                const selectedDate = document.getElementById('dateSelect').value;
                const isPastDate = selectedDate < todayStr;
                const isToday = (selectedDate === todayStr);
                const nowMinutes = isToday ? (now.getHours() * 60 + now.getMinutes()) : -1;

                // Header
                let html = '<table class="cal-table"><thead><tr>';
                html += `<th class="time-th">${t('الوقت','Time')}</th>`;
                employees.forEach(emp => {
                    html += `<th class="emp-th">
                        <div class="emp-th-name">${esc(emp.name)}</div>
                        <div class="emp-th-job">${esc(emp.jobTitle)}</div>
                    </th>`;
                });
                html += '</tr></thead><tbody>';

                // Rows
                timeSlots.forEach(slot => {
                    // وقت البداية بالدقائق للمقارنة
                    const [sh, sm] = slot.startTime.split(':').map(Number);
                    const slotMinutes = sh * 60 + sm;
                    const isPast = isPastDate || (isToday && slotMinutes <= nowMinutes);

                    html += '<tr>';
                    html += `<td class="time-cell" style="${isPast ? 'color:#ccc;' : ''}">${esc(fixTimeLabel(slot.timeLabel))}</td>`;

                    slot.cells.forEach((cell, idx) => {
                        const emp = employees[idx];
                        const isSelected = selectedSlot
                            && selectedSlot.empId === cell.empId
                            && selectedSlot.startTime === slot.startTime;

                        if (cell.status === 'محجوز') {
                            html += `<td class="slot-cell slot-booked">
                                <div class="slot-booked-name"><i class="fas fa-user" style="font-size:9px;"></i>${esc(cell.personName||'')}</div>
                            </td>`;
                        } else if (cell.status === 'استراحة') {
                            html += `<td class="slot-cell slot-break"><i class="fas fa-coffee" style="font-size:10px;"></i> ${t('استراحة','Break')}</td>`;
                        } else if (cell.status === 'خارج الدوام') {
                            html += `<td class="slot-cell slot-outside">—</td>`;
                        } else if (isPast) {
                            html += `<td class="slot-cell slot-outside" style="color:#ddd;">—</td>`;
                        } else {
                            const selClass = isSelected ? ' slot-selected' : '';
                            const tLabel = fixTimeLabel(slot.timeLabel);
                            html += `<td class="slot-cell slot-available${selClass}"
                                onclick="selectSlot(${cell.empId},'${esc(emp.name)}','${slot.startTime}','${slot.endTime}','${esc(tLabel)}')"
                                title="${esc(emp.name)} — ${tLabel}">
                                ${isSelected ? '<i class="fas fa-check-circle text-success"></i>' : `<span class="avail-text">${t('متاح','Available')}</span>`}
                            </td>`;
                        }
                    });

                    html += '</tr>';
                });

                html += '</tbody></table>';
                document.getElementById('calendarWrapper').innerHTML = html;
            }

            window.selectSlot = function(empId, empName, startTime, endTime, timeLabel) {
                selectedSlot = { empId, empName, startTime, endTime, timeLabel };

                const date = document.getElementById('dateSelect').value;
                document.getElementById('hdnAppointmentDate').value = date + 'T' + startTime + ':00';
                document.getElementById('hdnEndTime').value = endTime === '00:00' ? '00:00:00' : endTime + ':00';
                document.getElementById('hdnEmployeeId').value = empId;

                // عرض الوقت في الـ panel
                const endLabel = endTime === '00:00' ? (isEn() ? '12:00 AM' : '12:00 ص') : formatTime12(endTime);
                document.getElementById('displayTime').innerHTML =
                    `<span style="color:#0d6efd;">${esc(timeLabel)}</span>
                     <span style="color:#aaa;font-size:11px;"> — ${endLabel}</span>`;

                buildCalendarTable(cachedCalendar.employees, cachedCalendar.timeSlots);
                renderServicesList();
            };

            function formatTime12(t) {
                const parts = t.split(':');
                let h = parseInt(parts[0]);
                const m = parts[1] || '00';
                const ap = h < 12 ? 'ص' : 'م';
                const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h;
                return String(h12).padStart(2,'0') + ':' + m + ' ' + ap;
            }

            // ── Date navigation ──────────────────────────────────────────────
            function updateDisplayDate() {
                const v = document.getElementById('dateSelect').value;
                document.getElementById('panelDateInput').value = v;
            }

            function setDate(newDate) {
                document.getElementById('dateSelect').value = newDate;
                document.getElementById('panelDateInput').value = newDate;
                selectedSlot = null;
                document.getElementById('hdnAppointmentDate').value = '';
                document.getElementById('displayTime').innerHTML =
                    '<span class="text-muted" style="font-weight:400;font-size:12px;">اضغط على خلية في الجدول</span>';
                renderCalendar();
            }

            // date picker في شريط الفلتر
            document.getElementById('dateSelect').addEventListener('change', function() {
                document.getElementById('panelDateInput').value = this.value;
                selectedSlot = null;
                document.getElementById('hdnAppointmentDate').value = '';
                document.getElementById('displayTime').innerHTML =
                    '<span class="text-muted" style="font-weight:400;font-size:12px;">اضغط على خلية في الجدول</span>';
                renderCalendar();
            });

            // date picker في الـ panel
            document.getElementById('panelDateInput').addEventListener('change', function() {
                setDate(this.value);
            });

            document.getElementById('btnPrevDate').addEventListener('click', function() {
                const d = new Date(document.getElementById('dateSelect').value + 'T00:00:00');
                d.setDate(d.getDate() - 1);
                setDate(d.toISOString().split('T')[0]);
            });

            document.getElementById('btnNextDate').addEventListener('click', function() {
                const d = new Date(document.getElementById('dateSelect').value + 'T00:00:00');
                d.setDate(d.getDate() + 1);
                setDate(d.toISOString().split('T')[0]);
            });

            // ── Department buttons ────────────────────────────────────────────
            document.querySelectorAll('.dept-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    currentDept = this.dataset.dept;
                    document.querySelectorAll('.dept-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    selectedSlot = null;
                    addedServices = [];
                    usedPackageId = null;
                    packageServiceName = '';
                    document.getElementById('packagesSection').style.display = 'none';
                    renderServicesList();
                    loadCustomers();
                    loadServices();
                    renderCalendar();
                });
            });

            // ── Customer change ───────────────────────────────────────────────
            document.getElementById('customerSelect').addEventListener('change', async function() {
                const cid = this.value;
                document.getElementById('hdnCustomerId').value = cid;

                // Clear package selection
                usedPackageId = null;
                packageServiceName = '';
                document.getElementById('hdnPackageId').value = '';
                document.getElementById('packagesSection').style.display = 'none';
                document.getElementById('packagesList').innerHTML = '';
                renderServicesList();

                if (!cid) return;

                try {
                    const res = await fetch('/Appointments/GetCustomerPackages?customerId=' + cid);
                    const pkgs = await res.json();
                    if (pkgs.length) {
                        renderPackages(pkgs);
                        document.getElementById('packagesSection').style.display = '';
                    }
                } catch(e) {
                    console.error('خطأ في تحميل الباقات', e);
                }
            });

            function renderPackages(pkgs) {
                let html = '';
                pkgs.forEach(p => {
                    html += `<div class="package-card" id="pkgCard${p.id}" onclick="togglePkg(${p.id},'${esc(p.name)}',${p.remainingSessions})">
                        <div class="pkg-name">${esc(p.name)}</div>
                        <div class="pkg-meta">
                            <span class="pkg-sessions-badge"><i class="fas fa-calendar-check me-1"></i>${p.remainingSessions} / ${p.totalSessions} جلسة</span>
                            ${p.expiry ? `<span class="pkg-expiry-badge"><i class="fas fa-hourglass-end me-1"></i>${p.expiry}</span>` : ''}
                        </div>
                        <button type="button" class="btn-use-pkg" id="usePkgBtn${p.id}" onclick="event.stopPropagation(); usePkg(${p.id},'${esc(p.name)}',${p.remainingSessions})">
                            <i class="fas fa-layer-group"></i> استخدام من الباقة
                        </button>
                    </div>`;
                });
                document.getElementById('packagesList').innerHTML = html;
            }

            window.togglePkg = function(id, name, remaining) {
                document.querySelectorAll('.package-card').forEach(c => c.classList.remove('pkg-selected'));
                document.getElementById('pkgCard' + id)?.classList.add('pkg-selected');
            };

            window.usePkg = function(id, name, remaining) {
                usedPackageId = id;
                packageServiceName = name;
                document.getElementById('hdnPackageId').value = id;
                document.querySelectorAll('.btn-use-pkg').forEach(b => b.classList.remove('active'));
                document.getElementById('usePkgBtn' + id)?.classList.add('active');
                renderServicesList();
            };

            // ── Companions ────────────────────────────────────────────────────
            document.getElementById('btnToggleCompanion').addEventListener('click', function() {
                const row = document.getElementById('addCompanionRow');
                row.style.display = row.style.display === 'none' ? 'flex' : 'none';
            });

            document.getElementById('btnConfirmCompanion').addEventListener('click', function() {
                const inp = document.getElementById('companionNameInput');
                const name = inp.value.trim();
                if (!name) return;
                if (companions.find(c => c.name === name)) { inp.value = ''; return; }
                companions.push({ name });
                inp.value = '';
                document.getElementById('addCompanionRow').style.display = 'none';
                renderCompanions();
            });

            // إضافة مرافق بالضغط على Enter
            document.getElementById('companionNameInput').addEventListener('keydown', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); document.getElementById('btnConfirmCompanion').click(); }
            });

            function renderCompanions() {
                const ul = document.getElementById('companionsListUI');
                const badge = document.getElementById('companionsCountBadge');
                badge.textContent = companions.length;
                badge.style.display = companions.length ? '' : 'none';
                if (!companions.length) { ul.innerHTML = ''; return; }
                ul.innerHTML = companions.map((c, i) =>
                    `<div class="companion-item">
                        <i class="fas fa-user-friends text-secondary" style="font-size:11px;"></i>
                        <span class="companion-name">${esc(c.name)}</span>
                        <button type="button" class="btn-remove" onclick="removeCompanion(${i})"><i class="fas fa-times"></i></button>
                    </div>`
                ).join('');
            }

            window.removeCompanion = function(i) {
                companions.splice(i, 1);
                renderCompanions();
            };

            // ── Services dropdown ─────────────────────────────────────────────
            function renderServiceDropdown() {
                const ddEl = document.getElementById('svcDropdown');
                if (!allServices.length) { ddEl.innerHTML = '<div class="p-2 text-muted small">لا توجد خدمات</div>'; return; }
                ddEl.innerHTML = allServices.map(s =>
                    `<div class="svc-dropdown-item" onclick="addService(${s.id},'${esc(s.name)}',${s.priceNum},'${esc(s.price)}')">
                        <span>${esc(s.name)}</span>
                        <span class="svc-ddi-price">${s.price} د.ك</span>
                    </div>`
                ).join('');
            }

            document.getElementById('btnAddService').addEventListener('click', function(e) {
                e.stopPropagation();
                const dd = document.getElementById('svcDropdown');
                dd.classList.toggle('open');
            });

            document.addEventListener('click', function() {
                document.getElementById('svcDropdown').classList.remove('open');
            });

            window.addService = function(id, name, priceNum, price) {
                if (addedServices.find(s => s.id === id)) { document.getElementById('svcDropdown').classList.remove('open'); return; }
                addedServices.push({ id, name, priceNum, price });
                document.getElementById('svcDropdown').classList.remove('open');
                renderServicesList();
            };

            window.removeService = function(id) {
                addedServices = addedServices.filter(s => s.id !== id);
                renderServicesList();
            };

            // أيقونات الخدمات حسب الفئة
            const svcIcons = {
                'حلاقة': 'fa-cut', 'شعر': 'fa-cut', 'بشرة': 'fa-leaf',
                'مساج': 'fa-spa', 'جمال': 'fa-star', 'حمام': 'fa-shower',
            };
            function svcIcon(category) {
                const k = Object.keys(svcIcons).find(k => (category || '').includes(k));
                return svcIcons[k] || 'fa-concierge-bell';
            }

            function renderServicesList() {
                const ul = document.getElementById('servicesListUI');
                const empName = (selectedSlot && selectedSlot.empName) ? selectedSlot.empName : null;
                const empChip = empName ? `<span class="emp-chip"><i class="fas fa-user" style="font-size:9px;"></i> ${esc(empName)}</span>` : '';

                let html = '';

                // Package service card
                if (usedPackageId) {
                    html += `<div class="svc-card from-pkg">
                        <div class="svc-card-icon"><i class="fas fa-layer-group"></i></div>
                        <div class="svc-card-body">
                            <div class="svc-card-name">${esc(packageServiceName)}</div>
                            <div class="svc-card-emp">${empChip}</div>
                        </div>
                        <div class="svc-card-right">
                            <span class="svc-card-price from-pkg">من الباقة</span>
                        </div>
                    </div>`;
                }

                // Regular service cards
                addedServices.forEach(s => {
                    html += `<div class="svc-card">
                        <div class="svc-card-icon"><i class="fas ${svcIcon(s.category)}"></i></div>
                        <div class="svc-card-body">
                            <div class="svc-card-name">${esc(s.name)}</div>
                            <div class="svc-card-emp">${empChip}</div>
                        </div>
                        <div class="svc-card-right">
                            <span class="svc-card-price">${s.price}</span>
                            <span style="font-size:10px;color:#aaa;">د.ك</span>
                        </div>
                        <button type="button" class="svc-card-del" onclick="removeService(${s.id})" title="حذف"><i class="fas fa-times"></i></button>
                    </div>`;
                });

                if (!html) html = `<div class="text-muted small p-1 text-center" style="opacity:.6;">${t('لم تُضَف خدمات بعد','No services added yet')}</div>`;
                ul.innerHTML = html;

                // Total
                const total = addedServices.reduce((sum, s) => sum + (s.priceNum || 0), 0);
                const totalBar = document.getElementById('totalBar');
                if (addedServices.length) {
                    totalBar.style.display = 'flex';
                    document.getElementById('totalPriceVal').textContent = total.toFixed(3) + ' د.ك';
                } else {
                    totalBar.style.display = 'none';
                }
            }

            // ── Form submit ───────────────────────────────────────────────────
            document.getElementById('bookingForm').addEventListener('submit', function(e) {
                const cid = document.getElementById('customerSelect').value;
                if (!cid) {
                    e.preventDefault();
                    alert(t('يرجى اختيار العميل الرئيسي','Please select the main customer'));
                    document.getElementById('customerSelect').focus();
                    return;
                }
                if (!selectedSlot || !selectedSlot.empId) {
                    e.preventDefault();
                    alert(t('يرجى اختيار موظف ووقت من الجدول','Please select an employee and time from the calendar'));
                    return;
                }

                document.getElementById('hdnCustomerId').value = cid;

                // Service IDs
                this.querySelectorAll('input[name="serviceIds"]').forEach(el => el.remove());
                addedServices.forEach(s => {
                    const inp = document.createElement('input');
                    inp.type = 'hidden'; inp.name = 'serviceIds'; inp.value = s.id;
                    this.appendChild(inp);
                });

                // Companion names
                this.querySelectorAll('input[name="companionNames"]').forEach(el => el.remove());
                if (companions.length) {
                    const inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'companionNames';
                    inp.value = companions.map(c => c.name).join('،');
                    this.appendChild(inp);
                }
            });

            // ── Reset ─────────────────────────────────────────────────────────
            document.getElementById('btnReset').addEventListener('click', function() {
                selectedSlot = null;
                companions = [];
                addedServices = [];
                usedPackageId = null;
                packageServiceName = '';
                document.getElementById('customerSelect').value = '';
                document.getElementById('hdnCustomerId').value = '';
                document.getElementById('hdnPackageId').value = '';
                document.getElementById('hdnEmployeeId').value = '';
                document.getElementById('hdnAppointmentDate').value = '';
                document.getElementById('hdnEndTime').value = '';
                document.getElementById('displayTime').innerHTML =
                    '<span class="text-muted" style="font-weight:400;font-size:12px;">اضغط على خلية في الجدول</span>';
                document.getElementById('packagesSection').style.display = 'none';
                document.getElementById('packagesList').innerHTML = '';
                renderCompanions();
                renderServicesList();
                buildCalendarTable(cachedCalendar.employees, cachedCalendar.timeSlots);
            });

            // ── Start ─────────────────────────────────────────────────────────
            // تطبيق placeholders لو الصفحة محملة بالإنجليزي
            if (isEn()) {
                document.querySelectorAll('[data-placeholder-en]').forEach(function(el) {
                    el.placeholder = el.getAttribute('data-placeholder-en');
                });
            }
            init();

            // ── إعادة بناء الجدول عند تبديل اللغة ────────────────────────────
            const _origToggleLang = window.toggleLang;
            if (typeof _origToggleLang === 'function') {
                window.toggleLang = function() {
                    _origToggleLang.apply(this, arguments);
                    // تطبيق placeholder على حقول النصوص
                    document.querySelectorAll('[data-placeholder-en]').forEach(function(el) {
                        const isEnglish = localStorage.getItem('lang') === 'en';
                        el.placeholder = isEnglish ? el.getAttribute('data-placeholder-en') : el.getAttribute('data-placeholder-ar') || el.placeholder;
                        if (!el.getAttribute('data-placeholder-ar')) el.setAttribute('data-placeholder-ar', el.placeholder);
                    });
                    // إعادة بناء الجدول بالنصوص الصحيحة
                    if (cachedCalendar.employees.length) {
                        buildCalendarTable(cachedCalendar.employees, cachedCalendar.timeSlots);
                    }
                    // تحديث hint الوقت لو لم يُحدَّد وقت بعد
                    if (!selectedSlot) {
                        const hint = document.getElementById('displayTimeHint');
                        if (hint) hint.textContent = t('اضغط على خلية في الجدول','Click a cell in the calendar');
                    }
                };
            }
        })();
    </script>
}