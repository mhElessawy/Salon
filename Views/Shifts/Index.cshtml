@model IEnumerable<Salon.Models.Shift>
@{
    ViewData["Title"] = "إدارة الشفتات";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-clock me-2"></i>إدارة الشفتات</h1>
        <p>متابعة الشفتات اليومية</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> فتح شفت جديد
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم الشفت</th>
                        <th>التاريخ</th>
                        <th>وقت البداية</th>
                        <th>وقت النهاية</th>
                        <th>الكاشير</th>
                        <th>رصيد الفتح</th>
                        <th>رصيد الإغلاق</th>
                        <th>حالة الاعتماد</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">لا توجد شفتات مسجلة</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        string badgeClass = s.ApprovalStatus switch
                        {
                            "معتمد" => "bg-success",
                            "معتمد - يوجد فروقات" => "bg-danger",
                            "مغلق آلياً - بانتظار الاعتماد" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>@s.Id</td>
                            <td><strong>@s.Name</strong></td>
                            <td>@s.ShiftDate.ToString("yyyy/MM/dd")</td>
                            <td>@s.StartTime.ToString(@"hh\:mm")</td>
                            <td>@(s.EndTime?.ToString(@"hh\:mm") ?? "-")</td>
                            <td>@(s.CashierName ?? "-")</td>
                            <td>@s.OpeningBalance.ToString("N3") د.ك</td>
                            <td>@(s.ClosingBalance?.ToString("N3") + " د.ك" ?? "-")</td>
                            <td>
                                <span class="badge @badgeClass">@s.ApprovalStatus</span>
                            </td>
                            <td>
                                <a href="@Url.Action("Review", "DailyClosure", new { date = s.ShiftDate.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-clipboard-check"></i> مراجعة واعتماد
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
