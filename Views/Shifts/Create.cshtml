@model Salon.Models.Shift
@{
    ViewData["Title"] = "فتح شفت جديد";
}

<div class="page-header">
    <h1><i class="fas fa-clock me-2"></i>فتح شفت جديد</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="الشفت الصباحي / المسائي" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ShiftDate" class="form-label"></label>
                    <input asp-for="ShiftDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CashierName" class="form-label"></label>
                    <input asp-for="CashierName" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="OpeningBalance" class="form-label"></label>
                    <input asp-for="OpeningBalance" type="number" step="0.001" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-play me-1"></i> فتح الشفت</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>
