@model IEnumerable<Salon.Models.Employee>

@{
    ViewData["Title"] = "الموظفين";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>الموظفين</h2>
    <a asp-action="Create" class="btn btn-primary">+ إضافة موظف</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">لا يوجد موظفين حتى الآن.</div>
}
else
{
    <table class="table table-striped table-hover" dir="rtl">
        <thead class="table-dark">
            <tr>
                <th>الاسم</th>
                <th>رقم الهاتف</th>
                <th>العمولة (%)</th>
                <th>نوع الخدمة</th>
                <th>الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.Name</td>
                    <td>@emp.Phone</td>
                    <td>@emp.Commission%</td>
                    <td>
                        @switch (emp.ServiceType)
                        {
                            case Salon.Models.ServiceType.Haircut:
                                <span class="badge bg-primary">حلاقة</span>
                                break;
                            case Salon.Models.ServiceType.Massage:
                                <span class="badge bg-success">مساج</span>
                                break;
                            case Salon.Models.ServiceType.Both:
                                <span class="badge bg-warning text-dark">حلاقة + مساج</span>
                                break;
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                        <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-secondary">تفاصيل</a>
                        <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
