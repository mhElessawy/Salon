@model IEnumerable<Salon.Models.Deposit>
@{
    ViewData["Title"] = "الإيداعات";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-money-bill-wave me-2" style="color:#16a34a;"></i>الإيداعات</h1>
        <p>إجمالي اليوم: <strong class="text-success">@ViewBag.Total?.ToString("N3") د.ك</strong></p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-success">
        <i class="fas fa-plus me-1"></i> إضافة إيداع
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0">التاريخ:</label>
            <input type="date" name="date" value="@ViewBag.FilterDate" class="form-control" style="max-width:200px;" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>البيان</th>
                        <th>المصدر</th>
                        <th>المبلغ</th>
                        <th>التاريخ</th>
                        <th>ملاحظات</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">لا توجد إيداعات في هذا اليوم</td></tr>
                    }
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.Id</td>
                            <td>@d.Description</td>
                            <td>@(d.Source ?? "-")</td>
                            <td><strong class="text-success">@d.Amount.ToString("N3") د.ك</strong></td>
                            <td>@d.DepositDate.ToString("yyyy/MM/dd")</td>
                            <td class="text-muted small">@d.Notes</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = d.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        onclick="confirmDelete(@d.Id, '@Html.Raw(d.Description.Replace("'", "\\'"))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="3" class="text-end">الإجمالي</td>
                            <td class="text-success">@ViewBag.Total?.ToString("N3") د.ك</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف الإيداع:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}
