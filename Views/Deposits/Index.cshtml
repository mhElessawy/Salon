@model  IEnumerable<Salon.Models.Deposit>
@{
    ViewData["Title"] = "الإيداعات";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-money-bill-wave me-2" style="color:#16a34a;"></i>الإيداعات</h1>
        <p>إجمالي الفترة: <strong class="text-success">@ViewBag.Total?.ToString("N3") د.ك</strong></p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-success">
        <i class="fas fa-plus me-1"></i> إضافة إيداع
    </a>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-4">
        <div class="card text-center h-100 border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-coins me-1"></i>إجمالي الإيداعات</div>
                <div class="fw-bold fs-5 text-success">@(((decimal)(ViewBag.Total ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #3b82f6!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-cut me-1"></i>إيداعات الحلاقة</div>
                <div class="fw-bold fs-5" style="color:#3b82f6;">@(((decimal)(ViewBag.TotalBarber ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #8b5cf6!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-spa me-1"></i>إيداعات المساج</div>
                <div class="fw-bold fs-5" style="color:#8b5cf6;">@(((decimal)(ViewBag.TotalMassage ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

@{
    string userDeptFilter = ViewBag.UserDept ?? "";
    bool isRestrictedUser = userDeptFilter == "حلاقة" || userDeptFilter == "مساج";
    var selectedPayment = ViewBag.PaymentMethod as string;
}
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <label class="form-label mb-0">من تاريخ:</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:200px;" />
            <label class="form-label mb-0">إلى تاريخ:</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:200px;" />
            @if (isRestrictedUser)
            {
                <input type="hidden" name="department" value="@userDeptFilter" />
                <span class="ms-2 fw-bold">
                    @if (userDeptFilter == "حلاقة")
                    {
                        <span class="badge bg-primary fs-6"><i class="fas fa-cut me-1"></i>حلاقة</span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6"><i class="fas fa-spa me-1"></i>مساج</span>
                    }
                </span>
            }
            else
            {
                <label class="form-label mb-0 ms-2">القسم:</label>
                <select name="department" class="form-select" style="max-width:160px;">
                    <option value="">-- الكل --</option>
                    @if (ViewBag.FilterDepartment == "حلاقة")
                    {
                        <option value="حلاقة" selected="selected">حلاقة</option>
                    }
                    else
                    {
                        <option value="حلاقة">حلاقة</option>
                    }
                    @if (ViewBag.FilterDepartment == "مساج")
                    {
                        <option value="مساج" selected="selected">مساج</option>
                    }
                    else
                    {
                        <option value="مساج">مساج</option>
                    }
                </select>
            }
            <label class="form-label mb-0 ms-2">طريقة الدفع:</label>
            <select name="paymentMethod" class="form-select" style="max-width:160px;">
                <option value="">الكل</option>
                <option value="نقدي" selected="@(selectedPayment == "نقدي")">نقدي</option>
                <option value="بطاقة" selected="@(selectedPayment == "بطاقة")">بطاقة</option>
                <option value="تحويل بنكي" selected="@(selectedPayment == "تحويل بنكي")">تحويل بنكي</option>
            </select>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>القسم</th>
                        <th>البيان</th>
                        <th>المصدر</th>
                        <th>المبلغ</th>
                        <th>طريقة الدفع</th>
                        <th>التاريخ</th>
                        <th>ملاحظات</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">لا توجد إيداعات في هذه الفترة</td></tr>
                    }
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.Id</td>
                            <td>
                                @if (d.Department == "حلاقة")
                                {
                                    <span class="badge bg-primary"><i class="fas fa-cut me-1"></i>حلاقة</span>
                                }
                                else if (d.Department == "مساج")
                                {
                                    <span class="badge bg-success"><i class="fas fa-spa me-1"></i>مساج</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@d.Department</span>
                                }
                            </td>
                            <td>@d.Description</td>
                            <td>@(d.Source ?? "-")</td>
                            <td><strong class="text-success">@d.Amount.ToString("N3") د.ك</strong></td>
                            <td>@d.PaymentMethod</td>
                            <td>@d.DepositDate.ToString("yyyy/MM/dd")</td>
                            <td class="text-muted small">@d.Notes</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = d.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        onclick="confirmDelete(@d.Id, '@Html.Raw(d.Description.Replace("'", "\\'"))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">الإجمالي</td>
                            <td class="text-success">@ViewBag.Total?.ToString("N3") د.ك</td>
                            <td colspan="4"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف الإيداع:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}