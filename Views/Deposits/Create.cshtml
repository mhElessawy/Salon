@model  Salon.Models.Deposit
@{
    ViewData["Title"] = "إضافة إيداع";
}

<div class="page-header">
    <h1><i class="fas fa-plus-circle me-2"></i>إضافة إيداع جديد</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            @{
                string userDept = ViewBag.UserDept ?? "";
                bool isRestricted = userDept == "حلاقة" || userDept == "مساج";
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Department" class="form-label fw-bold"></label>
                    @if (isRestricted)
                    {
                        <input asp-for="Department" type="hidden" value="@userDept" />
                        <div class="form-control-plaintext fw-bold">
                            @if (userDept == "حلاقة")
                            {
                                <span class="badge bg-primary fs-6"><i class="fas fa-cut me-1"></i>حلاقة</span>
                            }
                            else
                            {
                                <span class="badge bg-success fs-6"><i class="fas fa-spa me-1"></i>مساج</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-3 mt-1">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="Department" id="deptHair" value="حلاقة" checked />
                                <label class="form-check-label" for="deptHair">
                                    <i class="fas fa-cut me-1 text-primary"></i> حلاقة
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="Department" id="deptMassage" value="مساج" />
                                <label class="form-check-label" for="deptMassage">
                                    <i class="fas fa-spa me-1 text-success"></i> مساج
                                </label>
                            </div>
                        </div>
                    }
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" placeholder="مثال: إيداع نقدي من المالك" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Source" class="form-label"></label>
                    <select asp-for="Source" class="form-select">
                        <option value="">-- اختر المصدر --</option>
                        <option>رأس مال</option>
                        <option>إيداع من المالك</option>
                        <option>قرض</option>
                        <option>مبالغ محصلة خارجية</option>
                        <option>أخرى</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Amount" type="number" step="0.001" min="0.001" class="form-control" />
                        <span class="input-group-text">د.ك</span>
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DepositDate" class="form-label"></label>
                    <input asp-for="DepositDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option value="نقدي">نقدي</option>
                        <option value="بطاقة">بطاقة</option>
                        <option value="تحويل بنكي">تحويل بنكي</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-success me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>