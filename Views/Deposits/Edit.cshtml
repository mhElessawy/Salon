@model Salon.Models.Deposit
@{
    ViewData["Title"] = "تعديل الإيداع";
}

<div class="page-header">
    <h1><i class="fas fa-edit me-2"></i>تعديل الإيداع</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Source" class="form-label"></label>
                    <select asp-for="Source" class="form-select">
                        <option value="">-- اختر المصدر --</option>
                        <option>رأس مال</option>
                        <option>إيداع من المالك</option>
                        <option>قرض</option>
                        <option>مبالغ محصلة خارجية</option>
                        <option>أخرى</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Amount" type="number" step="0.001" min="0.001" class="form-control" />
                        <span class="input-group-text">د.ك</span>
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DepositDate" class="form-label"></label>
                    <input asp-for="DepositDate" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-success me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>
