        function submitNewCustomer() {
            var name = document.getElementById('newCustName').value.trim();
            var fullNameEn = document.getElementById('newCustFullNameEn').value.trim();
            var phone = document.getElementById('newCustPhone').value.trim();
            var email = document.getElementById('newCustEmail').value.trim();
            var birthDate = document.getElementById('newCustBirthDate').value;
            var gender = document.getElementById('newCustGender').value;
            var assignedEmp = document.getElementById('newCustAssignedEmployee')?.value || '';
