            var btn = document.getElementById('newCustSubmitBtn');

            if (!name) { errEl.textContent = 'الاسم الكامل مطلوب'; errEl.classList.remove('d-none'); return; }
            errEl.classList.add('d-none');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> جاري الحفظ...';

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var body = new URLSearchParams({
                fullName: name,
                fullNameEn: fullNameEn,
                phone: phone,
                email: email,
                birthDate: birthDate,
                gender: gender,
                assignedEmployeeIdStr: assignedEmp,
                notes: notes,
                department: 'حلاقة',
                __RequestVerificationToken: token
            });

            fetch('/Customers/CreateQuick', {
                method: 'POST', body: body,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                           'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success) {
                    document.getElementById('customerSelect').value = data.id;
                    var nameEl = document.getElementById('customerDisplayName');
                    nameEl.textContent = data.displayName || data.fullName;
                    nameEl.style.color = '#212529';
                    bootstrap.Modal.getInstance(document.getElementById('newCustomerModal')).hide();
                    onCustomerChange(data.id);
                } else {
                    errEl.textContent = (data && data.message) || 'حدث خطأ أثناء الحفظ';
                    errEl.classList.remove('d-none');
                }
            })
            .catch(function(e) {
                errEl.textContent = 'خطأ: ' + e.message;
                errEl.classList.remove('d-none');
            })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-1"></i> حفظ العميل';
            });
        }
    </script>
}