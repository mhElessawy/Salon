        /* ══ Scheduling Sessions ══ */
        var schedEmployees = [
            @foreach (var emp in employees)
            {
                                        <text>{ id: @emp.Id, name: '@Html.Raw(emp.FullName.Replace("'", "\\'"))' },</text>
            }
        ];

        function openScheduleModal() {
            document.getElementById('schedConfirmOverlay').style.display = 'none';
            var rows = document.getElementById('schedSessionRows');
            rows.innerHTML = '';
            for (var i = 1; i <= window._schedRemaining; i++) {
                rows.insertAdjacentHTML('beforeend', buildSchedRow(i));
            }
            document.getElementById('schedSaveStatus').textContent = '';
            new bootstrap.Modal(document.getElementById('scheduleModal')).show();
        }

        function buildSchedRow(num) {
            var empOpts = '<option value="">-- اختياري --</option>';
            schedEmployees.forEach(function(e) {
                empOpts += '<option value="' + e.id + '">' + e.name + '</option>';
            });
            return '<div class="card mb-2 border-0 shadow-sm">' +
                '<div class="card-body p-3">' +
                '<div class="row align-items-center g-2">' +
                '<div class="col-auto" style="text-align:center;">' +
                '<div style="width:38px;height:38px;border-radius:50%;background:#2d5ba3;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;margin:0 auto;">' + num + '</div>' +
                '<div style="font-size:10px;color:#888;margin-top:3px;">جلسة</div></div>' +
                '<div class="col"><label style="font-size:12px;font-weight:600;color:#555;margin-bottom:2px;display:block;">التاريخ والوقت</label>' +
                '<input type="datetime-local" class="form-control form-control-sm sched-date" style="direction:ltr;" /></div>' +
                '<div class="col"><label style="font-size:12px;font-weight:600;color:#555;margin-bottom:2px;display:block;">الحلاق</label>' +
                '<select class="form-select form-select-sm sched-emp">' + empOpts + '</select></div>' +
                '<div class="col"><label style="font-size:12px;font-weight:600;color:#555;margin-bottom:2px;display:block;">ملاحظات</label>' +
                '<input type="text" class="form-control form-control-sm sched-notes" placeholder="اختياري" /></div>' +
                '</div></div></div>';
        }

        function saveScheduledSessions() {
            var rows = document.querySelectorAll('#schedSessionRows .card');
            var appointments = [];
            rows.forEach(function(row) {
                var dateVal = row.querySelector('.sched-date').value;
                if (!dateVal) return;
                var empVal = row.querySelector('.sched-emp').value;
                var notesVal = row.querySelector('.sched-notes').value;
                appointments.push({
                    CustomerId: window._schedCustomerId,
                    EmployeeId: empVal ? parseInt(empVal) : null,
                    AppointmentDate: dateVal,
                    Notes: notesVal || null
                });
            });
            if (!appointments.length) {
                document.getElementById('schedSaveStatus').textContent = '⚠ حدد موعداً واحداً على الأقل';
                return;
            }
            var statusEl = document.getElementById('schedSaveStatus');
            statusEl.textContent = 'جاري الحفظ...';
            fetch('/Appointments/BulkCreate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(appointments)
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.success) {
                    bootstrap.Modal.getInstance(document.getElementById('scheduleModal')).hide();
                    alert('✓ تم حفظ ' + d.count + ' موعد بنجاح');
                } else {
                    statusEl.textContent = '⚠ ' + (d.message || 'حدث خطأ');
                }
            })
            .catch(function(e) { statusEl.textContent = '⚠ ' + e.message; });
        }

        // ===== بحث عميل (popup) =====
        var _custSearchTimer = null;
        var _custModalInstance = null;

        function openCustomerSearchModal(tab) {
            document.getElementById('custSearchInput').value = '';
            document.getElementById('custSearchResults').innerHTML = '';
            document.getElementById('custSearchEmpty').style.display = 'none';
            _resetQuickForm();
            _switchCustTab(tab || 'search');
            _custModalInstance = new bootstrap.Modal(document.getElementById('customerSearchModal'), { backdrop: true, keyboard: true });
            _custModalInstance.show();
            setTimeout(function() {
                var inp = document.getElementById('custSearchInput');
                if (inp) inp.focus();
            }, 400);
        }

        function _switchCustTab(tab) {
            var isSearch = tab === 'search';
            document.getElementById('tabSearch').classList.toggle('active', isSearch);
            document.getElementById('tabRegister').classList.toggle('active', !isSearch);
            if (window.innerWidth < 768) {
                document.getElementById('custSearchPanel').style.display = isSearch ? '' : 'none';
                document.getElementById('custRegisterPanel').style.display = isSearch ? 'none' : '';
            }
        }
        function switchCustTab(tab) { _switchCustTab(tab); }

        function doCustomerSearch(val) {
            clearTimeout(_custSearchTimer);
            var q = val.trim();
            var resultsEl = document.getElementById('custSearchResults');
            var emptyEl = document.getElementById('custSearchEmpty');
            var qName = document.getElementById('qCustName');
            if (qName && !qName.dataset.manualEdit) qName.value = val;
            if (q.length < 1) { resultsEl.innerHTML = ''; emptyEl.style.display = 'none'; return; }
            _custSearchTimer = setTimeout(function() {
                resultsEl.innerHTML = '<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin fa-lg"></i></div>';
                emptyEl.style.display = 'none';
                fetch('/Customers/SearchJson?q=' + encodeURIComponent(q) + '&dept=حلاقة')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (!data.length) { resultsEl.innerHTML = ''; emptyEl.style.display = ''; return; }
                        var html = '';
                        data.forEach(function(c) {
                            html += '<div class="cust-card d-flex align-items-center gap-2"'
                                  + ' data-cust-id="' + c.id + '"'
                                  + ' data-cust-name="' + _escAttr(c.displayName) + '">'
                                  + '<div style="flex:1;min-width:0;">'
                                  + '<div class="cust-name">' + _escHtml(c.fullName) + '</div>'
                                  + '<div class="cust-phone">' + _escHtml(c.phone) + '</div>'
                                  + '<div class="cust-meta">'
                                  + (c.lastVisit ? 'آخر خدمة: ' + c.lastVisit + ' &nbsp;|&nbsp; ' : '')
                                  + 'نقاط الولاء: ' + c.visitCount
                                  + '</div></div>'
                                  + '<span class="cust-select-btn">اختيار</span>'
                                  + '</div>';
                        });
                        resultsEl.innerHTML = html;
                    })
                    .catch(function() { resultsEl.innerHTML = '<div class="text-danger text-center py-2">حدث خطأ في البحث</div>'; });
            }, 300);
        }

        // event delegation — مسجّل مرة واحدة عند تحميل الصفحة
        document.addEventListener('DOMContentLoaded', function() {
            // اختيار عميل من نتائج البحث
            document.getElementById('custSearchResults').addEventListener('click', function(e) {
                var card = e.target.closest('[data-cust-id]');
                if (!card) return;
                _pickCustomer(parseInt(card.dataset.custId), card.dataset.custName);
            });

            // toggle إكمال البيانات لاحقاً
            var laterToggle = document.getElementById('qCustLater');
            if (laterToggle) {
                laterToggle.addEventListener('change', function() {
                    document.getElementById('qCustExtraFields').style.display = this.checked ? 'none' : '';
                    document.getElementById('qCustSavedHint').style.display = this.checked ? '' : 'none';
                });
                laterToggle.dispatchEvent(new Event('change'));
            }
            var qName = document.getElementById('qCustName');
            if (qName) qName.addEventListener('input', function() { this.dataset.manualEdit = '1'; });
        });

        function _pickCustomer(id, displayName) {
            // 1. ضبط القيم
            document.getElementById('customerSelect').value = id;
            var nameEl = document.getElementById('customerDisplayName');
            nameEl.textContent = displayName;
            nameEl.style.color = '#212529';
            // 2. إغلاق الـ modal
            if (_custModalInstance) {
                _custModalInstance.hide();
            } else {
                var modalEl = document.getElementById('customerSearchModal');
                var m = bootstrap.Modal.getInstance(modalEl);
                if (m) m.hide();
            }
            // 3. تحميل باقات العميل
            onCustomerChange(id);
            updateCustomerWarning();
        }

        function clearCustomerSelection() {
            document.getElementById('customerSelect').value = '';
            var nameEl = document.getElementById('customerDisplayName');
            nameEl.textContent = 'زائر';
            nameEl.style.color = '#6c757d';
            if (_custModalInstance) _custModalInstance.hide();
            onCustomerChange('');
            updateCustomerWarning();
        }

        function _resetQuickForm() {
            document.getElementById('qCustName').value = '';
            document.getElementById('qCustPhone').value = '';
            document.getElementById('qCustLater').checked = true;
            document.getElementById('qCustExtraFields').style.display = 'none';
            document.getElementById('qCustSavedHint').style.display = 'none';
            document.getElementById('qCustError').classList.add('d-none');
            delete document.getElementById('qCustName').dataset.manualEdit;
        }

        function _escHtml(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }
        function _escAttr(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/"/g,'&quot;');
        }

        function submitQuickCustomer() {
            var name = document.getElementById('qCustName').value.trim();
            var phone = document.getElementById('qCustPhone').value.trim();
            var errEl = document.getElementById('qCustError');
            errEl.classList.add('d-none');
            if (!name) { errEl.textContent = 'الاسم مطلوب'; errEl.classList.remove('d-none'); return; }
            if (!phone) { errEl.textContent = 'رقم الهاتف مطلوب'; errEl.classList.remove('d-none'); return; }
            var later = document.getElementById('qCustLater').checked;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var body = new URLSearchParams({
                fullName: name, phone: phone,
                fullNameEn: later ? '' : (document.getElementById('qCustFullNameEn').value.trim()),
                email:     later ? '' : (document.getElementById('qCustEmail').value.trim()),
                birthDate: later ? '' : (document.getElementById('qCustBirthDate').value),
                gender:    later ? '' : (document.getElementById('qCustGender').value),
                department: 'حلاقة',
                __RequestVerificationToken: token
            });
            fetch('/Customers/CreateQuick', { method:'POST', body:body,
                headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'} })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success) {
                    _pickCustomer(data.id, data.displayName || data.fullName);
                } else {
                    errEl.textContent = (data && data.message) || 'حدث خطأ';
                    errEl.classList.remove('d-none');
                }
            })
            .catch(function(e) { errEl.textContent = 'خطأ: ' + e.message; errEl.classList.remove('d-none'); });
        }

