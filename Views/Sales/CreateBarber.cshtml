@model Salon.Models.Sale
@{
    ViewData["Title"] = "نقطة البيع (الكاشير)";
    var categories = ViewBag.ServiceCategories as List<Salon.Models.ServiceCategory> ?? new();
    var employees = ViewBag.Employees as List<Salon.Models.Employee> ?? new();
    var isEmployee = (bool)(ViewBag.IsEmployee ?? false);
    var salesCount = ViewBag.ServiceSalesCount as Dictionary<int, int> ?? new();
    var linkedEmpId = ViewBag.LinkedEmployeeId as int?;
    var queuePositions = ViewBag.EmployeeQueuePositions as Dictionary<int, int> ?? new();
    var checkInTimes = ViewBag.EmployeeCheckInTimes as Dictionary<int, TimeSpan?> ?? new();
    var canDiscount = (bool)(ViewBag.CanDiscount ?? true);
    var canCustomerDebt = (bool)(ViewBag.CanCustomerDebt ?? true);
    var presentEmpIds = ViewBag.PresentEmpIds as List<int> ?? new();

    // Employee whose turn it is = lowest queue position
    int onDutyEmpId = queuePositions.Any()
        ? queuePositions.OrderBy(x => x.Value).First().Key
        : 0;

    var firstEmpId = employees.FirstOrDefault()?.Id ?? 0;
    var autoSelectEmpId = isEmployee && linkedEmpId.HasValue ? linkedEmpId.Value : firstEmpId;
}

@section Styles {
    <style>
        :root {
            --dept-color: #F7941D;
            --dept-light: #fff8f0;
            --emp-blue: #2d5ba3;
            --emp-dark: #1b3d6e;
            --emp-green: #219150;
            --emp-green-dark: #196e3d;
        }

        /* ── Page header ── */
        .pos-page-header {
            text-align: right;
            margin-bottom: 12px;
        }

            .pos-page-header h1 {
                font-size: 22px;
                font-weight: 700;
                color: var(--text-dark);
                margin: 0 0 2px;
            }

            .pos-page-header p {
                color: #6c757d;
                font-size: 13px;
                margin: 0;
            }

        /* ── Top info bar ── */
        .pos-info-bar {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            padding: 14px 16px;
            margin-bottom: 12px;
        }

        .pos-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
        }

        .extra-payment-bar {
            background: #fff8f0;
            border-radius: 8px;
            padding: 12px;
            border: 1px solid #ffd9b3;
            margin-top: 10px;
        }

        /* ── 3-column main grid (RTL: col1→right, col2→mid, col3→left) ── */
        .pos-wrapper {
            display: grid;
            grid-template-columns: 260px 1fr 330px;
            gap: 12px;
            align-items: start;
        }

        /* ════════════════════════════════════════
                                                                       COLUMN 1 (RIGHT in RTL) — Employees
                                                                    ════════════════════════════════════════ */
        .pos-employees-panel {
            background: var(--emp-dark);
            border-radius: 12px;
            overflow: hidden;
            position: sticky;
            top: 70px;
            max-height: calc(100vh - 110px);
            display: flex;
            flex-direction: column;
        }

        .emp-header {
            background: var(--emp-dark);
            color: #fff;
            padding: 12px 14px;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
        }

        .emp-toggle-bar {
            background: rgba(255,255,255,.08);
            padding: 7px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: rgba(255,255,255,.85);
            font-size: 12px;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

        .badge-locked {
            background: #27ae60;
            color: #fff;
            padding: 2px 9px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

        .emp-list {
            overflow-y: auto;
            flex: 1;
        }

        .emp-item {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-bottom: 1px solid rgba(255,255,255,.07);
            cursor: pointer;
            color: #fff;
            transition: filter .15s;
            gap: 8px;
            background: var(--emp-blue); /* default = blue */
        }

            .emp-item.on-duty {
                background: var(--emp-green);
            }

            .emp-item:hover {
                filter: brightness(1.12);
            }

        .emp-queue-num {
            background: rgba(0,0,0,.2);
            color: #fff;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .emp-info {
            flex: 1;
            text-align: right;
        }

        .emp-name {
            font-size: 13px;
            font-weight: 600;
        }

        .emp-time {
            font-size: 10px;
            color: rgba(255,255,255,.65);
            display: flex;
            align-items: center;
            gap: 3px;
            justify-content: flex-end;
            margin-top: 1px;
        }

        .emp-check {
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            flex-shrink: 0;
            width: 16px;
            text-align: center;
            opacity: 0;
        }

        .emp-item.emp-selected .emp-check {
            opacity: 1;
        }

        .emp-item.emp-absent {
            background: rgba(45, 91, 163, 0.45);
            opacity: 0.72;
        }

        /* ════════════════════════════════════════
                                                                       COLUMN 2 (MIDDLE) — Services
                                                                    ════════════════════════════════════════ */
        .pos-services-panel {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .pos-search {
            padding: 8px 10px;
            border-bottom: 1px solid #f0f0f0;
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
            font-size: 13px;
            pointer-events: none;
        }

        .pos-search input {
            width: 100%;
            padding: 7px 10px 7px 32px;
            border: 1px solid #e9ecef;
            border-radius: 7px;
            font-size: 13px;
            background: #f8f9fa;
            direction: rtl;
        }

            .pos-search input:focus {
                outline: none;
                border-color: var(--dept-color);
                background: #fff;
            }

        .services-scroll {
            padding: 10px;
            overflow-y: auto;
            max-height: calc(100vh - 280px);
        }

        .cat-label {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 0 5px;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 6px;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 6px;
            margin-bottom: 10px;
        }

        .svc-card {
            background: #fff;
            border: 1.5px solid #e9ecef;
            border-radius: 8px;
            padding: 8px 6px;
            cursor: pointer;
            transition: all .16s;
            text-align: center;
        }

            .svc-card:hover {
                border-color: var(--dept-color);
                background: var(--dept-light);
                transform: translateY(-1px);
                box-shadow: 0 2px 8px rgba(247,148,29,.15);
            }

        .svc-name {
            font-size: 11px;
            font-weight: 600;
            color: #333;
            margin-bottom: 4px;
            line-height: 1.3;
        }

        .svc-price {
            font-size: 11px;
            font-weight: 700;
            color: var(--dept-color);
        }

        /* ════════════════════════════════════════
                                                                       COLUMN 3 (LEFT in RTL) — Cart / Invoice
                                                                    ════════════════════════════════════════ */
        .pos-cart-panel {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 10px rgba(0,0,0,.07);
            overflow: hidden;
            position: sticky;
            top: 70px;
        }

        .cart-header {
            background: var(--dept-color);
            color: #fff;
            padding: 11px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            font-weight: 700;
        }

        .invoice-items {
            min-height: 90px;
            max-height: 280px;
            overflow-y: auto;
        }

            .invoice-items table {
                width: 100%;
                font-size: 12px;
            }

            .invoice-items thead th {
                background: #f8f9fa;
                padding: 6px 8px;
                font-size: 11px;
                color: #6c757d;
            }

            .invoice-items tbody td {
                padding: 6px 8px;
                border-bottom: 1px solid #f0f0f0;
                vertical-align: middle;
            }

        .invoice-empty {
            text-align: center;
            padding: 22px 16px;
            color: #adb5bd;
            font-size: 12px;
        }

        .invoice-totals {
            padding: 10px 14px;
            border-top: 1px solid #f0f0f0;
            background: #fafafa;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 0;
            font-size: 13px;
        }

            .total-row.net {
                font-size: 15px;
                font-weight: 700;
                color: var(--dept-color);
                border-top: 2px solid #e9ecef;
                padding-top: 8px;
                margin-top: 4px;
            }

        .discount-input {
            width: 80px;
            text-align: center;
            border: 1px dashed #ccc;
            border-radius: 6px;
            padding: 3px 5px;
            font-size: 12px;
        }

            .discount-input:focus {
                outline: none;
                border-color: var(--dept-color);
            }

        .payment-btn-group {
            padding: 10px 12px 8px;
            background: #fff8f0;
            border-top: 1px solid #f0d090;
        }

        .payment-btn-label {
            font-size: 11px;
            font-weight: 700;
            color: #888;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .payment-btns {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .pay-btn {
            flex: 1 1 auto;
            min-width: calc(33% - 6px);
            padding: 6px 8px;
            font-size: 12px;
            font-weight: 600;
            border: 2px solid #ddd;
            border-radius: 8px;
            background: #fff;
            color: #555;
            cursor: pointer;
            transition: all .18s;
            text-align: center;
            white-space: nowrap;
        }

            .pay-btn:hover {
                border-color: var(--dept-color);
                color: var(--dept-color);
            }

            .pay-btn.active {
                background: var(--dept-color);
                border-color: var(--dept-color);
                color: #fff;
            }

        .btn-save-invoice {
            width: 100%;
            padding: 12px;
            background: var(--dept-color);
            color: #fff;
            border: none;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s;
        }

            .btn-save-invoice:hover {
                background: #e0841a;
            }

            .btn-save-invoice:disabled {
                background: #adb5bd;
                cursor: not-allowed;
            }


        .qty-btn:hover {
            background: var(--dept-color);
            color: #fff;
            border-color: var(--dept-color);
        }

        .qty-input {
            width: 28px;
            text-align: center;
            border: 1px solid #dee2e6;
            border-radius: 3px;
            font-size: 12px;
            padding: 1px;
        }

        .btn-remove-item {
            background: none;
            border: none;
            color: #dc3545;
            cursor: pointer;
            font-size: 12px;
            padding: 2px 4px;
            border-radius: 3px;
        }

            .btn-remove-item:hover {
                background: #fce4ec;
            }

        /* ── Responsive ── */
        @@media (max-width:1100px) {
            .pos-wrapper {
                grid-template-columns: 220px 1fr 300px;
            }
        }

        @@media (max-width:900px) {
            .pos-wrapper {
                grid-template-columns: 1fr;
            }

            .pos-employees-panel, .pos-cart-panel {
                position: static;
                max-height: none;
            }

            .services-grid {
                grid-template-columns: repeat(3,1fr);
            }

            .pos-info-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width:576px) {
            .services-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .pos-info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Header -->
<div class="pos-page-header">
    <h1>نقطة البيع (الكاشير)</h1>
    <p>إدارة المبيعات والفواتير</p>
</div>

<!-- مودال تنبيه الخدمة المكررة -->
<div id="dupModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.45);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:14px;padding:28px 32px;max-width:360px;width:90%;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.2);">
        <div style="font-size:40px;margin-bottom:10px;">⚠️</div>
        <p id="dupModalMsg" style="font-size:15px;font-weight:600;margin-bottom:20px;color:#333;"></p>
        <button type="button" onclick="closeDupModal()"
                style="background:var(--dept-color);color:#fff;border:none;border-radius:8px;padding:9px 36px;font-size:15px;font-weight:700;cursor:pointer;">
            موافق
        </button>
    </div>
</div>

<form asp-action="CreateBarber" method="post" id="posForm">
    @Html.AntiForgeryToken()
    <input asp-for="InvoiceNumber" type="hidden" />
    <input asp-for="SaleType" type="hidden" value="حلاقة" />
    <input type="hidden" id="selectedEmployeeId" name="EmployeeId" value="@(autoSelectEmpId > 0 ? autoSelectEmpId.ToString() : "")" />
    <input type="hidden" id="customerPackageId" name="customerPackageId" value="" />
    <input type="hidden" id="packagePaymentAmount" name="packagePaymentAmount" value="0" />
    <div id="hiddenItems"></div>

    <!-- ══ Top: Customer / Payment / Notes ══ -->
    <div class="pos-info-bar">
        <div class="pos-info-grid">
            <div>
                <label class="form-label">العميل</label>
                <select name="CustomerId" id="customerSelect" asp-items="@ViewBag.Customers"
                        class="form-select form-select-sm" onchange="onCustomerChange(this.value)">
                    <option value="">👤 زائر</option>
                </select>
                <small id="customerDebtWarning" class="text-danger mt-1" style="display:none">
                    <i class="fas fa-exclamation-circle me-1"></i>يتطلب اختيار عميل مسجل
                </small>
                <!-- ── باقات العميل ── -->
                <div id="customerPackagesArea" style="display:none; margin-top:8px;"></div>
                <!-- زر تعيين باقة -->
                <div id="assignPackageBtnWrap" style="display:none; margin-top:6px;">
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            onclick="openAssignPackageModal()"
                            style="font-size:11px;padding:3px 10px;">
                        <i class="fas fa-plus-circle me-1"></i>تعيين باقة لهذا العميل
                    </button>
                </div>
            </div>
            <div>
                <input type="hidden" asp-for="PaymentMethod" id="paymentMethodSelect" value="كاش" />
            </div>
            <div>
                <label class="form-label">ملاحظات</label>
                <textarea name="Notes" id="notesInput" class="form-control form-control-sm" rows="1"></textarea>
            </div>
        </div>

        <div id="extraPaymentBar" style="display:none" class="extra-payment-bar">
            <div id="debtEmpSection" style="display:none">
                <p class="mb-2 fw-semibold" style="font-size:13px">
                    <i class="fas fa-user-tag me-1 text-danger"></i>بيانات الدين
                </p>
                <label class="form-label mb-1" style="font-size:12px">اسم الموظف المدين <span class="text-danger">*</span></label>
                <select name="DebtEmployeeId" id="debtEmployeeSelect" class="form-select form-select-sm" style="max-width:260px;">
                    <option value="">-- اختر الموظف --</option>
                    @foreach (var emp in ViewBag.AllEmployees as IEnumerable<Salon.Models.Employee> ?? Enumerable.Empty<Salon.Models.Employee>())
                    {
                        <option value="@emp.Id">@emp.FullName</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- ══ 3-Column Grid ══ -->
    <div class="pos-wrapper">

        <!-- ── Col 1 (RIGHT in RTL): Employee Queue ── -->
        <div class="pos-employees-panel">
            <div class="emp-header">
                <i class="fas fa-user-tie"></i> الموظفين
            </div>
            <div class="emp-toggle-bar">
                <span class="badge-locked">مقفل</span>
                <span>توزيع تلقائي</span>
            </div>
            <div class="emp-list">
                @if (!employees.Any())
                {
                    <div class="text-center py-3" style="color:rgba(255,255,255,.6);font-size:13px">
                        <i class="fas fa-user-slash mb-1 d-block"></i>
                        لا يوجد موظفون
                    </div>
                }
                @foreach (var emp in employees)
                {
                    var isPresent = presentEmpIds.Contains(emp.Id);
                    var qPos = queuePositions.TryGetValue(emp.Id, out var p) ? p.ToString() : "—";
                    var tSpan = checkInTimes.TryGetValue(emp.Id, out var t) && t.HasValue ? t.Value : (TimeSpan?)null;
                    var timeStr = tSpan.HasValue ? tSpan.Value.ToString(@"hh\:mm") : "—";

                    var isOnDuty = emp.Id == onDutyEmpId;
                    var isSelected = emp.Id == autoSelectEmpId;

                    var rowClass = "emp-item" +
                    (isOnDuty ? " on-duty" : "") +
                    (!isPresent ? " emp-absent" : "") +
                    (isSelected ? " emp-selected" : "");
                    <div class="@rowClass"
                         id="emp-@emp.Id"
                         onclick="selectEmployee(@emp.Id, this)">
                        <div class="emp-info">
                            <div class="emp-name">@emp.FullName</div>
                            <div class="emp-time">
                                <i class="fas fa-clock" style="font-size:9px"></i> @timeStr
                            </div>
                        </div>
                        <div class="emp-queue-num">@qPos</div>
                        <div class="emp-check" id="check-@emp.Id">✓</div>
                    </div>
                }
            </div>
        </div>

        <!-- ── Col 2 (MIDDLE): Services ── -->
        <div class="pos-services-panel">
            <div class="pos-search">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="svcSearch" placeholder="ابحث..." oninput="filterItems(this.value)" />
            </div>

            <!-- Services -->
            <div class="services-scroll" id="servicesContent">
                @if (!categories.Any(c => c.Services.Any()))
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-cut fa-3x mb-3 opacity-25"></i>
                        <p>لا توجد خدمات حلاقة مسجلة</p>
                        <a href="@Url.Action("Create", "Services")" class="btn btn-sm btn-outline-warning">إضافة خدمة</a>
                    </div>
                }
                @foreach (var cat in categories)
                {
                    if (!cat.Services.Any()) continue;
                    <div class="cat-label" style="color:@(cat.Color ?? "#F7941D")">
                        <i class="@(cat.Icon ?? "fas fa-cut") me-1"></i>@cat.Name
                    </div>
                    <div class="services-grid">
                        @foreach (var svc in cat.Services.OrderByDescending(s => salesCount.TryGetValue(s.Id, out var c) ? c : 0).ThenBy(s => s.Name))
                        {
                            <div class="svc-card svc-item" data-name="@svc.Name.ToLower()"
                                 onclick="addItem(@svc.Id,'@Html.Raw(svc.Name.Replace("'", "\\\'"))',@svc.Price.ToString("F3"))">
                                <div class="svc-name">@svc.Name</div>
                                <div class="svc-price">@svc.Price.ToString("N3") د.ك</div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        <!-- ── Col 3 (LEFT in RTL): Cart / Invoice ── -->
        <div class="pos-cart-panel">
            <div class="cart-header">
                <span><i class="fas fa-shopping-cart me-1"></i> الخدمات المختارة</span>
                <span style="font-size:11px;opacity:.9">@Model.InvoiceNumber</span>
            </div>
            <div class="invoice-items">
                <table>
                    <thead>
                        <tr>
                            <th>الخدمة</th>
                            <th>السعر</th>
                            <th>الإجمالي</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="invoiceBody">
                        <tr id="emptyRow">
                            <td colspan="4" class="invoice-empty">
                                <i class="fas fa-hand-point-right mb-1 d-block"></i>اختر خدمة
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="invoice-totals">
                <div class="total-row">
                    <span>الإجمالي:</span><span id="subtotalDisplay">0.000 د.ك</span>
                </div>
                <div class="total-row" id="pkgPayTotalRow" style="display:none;color:#1a6fc4;font-size:12px;">
                    <span><i class="fas fa-box-open me-1"></i>دفع الباقة:</span>
                    <span id="pkgPayTotalDisplay">0.000 د.ك</span>
                </div>
                @if (canDiscount)
                {
                    <div class="total-row">
                        <span>الخصم:</span>
                        <input type="number" name="Discount" id="discountInput" class="discount-input"
                               value="0" step="0.001" min="0" oninput="recalc()" />
                    </div>
                }
                else
                {
                    <input type="hidden" name="Discount" id="discountInput" value="0" />
                }
                <div class="total-row net">
                    <span>الصافي:</span><span id="netDisplay">0.000 د.ك</span>
                </div>
                <div class="total-row" style="border-top:1px dashed #f0d090;padding-top:8px;margin-top:4px;">
                    <span style="color:#e67e22;font-size:12px;"><i class="fas fa-hand-holding-usd me-1"></i>عمولة خدمة للموظف:</span>
                    <input type="number" name="EmployeeGift" id="giftInput" class="discount-input"
                           value="" step="0.001" min="0" placeholder="0.000"
                           style="border-color:#f0d090;width:90px;" />
                </div>
                <div class="total-row" style="border-top:1px dashed #e74c3c;padding-top:8px;margin-top:4px;">
                    <span style="color:#c0392b;font-size:12px;"><i class="fas fa-gift me-1"></i>هدية للموظف:</span>
                    <input type="number" name="GiftForEmployee" id="hadiyaInput" class="discount-input"
                           value="" step="0.001" min="0" placeholder="0.000"
                           style="border-color:#e74c3c;width:90px;" oninput="recalc()" />
                </div>
                <div id="hadiyaTotalRow" style="display:none;border-top:2px solid #c0392b;margin-top:6px;padding-top:6px;">
                    <div class="total-row" style="font-size:14px;font-weight:700;color:#c0392b;">
                        <span><i class="fas fa-hand-holding-usd me-1"></i>إجمالي التحصيل من العميل:</span>
                        <span id="totalCollectDisplay" style="background:#fdf2f2;padding:2px 8px;border-radius:4px;border:1px solid #e74c3c;">0.000 د.ك</span>
                    </div>
                    <div style="font-size:10px;color:#888;text-align:left;margin-top:2px;">
                        <i class="fas fa-info-circle me-1"></i>الهدية تُصرف للموظف مع الراتب
                    </div>
                </div>
            </div>

            <!-- ══ قسم دفع ثمن الباقة (يظهر عند وجود رصيد غير مدفوع) ══ -->
            <div id="packagePaymentSection" style="display:none;padding:10px 14px;background:#e8f4fd;border-top:2px solid #1a6fc4;">
                <div style="font-size:12px;font-weight:700;color:#1a6fc4;margin-bottom:6px;">
                    <i class="fas fa-box-open me-1"></i>دفع ثمن الباقة
                    <span style="font-size:10px;font-weight:400;color:#888;margin-right:6px;">(الباقة لم تُدفع بعد)</span>
                </div>
                <div id="packageBalanceInfo" style="font-size:11px;color:#444;margin-bottom:8px;line-height:1.8;background:#fff;padding:6px 10px;border-radius:6px;border:1px solid #bee3f8;"></div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label style="font-size:12px;font-weight:600;white-space:nowrap;margin:0;">المبلغ المدفوع الآن:</label>
                    <div class="input-group input-group-sm" style="width:170px;">
                        <input type="number" id="pkgPayInput" step="0.001" min="0"
                               placeholder="0.000" class="form-control form-control-sm text-center"
                               oninput="onPackagePaymentChange(this.value)" />
                        <span class="input-group-text" style="font-size:11px;">د.ك</span>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block" style="font-size:10px;">
                    <i class="fas fa-info-circle me-1"></i>يمكن دفع المبلغ كاملاً أو جزء منه — اختر طريقة الدفع أدناه
                </small>
            </div>

            <!-- ══ Payment Method Buttons ══ -->
            <div class="payment-btn-group">
                <div class="payment-btn-label">طريقة الدفع</div>
                <div class="payment-btns">
                    <button type="button" class="pay-btn active" data-value="كاش" onclick="selectPayment(this)">
                        <i class="fas fa-money-bill-wave"></i> كاش
                    </button>
                    <button type="button" class="pay-btn" data-value="كي نت" onclick="selectPayment(this)">
                        <i class="fas fa-credit-card"></i> كي نت
                    </button>
                    <button type="button" class="pay-btn" data-value="كي نت و كاش" onclick="selectPayment(this)">
                        <i class="fas fa-exchange-alt"></i> كي نت و كاش
                    </button>
                    @if (canCustomerDebt)
                    {
                        <button type="button" class="pay-btn" data-value="دين على العميل" onclick="selectPayment(this)">
                            <i class="fas fa-user-clock"></i> دين على العميل
                        </button>
                    }
                    <button type="button" class="pay-btn" data-value="دين على الموظف" onclick="selectPayment(this)">
                        <i class="fas fa-user-tag"></i> دين على الموظف
                    </button>
                    <button type="button" class="pay-btn" data-value="دين على صاحب المكان" onclick="selectPayment(this)">
                        <i class="fas fa-building"></i> دين على صاحب المكان
                    </button>
                    <button type="button" class="pay-btn pay-btn-package" id="packagePayBtn"
                            data-value="باقة" onclick="selectPayment(this)" style="display:none;border-color:#1a6fc4;color:#1a6fc4;">
                        <i class="fas fa-box-open"></i> باقة
                    </button>
                </div>
            </div>
            <!-- تفاصيل الدفع المختلط -->
            <div id="splitSection" style="display:none;padding:10px 14px;background:#fff8f0;border-top:2px solid #f0a500;">
                <p class="mb-2 fw-semibold" style="font-size:13px">
                    <i class="fas fa-exchange-alt me-1 text-warning"></i>تفاصيل الدفع المختلط
                </p>
                <div class="d-flex gap-3 align-items-end flex-wrap">
                    <div>
                        <label class="form-label mb-1" style="font-size:12px">مبلغ الكاش</label>
                        <input type="number" name="CashAmount" id="cashAmountInput" class="form-control form-control-sm"
                               step="0.001" min="0" placeholder="0.000" oninput="validateSplit()" style="width:130px" />
                    </div>
                    <div>
                        <label class="form-label mb-1" style="font-size:12px">مبلغ كي نت</label>
                        <input type="number" name="LinkAmount" id="linkAmountInput" class="form-control form-control-sm"
                               step="0.001" min="0" placeholder="0.000" oninput="validateSplit()" style="width:130px" />
                    </div>
                    <small id="splitStatus" class="text-muted align-self-end pb-1"></small>
                </div>
            </div>

            <button type="submit" class="btn-save-invoice" id="saveBtn" disabled>
                <i class="fas fa-print me-2"></i> إتمام العملية
            </button>
        </div>

    </div><!-- /pos-wrapper -->
</form>

<!-- ══ Print Invoice Modal ══ -->
<div class="modal fade" id="printModal" tabindex="-1" aria-labelledby="printModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;overflow:hidden;">
            <div class="modal-header" style="background:#1a1a2e;color:#fff;padding:14px 20px;">
                <h6 class="modal-title mb-0 fw-bold" id="printModalLabel">
                    <i class="fas fa-print me-2"></i>طباعة الفاتورة
                </h6>
                <div class="d-flex gap-2 ms-auto">
                    <button type="button" onclick="printInvoice()" class="btn btn-sm btn-light px-3">
                        <i class="fas fa-print me-1"></i>طباعة
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" onclick="closeModal()"></button>
                </div>
            </div>
            <div class="modal-body p-0" style="height:70vh;">
                <iframe id="printFrame" style="width:100%;height:100%;border:none;" src=""></iframe>
            </div>
            <div class="modal-footer" style="gap:8px;justify-content:center;padding:12px;">
                <button type="button" class="btn btn-primary px-5" onclick="printInvoice()">
                    <i class="fas fa-print me-2"></i>طباعة
                </button>
                <button type="button" class="btn btn-secondary px-5" data-bs-dismiss="modal" onclick="closeModal()">
                    <i class="fas fa-times me-2"></i>إغلاق
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══ Modal: تعيين باقة للعميل ══ -->
<div class="modal fade" id="assignPackageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header" style="background:#1a6fc4;color:#fff;">
                <h6 class="modal-title fw-bold mb-0">
                    <i class="fas fa-box-open me-2"></i>تعيين باقة للعميل
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">العميل</label>
                    <input type="text" id="assignCustomerName" class="form-control" readonly
                           style="background:#f8f9fa;font-weight:600;" />
                    <input type="hidden" id="assignCustomerId" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold mb-2">اختر الباقة <span class="text-danger">*</span></label>
                    <div id="assignPackageCards" style="display:flex;flex-wrap:wrap;gap:10px;max-height:320px;overflow-y:auto;padding:4px 2px;">
                        @{
                            var barberPkgs = ViewBag.AvailablePackages as IEnumerable<Salon.Models.ServicePackage> ?? Enumerable.Empty<Salon.Models.ServicePackage>();
                        }
                        @foreach (var p in barberPkgs)
                        {
                            <div class="assign-pkg-card" id="apc-@p.Id"
                                 onclick="selectAssignCard(@p.Id, '@Html.Raw(p.NameAr.Replace("'", "\\\'"))', @p.Price.ToString(System.Globalization.CultureInfo.InvariantCulture), @p.SessionCount, @p.ValidityDays)"
                                 style="border:2px solid #dee2e6;border-radius:12px;background:#fff;padding:12px 16px;
                                                        cursor:pointer;min-width:170px;flex:1;max-width:230px;transition:all .2s;text-align:right;
                                                        box-shadow:0 1px 4px rgba(0,0,0,.06);">
                                <div style="font-weight:700;font-size:13px;color:#1a6fc4;margin-bottom:6px;">
                                    <i class="fas fa-box-open me-1"></i>@p.NameAr
                                </div>
                                <div style="font-size:11px;color:#666;margin-bottom:6px;display:flex;gap:8px;flex-wrap:wrap;">
                                    <span><i class="fas fa-list-ol me-1 text-primary"></i>@p.SessionCount جلسة</span>
                                    <span><i class="fas fa-clock me-1 text-warning"></i>@p.ValidityDays يوم</span>
                                </div>
                                <div style="font-size:18px;font-weight:800;color:#198754;">
                                    @p.Price.ToString("N3") <small style="font-size:11px;font-weight:600;">د.ك</small>
                                </div>
                            </div>
                        }
                        @if (!barberPkgs.Any())
                        {
                            <div style="text-align:center;padding:30px;color:#aaa;width:100%;">
                                <i class="fas fa-box-open fa-2x mb-2 d-block"></i>لا توجد باقات متاحة
                            </div>
                        }
                    </div>
                </div>
                <div id="assignSelectedInfo" class="alert alert-success py-2 px-3 d-none small">
                    <i class="fas fa-check-circle me-1"></i>
                    تم اختيار: <strong id="assignSelectedInfoText"></strong>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold">ملاحظات</label>
                    <input type="text" id="assignNotes" class="form-control" placeholder="اختياري" />
                </div>
                <div id="assignError" class="alert alert-danger py-2 d-none small mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary px-4" id="assignPackageSubmit"
                        onclick="submitAssignPackage()">
                    <i class="fas fa-save me-1"></i> تعيين الباقة
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
            let items = [], rowId = 0;

            @if (isEmployee && linkedEmpId.HasValue)
            {
                                                <text>
                                                document.querySelectorAll('.emp-item').forEach(function(el) {
                                                    el.style.cursor = 'default';
                                                    el.onclick = null;
                                                });
                                                </text>
            }

            function selectEmployee(id, el) {
                @if (isEmployee)
                {
                                                <text>return;</text>
                }
                document.querySelectorAll('.emp-item').forEach(function(e) { e.classList.remove('emp-selected'); });
                el.classList.add('emp-selected');
                document.getElementById('selectedEmployeeId').value = id;
            }

        function showDupModal(name) {
                document.getElementById('dupModalMsg').textContent = 'تنبيه: "' + name + '" مضافة أكثر من مرة';
                document.getElementById('dupModal').style.display = 'flex';
            }
            function closeDupModal() {
                document.getElementById('dupModal').style.display = 'none';
            }

            function addItem(id, name, price) {
                price = parseFloat(price) || 0;
                // تنبيه إذا الخدمة موجودة مسبقاً
                if (items.some(function(i) { return i.id === id; })) {
                    showDupModal(name);
                }
                // دائماً أضف سطراً جديداً مستقلاً
                var it = { rowId:++rowId, id:id, name:name, price:price, qty:1, total:price };
                items.push(it);
                renderRow(it);
                document.getElementById('emptyRow').style.display = 'none';
                document.getElementById('saveBtn').disabled = false;
                recalc();
            }
            function renderRow(it) {
                var tr = document.createElement('tr'); tr.id = 'row-' + it.rowId;
                tr.innerHTML = buildHtml(it);
                document.getElementById('invoiceBody').appendChild(tr);
            }
            function buildHtml(it) {
                return '<td>' + it.name + '</td>' +
                    '<td>' + it.price.toFixed(3) + '</td>' +
                    '<td><strong>' + it.total.toFixed(3) + '</strong></td>' +
                    '<td><button type="button" class="btn-remove-item" onclick="removeItem(' + it.rowId + ')"><i class="fas fa-times"></i></button></td>';
            }
            function removeItem(rid) {
                items = items.filter(function(i) { return i.rowId !== rid; });
                var tr = document.getElementById('row-' + rid); if (tr) tr.remove();
                if (!items.length) {
                    document.getElementById('emptyRow').style.display = '';
                    document.getElementById('saveBtn').disabled = true;
                }
                recalc();
            }
            function recalc() {
                var s = items.reduce(function(a,i) { return a + i.total; }, 0);
                var d = parseFloat(document.getElementById('discountInput').value) || 0;
                var pkgPay = parseFloat(document.getElementById('packagePaymentAmount').value) || 0;
                var hadiya = parseFloat(document.getElementById('hadiyaInput').value) || 0;
                document.getElementById('subtotalDisplay').textContent = s.toFixed(3) + ' د.ك';
                // سطر دفع الباقة
                var pkgRow = document.getElementById('pkgPayTotalRow');
                if (pkgPay > 0) {
                    pkgRow.style.display = '';
                    document.getElementById('pkgPayTotalDisplay').textContent = pkgPay.toFixed(3) + ' د.ك';
                } else {
                    pkgRow.style.display = 'none';
                }
                var net = Math.max(0, s + pkgPay - d);
                document.getElementById('netDisplay').textContent = net.toFixed(3) + ' د.ك';
                // سطر إجمالي التحصيل (صافي + هدية)
                var hadiyaRow = document.getElementById('hadiyaTotalRow');
                if (hadiya > 0) {
                    hadiyaRow.style.display = '';
                    document.getElementById('totalCollectDisplay').textContent = (net + hadiya).toFixed(3) + ' د.ك';
                } else {
                    hadiyaRow.style.display = 'none';
                }
            }
            function filterItems(q) {
                q = q.toLowerCase();
                document.querySelectorAll('.svc-item').forEach(function(c) {
                    c.style.display = (!q || c.dataset.name.includes(q)) ? '' : 'none';
                });
            }
            function selectPayment(btn) {
                document.querySelectorAll('.pay-btn').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                document.getElementById('paymentMethodSelect').value = btn.dataset.value;
                onPaymentChange();
            }
            function onPaymentChange() {
                var pm = document.getElementById('paymentMethodSelect').value;
                var extraBar       = document.getElementById('extraPaymentBar');
                var splitSection   = document.getElementById('splitSection');
                var debtEmpSection = document.getElementById('debtEmpSection');
                var customerWarning = document.getElementById('customerDebtWarning');
                var customerSelect  = document.getElementById('customerSelect');
                splitSection.style.display = 'none';
                debtEmpSection.style.display = extraBar.style.display = 'none';
                customerWarning.style.display = 'none';
                customerSelect.required = false;
                if (pm === 'كي نت و كاش')        { splitSection.style.display = ''; }
                else if (pm === 'دين على العميل') { customerWarning.style.display = ''; customerSelect.required = true; }
                else if (pm === 'دين على الموظف') { extraBar.style.display = ''; debtEmpSection.style.display = ''; }
            }
            function validateSplit() {
                var cash = parseFloat(document.getElementById('cashAmountInput').value) || 0;
                var link = parseFloat(document.getElementById('linkAmountInput').value) || 0;
                document.getElementById('splitStatus').textContent = 'المجموع: ' + (cash + link).toFixed(3) + ' د.ك';
            }

            document.getElementById('posForm').addEventListener('submit', function(e) {
                e.preventDefault();
                if (!items.length) return;
                var empId = document.getElementById('selectedEmployeeId').value;
                if (!empId) { alert('يرجى اختيار الحلاق أولاً'); return; }
                var pm = document.getElementById('paymentMethodSelect').value;
                if (pm === 'دين على العميل') {
                    if (!document.getElementById('customerSelect').value) {
                        alert('طريقة الدفع "دين على العميل" تتطلب اختيار عميل مسجل'); return;
                    }
                }
                if (pm === 'دين على الموظف') {
                    var sel = document.getElementById('debtEmployeeSelect');
                    if (!sel || !sel.value) { alert('يرجى اختيار الموظف المدين'); return; }
                }
                var c = document.getElementById('hiddenItems'); c.innerHTML = '';
                items.forEach(function(it) {
                    c.innerHTML +=
                        '<input type="hidden" name="itemIds"    value="' + it.id    + '"/>' +
                        '<input type="hidden" name="itemNames"  value="' + it.name  + '"/>' +
                        '<input type="hidden" name="itemPrices" value="' + it.price + '"/>' +
                        '<input type="hidden" name="itemQtys"   value="' + it.qty   + '"/>';
                });

                // تأكد من قيمة دفع الباقة لحظة الإرسال
                var pkgSection = document.getElementById('packagePaymentSection');
                if (pkgSection && pkgSection.style.display !== 'none') {
                    var pkgPayVal = parseFloat(document.getElementById('pkgPayInput').value) || 0;
                    document.getElementById('packagePaymentAmount').value = pkgPayVal.toFixed(3);
                }

                var saveBtn = document.getElementById('saveBtn');
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> جاري الحفظ...';

                var formData = new FormData(document.getElementById('posForm'));
                // أضف قيمة دفع الباقة مباشرة في FormData لضمان إرسالها صح
                var pkgSecCheck = document.getElementById('packagePaymentSection');
                if (pkgSecCheck && pkgSecCheck.style.display !== 'none') {
                    var finalPkgAmt = parseFloat(document.getElementById('pkgPayInput').value) || 0;
                    formData.set('packagePaymentAmount', finalPkgAmt.toFixed(3));
                } else {
                    formData.set('packagePaymentAmount', '0');
                }
                fetch(document.getElementById('posForm').action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                })
                .then(function(r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.text();
                })
                .then(function(text) {
                    var data;
                    try { data = JSON.parse(text); }
                    catch(e) { throw new Error('استجابة غير متوقعة من الخادم'); }
                    if (data.success) {
                        document.getElementById('printFrame').src = '/Sales/PrintInvoice/' + data.invoiceId + '?modal=1';
                        var modal = new bootstrap.Modal(document.getElementById('printModal'));
                        modal.show();
                        resetForm();
                    } else {
                        alert('خطأ: ' + (data.message || 'حدث خطأ أثناء الحفظ'));
                        saveBtn.disabled = false;
                        saveBtn.innerHTML = '<i class="fas fa-print me-2"></i> حفظ فاتورة الحلاقة';
                    }
                })
                .catch(function(err) {
                    alert('حدث خطأ أثناء الحفظ: ' + (err.message || 'يرجى المحاولة مرة أخرى'));
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="fas fa-print me-2"></i> حفظ فاتورة الحلاقة';
                });
            });

            function printInvoice() {
                var frame = document.getElementById('printFrame');
                frame.contentWindow.print();
            }

            function closeModal() {
                document.getElementById('printFrame').src = '';
            }

            /* ══ باقات العميل ══ */
            var selectedPackageId = null;
            var pendingAutoSelectData = null; // للاختيار التلقائي بعد تعيين باقة جديدة

            function onCustomerChange(customerId) {
                clearPackageSelection();
                var area = document.getElementById('customerPackagesArea');
                var btnWrap = document.getElementById('assignPackageBtnWrap');
                if (!customerId) {
                    area.style.display = 'none';
                    btnWrap.style.display = 'none';
                    return;
                }
                btnWrap.style.display = '';

                area.innerHTML = '<small class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>جاري التحميل...</small>';
                area.style.display = '';

                fetch('/Sales/GetCustomerPackagesForSale?customerId=' + encodeURIComponent(customerId) + '&dept=' + encodeURIComponent('حلاقة'))
                    .then(function(r) {
                        if (!r.ok) throw new Error('HTTP ' + r.status);
                        return r.json();
                    })
                    .then(function(data) {
                        if (data && data.error) {
                            area.innerHTML = '<small class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>' + data.error + '</small>';
                            return;
                        }
                        var pkgs = Array.isArray(data) ? data : [];
                        if (pkgs.length === 0) {
                            area.innerHTML = '<small class="text-muted"><i class="fas fa-box-open me-1"></i>لا توجد باقات نشطة لهذا العميل</small>';
                            pendingAutoSelectData = null;
                            return;
                        }
                        var html = '<div style="font-size:11px;font-weight:700;color:#1a6fc4;margin-bottom:5px;">' +
                                   '<i class="fas fa-box-open me-1"></i>الباقات النشطة — اختر للخصم:</div>' +
                                   '<div style="display:flex;flex-wrap:wrap;gap:5px;">';
                        pkgs.forEach(function(p) {
                            var unpaid = (parseFloat(p.packagePrice) - parseFloat(p.pricePaid)) > 0.001;
                            var badgeColor = unpaid ? '#dc3545' : '#1a6fc4';
                            html += '<button type="button" class="customer-pkg-btn" id="cpbtn-' + p.id + '" ' +
                                    'onclick="selectPackage(' + p.id + ',\'' + p.name.replace(/\\/g,'\\\\').replace(/'/g,"\\'") + '\',' + p.remaining + ',' + p.total + ',' + p.pricePaid + ',' + p.packagePrice + ')" ' +
                                    'style="border:1.5px solid ' + badgeColor + ';border-radius:7px;background:#fff;color:' + badgeColor + ';' +
                                    'padding:5px 12px;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;text-align:right;">' +
                                    '<i class="fas fa-calendar-check me-1"></i>' + p.name +
                                    ' <span style="background:' + badgeColor + ';color:#fff;border-radius:10px;padding:1px 7px;font-size:11px;font-weight:700;">' +
                                    p.remaining + '/' + p.total + '</span>' +
                                    (unpaid ? ' <span style="background:#fff3cd;color:#856404;border-radius:10px;padding:1px 7px;font-size:10px;font-weight:700;border:1px solid #ffc107;"><i class="fas fa-exclamation-triangle me-1"></i>غير مدفوعة</span>' : '') +
                                    '<br><small style="opacity:.65;font-size:10px;font-weight:400;">ينتهي: ' + p.expiry + '</small>' +
                                    '</button>';
                        });
                        html += '</div>';
                        area.innerHTML = html;

                        // اختيار تلقائي بعد تعيين باقة جديدة من الـ Modal
                        if (pendingAutoSelectData) {
                            var asd = pendingAutoSelectData;
                            pendingAutoSelectData = null;
                            // ابحث عن الباقة المعينة في القائمة المحدّثة
                            var match = pkgs.find(function(p) { return p.id === asd.id; });
                            if (match) {
                                selectPackage(match.id, match.name, match.remaining, match.total, match.pricePaid, match.packagePrice);
                            } else {
                                selectPackage(asd.id, asd.name, asd.remaining, asd.total, asd.pricePaid, asd.packagePrice);
                            }
                        }
                    })
                    .catch(function(err) {
                        area.innerHTML = '<small class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>خطأ في تحميل الباقات: ' + err.message + '</small>';
                        pendingAutoSelectData = null;
                    });
            }

            var currentPackageBalance = 0;

            function selectPackage(pkgId, pkgName, remaining, total, pricePaid, packagePrice) {
                document.querySelectorAll('.customer-pkg-btn').forEach(function(b) {
                    b.style.background = '#fff';
                    b.style.color = b.style.borderColor || '#1a6fc4';
                });
                selectedPackageId = pkgId;
                document.getElementById('customerPackageId').value = pkgId;
                var btn = document.getElementById('cpbtn-' + pkgId);
                if (btn) { btn.style.background = btn.style.borderColor || '#1a6fc4'; btn.style.color = '#fff'; }
                var pkgPayBtn = document.getElementById('packagePayBtn');
                pkgPayBtn.style.display = '';
                pkgPayBtn.innerHTML = '<i class="fas fa-box-open"></i> باقة: ' + pkgName;

                // إزالة أي عنصر باقة سابق من السلة
                var existingPkg = items.find(function(i) { return i.id === -999; });
                if (existingPkg) { items = items.filter(function(i) { return i.id !== -999; }); var tr = document.getElementById('row-' + existingPkg.rowId); if (tr) tr.remove(); }
                // إضافة جلسة الباقة (مجاناً)
                addItem(-999, 'جلسة باقة: ' + pkgName, 0);

                var balance = parseFloat(packagePrice || 0) - parseFloat(pricePaid || 0);
                currentPackageBalance = balance;

                if (balance > 0.001) {
                    // الباقة غير مدفوعة — اعرض قسم الدفع
                    document.getElementById('packagePaymentSection').style.display = '';
                    var pp = parseFloat(pricePaid || 0), pr = parseFloat(packagePrice || 0);
                    document.getElementById('packageBalanceInfo').innerHTML =
                        'سعر الباقة: <strong>' + pr.toFixed(3) + ' د.ك</strong>&nbsp;&nbsp;|&nbsp;&nbsp;' +
                        'تم دفع: <strong>' + pp.toFixed(3) + ' د.ك</strong>&nbsp;&nbsp;|&nbsp;&nbsp;' +
                        '<span style="color:#dc3545;font-weight:700;">المتبقي: ' + balance.toFixed(3) + ' د.ك</span>';
                    var inp = document.getElementById('pkgPayInput');
                    inp.max = balance.toFixed(3);
                    inp.value = balance.toFixed(3);
                    onPackagePaymentChange(balance.toFixed(3));
                    // طريقة الدفع كاش افتراضياً (العميل يدفع الباقة)
                    var cashBtn = document.querySelector('.pay-btn[data-value="كاش"]');
                    if (cashBtn) selectPayment(cashBtn);
                } else {
                    // الباقة مدفوعة — جلسة مجانية
                    document.getElementById('packagePaymentSection').style.display = 'none';
                    document.getElementById('packagePaymentAmount').value = '0';
                    recalc();
                    selectPayment(pkgPayBtn);
                }
            }

            function onPackagePaymentChange(value) {
                var amount = parseFloat(value) || 0;
                document.getElementById('packagePaymentAmount').value = amount;
                recalc();
            }

            /* ══ Modal تعيين باقة ══ */
            var assignSelectedPkgId   = null;
            var assignSelectedPkgName = '';
            var assignSelectedPkgPrice    = 0;
            var assignSelectedPkgSessions = 0;
            var assignSelectedPkgDays     = 0;

            function selectAssignCard(pkgId, pkgName, price, sessions, days) {
                assignSelectedPkgId       = pkgId;
                assignSelectedPkgName     = pkgName;
                assignSelectedPkgPrice    = parseFloat(price) || 0;
                assignSelectedPkgSessions = parseInt(sessions) || 0;
                assignSelectedPkgDays     = parseInt(days) || 0;
                // تمييز الكارت المختار
                document.querySelectorAll('.assign-pkg-card').forEach(function(c) {
                    c.style.border    = '2px solid #dee2e6';
                    c.style.background = '#fff';
                    c.style.boxShadow = '0 1px 4px rgba(0,0,0,.06)';
                });
                var card = document.getElementById('apc-' + pkgId);
                if (card) {
                    card.style.border    = '2px solid #1a6fc4';
                    card.style.background = '#e8f4fd';
                    card.style.boxShadow = '0 0 0 3px rgba(26,111,196,.15)';
                }
                // عرض معلومات الباقة المختارة
                document.getElementById('assignSelectedInfoText').textContent =
                    pkgName + ' — ' + sessions + ' جلسة | صلاحية ' + days + ' يوم | ' + parseFloat(price).toFixed(3) + ' د.ك';
                document.getElementById('assignSelectedInfo').classList.remove('d-none');
                document.getElementById('assignError').classList.add('d-none');
            }

            function openAssignPackageModal() {
                var sel = document.getElementById('customerSelect');
                var customerId = sel.value;
                var customerName = sel.options[sel.selectedIndex]?.text || '';
                if (!customerId) { alert('اختر عميلاً أولاً'); return; }
                document.getElementById('assignCustomerId').value = customerId;
                document.getElementById('assignCustomerName').value = customerName;
                // إعادة تعيين اختيار الكارت
                assignSelectedPkgId = null;
                document.querySelectorAll('.assign-pkg-card').forEach(function(c) {
                    c.style.border    = '2px solid #dee2e6';
                    c.style.background = '#fff';
                    c.style.boxShadow = '0 1px 4px rgba(0,0,0,.06)';
                });
                document.getElementById('assignSelectedInfo').classList.add('d-none');
                document.getElementById('assignNotes').value = '';
                document.getElementById('assignError').classList.add('d-none');
                new bootstrap.Modal(document.getElementById('assignPackageModal')).show();
            }

            function submitAssignPackage() {
                var customerId = document.getElementById('assignCustomerId').value;
                var packageId  = assignSelectedPkgId;
                var notes      = document.getElementById('assignNotes').value;
                var errEl      = document.getElementById('assignError');
                var submitBtn  = document.getElementById('assignPackageSubmit');

                if (!packageId) { errEl.textContent = 'اختر الباقة أولاً'; errEl.classList.remove('d-none'); return; }
                errEl.classList.add('d-none');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> جاري الحفظ...';

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var body  = new URLSearchParams({
                    customerId: customerId,
                    servicePackageId: packageId,
                    pricePaid: '0',   // الدفع يتم عبر الفاتورة
                    notes: notes,
                    __RequestVerificationToken: token
                });

                fetch('/Packages/AssignPackage', {
                    method: 'POST', body: body,
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                               'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data && data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('assignPackageModal')).hide();
                        // تعيين بيانات الاختيار التلقائي
                        pendingAutoSelectData = {
                            id:          data.customerPackageId,
                            name:        assignSelectedPkgName,
                            remaining:   assignSelectedPkgSessions,
                            total:       assignSelectedPkgSessions,
                            pricePaid:   0,
                            packagePrice: assignSelectedPkgPrice
                        };
                        onCustomerChange(customerId); // يُحدِّث القائمة ثم يختار الباقة تلقائياً
                    } else {
                        errEl.textContent = (data && data.message) || 'حدث خطأ أثناء الحفظ';
                        errEl.classList.remove('d-none');
                    }
                })
                .catch(function(e) {
                    errEl.textContent = 'خطأ: ' + e.message;
                    errEl.classList.remove('d-none');
                })
                .finally(function() {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-save me-1"></i> تعيين الباقة';
                });
            }

            function clearPackageSelection() {
                selectedPackageId = null;
                currentPackageBalance = 0;
                document.getElementById('customerPackageId').value = '';
                document.getElementById('packagePaymentAmount').value = '0';
                document.getElementById('packagePaymentSection').style.display = 'none';
                document.getElementById('pkgPayTotalRow').style.display = 'none';
                var inp = document.getElementById('pkgPayInput');
                if (inp) inp.value = '';
                var pkgPayBtn = document.getElementById('packagePayBtn');
                pkgPayBtn.style.display = 'none';
                var pkgItem = items.find(function(i) { return i.id === -999; });
                if (pkgItem) removeItem(pkgItem.rowId);
                var pm = document.getElementById('paymentMethodSelect').value;
                if (pm === 'باقة') {
                    var cashBtn = document.querySelector('.pay-btn[data-value="كاش"]');
                    if (cashBtn) selectPayment(cashBtn);
                }
                recalc();
            }

            function resetForm() {
                items = []; rowId = 0;
                document.getElementById('invoiceBody').innerHTML =
                    '<tr id="emptyRow"><td colspan="4" class="invoice-empty">' +
                    '<i class="fas fa-hand-point-right mb-1 d-block"></i>اختر خدمة</td></tr>';
                document.getElementById('hiddenItems').innerHTML = '';
                document.getElementById('subtotalDisplay').textContent = '0.000 د.ك';
                document.getElementById('netDisplay').textContent = '0.000 د.ك';
                document.getElementById('discountInput').value = '0';
                document.getElementById('giftInput').value = '';
                document.getElementById('notesInput').value = '';
                document.getElementById('customerSelect').value = '';
                document.getElementById('paymentMethodSelect').value = 'كاش';
                document.getElementById('pkgPayTotalRow').style.display = 'none';
                document.querySelectorAll('.pay-btn').forEach(function(b) { b.classList.remove('active'); });
                document.querySelector('.pay-btn[data-value="كاش"]').classList.add('active');
                onPaymentChange();
                clearPackageSelection();
                document.getElementById('customerPackagesArea').style.display = 'none';
                var saveBtn = document.getElementById('saveBtn');
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<i class="fas fa-print me-2"></i> إتمام العملية';
            }
    </script>
}