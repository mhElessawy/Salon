@model Salon.Models.Sale
@{
    ViewData["Title"] = "فاتورة مساج";
    var categories = ViewBag.ServiceCategories as List<Salon.Models.ServiceCategory> ?? new();
    var employees = ViewBag.Employees as List<Salon.Models.Employee> ?? new();
    var isEmployee = (bool)(ViewBag.IsEmployee ?? false);
    var linkedEmpId = ViewBag.LinkedEmployeeId as int?;
}

@section Styles {
    <style>
        :root {
            --dept-color: #17a2b8;
            --dept-light: #f0fbfd;
        }

        .pos-wrapper {
            display: grid;
            grid-template-columns: 1fr 420px;
            gap: 16px;
            align-items: start;
        }

        .pos-right {
            position: sticky;
            top: 70px;
        }

        .inv-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #17a2b8;
            color: #fff;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(148px,1fr));
            gap: 8px;
            margin-bottom: 14px;
        }

        .item-card {
            background: #fff;
            border: 1.5px solid var(--border-color);
            border-radius: 10px;
            padding: 12px 10px;
            cursor: pointer;
            transition: all .18s;
            text-align: center;
        }

            .item-card:hover {
                border-color: #17a2b8;
                background: var(--dept-light);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(23,162,184,.18);
            }

            .item-card .ic-icon {
                font-size: 22px;
                margin-bottom: 6px;
                color: #17a2b8;
            }

            .item-card .ic-name {
                font-size: 13px;
                font-weight: 600;
                color: var(--text-dark);
                line-height: 1.3;
                margin-bottom: 4px;
            }

            .item-card .ic-price {
                font-size: 13px;
                font-weight: 700;
                color: #17a2b8;
            }

            .item-card .ic-meta {
                font-size: 11px;
                color: #6c757d;
            }

        .cat-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 4px 6px;
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 8px;
            font-weight: 700;
            font-size: 13px;
            color: #17a2b8;
        }

        .invoice-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 16px rgba(0,0,0,.09);
            overflow: hidden;
        }

        .invoice-header {
            background: #17a2b8;
            color: #fff;
            padding: 14px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .invoice-items {
            min-height: 160px;
            max-height: 280px;
            overflow-y: auto;
        }

            .invoice-items table {
                width: 100%;
                font-size: 13px;
            }

            .invoice-items thead th {
                background: #f8f9fa;
                padding: 7px 10px;
                font-size: 12px;
                color: #6c757d;
            }

            .invoice-items tbody td {
                padding: 7px 10px;
                border-bottom: 1px solid #f0f0f0;
                vertical-align: middle;
            }

        .invoice-empty {
            text-align: center;
            padding: 35px 20px;
            color: #adb5bd;
        }

        .qty-control {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .qty-btn {
            width: 24px;
            height: 24px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            background: #f8f9fa;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

            .qty-btn:hover {
                background: #17a2b8;
                color: #fff;
                border-color: #17a2b8;
            }

        .qty-input {
            width: 34px;
            text-align: center;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            font-size: 13px;
            padding: 2px;
        }

        .btn-remove-item {
            background: none;
            border: none;
            color: #dc3545;
            cursor: pointer;
            font-size: 14px;
            padding: 2px 5px;
            border-radius: 4px;
        }

            .btn-remove-item:hover {
                background: #fce4ec;
            }

        .invoice-totals {
            padding: 12px 16px;
            border-top: 1px solid var(--border-color);
            background: #fafafa;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 5px 0;
            font-size: 14px;
        }

            .total-row.net {
                font-size: 16px;
                font-weight: 700;
                color: #17a2b8;
                border-top: 2px solid var(--border-color);
                padding-top: 10px;
                margin-top: 4px;
            }

        .discount-input {
            width: 90px;
            text-align: center;
            border: 1px dashed #ccc;
            border-radius: 6px;
            padding: 3px 6px;
            font-size: 13px;
        }

            .discount-input:focus {
                outline: none;
                border-color: #17a2b8;
            }

        .btn-save-invoice {
            width: 100%;
            padding: 14px;
            background: #17a2b8;
            color: #fff;
            border: none;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s;
        }

            .btn-save-invoice:hover {
                background: #138496;
            }

            .btn-save-invoice:disabled {
                background: #adb5bd;
                cursor: not-allowed;
            }

        .info-top-bar {
            background: #fff;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
            padding: 14px 18px;
            margin-bottom: 14px;
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 12px;
        }

        @@media (max-width:992px) {
            .pos-wrapper {
                grid-template-columns: 1fr;
            }

            .pos-right {
                position: static;
            }

            .info-top-bar {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width:576px) {
            .info-top-bar {
                grid-template-columns: 1fr;
            }

            .items-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }
    </style>
}

<div class="page-header d-flex justify-content-between align-items-center mb-2">
    <div>
        <div class="inv-badge"><i class="fas fa-spa"></i> MAS — فاتورة مساج</div>
        <small class="text-muted">الرقم التالي: <strong>@Model.InvoiceNumber</strong></small>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("CreateBarber")" class="btn btn-outline-warning btn-sm">
            <i class="fas fa-cut me-1"></i> فاتورة حلاقة
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-list me-1"></i> الفواتير
        </a>
    </div>
</div>

<form asp-action="CreateMassage" method="post" id="posForm">
    @Html.AntiForgeryToken()
    <input asp-for="InvoiceNumber" type="hidden" />
    <input asp-for="SaleType" type="hidden" value="مساج" />
    <div id="hiddenItems"></div>

    <div class="info-top-bar">
        <div>
            <label class="form-label">العميل</label>
            <select name="CustomerId" asp-items="@ViewBag.Customers" class="form-select form-select-sm">
                <option value="">👤 زائر</option>
            </select>
        </div>
        <div>
            <label class="form-label">المعالج المنفذ <span class="text-danger">*</span></label>
            @if (isEmployee && linkedEmpId.HasValue)
            {
                <select name="EmployeeId" class="form-select form-select-sm" disabled>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id" selected>@emp.FullName</option>
                    }
                </select>
                <input type="hidden" name="EmployeeId" value="@linkedEmpId" />
            }
            else
            {
                <select name="EmployeeId" class="form-select form-select-sm" required>
                    <option value="">-- اختر المعالج --</option>
                    @foreach (var emp in employees)
                    {
                        <option value="@emp.Id">@emp.FullName</option>
                    }
                </select>
            }
        </div>
        <div>
            <label class="form-label">طريقة الدفع</label>
            <select asp-for="PaymentMethod" class="form-select form-select-sm">
                <option>نقدي</option>
                <option>بطاقة</option>
                <option>تحويل بنكي</option>
            </select>
        </div>
    </div>

    <div class="pos-wrapper">
        <div class="pos-left">
            <div class="card mb-0">
                <div class="card-body p-3">
                    <div class="mb-3">
                        <input type="text" class="form-control form-control-sm" id="svcSearch"
                               placeholder="بحث في خدمات المساج..." oninput="filterItems(this.value)" />
                    </div>
                    @if (!categories.Any(c => c.Services.Any()))
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-spa fa-3x mb-3 opacity-25"></i>
                            <p>لا توجد خدمات مساج مسجلة</p>
                            <a href="@Url.Action("Create", "Services")" class="btn btn-sm btn-outline-info">إضافة خدمة</a>
                        </div>
                    }
                    @foreach (var cat in categories)
                    {
                        if (!cat.Services.Any()) continue;
                        <div class="cat-header" style="color:@(cat.Color ?? "#17a2b8")">
                            <i class="@(cat.Icon ?? "fas fa-spa")"></i>
                            @cat.Name
                        </div>
                        <div class="items-grid">
                            @foreach (var svc in cat.Services.OrderBy(s => s.Name))
                            {
                                <div class="item-card svc-item" data-name="@svc.Name.ToLower()"
                                     onclick="addItem(@svc.Id,'@Html.Raw(svc.Name.Replace("'", "\\\'"))',@svc.Price.ToString("F3"))">
                                    <div class="ic-icon" style="color:@(cat.Color ?? "#17a2b8")"><i class="@(cat.Icon ?? "fas fa-spa")"></i></div>
                                    <div class="ic-name">@svc.Name</div>
                                    <div class="ic-price">@svc.Price.ToString("N3") د.ك</div>
                                    @if (svc.DurationMinutes.HasValue)
                                    {
                                        <div class="ic-meta"><i class="fas fa-clock me-1"></i>@svc.DurationMinutes دق</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="pos-right">
            <div class="invoice-card">
                <div class="invoice-header">
                    <div style="font-size:15px;font-weight:700"><i class="fas fa-file-invoice me-2"></i>فاتورة مساج</div>
                    <div style="font-size:12px;opacity:.9">@Model.InvoiceNumber</div>
                </div>
                <div class="px-3 pt-2 pb-2 border-bottom">
                    <label class="form-label mb-1" style="font-size:12px">ملاحظات</label>
                    <textarea name="Notes" class="form-control form-control-sm" rows="1"></textarea>
                </div>
                <div class="invoice-items">
                    <table>
                        <thead><tr><th>الخدمة</th><th>الكمية</th><th>السعر</th><th>الإجمالي</th><th></th></tr></thead>
                        <tbody id="invoiceBody">
                            <tr id="emptyRow"><td colspan="5" class="invoice-empty"><i class="fas fa-hand-point-right fa-2x mb-2 d-block"></i>اختر خدمة</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="invoice-totals">
                    <div class="total-row"><span>الإجمالي:</span><span id="subtotalDisplay">0.000 د.ك</span></div>
                    <div class="total-row">
                        <span>الخصم:</span>
                        <input type="number" name="Discount" id="discountInput" class="discount-input" value="0" step="0.001" min="0" oninput="recalc()" />
                    </div>
                    <div class="total-row net"><span>الصافي:</span><span id="netDisplay">0.000 د.ك</span></div>
                </div>
                <div class="p-3 border-top">
                    <button type="submit" class="btn-save-invoice" id="saveBtn" disabled>
                        <i class="fas fa-print me-2"></i> حفظ فاتورة المساج
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        let items=[], rowId=0;
        function addItem(id,name,price){price=parseFloat(price)||0;const ex=items.find(i=>i.id===id);if(ex){ex.qty++;ex.total=ex.qty*ex.price;updateRow(ex);}else{const it={rowId:++rowId,id,name,price,qty:1,total:price};items.push(it);renderRow(it);}document.getElementById('emptyRow').style.display='none';recalc();document.getElementById('saveBtn').disabled=false;}
        function renderRow(it){const tr=document.createElement('tr');tr.id='row-'+it.rowId;tr.innerHTML=buildHtml(it);document.getElementById('invoiceBody').appendChild(tr);}
        function updateRow(it){const tr=document.getElementById('row-'+it.rowId);if(tr)tr.innerHTML=buildHtml(it);}
        function buildHtml(it){return`<td>${it.name}</td><td><div class="qty-control"><button type="button" class="qty-btn" onclick="chQty(${it.rowId},-1)">−</button><input type="number" class="qty-input" value="${it.qty}" min="1" onchange="setQty(${it.rowId},this.value)"/><button type="button" class="qty-btn" onclick="chQty(${it.rowId},1)">+</button></div></td><td>${it.price.toFixed(3)}</td><td><strong>${it.total.toFixed(3)}</strong></td><td><button type="button" class="btn-remove-item" onclick="removeItem(${it.rowId})"><i class="fas fa-times"></i></button></td>`;}
        function chQty(rid,d){const it=items.find(i=>i.rowId===rid);if(!it)return;const n=it.qty+d;if(n<1){removeItem(rid);return;}it.qty=n;it.total=it.qty*it.price;updateRow(it);recalc();}
        function setQty(rid,v){const it=items.find(i=>i.rowId===rid);if(!it)return;it.qty=Math.max(1,parseInt(v)||1);it.total=it.qty*it.price;updateRow(it);recalc();}
        function removeItem(rid){items=items.filter(i=>i.rowId!==rid);const tr=document.getElementById('row-'+rid);if(tr)tr.remove();if(!items.length){document.getElementById('emptyRow').style.display='';document.getElementById('saveBtn').disabled=true;}recalc();}
        function recalc(){const s=items.reduce((a,i)=>a+i.total,0);const d=parseFloat(document.getElementById('discountInput').value)||0;document.getElementById('subtotalDisplay').textContent=s.toFixed(3)+' د.ك';document.getElementById('netDisplay').textContent=Math.max(0,s-d).toFixed(3)+' د.ك';}
        function filterItems(q){q=q.toLowerCase();document.querySelectorAll('.svc-item').forEach(c=>{c.style.display=(!q||c.dataset.name.includes(q))?'':'none';});}
        document.getElementById('posForm').addEventListener('submit',function(e){if(!items.length){e.preventDefault();return;}const c=document.getElementById('hiddenItems');c.innerHTML='';items.forEach(it=>{c.innerHTML+=`<input type="hidden" name="itemIds" value="${it.id}"/><input type="hidden" name="itemNames" value="${it.name}"/><input type="hidden" name="itemPrices" value="${it.price}"/><input type="hidden" name="itemQtys" value="${it.qty}"/>`;});});
    </script>
}