@model IEnumerable<Salon.Models.Sale>
@{
    ViewData["Title"] = "الفواتير";
    var filterType = ViewBag.FilterType as string;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-file-invoice me-2"></i>الفواتير</h1>
        <p>إجمالي اليوم: <strong>@ViewBag.TotalSales?.ToString("N3") د.ك</strong></p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("CreateBarber")" class="btn btn-warning btn-sm">
            <i class="fas fa-cut me-1"></i> فاتورة حلاقة
        </a>
        <a href="@Url.Action("CreateMassage")" class="btn btn-info btn-sm">
            <i class="fas fa-spa me-1"></i> فاتورة مساج
        </a>
        <a href="@Url.Action("CreateProduct")" class="btn btn-success btn-sm">
            <i class="fas fa-box me-1"></i> فاتورة منتجات
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">التاريخ:</label>
            <input type="date" name="date" value="@ViewBag.FilterDate" class="form-control" style="max-width:180px;" />
            <label class="form-label mb-0">النوع:</label>
            <select name="type" class="form-select" style="max-width:160px;">
                <option value="">الكل</option>
                @if (filterType == "حلاقة") { <option value="حلاقة" selected>فواتير حلاقة (PAR)</option> } else { <option value="حلاقة">فواتير حلاقة (PAR)</option> }
                @if (filterType == "مساج")   { <option value="مساج" selected>فواتير مساج (MAS)</option>   } else { <option value="مساج">فواتير مساج (MAS)</option>   }
                @if (filterType == "منتجات") { <option value="منتجات" selected>فواتير منتجات (PRD)</option> } else { <option value="منتجات">فواتير منتجات (PRD)</option> }
            </select>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i> بحث</button>
            @if (!string.IsNullOrEmpty(filterType))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">إلغاء الفلتر</a>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>النوع</th>
                        <th>العميل</th>
                        <th>الموظف</th>
                        <th>التاريخ</th>
                        <th>الصافي</th>
                        <th>الدفع</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">لا توجد فواتير في هذا اليوم</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.InvoiceNumber</strong></td>
                            <td>
                                @if (s.SaleType == "حلاقة")
                                {
                                    <span class="badge" style="background:#F7941D"><i class="fas fa-cut me-1"></i>PAR</span>
                                }
                                else if (s.SaleType == "مساج")
                                {
                                    <span class="badge bg-info"><i class="fas fa-spa me-1"></i>MAS</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="fas fa-box me-1"></i>PRD</span>
                                }
                            </td>
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@s.SaleDate.ToString("yyyy/MM/dd hh:mm tt")</td>
                            <td><strong>@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>@s.PaymentMethod</td>
                            <td>
                                <span class="badge @(s.Status == "مكتمل" ? "bg-success" : "bg-danger")">@s.Status</span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = s.Id })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (s.Status != "ملغي")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="إلغاء الفاتورة"
                                            onclick="confirmDelete(@s.Id, '@Html.Raw(s.InvoiceNumber.Replace("'", "\\'"))')">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الإلغاء</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من إلغاء الفاتورة:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}