@model IEnumerable<Salon.Models.Sale>
@{
    ViewData["Title"] = "المبيعات / الكاشير";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-shopping-cart me-2"></i>المبيعات / الكاشير</h1>
        <p>إجمالي اليوم: <strong>@ViewBag.TotalSales?.ToString("N3") د.ك</strong></p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> فاتورة جديدة
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0">التاريخ:</label>
            <input type="date" name="date" value="@ViewBag.FilterDate" class="form-control" style="max-width:200px;" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>العميل</th>
                        <th>الموظف</th>
                        <th>التاريخ</th>
                        <th>الإجمالي</th>
                        <th>الخصم</th>
                        <th>الصافي</th>
                        <th>الدفع</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">لا توجد مبيعات في هذا اليوم</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.InvoiceNumber</strong></td>
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@s.SaleDate.ToString("yyyy/MM/dd")</td>
                            <td>@s.TotalAmount.ToString("N3")</td>
                            <td>@s.Discount.ToString("N3")</td>
                            <td><strong>@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>@s.PaymentMethod</td>
                            <td>
                                <span class="badge @(s.Status == "مكتمل" ? "bg-success" : "bg-danger")">@s.Status</span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = s.Id })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (s.Status != "ملغي")
                                {
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline"
                                          onsubmit="return confirm('هل تريد إلغاء هذه الفاتورة؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
