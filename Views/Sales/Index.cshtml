@model IEnumerable<Salon.Models.Sale>
@{
    ViewData["Title"] = "الفواتير";
    var filterType = ViewBag.FilterType as string;
    var userDept = ViewBag.UserDepartment as string;
    bool showBarber = userDept != "مساج";
    bool showMassage = userDept != "حلاقة";
    bool isEmployee = ViewBag.IsEmployee == true;
    bool canDelBarber = ViewBag.CanDeleteBarber != false;
    bool canDelMassage = ViewBag.CanDeleteMassage != false;
    bool canDelProduct = ViewBag.CanDeleteProduct != false;
    bool canEditSale = ViewBag.CanEditSaleDetails == true;
    bool canRefund = ViewBag.CanRefund == true;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-file-invoice me-2"></i>الفواتير</h1>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (showBarber)
        {
            <a href="@Url.Action("CreateBarber")" class="btn btn-warning btn-sm">
                <i class="fas fa-cut me-1"></i> فاتورة حلاقة
            </a>
        }
        @if (showMassage)
        {
            <a href="@Url.Action("CreateMassage")" class="btn btn-info btn-sm">
                <i class="fas fa-spa me-1"></i> فاتورة مساج
            </a>
        }
        @if (!isEmployee && string.IsNullOrEmpty(userDept))
        {
            <a href="@Url.Action("CreateProduct")" class="btn btn-success btn-sm">
                <i class="fas fa-box me-1"></i> فاتورة منتجات
            </a>
        }
        <a href="@Url.Action("PrintAllCompleted", new { from = ViewBag.From, to = ViewBag.To, type = ViewBag.FilterType })"
           class="btn btn-success btn-sm no-print" target="_blank">
            <i class="fas fa-print me-1"></i> طباعة الفواتير المكتملة
        </a>
        <button onclick="window.print()" class="btn btn-dark btn-sm no-print">
            <i class="fas fa-print me-1"></i> طباعة
        </button>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-4 col-lg">
        <div class="card text-center h-100 border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-file-invoice me-1"></i><span data-i18n-en="Total Invoices">إجمالي الفواتير</span></div>
                <div class="fw-bold fs-5 text-dark">@(((decimal)(ViewBag.TotalSales ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #198754!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-money-bill-wave me-1"></i><span data-i18n-en="Total Cash">إجمالي الكاش</span></div>
                <div class="fw-bold fs-5 text-success">@(((decimal)(ViewBag.TotalCash ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #0d6efd!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-credit-card me-1"></i><span data-i18n-en="Total K-Net">إجمالي الكي نت</span></div>
                <div class="fw-bold fs-5 text-primary">@(((decimal)(ViewBag.TotalKnet ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #fd7e14!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-user-tag me-1"></i><span data-i18n-en="Employee Debt">دين على الموظف</span></div>
                <div class="fw-bold fs-5 text-warning">@(((decimal)(ViewBag.TotalEmployeeDebt ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #dc3545!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-building me-1"></i><span data-i18n-en="Owner Debt">دين على صاحب العمل</span></div>
                <div class="fw-bold fs-5 text-danger">@(((decimal)(ViewBag.TotalOwnerDebt ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #dc2626!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-ban me-1"></i><span data-i18n-en="Total Cancelled">إجمالي الملغاة</span></div>
                <div class="fw-bold fs-5" style="color:#dc2626;">@(((decimal)(ViewBag.TotalCancelled ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card text-center h-100 border-0 shadow-sm" style="border-top:3px solid #6b7280!important">
            <div class="card-body py-3">
                <div class="text-muted small mb-1"><i class="fas fa-undo-alt me-1"></i><span data-i18n-en="Total Refunded">إجمالي المسترد</span></div>
                <div class="fw-bold fs-5" style="color:#6b7280;">@(((decimal)(ViewBag.TotalRefunded ?? 0m)).ToString("N3")) <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get">
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <label class="form-label mb-0">من:</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:150px;" />
                <label class="form-label mb-0">إلى:</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:150px;" />
                <select name="type" class="form-select" style="max-width:150px;">
                    <option value="">كل الأنواع</option>
                    @if (showBarber)
                    {
                        <option value="حلاقة" selected="@(filterType == "حلاقة" ? "selected" : null)">حلاقة (PAR)</option>
                    }
                    @if (showMassage)
                    {
                        <option value="مساج" selected="@(filterType == "مساج" ? "selected" : null)">مساج (MAS)</option>
                    }
                    @if (string.IsNullOrEmpty(userDept))
                    {
                        <option value="منتجات" selected="@(filterType == "منتجات" ? "selected" : null)">منتجات (PRD)</option>
                    }
                </select>
                <select name="status" class="form-select" style="max-width:130px;">
                    <option value="">كل الحالات</option>
                    <option value="مكتمل" selected="@(ViewBag.FilterStatus == "مكتمل" ? "selected" : null)">مكتمل</option>
                    <option value="ملغي" selected="@(ViewBag.FilterStatus == "ملغي" ? "selected" : null)">ملغي</option>
                    <option value="مسترجع" selected="@(ViewBag.FilterStatus == "مسترجع" ? "selected" : null)">مسترجع</option>
                    <option value="مسترجع جزئياً" selected="@(ViewBag.FilterStatus == "مسترجع جزئياً" ? "selected" : null)">مسترجع جزئياً</option>
                </select>
                <select name="paymentMethod" class="form-select" style="max-width:150px;">
                    <option value="">كل طرق الدفع</option>
                    <option value="كاش" selected="@(ViewBag.FilterPayment == "كاش" ? "selected" : null)">كاش</option>
                    <option value="كي نت" selected="@(ViewBag.FilterPayment == "كي نت" ? "selected" : null)">كي نت</option>
                    <option value="كي نت و كاش" selected="@(ViewBag.FilterPayment == "كي نت و كاش" ? "selected" : null)">كي نت و كاش</option>
                    <option value="مناصفة" selected="@(ViewBag.FilterPayment == "مناصفة" ? "selected" : null)">مناصفة</option>
                    <option value="آجل" selected="@(ViewBag.FilterPayment == "آجل" ? "selected" : null)">آجل</option>
                    <option value="دين على الموظف" selected="@(ViewBag.FilterPayment == "دين على الموظف" ? "selected" : null)">دين على الموظف</option>
                    <option value="دين على الإدارة" selected="@(ViewBag.FilterPayment == "دين على الإدارة" ? "selected" : null)">دين على الإدارة</option>
                </select>
                @if (ViewBag.Employees != null)
                {
                    <select name="employeeId" class="form-select" style="max-width:150px;">
                        <option value="">كل الموظفين</option>
                        @foreach (var emp in (IEnumerable<dynamic>)ViewBag.Employees)
                        {
                            <option value="@emp.Id" selected="@(ViewBag.FilterEmployeeId != null && (int)ViewBag.FilterEmployeeId == (int)emp.Id ? "selected" : null)">@emp.FullName</option>
                        }
                    </select>
                }
                @if (ViewBag.Users != null)
                {
                    var filterUserId = ViewBag.FilterCreatedByUserId as string;
                    <select name="createdByUserId" class="form-select" style="max-width:150px;">
                        <option value="">كل المستخدمين</option>
                        @foreach (var u in (IEnumerable<dynamic>)ViewBag.Users)
                        {
                            <option value="@u.Id" selected="@(filterUserId == (string)u.Id ? "selected" : null)">@u.FullName</option>
                        }
                    </select>
                }
                <input type="text" name="customerName" value="@ViewBag.FilterCustomer" class="form-control" style="max-width:140px;" placeholder="اسم العميل..." />
                <input type="text" name="invoiceNumber2" value="@ViewBag.InvoiceNumber" class="form-control" style="max-width:130px;" placeholder="رقم الفاتورة..." />
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i> بحث</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-undo"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card print-area">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th><span data-i18n-en="Invoice #">رقم الفاتورة</span></th>
                        <th><span data-i18n-en="Type">النوع</span></th>
                        <th><span data-i18n-en="Customer">العميل</span></th>
                        <th><span data-i18n-en="Employee">الموظف</span></th>
                        <th><span data-i18n-en="User">المستخدم</span></th>
                        <th><span data-i18n-en="Date">التاريخ</span></th>
                        <th><span data-i18n-en="Net">الصافي</span></th>
                        <th><span data-i18n-en="Tip">إكرامية للموظف</span></th>
                        <th><span data-i18n-en="Payment">الدفع</span></th>
                        <th><span data-i18n-en="Status">الحالة</span></th>
                        <th><span data-i18n-en="Notes">ملاحظات</span></th>
                        <th><span data-i18n-en="Actions">الإجراءات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">لا توجد فواتير في هذا اليوم</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.InvoiceNumber</strong></td>
                            <td>
                                @if (s.SaleType == "حلاقة")
                                {
                                    <span class="badge" style="background:#F7941D"><i class="fas fa-cut me-1"></i>PAR</span>
                                }
                                else if (s.SaleType == "مساج")
                                {
                                    <span class="badge bg-info"><i class="fas fa-spa me-1"></i>MAS</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="fas fa-box me-1"></i>PRD</span>
                                }
                            </td>
                            <td>@(s.Customer?.FullName ?? "زائر")</td>
                            <td>@(s.Employee?.FullName ?? "-")</td>
                            <td>@(s.CreatedByUserName ?? "-")</td>
                            <td>
                                <div>@s.SaleDate.ToString("yyyy/MM/dd")</div>
                                <div class="text-muted small">@s.SaleDate.ToString("hh:mm tt")</div>
                            </td>
                            <td><strong>@s.NetAmount.ToString("N3") د.ك</strong></td>
                            <td>
                                @if (s.GiftForEmployee.HasValue && s.GiftForEmployee > 0)
                                {
                                    <span class="badge" style="background:#c0392b;"><i class="fas fa-gift me-1"></i>@s.GiftForEmployee.Value.ToString("N3") د.ك</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (s.PaymentMethod == "كي نت و كاش")
                                {
                                    <div><span data-i18n-en="K-Net &amp; Cash">كي نت و كاش</span></div>
                                    <div class="small" style="color:#198754;white-space:nowrap;">
                                        <i class="fas fa-money-bill-wave me-1"></i><span data-i18n-en="Cash:">كاش:</span> @((s.CashAmount ?? 0).ToString("N3")) د.ك
                                    </div>
                                    <div class="small" style="color:#0d6efd;white-space:nowrap;">
                                        <i class="fas fa-credit-card me-1"></i><span data-i18n-en="K-Net:">كي نت:</span> @((s.NetAmount - (s.CashAmount ?? 0)).ToString("N3")) د.ك
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.KnetReceiptNumber))
                                    {
                                        <div class="small" style="color:#6c757d;white-space:nowrap;">
                                            <i class="fas fa-receipt me-1"></i><span data-i18n-en="Receipt No:">رقم:</span> <strong id="knet-receipt-text-@s.Id">@s.KnetReceiptNumber</strong>
                                            <button type="button" class="btn btn-sm p-0 ms-1" style="font-size:11px;opacity:.6;" title="تعديل رقم الإيصال" onclick="openKnetModal(@s.Id, '@Html.Raw((s.KnetReceiptNumber ?? "").Replace("'", "\\'"))')"><i class="fas fa-pen"></i></button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small mt-1">
                                            <span class="badge bg-warning text-dark" style="font-size:10px;"><i class="fas fa-exclamation-triangle me-1"></i>غير موثقة</span>
                                            <button type="button" class="btn btn-sm p-0 ms-1 text-primary" style="font-size:11px;" title="إضافة رقم الإيصال" onclick="openKnetModal(@s.Id, '')"><i class="fas fa-plus-circle"></i> إضافة رقم الإيصال</button>
                                        </div>
                                    }
                                }
                                else if (s.PaymentMethod == "كي نت")
                                {
                                    <div><i class="fas fa-credit-card me-1" style="color:#0d6efd;"></i><span data-i18n-en="K-Net">كي نت</span></div>
                                    @if (!string.IsNullOrEmpty(s.KnetReceiptNumber))
                                    {
                                        <div class="small" style="color:#6c757d;white-space:nowrap;">
                                            <i class="fas fa-receipt me-1"></i><span data-i18n-en="Receipt No:">رقم:</span> <strong id="knet-receipt-text-@s.Id">@s.KnetReceiptNumber</strong>
                                            <button type="button" class="btn btn-sm p-0 ms-1" style="font-size:11px;opacity:.6;" title="تعديل رقم الإيصال" onclick="openKnetModal(@s.Id, '@Html.Raw((s.KnetReceiptNumber ?? "").Replace("'", "\\'"))')"><i class="fas fa-pen"></i></button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small mt-1">
                                            <span class="badge bg-warning text-dark" style="font-size:10px;"><i class="fas fa-exclamation-triangle me-1"></i>غير موثقة</span>
                                            <button type="button" class="btn btn-sm p-0 ms-1 text-primary" style="font-size:11px;" title="إضافة رقم الإيصال" onclick="openKnetModal(@s.Id, '')"><i class="fas fa-plus-circle"></i> إضافة رقم الإيصال</button>
                                        </div>
                                    }
                                }
                                else if (s.PaymentMethod == "كاش" && s.PaidAmount.HasValue && s.PaidAmount > 0)
                                {
                                    <div><i class="fas fa-money-bill-wave me-1" style="color:#198754;"></i><span data-i18n-en="Cash">كاش</span></div>
                                    <div class="small" style="color:#198754;white-space:nowrap;">
                                        <i class="fas fa-hand-holding-usd me-1"></i><span data-i18n-en="Paid:">دفع:</span> @s.PaidAmount.Value.ToString("N3") د.ك
                                    </div>
                                    <div class="small" style="color:#e67e22;white-space:nowrap;">
                                        <i class="fas fa-coins me-1"></i><span data-i18n-en="Change:">الباقي:</span> @((s.ChangeAmount ?? 0).ToString("N3")) د.ك
                                    </div>
                                }
                                else
                                {
                                    @s.PaymentMethod
                                }
                            </td>
                            <td>
                                @{
                                    var rowStatusBadge = s.Status switch
                                    {
                                        "مكتمل" => "bg-success",
                                        Salon.Models.Sale.Statuses.Refunded => "bg-secondary",
                                        Salon.Models.Sale.Statuses.PartiallyRefunded => "bg-warning text-dark",
                                        _ => "bg-danger"
                                    };
                                }
                                <span class="badge @rowStatusBadge">@s.Status</span>
                            </td>
                            <td style="max-width:160px;">
                                <div class="d-flex align-items-start gap-1">
                                    <span class="small text-muted notes-cell-text" id="notes-text-@s.Id"
                                          style="white-space:pre-wrap;flex:1;">@s.Notes</span>
                                    <button type="button" class="btn btn-sm p-0 text-secondary"
                                            style="font-size:12px;flex-shrink:0;opacity:.6;"
                                            title="تعديل الملاحظات"
                                            onclick="openNotesModal(@s.Id, document.getElementById('notes-text-@s.Id').textContent.trim())">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = s.Id })" class="btn btn-sm btn-outline-primary me-1 d-inline-flex flex-column align-items-center" style="min-width:52px;">
                                    <i class="fas fa-eye"></i>
                                    <span style="font-size:0.65rem;line-height:1.2;margin-top:2px;">عرض</span>
                                </a>
                                <a href="@Url.Action("PrintInvoice", new { id = s.Id })" class="btn btn-sm btn-outline-dark me-1 d-inline-flex flex-column align-items-center" style="min-width:52px;" title="طباعة الفاتورة" target="_blank">
                                    <i class="fas fa-print"></i>
                                    <span style="font-size:0.65rem;line-height:1.2;margin-top:2px;">طباعة</span>
                                </a>
                                @if (s.Status != "ملغي" && canEditSale)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 d-inline-flex flex-column align-items-center" style="min-width:52px;" title="تعديل بيانات الفاتورة"
                                            onclick="openEditSaleModal(@s.Id, '@s.SaleDate.ToString("yyyy-MM-dd")', '@Html.Raw(s.PaymentMethod.Replace("'", "\\'"))', @(s.EmployeeId ?? 0), @(s.DebtEmployeeId ?? 0), @((s.CashAmount ?? 0).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)))">
                                        <i class="fas fa-edit"></i>
                                        <span style="font-size:0.65rem;line-height:1.2;margin-top:2px;">تعديل</span>
                                    </button>
                                }
                                @{
                                    bool canDelThis = s.SaleType == "مساج" ? canDelMassage
                                    : s.SaleType == "منتجات" ? canDelProduct
                                    : canDelBarber;
                                    bool canRefundThisRow = canRefund && s.Status != "ملغي" && s.RemainingRefundable > 0.001m;
                                }
                                @if (canRefundThisRow)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger me-1 d-inline-flex flex-column align-items-center" style="min-width:52px;" title="استرداد المبلغ"
                                            onclick="openRefundModal(@s.Id, '@Html.Raw(s.InvoiceNumber.Replace("'", "\\'"))', @s.RemainingRefundable.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))">
                                        <i class="fas fa-undo-alt"></i>
                                        <span style="font-size:0.65rem;line-height:1.2;margin-top:2px;">استرداد</span>
                                    </button>
                                }
                                @if (s.Status != "ملغي" && canDelThis)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex flex-column align-items-center" style="min-width:52px;" title="إلغاء الفاتورة"
                                            onclick="confirmDelete(@s.Id, '@Html.Raw(s.InvoiceNumber.Replace("'", "\\'"))')">
                                        <i class="fas fa-ban"></i>
                                        <span style="font-size:0.65rem;line-height:1.2;margin-top:2px;">إلغاء</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- K-Net Receipt Modal -->
<div class="modal fade" id="knetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0" style="background:#f0f4ff;">
                <h6 class="modal-title fw-bold"><i class="fas fa-receipt me-2 text-primary"></i>رقم إيصال كي نت</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="knetModalInput" class="form-control fw-bold"
                       placeholder="أدخل رقم الإيصال..." maxlength="100"
                       style="letter-spacing:1px;font-size:15px;" />
                <div id="knetModalStatus" class="small mt-2" style="min-height:18px;"></div>
                <div id="knetModalError" class="text-danger small mt-1" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary btn-sm fw-bold px-4" onclick="saveKnetReceipt()">
                    <i class="fas fa-save me-1"></i> حفظ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Notes Modal -->
<div class="modal fade" id="notesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold"><i class="fas fa-pen me-2 text-warning"></i>ملاحظات الفاتورة</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <textarea id="notesModalText" class="form-control" rows="4"
                          placeholder="اكتب الملاحظات هنا..."
                          style="resize:none;font-size:14px;"></textarea>
                <div id="notesModalError" class="text-danger small mt-2" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-warning btn-sm fw-bold px-4" onclick="saveNotes()">
                    <i class="fas fa-save me-1"></i> حفظ
                </button>
            </div>
        </div>
    </div>
</div>

@if (canEditSale)
{
    <!-- Edit Sale Modal -->
    <div class="modal fade" id="editSaleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold"><i class="fas fa-edit me-2 text-secondary"></i>تعديل بيانات الفاتورة</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label mb-1" style="font-size:12px">التاريخ</label>
                        <input type="date" id="editSaleDate" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-1" style="font-size:12px">طريقة الدفع</label>
                        <select id="editSalePaymentMethod" class="form-select" onchange="onEditPaymentMethodChange()">
                            <option value="كاش">كاش</option>
                            <option value="كي نت">كي نت</option>
                            <option value="كي نت و كاش">كي نت و كاش</option>
                            <option value="دين على العميل">دين على العميل</option>
                            <option value="دين على الموظف">دين على الموظف</option>
                            <option value="دين على الإدارة">دين على الإدارة</option>
                            <option value="مناصفة">مناصفة</option>
                            <option value="آجل">آجل</option>
                        </select>
                    </div>
                    <div class="mb-2" id="editSaleCashWrap" style="display:none;">
                        <label class="form-label mb-1" style="font-size:12px">مبلغ الكاش (من إجمالي الفاتورة)</label>
                        <input type="number" id="editSaleCashAmount" class="form-control" step="0.001" min="0" />
                    </div>
                    <div class="mb-2" id="editSaleDebtEmpWrap" style="display:none;">
                        <label class="form-label mb-1" style="font-size:12px">الموظف المدين</label>
                        <select id="editSaleDebtEmployee" class="form-select">
                            <option value="0">— اختر —</option>
                            @if (ViewBag.Employees != null)
                            {
                                @foreach (var emp in (IEnumerable<dynamic>)ViewBag.Employees)
                                {
                                    <option value="@emp.Id">@emp.FullName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label mb-1" style="font-size:12px">الموظف</label>
                        <select id="editSaleEmployee" class="form-select">
                            <option value="0">بدون موظف</option>
                            @if (ViewBag.Employees != null)
                            {
                                @foreach (var emp in (IEnumerable<dynamic>)ViewBag.Employees)
                                {
                                    <option value="@emp.Id">@emp.FullName</option>
                                }
                            }
                        </select>
                    </div>
                    <div id="editSaleError" class="text-danger small mt-1" style="display:none;"></div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-secondary btn-sm fw-bold px-4" onclick="saveSaleEdit()">
                        <i class="fas fa-save me-1"></i> حفظ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (canRefund)
{
    <!-- Refund Modal -->
    <div class="modal fade" id="refundModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fas fa-undo-alt me-2 text-danger"></i>استرداد مبلغ الفاتورة: <span id="refundInvoiceName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="refundForm" method="post" action="@Url.Action("Refund")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="refundSaleId" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">المبلغ المسترد (الحد الأقصى: <span id="refundMaxAmount"></span> د.ك)</label>
                            <input type="number" name="amount" id="refundAmount" class="form-control" step="0.001" min="0.001" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">سبب الاسترداد</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reason" id="idxReasonCustomer" value="إلغاء من العميل" checked />
                                <label class="form-check-label" for="idxReasonCustomer">إلغاء من العميل</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reason" id="idxReasonError" value="خطأ في الفاتورة" />
                                <label class="form-check-label" for="idxReasonError">خطأ في الفاتورة</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reason" id="idxReasonService" value="تعذر تقديم الخدمة" />
                                <label class="form-check-label" for="idxReasonService">تعذر تقديم الخدمة</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reason" id="idxReasonOther" value="سبب آخر" onchange="onIdxRefundReasonChange()" />
                                <label class="form-check-label" for="idxReasonOther">سبب آخر</label>
                            </div>
                        </div>
                        <div class="mb-3" id="idxRefundReasonDetailsWrap" style="display:none;">
                            <label class="form-label fw-semibold">تفاصيل السبب</label>
                            <textarea name="reasonDetails" id="idxRefundReasonDetails" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-1">
                            <label class="form-label fw-semibold">طريقة الاسترداد</label>
                            <select name="method" class="form-select" required>
                                <option value="كاش">كاش</option>
                                <option value="كي نت">KNET</option>
                                <option value="تحويل بنكي">تحويل بنكي</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-danger fw-bold px-4"><i class="fas fa-check me-1"></i> تأكيد الاسترداد</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الإلغاء</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من إلغاء الفاتورة:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-3">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="mb-4 text-start">
                    <label class="form-label text-white fw-semibold mb-1" style="font-size:14px;">
                        <i class="fas fa-pen me-1"></i> سبب الإلغاء <span class="text-warning">*</span>
                    </label>
                    <textarea id="deleteReason" rows="3" class="form-control"
                              placeholder="اكتب سبب إلغاء الفاتورة..."
                              style="border-radius:8px;resize:none;font-size:13px;"></textarea>
                    <div id="deleteReasonError" class="text-warning small mt-1" style="display:none;">
                        <i class="fas fa-exclamation-circle me-1"></i> يرجى كتابة سبب الإلغاء
                    </div>
                </div>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reason" id="deleteReasonInput" />
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold" onclick="return validateDeleteReason()">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRefundModal(saleId, invoiceNumber, maxAmount) {
            document.getElementById('refundSaleId').value = saleId;
            document.getElementById('refundInvoiceName').textContent = invoiceNumber;
            document.getElementById('refundMaxAmount').textContent = maxAmount;
            var amountInput = document.getElementById('refundAmount');
            amountInput.value = maxAmount;
            amountInput.max = maxAmount;
            document.getElementById('idxReasonOther').checked = false;
            document.getElementById('idxReasonCustomer').checked = true;
            document.getElementById('idxRefundReasonDetailsWrap').style.display = 'none';
            document.getElementById('idxRefundReasonDetails').value = '';
            new bootstrap.Modal(document.getElementById('refundModal')).show();
        }
        function onIdxRefundReasonChange() {
            document.getElementById('idxRefundReasonDetailsWrap').style.display =
                document.getElementById('idxReasonOther').checked ? '' : 'none';
        }
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            document.getElementById('deleteReason').value = '';
            document.getElementById('deleteReasonError').style.display = 'none';
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
            setTimeout(() => document.getElementById('deleteReason').focus(), 400);
        }
        function validateDeleteReason() {
            var reason = document.getElementById('deleteReason').value.trim();
            if (!reason) {
                document.getElementById('deleteReasonError').style.display = 'block';
                document.getElementById('deleteReason').focus();
                return false;
            }
            document.getElementById('deleteReasonInput').value = reason;
            return true;
        }
        // ── K-Net Receipt ────────────────────────────────────────────
        var _knetSaleId = null;
        var _knetModalInstance = null;
        var _knetCheckTimer = null;
        function openKnetModal(saleId, current) {
            _knetSaleId = saleId;
            var inp = document.getElementById('knetModalInput');
            inp.value = current || '';
            document.getElementById('knetModalStatus').innerHTML = '';
            document.getElementById('knetModalError').style.display = 'none';
            _knetModalInstance = new bootstrap.Modal(document.getElementById('knetModal'));
            _knetModalInstance.show();
            setTimeout(function() { inp.focus(); inp.select(); }, 350);
        }
        document.getElementById('knetModalInput').addEventListener('input', function() {
            var val = this.value.trim();
            var st = document.getElementById('knetModalStatus');
            clearTimeout(_knetCheckTimer);
            if (!val) { st.innerHTML = ''; return; }
            st.innerHTML = '<i class="fas fa-spinner fa-spin text-muted"></i>';
            _knetCheckTimer = setTimeout(function() {
                fetch('/Sales/CheckKnetReceipt?receipt=' + encodeURIComponent(val) + '&excludeSaleId=' + _knetSaleId)
                    .then(function(r) { return r.json(); })
                    .then(function(d) {
                        st.innerHTML = d.duplicate
                            ? '<i class="fas fa-times-circle text-danger me-1"></i><span class="text-danger">مستخدم مسبقاً</span>'
                            : '<i class="fas fa-check-circle text-success me-1"></i><span class="text-success">متاح</span>';
                    }).catch(function() { st.innerHTML = ''; });
            }, 500);
        });
        function saveKnetReceipt() {
            var receipt = document.getElementById('knetModalInput').value.trim();
            var statusHtml = document.getElementById('knetModalStatus').innerHTML;
            var errEl = document.getElementById('knetModalError');
            errEl.style.display = 'none';
            if (receipt && statusHtml.indexOf('fa-times-circle') !== -1) {
                errEl.textContent = 'رقم الإيصال مستخدم مسبقاً، يرجى إدخال رقم آخر';
                errEl.style.display = 'block';
                return;
            }
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('@Url.Action("UpdateKnetReceipt", "Sales")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams({ id: _knetSaleId, receipt: receipt, __RequestVerificationToken: token })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    if (_knetModalInstance) _knetModalInstance.hide();
                    location.reload();
                } else {
                    errEl.textContent = data.message || 'حدث خطأ';
                    errEl.style.display = 'block';
                }
            })
            .catch(function() { errEl.textContent = 'تعذّر الاتصال بالخادم'; errEl.style.display = 'block'; });
        }

        var _notesSaleId = null;
        var _notesModalInstance = null;
        function openNotesModal(saleId, currentNotes) {
            _notesSaleId = saleId;
            document.getElementById('notesModalText').value = currentNotes || '';
            document.getElementById('notesModalError').style.display = 'none';
            _notesModalInstance = new bootstrap.Modal(document.getElementById('notesModal'));
            _notesModalInstance.show();
            setTimeout(function() { document.getElementById('notesModalText').focus(); }, 350);
        }
        function saveNotes() {
            var notes = document.getElementById('notesModalText').value.trim();
            var errEl = document.getElementById('notesModalError');
            errEl.style.display = 'none';
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('@Url.Action("UpdateNotes", "Sales")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams({ id: _notesSaleId, notes: notes, __RequestVerificationToken: token })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    document.getElementById('notes-text-' + _notesSaleId).textContent = data.notes;
                    if (_notesModalInstance) _notesModalInstance.hide();
                } else {
                    errEl.textContent = data.message || 'حدث خطأ';
                    errEl.style.display = 'block';
                }
            })
            .catch(function() { errEl.textContent = 'تعذّر الاتصال بالخادم'; errEl.style.display = 'block'; });
        }

        // ── Edit Sale (date / payment method / employee) ──────────────
        var _editSaleId = null;
        var _editSaleModalInstance = null;
        function onEditPaymentMethodChange() {
            var pm = document.getElementById('editSalePaymentMethod').value;
            document.getElementById('editSaleCashWrap').style.display = (pm === 'كي نت و كاش') ? '' : 'none';
            document.getElementById('editSaleDebtEmpWrap').style.display = (pm === 'دين على الموظف') ? '' : 'none';
        }
        function openEditSaleModal(saleId, saleDate, paymentMethod, employeeId, debtEmployeeId, cashAmount) {
            _editSaleId = saleId;
            document.getElementById('editSaleDate').value = saleDate;
            document.getElementById('editSalePaymentMethod').value = paymentMethod;
            document.getElementById('editSaleEmployee').value = employeeId || 0;
            document.getElementById('editSaleDebtEmployee').value = debtEmployeeId || 0;
            document.getElementById('editSaleCashAmount').value = cashAmount || '';
            document.getElementById('editSaleError').style.display = 'none';
            onEditPaymentMethodChange();
            _editSaleModalInstance = new bootstrap.Modal(document.getElementById('editSaleModal'));
            _editSaleModalInstance.show();
        }
        function saveSaleEdit() {
            var errEl = document.getElementById('editSaleError');
            errEl.style.display = 'none';
            var pm = document.getElementById('editSalePaymentMethod').value;
            var payload = {
                id: _editSaleId,
                saleDate: document.getElementById('editSaleDate').value,
                paymentMethod: pm,
                employeeId: document.getElementById('editSaleEmployee').value || 0
            };
            if (pm === 'كي نت و كاش') payload.cashAmount = document.getElementById('editSaleCashAmount').value || 0;
            if (pm === 'دين على الموظف') payload.debtEmployeeId = document.getElementById('editSaleDebtEmployee').value || 0;

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            payload.__RequestVerificationToken = token;
            fetch('@Url.Action("UpdateSaleDetails", "Sales")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: new URLSearchParams(payload)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    if (_editSaleModalInstance) _editSaleModalInstance.hide();
                    location.reload();
                } else {
                    errEl.textContent = data.message || 'حدث خطأ';
                    errEl.style.display = 'block';
                }
            })
            .catch(function() { errEl.textContent = 'تعذّر الاتصال بالخادم'; errEl.style.display = 'block'; });
        }
    </script>
}