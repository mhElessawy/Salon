@model Salon.Models.Sale
@{
    Layout = null;

    // ── بيانات الصالون — عدّل هنا ──────────────────────────────
    const string SalonNameAr  = "معهد موس";
    const string SalonNameEn  = "Mos Institute";
    const string SalonPhone   = "+965 XXXX XXXX";
    const string SalonAddress = "الكويت";
    // ────────────────────────────────────────────────────────────

    var saleTypeAr = Model.SaleType;
    var saleTypeEn = Model.SaleType switch {
        "حلاقة"   => "Barbering",
        "مساج"    => "Massage",
        "منتجات"  => "Products",
        _          => Model.SaleType
    };
    var accentColor = Model.SaleType switch {
        "مساج"   => "#0d9488",
        "منتجات" => "#2563eb",
        _         => "#b45309"
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@SalonNameAr — @Model.InvoiceNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            background: #f3f4f6;
            direction: rtl;
            color: #1f2937;
        }

        .invoice-wrapper {
            max-width: 740px;
            margin: 30px auto;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 6px 32px rgba(0,0,0,0.10);
            overflow: hidden;
            border-top: 5px solid @accentColor;
        }

        /* ─── Header ─────────────────────────────────── */
        .inv-header {
            background: #fff;
            padding: 24px 32px 18px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 1px solid #e5e7eb;
        }

        .salon-block .salon-name-ar {
            font-size: 1.6rem;
            font-weight: 800;
            color: #111827;
            letter-spacing: .5px;
        }

        .salon-block .salon-name-en {
            font-size: 0.9rem;
            color: #6b7280;
            font-weight: 600;
            letter-spacing: 1px;
            margin-top: 1px;
        }

        .salon-block .salon-contact {
            margin-top: 8px;
            font-size: 0.78rem;
            color: #6b7280;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .salon-block .salon-contact span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .inv-number-block {
            text-align: center;
        }

        .inv-number-block .type-badge {
            display: inline-block;
            background: @accentColor;
            color: #fff;
            border-radius: 6px;
            padding: 3px 14px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: .5px;
            margin-bottom: 8px;
        }

        .inv-number-block .inv-num {
            font-size: 1.3rem;
            font-weight: 800;
            color: #111827;
            letter-spacing: 1px;
        }

        .inv-number-block .inv-lbl {
            font-size: 0.68rem;
            color: #9ca3af;
            display: flex;
            flex-direction: column;
            gap: 1px;
            margin-top: 2px;
            text-align: center;
        }

        /* ─── Info strip ──────────────────────────────── */
        .info-strip {
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            padding: 14px 32px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px 32px;
        }

        .info-cell {}

        .info-cell .bi-label {
            font-size: 0.68rem;
            color: #9ca3af;
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
        }

        .info-cell .bi-label span:last-child {
            font-style: italic;
        }

        .info-cell .bi-value {
            font-size: 0.9rem;
            font-weight: 600;
            color: #111827;
        }

        /* ─── Body ────────────────────────────────────── */
        .inv-body {
            padding: 20px 32px 24px;
        }

        /* ─── Items Table ─────────────────────────────── */
        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            margin-bottom: 20px;
        }

        .items-table thead tr {
            background: @accentColor;
            color: #fff;
        }

        .items-table thead th {
            padding: 9px 12px;
            font-weight: 600;
            text-align: right;
        }

        .items-table thead th .th-en {
            display: block;
            font-size: 0.65rem;
            opacity: .75;
            font-weight: 400;
            font-style: italic;
        }

        .items-table tbody tr:nth-child(even) { background: #f9fafb; }

        .items-table tbody td {
            padding: 9px 12px;
            border-bottom: 1px solid #f0f0f0;
            color: #374151;
        }

        /* ─── Totals ──────────────────────────────────── */
        .totals-section {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 18px;
        }

        .totals-box {
            background: #f9fafb;
            border-radius: 10px;
            padding: 14px 20px;
            min-width: 290px;
            border: 1px solid #e5e7eb;
        }

        .totals-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 5px 0;
            font-size: 0.88rem;
            color: #555;
        }

        .totals-row .tr-label {
            display: flex;
            flex-direction: column;
        }

        .totals-row .tr-label span:last-child {
            font-size: 0.65rem;
            color: #aaa;
            font-style: italic;
        }

        .totals-row.net {
            border-top: 2px solid @accentColor;
            margin-top: 8px;
            padding-top: 10px;
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827;
        }

        /* ─── Payment ─────────────────────────────────── */
        .payment-section { margin-bottom: 14px; }

        .pay-label {
            font-size: 0.68rem;
            color: #9ca3af;
            display: flex;
            gap: 6px;
            margin-bottom: 4px;
        }

        .payment-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #ecfdf5;
            color: #065f46;
            border-radius: 20px;
            padding: 5px 16px;
            font-size: 0.85rem;
            font-weight: 600;
            border: 1px solid #a7f3d0;
        }

        /* ─── Notes ───────────────────────────────────── */
        .notes-box {
            background: #fffbeb;
            border-right: 4px solid #fbbf24;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 0.85rem;
            color: #78350f;
        }

        /* ─── Footer ──────────────────────────────────── */
        .inv-footer {
            background: #f9fafb;
            border-top: 1px solid #e5e7eb;
            padding: 14px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.75rem;
            color: #9ca3af;
        }

        .inv-footer .thank-you {
            font-weight: 700;
            color: @accentColor;
            font-size: 0.85rem;
        }

        /* ─── Action bar ──────────────────────────────── */
        .action-bar {
            padding: 14px 32px;
            display: flex;
            gap: 10px;
            justify-content: center;
            border-top: 1px solid #e5e7eb;
        }

        @@media print {
            body { background: #fff; }
            .action-bar { display: none !important; }
            .invoice-wrapper { box-shadow: none; border-radius: 0; margin: 0; max-width: 100%; }
            .inv-footer { background: #fff; }
        }
    </style>
</head>
<body>

<div class="invoice-wrapper">

    <!-- ─── Header ────────────────────────────────────────── -->
    <div class="inv-header">
        <div class="salon-block">
            <div class="salon-name-ar">@SalonNameAr</div>
            <div class="salon-name-en">@SalonNameEn</div>
            <div class="salon-contact">
                <span>📞 @SalonPhone</span>
                <span>📍 @SalonAddress</span>
            </div>
        </div>
        <div class="inv-number-block">
            <div class="type-badge">@saleTypeAr · @saleTypeEn</div>
            <div class="inv-num">@Model.InvoiceNumber</div>
            <div class="inv-lbl">
                <span>رقم الفاتورة</span>
                <span>Invoice No.</span>
            </div>
        </div>
    </div>

    <!-- ─── Info Strip ────────────────────────────────────── -->
    <div class="info-strip">
        <div class="info-cell">
            <div class="bi-label"><span>التاريخ والوقت</span><span>Date &amp; Time</span></div>
            <div class="bi-value">@Model.SaleDate.ToString("yyyy/MM/dd  hh:mm tt")</div>
        </div>
        <div class="info-cell">
            <div class="bi-label"><span>العميل</span><span>Customer</span></div>
            <div class="bi-value">@(Model.Customer?.FullName ?? "زائر / Walk-in")</div>
        </div>
        <div class="info-cell">
            <div class="bi-label"><span>الموظف المُنفِّذ</span><span>Served By</span></div>
            <div class="bi-value">@(Model.Employee?.FullName ?? "—")</div>
        </div>
        <div class="info-cell">
            <div class="bi-label"><span>نوع الفاتورة</span><span>Invoice Type</span></div>
            <div class="bi-value">@saleTypeAr / @saleTypeEn</div>
        </div>
    </div>

    <!-- ─── Body ──────────────────────────────────────────── -->
    <div class="inv-body">

        <!-- Items Table -->
        <table class="items-table">
            <thead>
                <tr>
                    <th style="width:36px;">#</th>
                    <th>
                        البيان
                        <span class="th-en">Description</span>
                    </th>
                    <th class="text-center" style="width:70px;">
                        الكمية
                        <span class="th-en">Qty</span>
                    </th>
                    <th class="text-center" style="width:100px;">
                        السعر
                        <span class="th-en">Price</span>
                    </th>
                    <th class="text-center" style="width:110px;">
                        الإجمالي
                        <span class="th-en">Total</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNum = 1; }
                @foreach (var item in Model.SaleItems)
                {
                    <tr>
                        <td>@(rowNum++)</td>
                        <td>@item.ItemName</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-center">@item.Price.ToString("N3")</td>
                        <td class="text-center">@item.Total.ToString("N3") د.ك</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Totals -->
        <div class="totals-section">
            <div class="totals-box">
                <div class="totals-row">
                    <div class="tr-label">
                        <span>المجموع الكلي</span>
                        <span>Subtotal</span>
                    </div>
                    <span>@Model.TotalAmount.ToString("N3") د.ك</span>
                </div>
                @if (Model.Discount > 0)
                {
                    <div class="totals-row" style="color:#c0392b">
                        <div class="tr-label">
                            <span>الخصم</span>
                            <span>Discount</span>
                        </div>
                        <span>- @Model.Discount.ToString("N3") د.ك</span>
                    </div>
                }
                <div class="totals-row net">
                    <div class="tr-label">
                        <span>الصافي المستحق</span>
                        <span style="font-size:0.7rem;color:#6b7280;font-style:italic;">Amount Due</span>
                    </div>
                    <span>@Model.NetAmount.ToString("N3") د.ك</span>
                </div>
                @if (Model.EmployeeGift.HasValue && Model.EmployeeGift > 0)
                {
                    <div class="totals-row" style="color:#d97706;border-top:1px dashed #fde68a;margin-top:8px;padding-top:8px;">
                        <div class="tr-label">
                            <span>عمولة خدمة للموظف</span>
                            <span>Service Commission</span>
                        </div>
                        <span style="font-weight:700;">@Model.EmployeeGift.Value.ToString("N3") د.ك</span>
                    </div>
                }
                @if (Model.GiftForEmployee.HasValue && Model.GiftForEmployee > 0)
                {
                    <div class="totals-row" style="color:#c0392b;border-top:1px dashed #fca5a5;margin-top:8px;padding-top:8px;">
                        <div class="tr-label">
                            <span>هدية للموظف</span>
                            <span>Staff Gift</span>
                        </div>
                        <span style="font-weight:700;">@Model.GiftForEmployee.Value.ToString("N3") د.ك</span>
                    </div>
                    @{
                        var totalCollect = Model.NetAmount + (Model.GiftForEmployee ?? 0);
                    }
                    <div class="totals-row" style="font-size:1rem;font-weight:800;color:#c0392b;background:#fef2f2;border-radius:6px;padding:6px 8px;margin-top:6px;">
                        <div class="tr-label">
                            <span>إجمالي التحصيل من العميل</span>
                            <span style="font-size:0.65rem;color:#ef4444;font-style:italic;">Total to Collect</span>
                        </div>
                        <span>@totalCollect.ToString("N3") د.ك</span>
                    </div>
                }
            </div>
        </div>

        @if (Model.GiftForEmployee.HasValue && Model.GiftForEmployee > 0)
        {
            <div class="notes-box" style="background:#fef2f2;border-right-color:#ef4444;margin-bottom:14px;">
                <strong>ملاحظة / Note: </strong>
                مبلغ الهدية <strong>@Model.GiftForEmployee.Value.ToString("N3") د.ك</strong> خاص بالموظف <strong>@(Model.Employee?.FullName ?? "")</strong> ويُصرف له مع الراتب
            </div>
        }

        <!-- Payment Method -->
        <div class="payment-section">
            <div class="pay-label">
                <span>طريقة الدفع</span>
                <span>/</span>
                <span>Payment Method</span>
            </div>
            @if (Model.PaymentMethod == "مناصفة" && (Model.CashAmount.HasValue || Model.LinkAmount.HasValue))
            {
                <span class="payment-chip" style="background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe;">
                    نقدي: @(Model.CashAmount?.ToString("N3") ?? "0.000") د.ك &nbsp;|&nbsp; رابط: @(Model.LinkAmount?.ToString("N3") ?? "0.000") د.ك
                </span>
            }
            else if (Model.PaymentMethod == "كي نت و كاش" && (Model.CashAmount.HasValue || Model.LinkAmount.HasValue))
            {
                <span class="payment-chip" style="background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe;">
                    كاش: @(Model.CashAmount?.ToString("N3") ?? "0.000") د.ك &nbsp;|&nbsp; كي نت: @((Model.NetAmount - (Model.CashAmount ?? 0)).ToString("N3")) د.ك
                </span>
            }
            else if (Model.PaymentMethod == "آجل" && Model.DebtEmployee != null)
            {
                <span class="payment-chip" style="background:#fef2f2;color:#c62828;border-color:#fca5a5;">
                    آجل / Credit — @Model.DebtEmployee.FullName
                </span>
            }
            else
            {
                <span class="payment-chip">@Model.PaymentMethod</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="notes-box">
                <strong>ملاحظات / Notes: </strong>@Model.Notes
            </div>
        }

    </div><!-- /inv-body -->

    <!-- ─── Footer ────────────────────────────────────────── -->
    <div class="inv-footer">
        <div>
            <div>@SalonNameAr · @SalonNameEn</div>
            <div style="margin-top:2px;">📞 @SalonPhone &nbsp;·&nbsp; 📍 @SalonAddress</div>
        </div>
        <div class="thank-you">شكراً لزيارتكم · Thank You</div>
    </div>

    <!-- ─── Action Bar ─────────────────────────────────────── -->
    @{
        var isModal = Context.Request.Query.ContainsKey("modal");
    }
    @if (!isModal)
    {
        <div class="action-bar">
            <button onclick="window.print()" class="btn btn-dark px-4">
                🖨 طباعة / Print
            </button>
            <a href="@Url.Action("Index", "Sales", new { type = Model.SaleType })" class="btn btn-outline-secondary px-4">
                رجوع / Back
            </a>
        </div>
    }

</div><!-- /invoice-wrapper -->

<script>
    if (!new URLSearchParams(window.location.search).get('modal')) {
        window.onload = function () { window.print(); };
    }
</script>

</body>
</html>
