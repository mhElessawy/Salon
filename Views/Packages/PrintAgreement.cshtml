@model Salon.Models.PackageAgreement
@{
    Layout = null;

    string SalonNameAr = ViewBag.SalonName ?? "معهد موس";
    string SalonNameEn = ViewBag.SalonNameEn ?? "Mos Institute";
    string SalonPhone = ViewBag.SalonPhone ?? "";
    string SalonAddress = ViewBag.SalonAddress ?? "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>اتفاقية باقة — @Model.InvoiceNumber</title>
    <style>
        @@page {
            size: A4;
            margin: 14mm 16mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Tahoma', 'Segoe UI', Arial, sans-serif;
            direction: rtl;
            color: #1a1a2e;
            background: #fff;
            font-size: 12.5px;
            line-height: 1.6;
            margin: 0;
        }

        .doc {
            max-width: 800px;
            margin: 0 auto;
            padding: 6mm;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #1a1a2e;
            padding-bottom: 10px;
            margin-bottom: 16px;
        }

        .salon-ar {
            font-size: 19px;
            font-weight: 800;
        }

        .salon-en {
            font-size: 12px;
            color: #555;
            font-weight: 600;
        }

        .salon-contact {
            font-size: 11px;
            color: #777;
            margin-top: 3px;
        }

        .doc-title {
            text-align: center;
            font-size: 16px;
            font-weight: 800;
            margin: 14px 0 6px;
            color: #F7941D;
        }

        .doc-title-en {
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            color: #777;
            margin-bottom: 16px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 24px;
            margin-bottom: 16px;
        }

        .box {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px 14px;
        }

        .box-title {
            font-size: 11px;
            font-weight: 700;
            color: #F7941D;
            margin-bottom: 6px;
        }

        .row-line {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
            font-size: 12px;
        }

            .row-line .lbl {
                color: #666;
            }

            .row-line .val {
                font-weight: 700;
            }

        .terms-block {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 14px 16px;
            margin: 10px 0;
            font-size: 11.5px;
            white-space: pre-wrap;
            line-height: 1.9;
        }

            .terms-block.en {
                direction: ltr;
                text-align: left;
            }

        .section-title {
            font-weight: 800;
            font-size: 13px;
            margin: 16px 0 6px;
            border-right: 4px solid #F7941D;
            padding-right: 8px;
        }

            .section-title.en {
                border-right: none;
                border-left: 4px solid #F7941D;
                padding-left: 8px;
                padding-right: 0;
            }

        .agree-line {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            font-weight: 700;
            margin: 10px 0;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 10px 14px;
        }

        .sig-area {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-top: 20px;
        }

        .sig-box {
            flex: 1;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px 14px;
            text-align: center;
        }

        .sig-img {
            max-width: 100%;
            max-height: 90px;
            border-bottom: 1px solid #999;
            padding-bottom: 6px;
            margin-bottom: 6px;
        }

        .sig-meta {
            font-size: 10.5px;
            color: #666;
        }

        .footer-note {
            margin-top: 20px;
            font-size: 10px;
            color: #999;
            text-align: center;
            border-top: 1px dashed #ddd;
            padding-top: 8px;
        }

        .action-bar {
            padding: 10px 0 0;
            display: flex;
            gap: 8px;
            justify-content: center;
        }

            .action-bar button, .action-bar a {
                font-size: 12px;
                padding: 8px 18px;
                border-radius: 6px;
                border: 1px solid #1a1a2e;
                background: #1a1a2e;
                color: #fff;
                text-decoration: none;
                cursor: pointer;
                font-family: inherit;
            }

            .action-bar a {
                background: #fff;
                color: #1a1a2e;
            }

        @@media print {
            .action-bar {
                display: none !important;
            }
        }

        @@media screen {
            body {
                background: #e5e7eb;
            }

            .doc {
                background: #fff;
                box-shadow: 0 2px 14px rgba(0,0,0,0.15);
                margin-top: 10mm;
                margin-bottom: 10mm;
            }
        }
    </style>
</head>
<body>
    <div class="doc">
        <div class="header">
            <div class="salon-ar">@SalonNameAr</div>
            <div class="salon-en">@SalonNameEn</div>
            <div class="salon-contact">
                @if (!string.IsNullOrWhiteSpace(SalonPhone))
                {
                    <span>📞 @SalonPhone</span>
                }
                @if (!string.IsNullOrWhiteSpace(SalonAddress))
                {
                    <span> &nbsp;|&nbsp; 📍 @SalonAddress</span>
                }
            </div>
        </div>

        <div class="doc-title">اتفاقية الاشتراك في الباقة</div>
        <div class="doc-title-en">Package Subscription Agreement</div>

        <div class="grid">
            <div class="box">
                <div class="box-title">بيانات العميل / Customer</div>
                <div class="row-line"><span class="lbl">الاسم</span><span class="val">@Model.CustomerName</span></div>
                <div class="row-line"><span class="lbl">رقم الهاتف</span><span class="val">@(Model.CustomerPhone ?? "—")</span></div>
            </div>
            <div class="box">
                <div class="box-title">بيانات الباقة / Package</div>
                <div class="row-line"><span class="lbl">اسم الباقة</span><span class="val">@Model.PackageNameAr @(string.IsNullOrEmpty(Model.PackageNameEn) ? "" : $"({Model.PackageNameEn})")</span></div>
                <div class="row-line"><span class="lbl">عدد الجلسات</span><span class="val">@Model.SessionCount</span></div>
            </div>
            <div class="box">
                <div class="box-title">تفاصيل البيع / Sale Details</div>
                <div class="row-line"><span class="lbl">قيمة الباقة</span><span class="val">@Model.PackagePrice.ToString("N3") د.ك</span></div>
                <div class="row-line"><span class="lbl">المبلغ المدفوع</span><span class="val">@Model.AmountPaid.ToString("N3") د.ك</span></div>
                <div class="row-line"><span class="lbl">طريقة الدفع</span><span class="val">@Model.PaymentMethod</span></div>
                @if (Model.PaymentMethod == "كي نت و كاش" && (Model.CashAmount.HasValue || Model.LinkAmount.HasValue))
                {
                    <div class="row-line"><span class="lbl">مبلغ الكاش</span><span class="val">@((Model.CashAmount ?? 0).ToString("N3")) د.ك</span></div>
                    <div class="row-line"><span class="lbl">مبلغ كي نت</span><span class="val">@((Model.LinkAmount ?? 0).ToString("N3")) د.ك</span></div>
                }
                <div class="row-line"><span class="lbl">رقم الفاتورة</span><span class="val">@Model.InvoiceNumber</span></div>
            </div>
            <div class="box">
                <div class="box-title">التواريخ / Dates</div>
                <div class="row-line"><span class="lbl">تاريخ الشراء</span><span class="val">@Model.PurchaseDate.ToString("yyyy/MM/dd")</span></div>
                <div class="row-line"><span class="lbl">تاريخ الانتهاء</span><span class="val">@(Model.ExpiryDate.HasValue? Model.ExpiryDate.Value.ToString("yyyy/MM/dd") : "—")</span></div>
            </div>
        </div>

        <div class="section-title">الشروط والأحكام</div>
        <div class="terms-block">@Model.TermsAr</div>

        <div class="section-title en">Terms &amp; Conditions</div>
        <div class="terms-block en">@Model.TermsEn</div>

        <div class="agree-line">
            <span>☑</span>
            <span>أقر بأنني قرأت ووافقت على شروط وأحكام الباقة — I acknowledge that I have read and agreed to the package terms &amp; conditions</span>
        </div>

        <div class="sig-area">
            <div class="sig-box">
                @if (!string.IsNullOrEmpty(Model.SignatureImage))
                {
                    <img src="@Model.SignatureImage" class="sig-img" alt="التوقيع الإلكتروني" />
                }
                <div class="sig-meta">
                    التوقيع الإلكتروني للعميل / Customer Electronic Signature<br />
                    @Model.SignedAt.ToString("yyyy/MM/dd hh:mm tt")
                </div>
            </div>
            <div class="sig-box">
                <div class="sig-meta" style="margin-top:40px;">
                    المستخدم / Cashier: <strong>@Model.SignedByUserName</strong><br />
                    رقم الفاتورة / Invoice: <strong>@Model.InvoiceNumber</strong>
                </div>
            </div>
        </div>

        <div class="footer-note">
            اتفاقية إلكترونية موقّعة رقم #@Model.Id — تم إنشاؤها آلياً بواسطة النظام ولا تحتاج توقيعاً ورقياً إضافياً
        </div>

        @{
            var isModal = Context.Request.Query.ContainsKey("modal");
        }
        @if (!isModal)
        {
            <div class="action-bar">
                <button onclick="window.print()">🖨 طباعة / حفظ PDF</button>
                <a href="@Url.Action("Index", "Packages", new { tab = "balances" })">رجوع</a>
            </div>
        }
    </div>
</body>
</html>