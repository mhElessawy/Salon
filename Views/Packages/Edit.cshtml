@model Salon.Models.ServicePackage
@{
    ViewData["Title"] = "تعديل الباقة";
}

<div class="page-header">
    <h1><i class="fas fa-edit me-2"></i>تعديل الباقة</h1>
</div>

<div class="card" style="max-width:750px">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NameAr" class="form-label"></label>
                    <input asp-for="NameAr" class="form-control" />
                    <span asp-validation-for="NameAr" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NameEn" class="form-label"></label>
                    <input asp-for="NameEn" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="SessionCount" class="form-label"></label>
                    <input asp-for="SessionCount" type="number" min="1" max="1000" class="form-control" />
                    <span asp-validation-for="SessionCount" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Price" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Price" type="number" step="0.001" min="0" class="form-control" />
                        <span class="input-group-text">د.ك</span>
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ValidityDays" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ValidityDays" type="number" min="1" max="3650" class="form-control" />
                        <span class="input-group-text">يوم</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label asp-for="ServiceCategoryId" class="form-label">فئة الخدمة</label>
                    <select asp-for="ServiceCategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- كل الفئات --</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">مفعّل</label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save me-1"></i> حفظ التعديلات
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-arrow-right me-1"></i> رجوع
                </a>
            </div>
        </form>
    </div>
</div>
