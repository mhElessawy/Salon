@{
    ViewData["Title"] = "صلاحيات المستخدم";
    var userId = ViewBag.UserId as string ?? "";
    var userName = ViewBag.UserFullName as string ?? "";
    var userRole = ViewBag.UserRole as string ?? "";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var permSet = ViewBag.PermSet as Dictionary<string, bool> ?? new();
    var modules = ViewBag.Modules as List<(string Key, string NameAr, string Icon, string Group)>
                     ?? new();
    var groups = modules.GroupBy(m => m.Group);

    var roleAr = userRole switch
    {
        "Admin" => "مدير النظام",
        "Manager" => "مدير",
        "Cashier" => "كاشير",
        "Employee" => "موظف",
        _ => userRole
    };
}

@section Styles {
    <style>
        .perm-card {
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .perm-group-header {
            background: #f8f9fa;
            padding: 12px 18px;
            font-weight: 700;
            font-size: 14px;
            border-bottom: 2px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .perm-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 18px;
            border-bottom: 1px solid #f0f0f0;
        }

            .perm-row:last-child {
                border-bottom: none;
            }

        .perm-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
        }

            .perm-label i {
                width: 20px;
                text-align: center;
                color: var(--primary);
            }

        .form-switch .form-check-input {
            width: 3em;
            height: 1.5em;
            cursor: pointer;
        }

            .form-switch .form-check-input:checked {
                background-color: var(--primary);
                border-color: var(--primary);
            }

        .select-all-bar {
            background: var(--primary);
            color: #fff;
            padding: 10px 18px;
            border-radius: 10px;
            margin-bottom: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    </style>
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-key me-2"></i>صلاحيات: @userName</h1>
        <p>الدور: <span class="badge bg-primary">@roleAr</span></p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-right me-1"></i> رجوع للمستخدمين
    </a>
</div>

@if (isAdmin)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        مدير النظام لديه صلاحيات كاملة لا يمكن تقييدها.
    </div>
}
else
{
    <form asp-action="Permissions" method="post" id="permForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@userId" />

        <div class="select-all-bar">
            <span><i class="fas fa-check-double me-2"></i>تحديد سريع</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-light" onclick="setAll(true)">
                    <i class="fas fa-check-square me-1"></i> تحديد الكل
                </button>
                <button type="button" class="btn btn-sm btn-outline-light" onclick="setAll(false)">
                    <i class="fas fa-times me-1"></i> إلغاء الكل
                </button>
            </div>
        </div>

        @foreach (var group in groups)
        {
            <div class="card perm-card">
                <div class="perm-group-header">
                    <i class="fas fa-layer-group text-primary"></i>
                    @group.Key
                    <small class="text-muted me-auto">(@group.Count() شاشة)</small>
                    <button type="button" class="btn btn-sm btn-outline-primary py-0"
                            onclick="setGroup('@group.Key', true)" style="font-size:12px">
                        كل المجموعة
                    </button>
                </div>
                @foreach (var mod in group)
                {
                    var hasAccess = permSet.TryGetValue(mod.Key, out var val) && val;
                    <div class="perm-row" data-group="@group.Key">
                        <div class="perm-label">
                            <i class="@mod.Icon"></i>
                            <span>@mod.NameAr</span>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input perm-toggle" type="checkbox"
                                   name="allowedModules" value="@mod.Key"
                                   id="perm_@mod.Key" @(hasAccess ? "checked" : "") />
                            <label class="form-check-label" for="perm_@mod.Key" id="label_@mod.Key"
                                   style="font-size:13px;color:@(hasAccess ? "var(--primary)" : "#adb5bd")">
                                @(hasAccess ? "مسموح" : "محظور")
                            </label>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="d-flex gap-3 mt-3">
            <button type="submit" class="btn btn-primary px-5">
                <i class="fas fa-save me-2"></i> حفظ الصلاحيات
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">رجوع</a>
        </div>
    </form>
}

@section Scripts {
    <script>
        document.querySelectorAll('.perm-toggle').forEach(cb => {
            cb.addEventListener('change', function() {
                const label = document.getElementById('label_' + this.value);
                if (label) {
                    label.textContent = this.checked ? 'مسموح' : 'محظور';
                    label.style.color  = this.checked ? 'var(--primary)' : '#adb5bd';
                }
            });
        });

        function setAll(val) {
            document.querySelectorAll('.perm-toggle').forEach(cb => {
                cb.checked = val;
                const label = document.getElementById('label_' + cb.value);
                if (label) {
                    label.textContent = val ? 'مسموح' : 'محظور';
                    label.style.color  = val ? 'var(--primary)' : '#adb5bd';
                }
            });
        }

        function setGroup(groupName, val) {
            document.querySelectorAll(`[data-group="${groupName}"] .perm-toggle`).forEach(cb => {
                cb.checked = val;
                const label = document.getElementById('label_' + cb.value);
                if (label) {
                    label.textContent = val ? 'مسموح' : 'محظور';
                    label.style.color  = val ? 'var(--primary)' : '#adb5bd';
                }
            });
        }
    </script>
}