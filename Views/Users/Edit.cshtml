@model Salon.Models.EditUserViewModel
@{
    ViewData["Title"] = "تعديل المستخدم";
    var roles = ViewBag.Roles as List<string> ?? new();
}

<div class="page-header">
    <h1><i class="fas fa-user-edit me-2"></i>تعديل بيانات المستخدم</h1>
</div>

<div class="card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Role" class="form-label"></label>
                    <div class="row g-2">
                        @foreach (var role in roles)
                        {
                            var roleAr = role switch
                            {
                                "Admin" => "مدير النظام",
                                "Manager" => "مدير",
                                "Cashier" => "كاشير",
                                "Employee" => "موظف",
                                _ => role
                            };
                            var roleIcon = role switch
                            {
                                "Admin" => "fas fa-crown",
                                "Manager" => "fas fa-user-tie",
                                "Cashier" => "fas fa-cash-register",
                                "Employee" => "fas fa-user",
                                _ => "fas fa-user"
                            };
                            var roleColor = role switch
                            {
                                "Admin" => "#dc3545",
                                "Manager" => "#ffc107",
                                "Cashier" => "#0dcaf0",
                                "Employee" => "#6c757d",
                                _ => "#6c757d"
                            };
                            <div class="col-6 col-md-3">
                                <input type="radio" name="Role" id="role_@role" value="@role"
                                       class="btn-check" @(Model.Role == role ? "checked" : "") />
                                <label class="btn btn-outline-secondary w-100 d-flex flex-column align-items-center gap-1 py-3"
                                       for="role_@role" style="font-size:13px;">
                                    <i class="@roleIcon" style="font-size:20px;color:@roleColor"></i>
                                    @roleAr
                                </label>
                            </div>
                        }
                    </div>
                </div>
                @* القسم *@
                <div class="col-12" id="deptSection">
                    <label class="form-label">القسم <small class="text-muted">(للكاشير والموظف)</small></label>
                    <div class="d-flex gap-3 flex-wrap">
                        @foreach (var d in new[] { ("حلاقة", "fas fa-cut", "#F7941D"), ("مساج", "fas fa-spa", "#17a2b8"), ("الكل", "fas fa-layer-group", "#6c757d") })
                        {
                            <div>
                                <input type="radio" name="UserDepartment" id="dept_@d.Item1" value="@d.Item1"
                                       class="btn-check" @(Model.UserDepartment == d.Item1 ? "checked" : "") />
                                <label class="btn btn-outline-secondary d-flex flex-column align-items-center gap-1 px-4 py-2"
                                       for="dept_@d.Item1" style="font-size:13px;">
                                    <i class="@d.Item2" style="font-size:18px;color:@d.Item3"></i>
                                    @d.Item1
                                </label>
                            </div>
                        }
                    </div>
                </div>

                @* الموظف المرتبط *@
                <div class="col-12" id="empLinkSection">
                    <label asp-for="LinkedEmployeeId" class="form-label"></label>
                    <select asp-for="LinkedEmployeeId" asp-items="ViewBag.Employees" class="form-select">
                        <option value="">-- لا يوجد ربط --</option>
                    </select>
                    <small class="text-muted">إذا كان الدور "موظف" سيُنشئ فواتير باسمه فقط</small>
                </div>

                <div class="col-12">
                    <label asp-for="IsActive" class="form-label d-block">الحالة</label>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">المستخدم نشط</label>
                    </div>
                </div>
            </div>
            <script>
                function updateSections() {
                    const role = document.querySelector('input[name="Role"]:checked')?.value ?? '';
                    document.getElementById('deptSection').style.display = (role==='Cashier'||role==='Employee') ? '' : 'none';
                    document.getElementById('empLinkSection').style.display = role === 'Employee' ? '' : 'none';
                }
                document.querySelectorAll('input[name="Role"]').forEach(r => r.addEventListener('change', updateSections));
                updateSections();
            </script>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Permissions", new { id = Model.Id })" class="btn btn-outline-primary">
                    <i class="fas fa-key me-1"></i> الصلاحيات
                </a>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>