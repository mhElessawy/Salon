@model IEnumerable<Salon.Models.ApplicationUser>
@{
    ViewData["Title"] = "إدارة المستخدمين";
    var userRoles = ViewBag.UserRoles as List<(Salon.Models.ApplicationUser User, string Role)> ?? new();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-user-shield me-2"></i>إدارة المستخدمين</h1>
        <p>إضافة وتعديل المستخدمين وصلاحياتهم</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Activity")" class="btn btn-outline-primary">
            <i class="fas fa-chart-line me-1"></i> نشاط المستخدمين
        </a>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-user-plus me-1"></i> إضافة مستخدم
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>المستخدم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الدور</th>
                        <th>الحالة</th>
                        <th>تاريخ الإنشاء</th>
                        <th style="min-width:220px">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (user, role) in userRoles)
                    {
                        var roleColor = role switch
                        {
                            "Admin"    => "danger",
                            "Manager"  => "warning",
                            "Cashier"  => "info",
                            "Employee" => "secondary",
                            _          => "secondary"
                        };
                        var roleAr = role switch
                        {
                            "Admin"    => "مدير النظام",
                            "Manager"  => "مدير",
                            "Cashier"  => "كاشير",
                            "Employee" => "موظف",
                            _          => role
                        };
                        <tr class="@(!user.IsActive ? "table-secondary opacity-75" : "")">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                         style="width:38px;height:38px;background:var(--primary);font-size:16px;flex-shrink:0">
                                        @user.FullName.FirstOrDefault()
                                    </div>
                                    <span class="fw-semibold">@user.FullName</span>
                                </div>
                            </td>
                            <td class="text-muted">@user.Email</td>
                            <td><span class="badge bg-@roleColor">@roleAr</span></td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fas fa-circle me-1" style="font-size:8px"></i>نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-circle me-1" style="font-size:8px"></i>معطّل</span>
                                }
                            </td>
                            <td class="text-muted" style="font-size:13px">@user.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = user.Id })" class="btn btn-sm btn-outline-warning me-1" title="تعديل البيانات">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("Permissions", new { id = user.Id })" class="btn btn-sm btn-outline-primary me-1" title="إدارة الصلاحيات">
                                    <i class="fas fa-key"></i>
                                </a>
                                <a href="@Url.Action("ChangePassword", new { id = user.Id })" class="btn btn-sm btn-outline-info me-1" title="تغيير كلمة المرور">
                                    <i class="fas fa-lock"></i>
                                </a>
                                <form asp-action="Deactivate" asp-route-id="@user.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('@(user.IsActive ? "هل تريد تعطيل هذا المستخدم؟" : "هل تريد تفعيل هذا المستخدم؟")')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(user.IsActive ? "تعطيل" : "تفعيل")">
                                        <i class="fas @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
