@model Salon.Models.AdminChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="page-header">
    <h1><i class="fas fa-lock me-2"></i>تغيير كلمة مرور: @Model.UserName</h1>
</div>

<div class="card" style="max-width:460px">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="UserId" type="hidden" />
            <input asp-for="UserName" type="hidden" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="NewPassword" type="password" class="form-control" id="newPassInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePass('newPassInput')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePass('confirmPassInput')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function togglePass(id) {
    const inp = document.getElementById(id);
    inp.type = inp.type === 'password' ? 'text' : 'password';
}
</script>
}
