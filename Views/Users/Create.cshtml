@model Salon.Models.CreateUserViewModel
@{
    ViewData["Title"] = "إضافة مستخدم";
    var roles = ViewBag.Roles as List<string> ?? new();
}

<div class="page-header">
    <h1><i class="fas fa-user-plus me-2"></i>إضافة مستخدم جديد</h1>
</div>

<div class="card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="الاسم كما سيظهر في النظام" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="example@salon.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" id="passwordInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePass('passwordInput')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePass('confirmInput')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Role" class="form-label"></label>
                    <div class="row g-2">
                        @foreach (var role in roles)
                        {
                            var roleAr = role switch
                            {
                                "Admin" => "مدير النظام",
                                "Manager" => "مدير",
                                "Cashier" => "كاشير",
                                "Employee" => "موظف",
                                _ => role
                            };
                            var roleIcon = role switch
                            {
                                "Admin" => "fas fa-crown",
                                "Manager" => "fas fa-user-tie",
                                "Cashier" => "fas fa-cash-register",
                                "Employee" => "fas fa-user",
                                _ => "fas fa-user"
                            };
                            var roleColor = role switch
                            {
                                "Admin" => "#dc3545",
                                "Manager" => "#ffc107",
                                "Cashier" => "#0dcaf0",
                                "Employee" => "#6c757d",
                                _ => "#6c757d"
                            };
                            <div class="col-6 col-md-3">
                                <input type="radio" name="Role" id="role_@role" value="@role"
                                       class="btn-check" @(Model.Role == role ? "checked" : "") />
                                <label class="btn btn-outline-secondary w-100 d-flex flex-column align-items-center gap-1 py-3"
                                       for="role_@role" style="font-size:13px;">
                                    <i class="@roleIcon" style="font-size:20px;color:@roleColor"></i>
                                    @roleAr
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                @* القسم - يظهر عند اختيار Cashier أو Employee *@
                <div class="col-12" id="deptSection">
                    <label class="form-label">القسم <small class="text-muted">(للكاشير والموظف)</small></label>
                    <div class="d-flex gap-3">
                        @foreach (var d in new[] { ("حلاقة", "fas fa-cut", "#F7941D"), ("مساج", "fas fa-spa", "#17a2b8"), ("الكل", "fas fa-layer-group", "#6c757d") })
                        {
                            <div>
                                <input type="radio" name="UserDepartment" id="dept_@d.Item1" value="@d.Item1"
                                       class="btn-check" @(Model.UserDepartment == d.Item1 || (d.Item1 == "الكل" && Model.UserDepartment == null) ? "checked" : "") />
                                <label class="btn btn-outline-secondary d-flex flex-column align-items-center gap-1 px-4 py-2"
                                       for="dept_@d.Item1" style="font-size:13px;">
                                    <i class="@d.Item2" style="font-size:18px;color:@d.Item3"></i>
                                    @d.Item1
                                </label>
                            </div>
                        }
                    </div>
                </div>

                @* الموظف المرتبط - يظهر عند اختيار Employee *@
                <div class="col-12" id="empLinkSection" style="display:none">
                    <label asp-for="LinkedEmployeeId" class="form-label"></label>
                    <select asp-for="LinkedEmployeeId" asp-items="ViewBag.Employees" class="form-select">
                        <option value="">-- اختر الموظف المرتبط --</option>
                    </select>
                    <small class="text-muted">اختر الموظف الذي سيُنشئ هذا المستخدم فواتيره باسمه فقط</small>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> إنشاء المستخدم</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePass(id) {
            const inp = document.getElementById(id);
            inp.type = inp.type === 'password' ? 'text' : 'password';
        }
        function updateSections() {
            const role = document.querySelector('input[name="Role"]:checked')?.value ?? '';
            document.getElementById('deptSection').style.display = (role === 'Cashier' || role === 'Employee') ? '' : 'none';
            document.getElementById('empLinkSection').style.display = role === 'Employee' ? '' : 'none';
        }
        document.querySelectorAll('input[name="Role"]').forEach(r => r.addEventListener('change', updateSections));
        updateSections();
    </script>
}