@model IEnumerable<Salon.Models.Employee>
@{
    ViewData["Title"] = "الموظفين";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-user-tie me-2"></i>شؤون الموظفين</h1>
        <p>إدارة بيانات الموظفين</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة موظف
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="search-bar mb-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو الهاتف..." />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الاسم</th>
                        <th>المسمى الوظيفي</th>
                        <th>الهاتف</th>
                        <th>الراتب</th>
                        <th>تاريخ التعيين</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">لا توجد بيانات</td></tr>
                    }
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.Id</td>
                            <td><strong>@e.FullName</strong></td>
                            <td>@(e.JobTitle ?? "-")</td>
                            <td>@(e.Phone ?? "-")</td>
                            <td>@e.BasicSalary.ToString("N3") د.ك</td>
                            <td>@e.HireDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = e.Id })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = e.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@e.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('هل تريد حذف هذا الموظف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
