@model Salon.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="page-header">
    <h1><i class="fas fa-key me-2"></i>تغيير كلمة المرور</h1>
</div>

<div class="card" style="max-width:460px">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="CurrentPassword" type="password" class="form-control" id="currentPassInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePass('currentPassInput')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="NewPassword" type="password" class="form-control" id="newPassInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePass('newPassInput')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <div class="mt-1" id="strengthBar" style="height:4px;border-radius:2px;background:#e9ecef;overflow:hidden">
                        <div id="strengthFill" style="height:100%;width:0;transition:all .3s"></div>
                    </div>
                    <small id="strengthText" class="text-muted"></small>
                </div>
                <div class="col-12">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassInput" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePass('confirmPassInput')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function togglePass(id) {
    const inp = document.getElementById(id);
    inp.type = inp.type === 'password' ? 'text' : 'password';
}

document.getElementById('newPassInput').addEventListener('input', function() {
    const val = this.value;
    let score = 0;
    if (val.length >= 6) score++;
    if (val.length >= 10) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const fill = document.getElementById('strengthFill');
    const text = document.getElementById('strengthText');
    const colors = ['#dc3545', '#ffc107', '#ffc107', '#20c997', '#28a745'];
    const labels = ['ضعيفة جداً', 'ضعيفة', 'متوسطة', 'قوية', 'قوية جداً'];
    fill.style.width = (score * 20) + '%';
    fill.style.background = colors[score - 1] || '#e9ecef';
    text.textContent = val ? 'قوة كلمة المرور: ' + (labels[score - 1] || '') : '';
});
</script>
}
