@model    Salon.Models.DailyPerformanceViewModel
@{
    ViewData["Title"] = "تقرير الأداء اليومي";
    var selectedDate = Model.ReportDate.ToString("yyyy-MM-dd");
    var allRows = Model.EmployeeRows;
    bool showDeptCol = Model.SelectedDept == null;
    var totalInv = allRows.Sum(r => r.InvoiceCount);
    var totalWork = allRows.Sum(r => r.TotalSales);
    var totalDiscount = allRows.Sum(r => r.Discount);
    var totalCash = allRows.Sum(r => r.Cash);
    var totalKNet = allRows.Sum(r => r.KNet);
    var totalOwnerDebt = allRows.Sum(r => r.OwnerDebt);
    var totalEmployeeDebt = allRows.Sum(r => r.EmployeeDebt);
    var totalAdv = allRows.Sum(r => r.Advances);
    var totalDue = allRows.Sum(r => r.DueAmount);
    var totalServiceCommission = allRows.Sum(r => r.ServiceCommission);
    var totalHadiya = allRows.Sum(r => r.Hadiya);
    var totalShopNet = allRows.Sum(r => r.ShopNet);
    var totalNetCollected = allRows.Sum(r => r.InstantCollection);
    var discountInvoices = Model.Invoices.Where(s => s.Discount > 0).OrderByDescending(s => s.SaleDate).ToList();
    string deptSuffix = Model.SelectedDept != null ? $"&dept={Uri.EscapeDataString(Model.SelectedDept)}" : "";

    // Donut chart colours
    var catColors = new[] { "#ef4444", "#f97316", "#3b82f6", "#10b981", "#8b5cf6", "#06b6d4", "#ec4899" };
    var cats = Model.ExpensesByCategory.OrderByDescending(c => c.Value).ToList();
    var totalExp = cats.Sum(c => c.Value);
    string grad = "";
    decimal cum = 0m;
    for (int ci = 0; ci < cats.Count; ci++)
    {
        var p = totalExp > 0 ? cats[ci].Value / totalExp * 100 : 0;
        if (ci > 0) grad += ",";
        grad += $"{catColors[ci % catColors.Length]} {cum:F1}% {(cum + p):F1}%";
        cum += p;
    }
    if (!cats.Any()) grad = "#e5e7eb 0% 100%";

    // Avatar colours per employee index
    var avatarPalette = new[] { "#1a1a2e", "#0891b2", "#7c3aed", "#059669", "#dc2626", "#d97706", "#1d4ed8", "#be185d" };
}

<style>
    .dp2-page {
        font-family: 'Segoe UI',Tahoma,Arial,sans-serif;
        direction: rtl;
        background: #f1f5f9;
        color: #111;
        font-size: 13px;
    }
    /* ── Title bar ─────────────────────────── */
    .dp2-titlebar {
        background: #fff;
        border-radius: 10px;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
    }

        .dp2-titlebar h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            color: #1a1a2e;
        }

        .dp2-titlebar .sub {
            font-size: 11px;
            color: #64748b;
            margin-top: 2px;
        }

    .dp2-btn-row {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .dp2-btn {
        padding: 5px 12px;
        border-radius: 6px;
        border: 1px solid #ddd;
        background: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .15s;
    }

        .dp2-btn:hover {
            background: #f1f5f9;
        }

        .dp2-btn.print-btn {
            background: #1a1a2e;
            color: #fff;
            border-color: #1a1a2e;
        }

        .dp2-btn.excel-btn {
            background: #16a34a;
            color: #fff;
            border-color: #16a34a;
        }

        .dp2-btn.pdf-btn {
            background: #dc2626;
            color: #fff;
            border-color: #dc2626;
        }
    /* ── Info bar ───────────────────────────── */
    .dp2-infobar {
        background: #fff;
        border-radius: 8px;
        padding: 8px 18px;
        display: flex;
        gap: 24px;
        align-items: center;
        margin-bottom: 10px;
        font-size: 12px;
        color: #475569;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

        .dp2-infobar span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dp2-infobar i {
            color: #1a1a2e;
        }
    /* ── Date nav ───────────────────────────── */
    .dp2-datebar {
        background: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 12px;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }
    /* ── Cards ──────────────────────────────── */
    .dp2-cards {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        gap: 8px;
        margin-bottom: 10px;
    }

    .dp2-card {
        background: #fff;
        border-radius: 10px;
        padding: 12px 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        position: relative;
        overflow: hidden;
    }

        .dp2-card .c-icon {
            font-size: 20px;
            margin-bottom: 5px;
        }

        .dp2-card .c-lbl {
            font-size: 10px;
            font-weight: 700;
            color: #64748b;
            margin-bottom: 3px;
        }

        .dp2-card .c-val {
            font-size: 19px;
            font-weight: 800;
            line-height: 1;
        }

        .dp2-card .c-cur {
            font-size: 9px;
            color: #888;
        }

        .dp2-card .c-sub {
            font-size: 10px;
            color: #94a3b8;
            margin-top: 4px;
        }

        .dp2-card .c-pct {
            position: absolute;
            top: 8px;
            left: 8px;
            font-size: 9px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
        }

        .dp2-card .c-link {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 4px;
            text-decoration: none;
        }
    /* ── Panel box ──────────────────────────── */
    .dp2-panel {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        overflow: hidden;
        height: 100%;
    }

    .dp2-panel-hdr {
        background: #1a1a2e;
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: space-between;
    }

        .dp2-panel-hdr .badge-count {
            background: rgba(255,255,255,.2);
            font-size: 10px;
            padding: 1px 7px;
            border-radius: 10px;
        }

    .dp2-panel-body {
        padding: 10px 12px;
    }
    /* ── Donut chart ─────────────────────────  */
    .dp2-donut-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        padding: 8px 0;
    }

    .dp2-donut {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: conic-gradient( @grad );
        position: relative;
        flex-shrink: 0;
    }

    .dp2-donut-inner {
        position: absolute;
        top: 20px;
        left: 20px;
        width: 90px;
        height: 90px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .dp2-legend {
        font-size: 10px;
    }

    .dp2-legend-row {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 4px;
    }

    .dp2-legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    /* ── Cash movement list ─────────────────── */
    .dp2-cash-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px dashed #e2e8f0;
        font-size: 12px;
    }

        .dp2-cash-row:last-child {
            border-bottom: none;
        }

    .dp2-cash-lbl {
        color: #475569;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .dp2-cash-val {
        font-weight: 700;
    }

    .dp2-cash-total {
        background: #1a1a2e;
        color: #fff;
        margin: 8px -12px -10px;
        padding: 10px 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        font-weight: 700;
    }

        .dp2-cash-total span {
            color: #fbbf24;
            font-size: 15px;
        }
    /* ── Compact panels (cash movement + custody stack) ──── */
    .dp2-panel-sm .dp2-panel-hdr {
        font-size: 10px;
        padding: 4px 8px;
    }

    .dp2-panel-sm .dp2-panel-body {
        padding: 5px 8px;
    }

    .dp2-panel-sm .dp2-cash-row {
        padding: 3px 0;
        font-size: 10px;
    }

    .dp2-panel-sm .dp2-cash-total {
        padding: 5px 8px;
        margin: 4px -8px -5px;
        font-size: 10px;
    }

        .dp2-panel-sm .dp2-cash-total span {
            font-size: 11px;
        }
    /* ── Employee table ─────────────────────── */
    .dp2-emp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .dp2-emp-table thead th {
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
            padding: 6px 5px;
            text-align: center;
            border-bottom: 2px solid #e2e8f0;
        }

        .dp2-emp-table tbody td {
            padding: 6px 5px;
            text-align: center;
            border-bottom: 1px solid #f1f5f9;
        }

        .dp2-emp-table tbody tr:hover {
            background: #f8fafc;
        }

        .dp2-emp-table tfoot td {
            background: #1a1a2e;
            color: #fff;
            font-weight: 700;
            padding: 6px 5px;
            text-align: center;
        }

    .dp2-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
    }

    .dept-filter-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .dept-btn {
        padding: 3px 12px;
        border-radius: 16px;
        border: 1.5px solid #1a1a2e;
        background: #fff;
        color: #1a1a2e;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: background .15s,color .15s;
        display: inline-block;
    }

        .dept-btn.active, .dept-btn:hover {
            background: #1a1a2e;
            color: #fff;
        }

        .dept-btn[data-dept="مساج"].active, .dept-btn[data-dept="مساج"]:hover {
            background: #0891b2;
            color: #fff;
            border-color: #0891b2;
        }
    /* ── Invoice / discount tables ──────────── */
    .dp2-inv-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .dp2-inv-table thead th {
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
            padding: 5px 4px;
            text-align: center;
            border-bottom: 2px solid #e2e8f0;
        }

        .dp2-inv-table tbody td {
            padding: 5px 4px;
            text-align: center;
            border-bottom: 1px solid #f1f5f9;
        }

        .dp2-inv-table tbody tr:hover {
            background: #f8fafc;
        }

    .dp2-show-all {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        font-weight: 600;
        color: #1a1a2e;
        text-decoration: none;
        padding: 6px 12px;
        margin-top: 6px;
    }

        .dp2-show-all:hover {
            color: #0891b2;
        }
    /* ── Quick summary ──────────────────────── */
    .dp2-qs-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 7px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 12px;
    }

        .dp2-qs-row:last-child {
            border-bottom: none;
        }

    .dp2-qs-lbl {
        color: #475569;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .dp2-qs-val {
        font-weight: 700;
        color: #1a1a2e;
    }
    /* ── Tips section ────────────────────────  */
    .dp2-tips-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0;
        border-top: 1px solid #fde68a;
    }

    .dp2-tip-cell {
        text-align: center;
        padding: 8px 6px;
        border-left: 1px solid #fde68a;
    }

        .dp2-tip-cell:last-child {
            border-left: none;
        }

    .dp2-tip-lbl {
        font-size: 10px;
        font-weight: 700;
        color: #92400e;
        margin-bottom: 3px;
    }

    .dp2-tip-val {
        font-size: 16px;
        font-weight: 800;
    }
    /* ── Payment badge ───────────────────────  */
    .pmb {
        font-size: 10px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 10px;
        display: inline-block;
    }

    .pmb-cash {
        background: #dcfce7;
        color: #166534;
    }

    .pmb-knet {
        background: #dbeafe;
        color: #1e40af;
    }

    .pmb-debt {
        background: #fee2e2;
        color: #991b1b;
    }

    .pmb-mix {
        background: #fef3c7;
        color: #92400e;
    }
    /* ── Notes ───────────────────────────────  */
    .dp2-notes {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 10px 12px;
        margin-top: 10px;
    }
    /* ── Print ───────────────────────────────  */
    @@media print {
        .no-print {
            display: none !important;
        }

        .dp2-page {
            background: #fff;
        }

        .dp2-panel, .dp2-card {
            box-shadow: none;
            border: 1px solid #e2e8f0;
        }
    }
</style>

<div class="dp2-page">

    <!-- Title bar -->
    <div class="dp2-titlebar no-print">
        <div>
            <h4><i class="fas fa-chart-line me-2" style="color:#1a1a2e;"></i><span data-i18n-en="Daily Performance Report">تقرير الأداء اليومي</span></h4>
            <div class="sub" data-i18n-en="Comprehensive daily summary of salon performance and cash flow">ملخص شامل لأداء الصالون والمبيعات والمصروفات وحركة الصندوق</div>
        </div>
        <div class="dp2-btn-row">
            <button class="dp2-btn print-btn" onclick="window.print()"><i class="fas fa-print"></i> <span data-i18n-en="Print">طباعة</span></button>
            <button class="dp2-btn excel-btn" onclick="exportTableToCSV()"><i class="fas fa-file-excel"></i> Excel</button>
            <button class="dp2-btn pdf-btn" onclick="window.print()"><i class="fas fa-file-pdf"></i> PDF</button>
            <button class="dp2-btn" onclick="navigator.share&&navigator.share({title:'تقرير الأداء',url:window.location.href})"><i class="fas fa-share-alt"></i> <span data-i18n-en="Share">مشاركة</span></button>
        </div>
    </div>

    <!-- Info bar -->
    <div class="dp2-infobar no-print">
        <span><i class="fas fa-calendar-alt"></i> @Model.ReportDate.ToString("dd/MM/yyyy")</span>
        <span><i class="fas fa-clock"></i> وقت الإغلاق: @Model.ReportTime</span>
        <span><i class="fas fa-user-tie"></i> المستخدم: @Model.UserName</span>
        @if (Model.SelectedDept != null)
        {
            <span><i class="fas fa-filter"></i> القسم: <strong>@Model.SelectedDept</strong></span>
        }
    </div>

    <!-- Date navigation -->
    <div class="dp2-datebar no-print">
        <a href="?date=@Model.PrevDate.ToString("yyyy-MM-dd")@deptSuffix" class="btn btn-outline-secondary btn-sm"><i class="fas fa-chevron-right"></i></a>
        <form method="get" action="@Url.Action("Index","BarberDaily")" class="d-flex align-items-center gap-2">
            <input type="date" name="date" value="@selectedDate" class="form-control form-control-sm" style="width:150px;" />
            @if (Model.SelectedDept != null)
            {
                <input type="hidden" name="dept" value="@Model.SelectedDept" />
            }
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i><span data-i18n-en="View">عرض</span></button>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="this.previousElementSibling.previousElementSibling.value=new Date().toISOString().slice(0,10);this.form.submit();"><span data-i18n-en="Today">اليوم</span></button>
        </form>
        <a href="?date=@Model.NextDate.ToString("yyyy-MM-dd")@deptSuffix" class="btn btn-outline-secondary btn-sm"
           @(Model.NextDate > DateTime.Today ? "style=opacity:.4;pointer-events:none;" : "")>
            <i class="fas fa-chevron-left"></i>
        </a>
        <span class="fw-bold text-secondary small ms-1">@Model.DayName @Model.ReportDate.ToString("yyyy/MM/dd")</span>
    </div>

    <!-- ===== 7 Summary Cards ===== -->
    <div class="dp2-cards mb-2">

        <!-- 1. إجمالي المبيعات -->
        <div class="dp2-card" style="border-top:3px solid #16a34a;">
            <div class="c-icon" style="color:#16a34a;"><i class="fas fa-shopping-cart"></i></div>
            <div class="c-lbl" data-i18n-en="Total Sales">إجمالي المبيعات</div>
            <div class="c-val" style="color:#16a34a;">@Model.TotalSales.ToString("N3")</div>
            <div class="c-cur">د.ك</div>
            <div class="c-sub">عدد الفواتير: <strong>@Model.InvoiceCount</strong></div>
        </div>

        <!-- 2. كاش -->
        <div class="dp2-card" style="border-top:3px solid #1d4ed8;">
            <div class="c-pct" style="background:#dbeafe;color:#1e40af;">@Model.CashPercent.ToString("N1")%</div>
            <div class="c-icon" style="color:#1d4ed8;"><i class="fas fa-money-bill-wave"></i></div>
            <div class="c-lbl" data-i18n-en="Cash">الكاش</div>
            <div class="c-val" style="color:#1d4ed8;">@Model.CashTotal.ToString("N3")</div>
            <div class="c-cur">د.ك</div>
            <div class="c-sub">نسبة الكاش: @Model.CashPercent.ToString("N1")%</div>
        </div>

        <!-- 3. كي نت -->
        <div class="dp2-card" style="border-top:3px solid #0891b2;">
            <div class="c-pct" style="background:#cffafe;color:#0e7490;">@Model.KNetPercent.ToString("N1")%</div>
            <div class="c-icon" style="color:#0891b2;"><i class="fas fa-credit-card"></i></div>
            <div class="c-lbl" data-i18n-en="K-Net">كي نت</div>
            <div class="c-val" style="color:#0891b2;">@Model.KNetTotal.ToString("N3")</div>
            <div class="c-cur">د.ك</div>
            <div class="c-sub">نسبة كي نت: @Model.KNetPercent.ToString("N1")%</div>
        </div>

        <!-- 4. دين على الموظف -->
        <div class="dp2-card" style="border-top:3px solid #d97706;">
            <div class="c-pct" style="background:#fef3c7;color:#92400e;">@Model.EmployeeDebtPercent.ToString("N1")%</div>
            <div class="c-icon" style="color:#d97706;"><i class="fas fa-user-minus"></i></div>
            <div class="c-lbl" data-i18n-en="Employee Debt">دين على الموظف</div>
            <div class="c-val" style="color:#d97706;">@Model.EmployeeDebtTotal.ToString("N3")</div>
            <div class="c-cur">د.ك</div>
            <div class="c-sub">نسبة الدين: @Model.EmployeeDebtPercent.ToString("N1")%</div>
        </div>

        <!-- 5. دين على الإدارة -->
        <div class="dp2-card" style="border-top:3px solid #b91c1c;">
            <div class="c-pct" style="background:#fee2e2;color:#b91c1c;">@Model.OwnerDebtPercent.ToString("N1")%</div>
            <div class="c-icon" style="color:#b91c1c;"><i class="fas fa-landmark"></i></div>
            <div class="c-lbl" data-i18n-en="Owner Debt">دين على الإدارة</div>
            <div class="c-val" style="color:#b91c1c;">@Model.OwnerDebtTotal.ToString("N3")</div>
            <div class="c-cur">د.ك</div>
            <div class="c-sub">نسبة الدين: @Model.OwnerDebtPercent.ToString("N1")%</div>
        </div>

        <!-- 6. إكراميات -->
        <div class="dp2-card" style="border-top:3px solid #f59e0b;background:#fffbeb;">
            <div class="c-icon" style="color:#f59e0b;"><i class="fas fa-gift"></i></div>
            <div class="c-lbl" data-i18n-en="Tips (K-Net)">إكراميات (كي نت)</div>
            <div class="c-val" style="color:#d97706;">@Model.TipsTotal.ToString("N3")</div>
            <div class="c-cur">د.ك</div>
            <div class="c-sub">عدد العمليات: <strong>@Model.TipInvoices.Count</strong></div>
            <a class="c-link" style="color:#d97706;" href="#tips-section"><i class="fas fa-eye"></i> عرض التفاصيل</a>
        </div>

        <!-- 7. خصومات -->
        <div class="dp2-card" style="border-top:3px solid #7c3aed;background:#faf5ff;">
            <div class="c-icon" style="color:#7c3aed;"><i class="fas fa-percent"></i></div>
            <div class="c-lbl" data-i18n-en="Today's Discounts">خصومات اليوم</div>
            <div class="c-val" style="color:#7c3aed;">@Model.TotalDiscount.ToString("N3")</div>
            <div class="c-cur">د.ك</div>
            <div class="c-sub">عدد الفواتير: <strong>@discountInvoices.Count</strong></div>
            <a class="c-link" style="color:#7c3aed;" href="#disc-section"><i class="fas fa-eye"></i> عرض التفاصيل</a>
        </div>

    </div>

    <!-- ===== Employee Performance - Full Width ===== -->
    <div class="row g-2 mb-2">

        <!-- Employee Performance Table -->
        <div class="col-12">
            <div class="dp2-panel">
                <div class="dp2-panel-hdr">
                    <span><i class="fas fa-users me-1"></i> أداء الموظفين</span>
                    <span>
                        <span class="badge-count">@allRows.Count موظف</span>
                    </span>
                </div>
                <!-- Dept filter -->
                <div class="dept-filter-bar no-print">
                    <span style="font-size:11px;color:#64748b;font-weight:700;" data-i18n-en="Department:">القسم:</span>
                    <a href="?date=@selectedDate" class="dept-btn @(Model.SelectedDept == null ? "active" : "")" data-dept="all">الكل (@allRows.Count)</a>
                    <a href="?date=@selectedDate&dept=حلاقة" class="dept-btn @(Model.SelectedDept == "حلاقة" ? "active" : "")" data-dept="حلاقة">✂ حلاقة (@Model.BarberRows.Count)</a>
                    <a href="?date=@selectedDate&dept=مساج" class="dept-btn @(Model.SelectedDept == "مساج" ? "active" : "")" data-dept="مساج">🌿 مساج (@Model.MassageRows.Count)</a>
                </div>
                <div style="overflow-x:auto;">
                    <table class="dp2-emp-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                @if (showDeptCol)
                                {
                                    <th>القسم</th>
                                }
                                <th>الموظف</th>
                                <th data-i18n-en="Invoices">عدد الفواتير</th>
                                <th data-i18n-en="Discount">الخصم</th>
                                <th data-i18n-en="Total Amount">المبلغ الاجمالي</th>
                                <th data-i18n-en="Cash">كاش</th>
                                <th data-i18n-en="K-Net">كي نت</th>
                                <th data-i18n-en="Employee Debt">دين على الموظف</th>
                                <th data-i18n-en="Owner Debt">دين على الإدارة</th>
                                <th data-i18n-en="Advances">السلف</th>
                                <th data-i18n-en="Employee Service Commission">عمولة خدمة للموظف</th>
                                <th data-i18n-en="Tip">إكرامية</th>
                                <th data-i18n-en="Net Collected">صافي المحصل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!allRows.Any())
                            {
                                <tr><td colspan="@(showDeptCol ? 13 : 12)" class="text-center text-muted py-3" style="font-size:12px;"><i class="fas fa-inbox me-1"></i>لا توجد بيانات</td></tr>
                            }
                            @{
                                int si = 1;
                            }
                            @foreach (var row in allRows)
                            {
                                var avColor = avatarPalette[(si - 1) % avatarPalette.Length];
                                var initials = row.Employee.FullName.Length > 0 ? row.Employee.FullName.Substring(0, 1) : "؟";
                                <tr>
                                    <td>@(si++)</td>
                                    @if (showDeptCol)
                                    {
                                        <td>
                                            @if (row.DepartmentName == "حلاقة")
                                            {
                                                <span class="badge" style="background:#1a1a2e;font-size:9px;">✂</span>
                                            }
                                            else
                                            {

                                                <span class="badge" style="background:#0891b2;font-size:9px;">🌿</span>
                                            }
                                        </td>
                                    }
                                    <td style="text-align:right;white-space:nowrap;">
                                        <div style="display:flex;align-items:center;gap:5px;">
                                            <div class="dp2-avatar" style="background:@avColor;">@initials</div>
                                            <div>
                                                <span style="font-weight:600;">@row.Employee.FullName</span>
                                                @if (row.Hadiya > 0)
                                                {
                                                    <div style="margin-top:2px;">
                                                        <span style="background:#fef3c7;color:#92400e;border:1px solid #fbbf24;border-radius:8px;padding:1px 7px;font-size:10px;font-weight:700;display:inline-flex;align-items:center;gap:3px;">
                                                            <i class="fas fa-gift" style="font-size:9px;"></i> إكرامية: @row.Hadiya.ToString("N3") د.ك
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>@row.InvoiceCount</td>
                                    <td class="@(row.Discount > 0 ? "text-danger" : "")">@row.Discount.ToString("N3")</td>
                                    <td style="font-weight:600;">@row.TotalSales.ToString("N3")</td>
                                    <td>@row.Cash.ToString("N3")</td>
                                    <td>@row.KNet.ToString("N3")</td>
                                    <td class="@(row.EmployeeDebt > 0 ? "text-danger" : "")">@row.EmployeeDebt.ToString("N3")</td>
                                    <td class="@(row.OwnerDebt > 0 ? "text-danger" : "")">@row.OwnerDebt.ToString("N3")</td>
                                    <td class="@(row.Advances > 0 ? "text-warning" : "")">@row.Advances.ToString("N3")</td>
                                    <td style="color:#16a34a;font-weight:700;">@row.ServiceCommission.ToString("N3")</td>
                                    <td>
                                        @if (row.Hadiya > 0)
                                        {
                                            <span style="color:#d97706;font-weight:700;">@row.Hadiya.ToString("N3")</span>
                                        }
                                        else
                                        {

                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td style="color:#1d4ed8;font-weight:700;">@row.InstantCollection.ToString("N3")</td>
                                </tr>
                            }
                        </tbody>
                        @if (allRows.Any())
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="@(showDeptCol ? 3 : 2)">الإجمالي</td>
                                    <td>@totalInv</td>
                                    <td>@totalDiscount.ToString("N3")</td>
                                    <td>@totalWork.ToString("N3")</td>
                                    <td>@totalCash.ToString("N3")</td>
                                    <td>@totalKNet.ToString("N3")</td>
                                    <td>@totalEmployeeDebt.ToString("N3")</td>
                                    <td>@totalOwnerDebt.ToString("N3")</td>
                                    <td>@totalAdv.ToString("N3")</td>
                                    <td>@totalServiceCommission.ToString("N3")</td>
                                    <td style="color:#fbbf24;">@totalHadiya.ToString("N3")</td>
                                    <td>@totalNetCollected.ToString("N3")</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
                @if (allRows.Any())
                {
                    <div style="font-size:10px;color:#94a3b8;padding:5px 10px;">
                        * يتم احتساب النسبة من إجمالي الشغل بعد خصم الخصومات
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ===== Tips Summary ===== -->
    @if (Model.TipsTotal > 0)
    {
        <div id="tips-section" class="dp2-panel mb-2" style="border:1px solid #fde68a;">
            <div class="dp2-panel-hdr" style="background:#d97706;">
                <span><i class="fas fa-hand-holding-heart me-1"></i> تفاصيل الإكراميات</span>
                <span class="badge-count">@Model.TipInvoices.Count عملية</span>
            </div>
            <div class="dp2-tips-row">
                <div class="dp2-tip-cell">
                    <div class="dp2-tip-lbl"><i class="fas fa-coins me-1"></i>إجمالي الإكراميات</div>
                    <div class="dp2-tip-val" style="color:#d97706;">@Model.TipsTotal.ToString("N3") <small style="font-size:10px;color:#888;">د.ك</small></div>
                </div>
                <div class="dp2-tip-cell">
                    <div class="dp2-tip-lbl"><i class="fas fa-check-circle me-1" style="color:#16a34a;"></i>تم التسليم للموظفين</div>
                    <div class="dp2-tip-val" style="color:#16a34a;">@Model.TipsDelivered.ToString("N3") <small style="font-size:10px;color:#888;">د.ك</small></div>
                    @if (Model.TipsDelivered > 0)
                    {
                        <span class="pmb pmb-cash">✓ تم التسليم</span>
                    }
                </div>
                <div class="dp2-tip-cell">
                    <div class="dp2-tip-lbl"><i class="fas fa-exclamation-circle me-1" style="color:@(Model.TipsRemaining > 0 ? "#dc2626" : "#16a34a");"></i>المتبقي للتسليم</div>
                    <div class="dp2-tip-val" style="color:@(Model.TipsRemaining > 0 ? "#dc2626" : "#16a34a");">@Model.TipsRemaining.ToString("N3") <small style="font-size:10px;color:#888;">د.ك</small></div>
                    @if (Model.TipsRemaining > 0)
                    {
                        <span class="pmb pmb-debt">⚠ لم يُسلَّم بعد</span>
                    }
                    else if (Model.TipsTotal > 0)
                    {

                        <span class="pmb pmb-cash">✓ تم التسليم الكامل</span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ===== Invoices Full Width ===== -->
    <div class="row g-2 mb-2">
        <div class="col-12">
            <div class="dp2-panel">
                <div class="dp2-panel-hdr">
                    <span><i class="fas fa-file-invoice me-1"></i> فواتير اليوم</span>
                    <span class="badge-count">@Model.Invoices.Count فاتورة</span>
                </div>
                <div style="overflow-x:auto;">
                    <table class="dp2-inv-table">
                        <thead>
                            <tr>
                                <th>رقم الفاتورة</th>
                                <th>الموظف</th>
                                <th>العميل</th>
                                <th>النوع</th>
                                <th>الخدمات</th>
                                <th>الإجمالي<br /><small>د.ك</small></th>
                                <th>الخصم<br /><small>د.ك</small></th>
                                <th>الصافي<br /><small>د.ك</small></th>
                                <th data-i18n-en="Tip for Employee (KD)">إكرامية للموظف<br /><small>د.ك</small></th>
                                <th>طريقة الدفع</th>
                                <th>ملاحظات</th>
                                <th>الوقت</th>
                                <th class="no-print"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Invoices.Any() && !Model.Advances.Any())
                            {
                                <tr><td colspan="13" class="text-center text-muted py-3"><i class="fas fa-inbox me-1"></i>لا توجد فواتير</td></tr>
                            }
                            @foreach (var inv in Model.Invoices)
                            {
                                var isCancelled = inv.Status == "ملغي";
                                <tr style="@(isCancelled ? "background:#fff5f5;opacity:.85;" : "")">
                                    <td style="font-family:monospace;font-size:10px;white-space:nowrap;">
                                        <strong style="@(isCancelled ? "text-decoration:line-through;color:#dc2626;" : "")">@inv.InvoiceNumber</strong>
                                        @if (isCancelled)
                                        {
                                            <br /><span class="pmb pmb-debt" style="font-size:9px;"><i class="fas fa-ban me-1"></i>ملغي</span>
                                        }
                                    </td>
                                    <td style="white-space:nowrap;">@(inv.Employee?.FullName ?? "—")</td>
                                    <td style="white-space:nowrap;">@(inv.Customer?.FullName ?? "زائر")</td>
                                    <td>
                                        @if (inv.SaleType == "حلاقة")
                                        {
                                            <span class="pmb" style="background:#1a1a2e;color:#fff;"><i class="fas fa-cut me-1"></i>حلاقة</span>
                                        }
                                        else if (inv.SaleType == "مساج")
                                        {
                                            <span class="pmb" style="background:#0891b2;color:#fff;"><i class="fas fa-spa me-1"></i>مساج</span>
                                        }
                                        else
                                        {
                                            <span class="pmb" style="background:#64748b;color:#fff;"><i class="fas fa-box me-1"></i>منتجات</span>
                                        }
                                    </td>
                                    <td style="font-size:10px;max-width:160px;">
                                        @if (inv.SaleItems != null && inv.SaleItems.Any())
                                        {
                                            <ul style="margin:0;padding-right:14px;">
                                                @foreach (var item in inv.SaleItems)
                                                {
                                                    <li>@item.ItemName@(item.Quantity > 1 ? $" ×{item.Quantity}" : "")</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@inv.TotalAmount.ToString("N3")</td>
                                    <td style="color:#dc2626;">
                                        @if (inv.Discount > 0)
                                        {
                                            @inv.Discount.ToString("N3")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td style="font-weight:700;color:@(isCancelled ? "#dc2626" : "#16a34a");">@inv.NetAmount.ToString("N3")</td>
                                    <td>
                                        @if (inv.GiftForEmployee.HasValue && inv.GiftForEmployee > 0)
                                        {
                                            <span class="pmb" style="background:#c0392b;color:#fff;"><i class="fas fa-gift me-1"></i>@inv.GiftForEmployee.Value.ToString("N3")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td style="white-space:nowrap;">
                                        @if (inv.PaymentMethod == "كاش")
                                        {
                                            <span class="pmb pmb-cash"><i class="fas fa-money-bill-wave me-1"></i>كاش</span>
                                        }
                                        else if (inv.PaymentMethod == "كي نت")
                                        {
                                            <span class="pmb pmb-knet"><i class="fas fa-credit-card me-1"></i>كي نت</span>
                                            @if (!string.IsNullOrEmpty(inv.KnetReceiptNumber))
                                            {
                                                <div style="font-size:9px;color:#1e40af;margin-top:2px;">
                                                    <i class="fas fa-receipt me-1"></i>رقم: <strong>@inv.KnetReceiptNumber</strong>
                                                </div>
                                            }
                                        }
                                        else if (inv.PaymentMethod == "كي نت و كاش")
                                        {
                                            <span class="pmb pmb-mix"><i class="fas fa-exchange-alt me-1"></i>كاش + كي نت</span>
                                            <div style="font-size:9px;color:#64748b;margin-top:2px;">
                                                @if (inv.CashAmount.HasValue && inv.CashAmount > 0) { <span>كاش: @inv.CashAmount.Value.ToString("N3")</span> }
                                                @if (inv.LinkAmount.HasValue && inv.LinkAmount > 0) { <span class="ms-1">كي نت: @inv.LinkAmount.Value.ToString("N3")</span> }
                                            </div>
                                            @if (!string.IsNullOrEmpty(inv.KnetReceiptNumber))
                                            {
                                                <div style="font-size:9px;color:#1e40af;margin-top:2px;">
                                                    <i class="fas fa-receipt me-1"></i>رقم: <strong>@inv.KnetReceiptNumber</strong>
                                                </div>
                                            }
                                        }
                                        else if (inv.PaymentMethod != null && inv.PaymentMethod.Contains("دين"))
                                        {
                                            <span class="pmb pmb-debt"><i class="fas fa-user me-1"></i>@inv.PaymentMethod</span>
                                        }
                                        else
                                        {
                                            <span class="pmb" style="background:#e2e8f0;color:#1a1a2e;">@inv.PaymentMethod</span>
                                        }
                                    </td>
                                    <td style="font-size:10px;color:#64748b;max-width:120px;white-space:pre-wrap;">@inv.Notes</td>
                                    <td style="white-space:nowrap;color:#64748b;font-size:10px;">@inv.SaleDate.ToString("hh:mm tt")</td>
                                    <td class="no-print" style="text-align:center;">
                                        <button onclick="openInvModal(@inv.Id)"
                                                style="display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:5px;background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;cursor:pointer;font-size:12px;">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                            @foreach (var adv in Model.Advances)
                            {
                                var advTime = adv.AdvanceDate != default ? adv.AdvanceDate.ToString("hh:mm tt") : adv.CreatedAt.ToString("hh:mm tt");
                                <tr style="background:#fff0f0;">
                                    <td style="font-family:monospace;font-size:10px;"><strong class="text-danger">سلفة #@adv.Id</strong></td>
                                    <td style="white-space:nowrap;">@(adv.Employee?.FullName ?? "—")</td>
                                    <td class="text-muted">—</td>
                                    <td><span class="pmb" style="background:#9f1239;color:#fff;"><i class="fas fa-hand-holding-usd me-1"></i>سلفة</span></td>
                                    <td style="font-size:10px;color:#64748b;">@(string.IsNullOrEmpty(adv.Reason) ? "—" : adv.Reason)</td>
                                    <td style="color:#dc2626;font-weight:700;">@adv.Amount.ToString("N3")</td>
                                    <td class="text-muted">—</td>
                                    <td style="color:#dc2626;font-weight:700;">@adv.Amount.ToString("N3")</td>
                                    <td class="text-muted">—</td>
                                    <td>
                                        @if (adv.PaymentMethod == "كاش" || adv.PaymentMethod == "نقدي")
                                        {
                                            <span class="pmb pmb-cash"><i class="fas fa-money-bill-wave me-1"></i>@adv.PaymentMethod</span>
                                        }
                                        else if (adv.PaymentMethod == "كي نت")
                                        {
                                            <span class="pmb pmb-knet"><i class="fas fa-credit-card me-1"></i>كي نت</span>
                                        }
                                        else
                                        {
                                            <span class="pmb" style="background:#e2e8f0;color:#1a1a2e;">@adv.PaymentMethod</span>
                                        }
                                    </td>
                                    <td></td>
                                    <td style="white-space:nowrap;color:#64748b;font-size:10px;">@advTime</td>
                                    <td></td>
                                </tr>
                            }
                        </tbody>
                        @if (Model.Invoices.Any() || Model.Advances.Any())
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="5" style="text-align:end;">
                                        فواتير: <span style="background:rgba(255,255,255,.2);padding:1px 6px;border-radius:8px;">@Model.Invoices.Count</span>
                                        @if (Model.Advances.Any())
                                        {
                                            <span style="margin-right:8px;">سلف: <span style="background:#dc2626;padding:1px 6px;border-radius:8px;">@Model.Advances.Count</span></span>
                                        }
                                    </td>
                                    <td>@Model.Invoices.Sum(s => s.TotalAmount).ToString("N3")</td>
                                    <td style="color:#fbbf24;">@Model.Invoices.Sum(s => s.Discount).ToString("N3")</td>
                                    <td style="color:#4ade80;">@Model.Invoices.Sum(s => s.NetAmount).ToString("N3")</td>
                                    <td style="color:#fbbf24;">
                                        @{var hadiyaSum2 = Model.Invoices.Sum(s => s.GiftForEmployee ?? 0);}
                                        @(hadiyaSum2 > 0 ? hadiyaSum2.ToString("N3") : "—")
                                    </td>
                                    <td colspan="4"></td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Bottom Row: Expenses | Cash Movement | Discounts | Quick Summary ===== -->
    <div class="row g-2">

        <!-- Expenses + Chart -->
        <div class="col-lg-3 col-md-6">
            <div class="dp2-panel">
                <div class="dp2-panel-hdr">
                    <span><i class="fas fa-receipt me-1"></i> مصروفات تشغيل اليوم</span>
                </div>
                <div class="dp2-panel-body">
                    <div style="text-align:center;font-size:12px;color:#64748b;margin-bottom:4px;">إجمالي المصروفات</div>
                    <div style="text-align:center;font-size:22px;font-weight:800;color:#dc2626;">@Model.TotalExpensesAmount.ToString("N3")</div>
                    <div style="text-align:center;font-size:10px;color:#888;margin-bottom:8px;">د.ك</div>

                    @if (cats.Any())
                    {
                        <div class="dp2-donut-wrap">
                            <div class="dp2-donut">
                                <div class="dp2-donut-inner">
                                    <span style="font-size:11px;font-weight:800;color:#1a1a2e;">@Model.ExpenseCount</span>
                                    <span style="font-size:9px;color:#64748b;">بند</span>
                                </div>
                            </div>
                            <div class="dp2-legend">
                                @for (int ci = 0; ci < cats.Count; ci++)
                                {
                                    var pct = totalExp > 0 ? Math.Round(cats[ci].Value / totalExp * 100, 0) : 0;
                                    <div class="dp2-legend-row">
                                        <div class="dp2-legend-dot" style="background:@catColors[ci % catColors.Length];"></div>
                                        <span>@cats[ci].Key</span>
                                        <span style="font-weight:700;margin-right:auto;">@pct%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="text-align:center;color:#94a3b8;padding:20px 0;font-size:12px;">
                            <i class="fas fa-check-circle" style="font-size:28px;color:#16a34a;display:block;margin-bottom:6px;"></i>
                            لا توجد مصروفات اليوم
                        </div>
                    }
                    @if (Model.Expenses.Any())
                    {
                        <button class="dp2-show-all no-print" onclick="openExpModal()" style="border:none;background:none;cursor:pointer;"><i class="fas fa-eye"></i> عرض التفاصيل</button>
                    }
                </div>
            </div>
        </div>

        <!-- Cash Movement & Custody -->
        <div class="col-lg-3 col-md-6">
            <div class="dp2-panel dp2-panel-sm">
                <div class="dp2-panel-hdr"><i class="fas fa-building-columns me-1"></i> حركة الصندوق و العهد</div>
                <div class="dp2-panel-body">
                    <div class="dp2-cash-row">
                        <span class="dp2-cash-lbl"><i class="fas fa-box-open" style="color:#64748b;"></i> رصيد بداية اليوم</span>
                        <span class="dp2-cash-val">@Model.OpeningBalance.ToString("N3")</span>
                    </div>
                    <div class="dp2-cash-row">
                        <span class="dp2-cash-lbl"><i class="fas fa-plus-circle" style="color:#16a34a;"></i> فواتير كاش</span>
                        <span class="dp2-cash-val" style="color:#16a34a;">+ @Model.CashRevenue.ToString("N3")</span>
                    </div>
                    @if (Model.TotalDeposits > 0)
                    {
                        <div class="dp2-cash-row">
                            <span class="dp2-cash-lbl"><i class="fas fa-arrow-circle-down" style="color:#1d4ed8;"></i> إيداع للصندوق</span>
                            <span class="dp2-cash-val" style="color:#1d4ed8;">+ @Model.TotalDeposits.ToString("N3")</span>
                        </div>
                    }
                    @if (Model.CashExpensesAmount > 0)
                    {
                        <div class="dp2-cash-row">
                            <span class="dp2-cash-lbl"><i class="fas fa-minus-circle" style="color:#dc2626;"></i> مصروفات تشغيل (نقدي)</span>
                            <span class="dp2-cash-val" style="color:#dc2626;">− @Model.CashExpensesAmount.ToString("N3")</span>
                        </div>
                    }
                    @if (Model.CashAdvancesAmount > 0)
                    {
                        <div class="dp2-cash-row">
                            <span class="dp2-cash-lbl"><i class="fas fa-minus-circle" style="color:#d97706;"></i> سلف موظفين (نقدي)</span>
                            <span class="dp2-cash-val" style="color:#d97706;">− @Model.CashAdvancesAmount.ToString("N3")</span>
                        </div>
                    }
                    @if (Model.CashSalariesAmount > 0)
                    {
                        <div class="dp2-cash-row">
                            <span class="dp2-cash-lbl"><i class="fas fa-minus-circle" style="color:#d97706;"></i> رواتب (نقدي)</span>
                            <span class="dp2-cash-val" style="color:#d97706;">− @Model.CashSalariesAmount.ToString("N3")</span>
                        </div>
                    }
                    @if (Model.TotalWithdrawals > 0)
                    {
                        <div class="dp2-cash-row">
                            <span class="dp2-cash-lbl"><i class="fas fa-minus-circle" style="color:#dc2626;"></i> تسليم للبنك</span>
                            <span class="dp2-cash-val" style="color:#dc2626; text-decoration:line-through;">− @Model.TotalWithdrawals.ToString("N3")</span>
                        </div>
                    }
                    <div class="dp2-cash-total">
                        <span>الموجود في الصندوق</span>
                        <span>@Model.CurrentCashBalance.ToString("N3") <small>د.ك</small></span>
                    </div>

                    <div style="margin:8px -8px 0;border-top:1px dashed #cbd5e1;"></div>
                    <div style="font-weight:700;font-size:10px;color:#b91c1c;padding:6px 0 2px;display:flex;align-items:center;gap:4px;">
                        <i class="fas fa-hand-holding-dollar"></i> العهد الحالية
                        @if (Model.CurrentCustodies.Any())
                        {
                            <span class="badge-count" style="background:#fee2e2;color:#b91c1c;">@Model.CurrentCustodies.Count</span>
                        }
                    </div>
                    @if (Model.CurrentCustodies.Any())
                    {
                        @foreach (var custody in Model.CurrentCustodies)
                        {
                            <div class="dp2-cash-row">
                                <span class="dp2-cash-lbl"><i class="fas fa-user" style="color:#64748b;"></i> @custody.EmployeeName</span>
                                <span class="dp2-cash-val" style="color:#b91c1c;">@custody.Amount.ToString("N3")</span>
                            </div>
                        }
                        <div class="dp2-cash-total" style="background:#b91c1c;">
                            <span>إجمالي العهد</span>
                            <span>@Model.TotalCurrentCustody.ToString("N3") <small>د.ك</small></span>
                        </div>
                    }
                    else
                    {
                        <div style="text-align:center;color:#94a3b8;padding:8px 0;font-size:10px;">
                            <i class="fas fa-check-circle" style="font-size:16px;color:#16a34a;display:block;margin-bottom:3px;"></i>
                            لا توجد عهد حالياً لدى الموظفين
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Discounts Table -->
        <div id="disc-section" class="col-lg-3 col-md-6">
            <div class="dp2-panel">
                <div class="dp2-panel-hdr" style="background:#7c3aed;">
                    <span><i class="fas fa-tags me-1"></i> تفاصيل خصومات اليوم</span>
                    <span class="badge-count">@discountInvoices.Count</span>
                </div>
                <div style="overflow-x:auto;max-height:260px;overflow-y:auto;">
                    <table class="dp2-inv-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم الفاتورة</th>
                                <th>الموظف</th>
                                <th>الوقت</th>
                                <th>السبب</th>
                                <th>قيمة الخصم</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!discountInvoices.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">لا توجد خصومات اليوم</td></tr>
                            }
                            @{
                                int di = 1;
                            }
                            @foreach (var disc in discountInvoices)
                            {
                                <tr>
                                    <td>@(di++)</td>
                                    <td style="font-family:monospace;font-size:10px;">@disc.InvoiceNumber</td>
                                    <td style="white-space:nowrap;">@(disc.Employee?.FullName ?? "—")</td>
                                    <td>@disc.SaleDate.ToString("hh:mm tt")</td>
                                    <td style="font-size:10px;color:#64748b;">@(string.IsNullOrEmpty(disc.Notes) ? "—" : disc.Notes)</td>
                                    <td style="font-weight:700;color:#7c3aed;">@disc.Discount.ToString("N3")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (discountInvoices.Any())
                {
                    <a class="dp2-show-all no-print" href="@Url.Action("Index", "Sales")?date=@selectedDate">
                        <i class="fas fa-arrow-left"></i> عرض جميع الخصومات
                    </a>
                }
            </div>
        </div>

        <!-- Quick Summary -->
        <div class="col-lg-3 col-md-6">
            <div class="dp2-panel">
                <div class="dp2-panel-hdr"><i class="fas fa-list-check me-1"></i> ملخص سريع لليوم</div>
                <div class="dp2-panel-body">
                    <div class="dp2-qs-row">
                        <span class="dp2-qs-lbl"><i class="fas fa-file-invoice" style="color:#64748b;"></i> عدد الفواتير</span>
                        <span class="dp2-qs-val">@Model.InvoiceCount</span>
                    </div>
                    <div class="dp2-qs-row">
                        <span class="dp2-qs-lbl"><i class="fas fa-cash-register" style="color:#16a34a;"></i> إجمالي المبيعات</span>
                        <span class="dp2-qs-val" style="color:#16a34a;">@Model.TotalSales.ToString("N3") د.ك</span>
                    </div>
                    <div class="dp2-qs-row">
                        <span class="dp2-qs-lbl"><i class="fas fa-tags" style="color:#7c3aed;"></i> إجمالي الخصومات</span>
                        <span class="dp2-qs-val" style="color:#7c3aed;">@Model.TotalDiscount.ToString("N3") د.ك</span>
                    </div>
                    @if (Model.TotalExpensesAmount > 0)
                    {
                        <div class="dp2-qs-row">
                            <span class="dp2-qs-lbl"><i class="fas fa-receipt" style="color:#dc2626;"></i> إجمالي المصروفات</span>
                            <span class="dp2-qs-val" style="color:#dc2626;">@Model.TotalExpensesAmount.ToString("N3") د.ك</span>
                        </div>
                    }
                    @if (Model.TotalCustodyAmount > 0)
                    {
                        <div class="dp2-qs-row">
                            <span class="dp2-qs-lbl"><i class="fas fa-hand-holding-dollar" style="color:#b91c1c;"></i> عهد الموظفين</span>
                            <span class="dp2-qs-val" style="color:#b91c1c;">@Model.TotalCustodyAmount.ToString("N3") د.ك</span>
                        </div>
                    }
                    @if (Model.TipsTotal > 0)
                    {
                        <div class="dp2-qs-row">
                            <span class="dp2-qs-lbl"><i class="fas fa-gift" style="color:#d97706;"></i> إكراميات (كي نت)</span>
                            <span class="dp2-qs-val" style="color:#d97706;">@Model.TipsTotal.ToString("N3") د.ك</span>
                        </div>
                    }
                    <div class="dp2-qs-row">
                        <span class="dp2-qs-lbl"><i class="fas fa-safe" style="color:#1d4ed8;"></i> الموجود في الصندوق</span>
                        <span class="dp2-qs-val" style="color:#1d4ed8;">@Model.CurrentCashBalance.ToString("N3") د.ك</span>
                    </div>
                    <div class="dp2-qs-row">
                        <span class="dp2-qs-lbl"><i class="fas fa-users" style="color:#0891b2;"></i> عدد الموظفين</span>
                        <span class="dp2-qs-val">@allRows.Count</span>
                    </div>
                    @if (totalDue > 0)
                    {
                        <div class="dp2-qs-row">
                            <span class="dp2-qs-lbl"><i class="fas fa-hand-holding-usd" style="color:#16a34a;"></i> عمولة الموظفين</span>
                            <span class="dp2-qs-val" style="color:#16a34a;">@totalDue.ToString("N3") د.ك</span>
                        </div>
                        <div class="dp2-qs-row">
                            <span class="dp2-qs-lbl"><i class="fas fa-store" style="color:#1a1a2e;"></i> صافي المحل</span>
                            <span class="dp2-qs-val" style="font-size:14px;">@totalShopNet.ToString("N3") د.ك</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Notes -->
    @if (!string.IsNullOrWhiteSpace(Model.DailyNotes) || Model.ShiftId > 0)
    {
        <div class="dp2-notes mt-2 no-print">
            <div style="font-weight:700;font-size:12px;color:#92400e;margin-bottom:6px;">
                <i class="fas fa-sticky-note me-1"></i> ملاحظات اليوم
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.DailyNotes))
            {
                <p style="font-size:12px;margin-bottom:8px;">@Model.DailyNotes</p>
            }
            @if (Model.ShiftId > 0)
            {
                <form method="post" action="@Url.Action("SaveNote","BarberDaily")" class="d-flex gap-2">
                    <input type="hidden" name="shiftId" value="@Model.ShiftId" />
                    <input type="hidden" name="date" value="@selectedDate" />
                    <input type="text" name="notes" class="form-control form-control-sm" placeholder="أضف ملاحظة..." value="@Model.DailyNotes" style="max-width:400px;" />
                    <button type="submit" class="btn btn-sm btn-outline-warning">حفظ</button>
                </form>
            }
        </div>
    }

    <div style="text-align:center;color:#94a3b8;font-size:10px;margin-top:12px;padding-top:8px;border-top:1px solid #e2e8f0;">
        جميع المبالغ بالدينار الكويتي (د.ك) — @Model.ReportDate.ToString("yyyy/MM/dd") @Model.DayName
    </div>

</div>

<!-- ===== Expenses Detail Modal ===== -->
<div id="expModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.55);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:12px;width:min(780px,96vw);max-height:92vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.25);direction:rtl;font-size:13px;">
        <!-- Header -->
        <div style="background:#dc2626;color:#fff;padding:14px 18px;border-radius:12px 12px 0 0;display:flex;justify-content:space-between;align-items:center;">
            <div>
                <span style="font-size:15px;font-weight:700;"><i class="fas fa-receipt me-2"></i>تفاصيل مصروفات اليوم</span>
                <div style="font-size:11px;color:rgba(255,255,255,.75);margin-top:2px;">@Model.ReportDate.ToString("yyyy/MM/dd") — @Model.DayName</div>
            </div>
            <button onclick="closeExpModal()" style="background:rgba(255,255,255,.15);border:none;color:#fff;border-radius:6px;width:30px;height:30px;cursor:pointer;font-size:14px;">✕</button>
        </div>
        <!-- Body -->
        <div style="padding:16px 18px;">
            @if (Model.Expenses.Any())
            {
                <!-- إجمالي سريع -->
                <div style="display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;">
                    <div style="background:#fff5f5;border:1px solid #fecaca;border-radius:8px;padding:10px 16px;flex:1;min-width:120px;text-align:center;">
                        <div style="font-size:10px;color:#dc2626;font-weight:700;margin-bottom:4px;">عدد البنود</div>
                        <div style="font-size:22px;font-weight:800;color:#dc2626;">@Model.Expenses.Count</div>
                    </div>
                    <div style="background:#fff5f5;border:1px solid #fecaca;border-radius:8px;padding:10px 16px;flex:1;min-width:140px;text-align:center;">
                        <div style="font-size:10px;color:#dc2626;font-weight:700;margin-bottom:4px;">إجمالي المصروفات</div>
                        <div style="font-size:22px;font-weight:800;color:#dc2626;">@Model.TotalExpensesAmount.ToString("N3")</div>
                        <div style="font-size:9px;color:#888;">د.ك</div>
                    </div>
                    @{
                        var expByDept = Model.Expenses.GroupBy(e => string.IsNullOrEmpty(e.Department) ? "مشترك" : e.Department).ToList();
                    }
                    @foreach (var dg in expByDept)
                    {
                        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:10px 16px;flex:1;min-width:120px;text-align:center;">
                            <div style="font-size:10px;color:#475569;font-weight:700;margin-bottom:4px;">@dg.Key</div>
                            <div style="font-size:18px;font-weight:800;color:#1a1a2e;">@dg.Sum(e => e.Amount).ToString("N3")</div>
                            <div style="font-size:9px;color:#888;">د.ك</div>
                        </div>
                    }
                </div>

                <!-- جدول المصروفات -->
                <div style="margin-bottom:4px;font-weight:700;font-size:12px;color:#1a1a2e;"><i class="fas fa-list me-1"></i> بنود المصروفات</div>
                <div style="overflow-x:auto;border-radius:8px;border:1px solid #e2e8f0;">
                    <table style="width:100%;border-collapse:collapse;font-size:12px;">
                        <thead>
                            <tr style="background:#1a1a2e;color:#fff;">
                                <th style="padding:8px 10px;text-align:right;">#</th>
                                <th style="padding:8px 10px;text-align:right;">البيان</th>
                                <th style="padding:8px 10px;text-align:right;">الفئة</th>
                                <th style="padding:8px 10px;text-align:center;">القسم</th>
                                <th style="padding:8px 10px;text-align:center;">المبلغ (د.ك)</th>
                                <th style="padding:8px 10px;text-align:center;">طريقة الدفع</th>
                                <th style="padding:8px 10px;text-align:right;">ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int ei = 1; }
                            @foreach (var exp in Model.Expenses)
                            {
                                <tr style="border-bottom:1px solid #f1f5f9;@(ei % 2 == 0 ? "background:#f8fafc;" : "")">
                                    <td style="padding:7px 10px;color:#64748b;">@(ei++)</td>
                                    <td style="padding:7px 10px;font-weight:600;">@exp.Description</td>
                                    <td style="padding:7px 10px;color:#475569;">
                                        @if (!string.IsNullOrEmpty(exp.Category))
                                        {
                                            <span style="background:#e0f2fe;color:#0369a1;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700;">@exp.Category</span>
                                        }
                                        else
                                        {
                                            <span style="color:#94a3b8;">—</span>
                                        }
                                    </td>
                                    <td style="padding:7px 10px;text-align:center;">
                                        @if (exp.Department == "حلاقة")
                                        {
                                            <span style="background:#1a1a2e;color:#fff;padding:2px 8px;border-radius:8px;font-size:10px;">✂ حلاقة</span>
                                        }
                                        else if (exp.Department == "مساج")
                                        {
                                            <span style="background:#0891b2;color:#fff;padding:2px 8px;border-radius:8px;font-size:10px;">🌿 مساج</span>
                                        }
                                        else
                                        {
                                            <span style="background:#e2e8f0;color:#475569;padding:2px 8px;border-radius:8px;font-size:10px;">مشترك</span>
                                        }
                                    </td>
                                    <td style="padding:7px 10px;text-align:center;font-weight:700;color:#dc2626;">@exp.Amount.ToString("N3")</td>
                                    <td style="padding:7px 10px;text-align:center;color:#475569;font-size:11px;">@exp.PaymentMethod</td>
                                    <td style="padding:7px 10px;color:#64748b;font-size:11px;">@exp.Notes</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background:#1a1a2e;color:#fff;font-weight:700;">
                                <td colspan="4" style="padding:8px 10px;text-align:end;">الإجمالي</td>
                                <td style="padding:8px 10px;text-align:center;color:#fbbf24;font-size:14px;">@Model.TotalExpensesAmount.ToString("N3")</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div style="text-align:center;padding:40px;color:#94a3b8;">
                    <i class="fas fa-check-circle" style="font-size:36px;color:#16a34a;display:block;margin-bottom:10px;"></i>
                    لا توجد مصروفات اليوم
                </div>
            }

            @if (Model.Advances.Any())
            {
                <div style="margin-top:18px;margin-bottom:6px;font-weight:700;font-size:12px;color:#1a1a2e;"><i class="fas fa-hand-holding-usd me-1" style="color:#d97706;"></i> سلف الموظفين</div>
                <div style="overflow-x:auto;border-radius:8px;border:1px solid #fde68a;">
                    <table style="width:100%;border-collapse:collapse;font-size:12px;">
                        <thead>
                            <tr style="background:#d97706;color:#fff;">
                                <th style="padding:8px 10px;text-align:right;">#</th>
                                <th style="padding:8px 10px;text-align:right;">الموظف</th>
                                <th style="padding:8px 10px;text-align:right;">السبب</th>
                                <th style="padding:8px 10px;text-align:center;">المبلغ (د.ك)</th>
                                <th style="padding:8px 10px;text-align:center;">طريقة الدفع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int ai = 1; }
                            @foreach (var adv in Model.Advances)
                            {
                                <tr style="border-bottom:1px solid #fef3c7;@(ai % 2 == 0 ? "background:#fffbeb;" : "")">
                                    <td style="padding:7px 10px;color:#64748b;">@(ai++)</td>
                                    <td style="padding:7px 10px;font-weight:600;">@(adv.Employee?.FullName ?? "—")</td>
                                    <td style="padding:7px 10px;color:#475569;">@(string.IsNullOrEmpty(adv.Reason) ? "—" : adv.Reason)</td>
                                    <td style="padding:7px 10px;text-align:center;font-weight:700;color:#d97706;">@adv.Amount.ToString("N3")</td>
                                    <td style="padding:7px 10px;text-align:center;color:#475569;font-size:11px;">@adv.PaymentMethod</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background:#d97706;color:#fff;font-weight:700;">
                                <td colspan="3" style="padding:8px 10px;text-align:end;">إجمالي السلف</td>
                                <td style="padding:8px 10px;text-align:center;font-size:14px;">@Model.Advances.Sum(a => a.Amount).ToString("N3")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- ===== Invoice Detail Modal ===== -->
<div id="invModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.55);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:12px;width:min(860px,96vw);max-height:92vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.25);direction:rtl;font-size:13px;" id="invModalBox">
        <!-- Modal Header -->
        <div id="invModalHdr" style="background:#1a1a2e;color:#fff;padding:14px 18px;border-radius:12px 12px 0 0;display:flex;justify-content:space-between;align-items:center;">
            <div>
                <span style="font-size:15px;font-weight:700;"><i class="fas fa-file-invoice me-2"></i><span id="invNum">—</span></span>
                <div style="font-size:11px;color:#94a3b8;margin-top:3px;" id="invDate"></div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <a id="invPrintBtn" href="#" target="_blank"
                   style="background:#fff;color:#1a1a2e;border-radius:6px;padding:5px 12px;font-size:11px;font-weight:700;text-decoration:none;">
                    <i class="fas fa-print me-1"></i>طباعة
                </a>
                <button onclick="closeInvModal()" style="background:rgba(255,255,255,.15);border:none;color:#fff;border-radius:6px;width:30px;height:30px;cursor:pointer;font-size:14px;">✕</button>
            </div>
        </div>
        <!-- Modal Body -->
        <div style="padding:16px 18px;" id="invModalBody">
            <div id="invModalLoading" style="text-align:center;padding:40px;color:#64748b;">
                <i class="fas fa-spinner fa-spin fa-2x"></i>
                <div style="margin-top:8px;">جاري التحميل...</div>
            </div>
            <div id="invModalContent" style="display:none;">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
                    <!-- Info card -->
                    <div style="background:#f8fafc;border-radius:8px;padding:12px;">
                        <div style="font-weight:700;font-size:12px;color:#1a1a2e;margin-bottom:10px;border-bottom:1px solid #e2e8f0;padding-bottom:6px;">
                            <i class="fas fa-info-circle me-1"></i> معلومات الفاتورة
                        </div>
                        <table style="width:100%;font-size:12px;border-collapse:collapse;">
                            <tr><td style="color:#64748b;padding:4px 0;width:110px;">العميل</td><td style="font-weight:600;" id="iCustomer"></td></tr>
                            <tr><td style="color:#64748b;padding:4px 0;">الموظف</td><td style="font-weight:600;" id="iEmployee"></td></tr>
                            <tr><td style="color:#64748b;padding:4px 0;">النوع</td><td id="iType"></td></tr>
                            <tr><td style="color:#64748b;padding:4px 0;">الحالة</td><td id="iStatus"></td></tr>
                            <tr><td style="color:#64748b;padding:4px 0;">طريقة الدفع</td><td id="iPayment"></td></tr>
                        </table>
                    </div>
                    <!-- Totals card -->
                    <div style="background:#f8fafc;border-radius:8px;padding:12px;">
                        <div style="font-weight:700;font-size:12px;color:#1a1a2e;margin-bottom:10px;border-bottom:1px solid #e2e8f0;padding-bottom:6px;">
                            <i class="fas fa-calculator me-1"></i> المبالغ
                        </div>
                        <table style="width:100%;font-size:12px;border-collapse:collapse;">
                            <tr><td style="color:#64748b;padding:4px 0;width:110px;">الإجمالي</td><td id="iTotal"></td></tr>
                            <tr><td style="color:#64748b;padding:4px 0;">الخصم</td><td id="iDiscount" style="color:#dc2626;"></td></tr>
                            <tr style="border-top:1px solid #e2e8f0;"><td style="color:#64748b;padding:6px 0;font-weight:700;">الصافي</td><td id="iNet" style="font-size:15px;font-weight:800;color:#16a34a;"></td></tr>
                            <tr id="iGiftRow" style="display:none;"><td style="color:#64748b;padding:4px 0;">إكرامية للموظف</td><td id="iGift" style="color:#c0392b;"></td></tr>
                        </table>
                        <div id="iNotes" style="margin-top:10px;background:#fffbeb;border-radius:6px;padding:8px;font-size:11px;color:#92400e;display:none;"></div>
                    </div>
                </div>
                <!-- Items table -->
                <div>
                    <div style="font-weight:700;font-size:12px;color:#1a1a2e;margin-bottom:8px;"><i class="fas fa-list me-1"></i> البنود</div>
                    <table style="width:100%;border-collapse:collapse;font-size:12px;">
                        <thead>
                            <tr style="background:#1a1a2e;color:#fff;">
                                <th style="padding:7px 10px;text-align:right;">#</th>
                                <th style="padding:7px 10px;text-align:right;">البيان</th>
                                <th style="padding:7px 10px;text-align:center;">الكمية</th>
                                <th style="padding:7px 10px;text-align:center;">السعر</th>
                                <th style="padding:7px 10px;text-align:center;">الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody id="iItemsBody"></tbody>
                        <tfoot id="iItemsFoot"></tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function exportTableToCSV() {
        var rows = document.querySelectorAll('.dp2-emp-table tr');
        var csv = [];
        rows.forEach(function(row) {
            var cols = row.querySelectorAll('td, th');
            var data = Array.from(cols).map(function(c) { return '"' + c.innerText.replace(/"/g,'""') + '"'; });
            csv.push(data.join(','));
        });
        var blob = new Blob(['﻿' + csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'daily_report_@(selectedDate).csv';
        link.click();
    }

    // ── Expenses Modal ───────────────────────────────────────────────────────
    var expModal = document.getElementById('expModal');

    function openExpModal() {
        expModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeExpModal() {
        expModal.style.display = 'none';
        document.body.style.overflow = '';
    }

    expModal.addEventListener('click', function(e) {
        if (e.target === expModal) closeExpModal();
    });

    // ── Invoice Modal ─────────────────────────────────────────────────────────
    var invModal = document.getElementById('invModal');

    function openInvModal(id) {
        invModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        document.getElementById('invModalLoading').style.display = 'block';
        document.getElementById('invModalContent').style.display = 'none';
        document.getElementById('invNum').textContent = '…';
        document.getElementById('invDate').textContent = '';

        fetch('/Sales/DetailsJson/' + id)
            .then(function(r) { return r.json(); })
            .then(function(d) { renderInvModal(d); })
            .catch(function() {
                document.getElementById('invModalLoading').innerHTML =
                    '<i class="fas fa-exclamation-circle fa-2x" style="color:#dc2626;"></i><div style="margin-top:8px;">تعذّر تحميل البيانات</div>';
            });
    }

    function renderInvModal(d) {
        document.getElementById('invNum').textContent = d.invoiceNumber;
        document.getElementById('invDate').textContent = d.saleDate;
        document.getElementById('invPrintBtn').href = '/Sales/PrintInvoice/' + d.id;

        document.getElementById('iCustomer').textContent = d.customer;
        document.getElementById('iEmployee').textContent = d.employee;

        // نوع
        var typeColors = { 'حلاقة': '#1a1a2e', 'مساج': '#0891b2', 'منتجات': '#64748b' };
        var typeIcons  = { 'حلاقة': 'fa-cut', 'مساج': 'fa-spa', 'منتجات': 'fa-box' };
        var tc = typeColors[d.saleType] || '#64748b';
        var ti = typeIcons[d.saleType] || 'fa-tag';
        document.getElementById('iType').innerHTML =
            '<span style="background:' + tc + ';color:#fff;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;">' +
            '<i class="fas ' + ti + ' me-1"></i>' + (d.saleType || '—') + '</span>';

        // حالة
        var statusBg = d.status === 'مكتمل' ? '#16a34a' : '#dc2626';
        document.getElementById('iStatus').innerHTML =
            '<span style="background:' + statusBg + ';color:#fff;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;">' + d.status + '</span>';

        // طريقة الدفع
        var pm = d.paymentMethod || '';
        var pmHtml = '';
        if (pm === 'كاش') {
            pmHtml = '<span style="background:#dcfce7;color:#166534;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;"><i class="fas fa-money-bill-wave me-1"></i>كاش</span>';
        } else if (pm === 'كي نت') {
            pmHtml = '<span style="background:#dbeafe;color:#1e40af;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;"><i class="fas fa-credit-card me-1"></i>كي نت</span>';
            if (d.knetReceiptNumber) {
                pmHtml += '<div style="font-size:10px;color:#1e40af;margin-top:4px;"><i class="fas fa-receipt me-1"></i>رقم: <strong>' + d.knetReceiptNumber + '</strong></div>';
            }
        } else if (pm === 'كي نت و كاش') {
            pmHtml = '<span style="background:#fef3c7;color:#92400e;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;"><i class="fas fa-exchange-alt me-1"></i>كاش + كي نت</span>';
            if (d.cashAmount > 0 || d.linkAmount > 0) {
                pmHtml += '<div style="font-size:10px;color:#64748b;margin-top:4px;">';
                if (d.cashAmount > 0) pmHtml += '<span style="background:#dcfce7;color:#166534;padding:1px 7px;border-radius:8px;margin-left:4px;">كاش: ' + d.cashAmount.toFixed(3) + '</span>';
                if (d.linkAmount > 0) pmHtml += '<span style="background:#dbeafe;color:#1e40af;padding:1px 7px;border-radius:8px;">كي نت: ' + d.linkAmount.toFixed(3) + '</span>';
                pmHtml += '</div>';
            }
            if (d.knetReceiptNumber) {
                pmHtml += '<div style="font-size:10px;color:#1e40af;margin-top:4px;"><i class="fas fa-receipt me-1"></i>رقم: <strong>' + d.knetReceiptNumber + '</strong></div>';
            }
        } else if (pm.includes('دين')) {
            pmHtml = '<span style="background:#fee2e2;color:#991b1b;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;"><i class="fas fa-user me-1"></i>' + pm + '</span>';
        } else {
            pmHtml = '<span style="background:#e2e8f0;color:#1a1a2e;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;">' + pm + '</span>';
        }
        document.getElementById('iPayment').innerHTML = pmHtml;

        // مبالغ
        document.getElementById('iTotal').textContent = d.totalAmount.toFixed(3) + ' د.ك';
        document.getElementById('iDiscount').textContent = d.discount > 0 ? d.discount.toFixed(3) + ' د.ك' : '—';
        document.getElementById('iNet').textContent = d.netAmount.toFixed(3) + ' د.ك';

        // إكرامية
        var giftRow = document.getElementById('iGiftRow');
        if (d.giftForEmployee > 0) {
            giftRow.style.display = '';
            document.getElementById('iGift').textContent = d.giftForEmployee.toFixed(3) + ' د.ك';
        } else {
            giftRow.style.display = 'none';
        }

        // ملاحظات
        var notesEl = document.getElementById('iNotes');
        if (d.notes) {
            notesEl.style.display = '';
            notesEl.innerHTML = '<i class="fas fa-sticky-note me-1"></i>' + d.notes;
        } else {
            notesEl.style.display = 'none';
        }

        // بنود
        var tbody = document.getElementById('iItemsBody');
        var tfoot = document.getElementById('iItemsFoot');
        tbody.innerHTML = '';
        if (d.items && d.items.length > 0) {
            d.items.forEach(function(item, idx) {
                var tr = document.createElement('tr');
                tr.style.borderBottom = '1px solid #f1f5f9';
                tr.innerHTML =
                    '<td style="padding:7px 10px;">' + (idx + 1) + '</td>' +
                    '<td style="padding:7px 10px;font-weight:600;">' + item.itemName + '</td>' +
                    '<td style="padding:7px 10px;text-align:center;">' + item.quantity + '</td>' +
                    '<td style="padding:7px 10px;text-align:center;">' + item.price.toFixed(3) + '</td>' +
                    '<td style="padding:7px 10px;text-align:center;font-weight:700;color:#1d4ed8;">' + item.total.toFixed(3) + '</td>';
                tbody.appendChild(tr);
            });
            tfoot.innerHTML =
                '<tr style="background:#f8fafc;">' +
                '<td colspan="4" style="padding:8px 10px;text-align:end;font-weight:700;color:#1a1a2e;">الصافي</td>' +
                '<td style="padding:8px 10px;text-align:center;font-weight:800;font-size:14px;color:#16a34a;">' + d.netAmount.toFixed(3) + ' د.ك</td>' +
                '</tr>';
        } else {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:16px;">لا توجد بنود</td></tr>';
            tfoot.innerHTML = '';
        }

        document.getElementById('invModalLoading').style.display = 'none';
        document.getElementById('invModalContent').style.display = 'block';
    }

    function closeInvModal() {
        invModal.style.display = 'none';
        document.body.style.overflow = '';
    }

    // أغلق الـ modal بالضغط خارجه
    invModal.addEventListener('click', function(e) {
        if (e.target === invModal) closeInvModal();
    });

    // أغلق بـ Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { closeInvModal(); closeExpModal(); }
    });
</script>