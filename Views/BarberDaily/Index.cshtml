@model Salon.Models.DailyPerformanceViewModel
@{
    ViewData["Title"] = "تقرير الأداء اليومي";
    var selectedDate = Model.ReportDate.ToString("yyyy-MM-dd");
    var allRows = Model.EmployeeRows;
    bool showDeptCol = Model.SelectedDept == null;
    var totalInv      = allRows.Sum(r => r.InvoiceCount);
    var totalWork     = allRows.Sum(r => r.TotalSales);
    var totalCash     = allRows.Sum(r => r.Cash);
    var totalKNet     = allRows.Sum(r => r.KNet);
    var totalDebts    = allRows.Sum(r => r.Debts);
    var totalAdv      = allRows.Sum(r => r.Advances);
    var totalDue      = allRows.Sum(r => r.DueAmount);
    var totalHadiya   = allRows.Sum(r => r.Hadiya);
    var totalShopNet  = allRows.Sum(r => r.ShopNet);
    var overallPct    = totalWork > 0 ? Math.Round(totalDue / totalWork * 100, 1) : 0m;
    string deptSuffix = Model.SelectedDept != null ? $"&dept={Model.SelectedDept}" : "";
}

<style>
    .dp-page {
        font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
        direction: rtl;
        max-width: 1150px;
        margin: 0 auto;
        background: #fff;
        color: #111;
        font-size: 13px;
    }
    /* Header */
    .dp-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 12px;
        border-bottom: 3px solid #111;
        padding-bottom: 12px;
        margin-bottom: 14px;
    }
    .dp-logo-circle {
        width: 60px; height: 60px; border-radius: 50%;
        background: #1a1a2e; color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px; font-weight: bold;
    }
    .dp-logo-text { font-size: 11px; text-align: center; color: #555; margin-top: 4px; }
    .dp-title-center { text-align: center; }
    .dp-title-center h1 { font-size: 20px; font-weight: bold; margin: 0 0 4px; }
    .dp-title-center h2 { font-size: 13px; font-weight: 600; margin: 0 0 8px; color: #333; }
    .dp-meta-row {
        display: flex; justify-content: center; gap: 0;
        border: 1px solid #ccc; border-radius: 6px; overflow: hidden;
    }
    .dp-meta-cell {
        display: flex; flex-direction: column; align-items: center;
        padding: 5px 14px; border-left: 1px solid #ccc; min-width: 100px;
    }
    .dp-meta-cell:last-child { border-left: none; }
    .dp-meta-cell .mlbl { font-size: 10px; color: #666; }
    .dp-meta-cell .mval { font-weight: bold; font-size: 12px; }
    .dp-num-box {
        border: 2px solid #1a1a2e; border-radius: 8px;
        padding: 8px 14px; text-align: center; min-width: 120px;
    }
    .dp-num-box .nlbl { font-size: 10px; color: #666; }
    .dp-num-box .nval { font-size: 16px; font-weight: bold; color: #1a1a2e; letter-spacing: 1px; }
    /* Summary cards */
    .dp-cards-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-bottom: 12px;
    }
    .dp-card {
        border: 1px solid #ddd; border-radius: 8px;
        padding: 12px 10px; text-align: center;
        position: relative; overflow: hidden;
    }
    .dp-card .card-icon { font-size: 22px; color: #999; margin-bottom: 4px; }
    .dp-card .card-lbl { font-size: 11px; color: #555; font-weight: 600; margin-bottom: 4px; }
    .dp-card .card-val { font-size: 18px; font-weight: bold; }
    .dp-card .card-cur { font-size: 10px; color: #666; }
    .dp-card .card-sub { font-size: 11px; color: #888; margin-top: 3px; }
    .dp-card .card-pct {
        position: absolute; top: 8px; left: 8px;
        background: #1a1a2e; color: #fff;
        font-size: 10px; font-weight: bold;
        padding: 2px 6px; border-radius: 10px;
    }
    .card-val.blue { color: #1d4ed8; }
    .card-val.green { color: #16a34a; }
    .card-val.red { color: #dc2626; }
    .card-val.amber { color: #d97706; }
    .card-val.purple { color: #7c3aed; }
    /* Tips card */
    .dp-tips-bar {
        border: 1px solid #d97706; border-radius: 8px;
        background: #fffbeb; padding: 12px 16px;
        margin-bottom: 12px;
        display: grid; grid-template-columns: 1fr 1fr 1fr;
        gap: 10px; align-items: center;
    }
    .dp-tips-cell { text-align: center; }
    .dp-tips-cell .t-lbl { font-size: 11px; color: #92400e; font-weight: 600; }
    .dp-tips-cell .t-val { font-size: 20px; font-weight: bold; }
    .dp-tips-cell .t-cur { font-size: 10px; color: #666; }
    .tips-badge {
        display: inline-block; font-size: 10px; font-weight: bold;
        padding: 2px 8px; border-radius: 10px; margin-top: 3px;
    }
    .badge-delivered { background: #dcfce7; color: #166534; }
    .badge-remaining { background: #fee2e2; color: #991b1b; }
    /* Cash register */
    .dp-cash-box {
        border: 1px solid #ccc; border-radius: 8px;
        margin-bottom: 12px; overflow: hidden;
    }
    .dp-cash-title {
        background: #1a1a2e; color: #fff; text-align: center;
        font-weight: bold; font-size: 13px; padding: 6px;
    }
    .dp-cash-flow {
        display: flex; align-items: center; justify-content: center;
        flex-wrap: wrap; gap: 0; padding: 12px 8px;
    }
    .dp-cf-item {
        display: flex; flex-direction: column; align-items: center;
        padding: 6px 14px; text-align: center; min-width: 100px;
    }
    .dp-cf-item .cf-icon { font-size: 18px; margin-bottom: 3px; }
    .dp-cf-item .cf-lbl { font-size: 10px; color: #555; font-weight: 600; }
    .dp-cf-item .cf-val { font-size: 14px; font-weight: bold; }
    .dp-cf-op { font-size: 20px; font-weight: bold; color: #555; padding: 0 4px; line-height: 50px; }
    .dp-cash-result {
        background: #1a1a2e; color: #fff; text-align: center;
        padding: 8px; font-size: 15px; font-weight: bold;
    }
    .dp-cash-result span { color: #fbbf24; }
    /* Section title */
    .dp-section-title {
        background: #1a1a2e; color: #fff; text-align: center;
        font-weight: bold; font-size: 13px; padding: 6px 10px;
        border-radius: 4px 4px 0 0; margin-bottom: 0;
    }
    /* Dept filter */
    .dept-filter-bar {
        display: flex; align-items: center; gap: 8px;
        padding: 8px 12px; background: #f8f9fa;
        border-bottom: 1px solid #ddd; flex-wrap: wrap;
    }
    .dept-filter-label { font-size: 12px; color: #555; font-weight: 600; }
    .dept-btn {
        padding: 4px 14px; border-radius: 20px;
        border: 1.5px solid #1a1a2e; background: #fff;
        color: #1a1a2e; font-size: 12px; font-weight: 600;
        cursor: pointer; text-decoration: none; transition: background .15s, color .15s;
        display: inline-block;
    }
    .dept-btn.active, .dept-btn[data-dept="all"]:hover { background: #1a1a2e; color: #fff; }
    .dept-btn[data-dept="حلاقة"]:hover, .dept-btn[data-dept="حلاقة"].active { background: #1a1a2e; color: #fff; border-color: #1a1a2e; }
    .dept-btn[data-dept="مساج"]:hover, .dept-btn[data-dept="مساج"].active { background: #0891b2; color: #fff; border-color: #0891b2; }
    /* Table */
    .dp-table-wrap { border: 1px solid #ccc; border-radius: 6px; overflow: hidden; margin-bottom: 12px; }
    .dp-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .dp-table thead tr { background: #1a1a2e; color: #fff; }
    .dp-table thead th { padding: 8px 5px; text-align: center; border-left: 1px solid #333; }
    .dp-table thead th:last-child { border-left: none; }
    .dp-table tbody tr:nth-child(even) { background: #f9f9f9; }
    .dp-table tbody td { padding: 7px 5px; text-align: center; border-left: 1px solid #eee; }
    .dp-table tfoot tr { background: #1a1a2e; color: #fff; font-weight: bold; }
    .dp-table tfoot td { padding: 8px 5px; text-align: center; border-left: 1px solid #333; }
    /* Notes */
    .dp-notes-box {
        border: 1px solid #e2e8f0; border-radius: 6px;
        padding: 10px 14px; background: #f8fafc; margin-bottom: 10px;
    }
    .dp-notes-title { font-weight: bold; font-size: 12px; color: #334155; margin-bottom: 6px; }
    /* Footer */
    .dp-footer { text-align: center; color: #888; font-size: 11px; margin-top: 12px; border-top: 1px solid #eee; padding-top: 8px; }
    /* Print */
    @@media print {
        .no-print { display: none !important; }
        .dp-page { max-width: 100%; }
        body { background: #fff; }
        .dp-table thead tr, .dp-table tfoot tr, .dp-cash-title, .dp-section-title { background: #1a1a2e !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .dp-tips-bar { background: #fffbeb !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>

<!-- Controls (no print) -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 no-print">
    <div>
        <h1><i class="fas fa-chart-line me-2"></i>تقرير الأداء اليومي</h1>
        <p class="mb-0">@Model.ReportDate.ToString("yyyy/MM/dd") — @Model.DayName</p>
    </div>
    <button onclick="window.print()" class="btn btn-dark btn-sm">
        <i class="fas fa-print me-1"></i>طباعة
    </button>
</div>

<div class="card mb-3 no-print">
    <div class="card-body py-2">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <form method="get" action="@Url.Action("Index","BarberDaily")" class="d-flex align-items-end gap-2">
                <div>
                    <label class="form-label small fw-semibold mb-1">التاريخ</label>
                    <div class="input-group input-group-sm">
                        <input type="date" name="date" value="@selectedDate" class="form-control" style="max-width:160px;" />
                        @if (Model.SelectedDept != null)
                        {
                            <input type="hidden" name="dept" value="@Model.SelectedDept" />
                        }
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="this.previousElementSibling.value=new Date().toISOString().slice(0,10);this.form.submit();" title="اليوم">
                            <i class="fas fa-calendar-day"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i>عرض</button>
            </form>
            <!-- Day navigation -->
            <div class="d-flex gap-1 align-items-center">
                <a href="?date=@Model.PrevDate.ToString("yyyy-MM-dd")@deptSuffix" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-chevron-right"></i>
                </a>
                <span class="fw-semibold small">@Model.DayName</span>
                <a href="?date=@Model.NextDate.ToString("yyyy-MM-dd")@deptSuffix" class="btn btn-outline-secondary btn-sm"
                   @(Model.NextDate > DateTime.Today ? "style=opacity:.4;pointer-events:none;" : "")>
                    <i class="fas fa-chevron-left"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ===== Print page ===== -->
<div class="dp-page" dir="rtl">

    <!-- Header -->
    <div class="dp-header">
        <div style="text-align:center;">
            <div class="dp-logo-circle"><i class="fas fa-cut"></i></div>
            <div class="dp-logo-text">معهد وصالون<br />للرجال</div>
        </div>
        <div class="dp-title-center">
            <h1>معهد وصالون موس للرجال</h1>
            <h2>تقرير الأداء اليومي</h2>
            <div class="dp-meta-row">
                <div class="dp-meta-cell">
                    <span class="mlbl">التاريخ</span>
                    <span class="mval">@Model.ReportDate.ToString("yyyy/MM/dd")</span>
                </div>
                <div class="dp-meta-cell">
                    <span class="mlbl">اليوم</span>
                    <span class="mval">@Model.DayName</span>
                </div>
                <div class="dp-meta-cell">
                    <span class="mlbl">الكاشير</span>
                    <span class="mval">@Model.UserName</span>
                </div>
                <div class="dp-meta-cell">
                    <span class="mlbl">وقت الطباعة</span>
                    <span class="mval">@Model.ReportTime</span>
                </div>
                @if (Model.SelectedDept != null)
                {
                    <div class="dp-meta-cell">
                        <span class="mlbl">القسم</span>
                        <span class="mval">@Model.SelectedDept</span>
                    </div>
                }
            </div>
        </div>
        <div class="dp-num-box">
            <div class="nlbl">رقم اليومية</div>
            <div class="nval">@Model.ReportNumber</div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="dp-cards-row">
        <div class="dp-card">
            <div class="card-icon"><i class="fas fa-cash-register"></i></div>
            <div class="card-lbl">إجمالي المبيعات</div>
            <div class="card-val blue">@Model.TotalSales.ToString("N3")</div>
            <div class="card-cur">د.ك</div>
            <div class="card-sub">@Model.InvoiceCount فاتورة — متوسط @Model.AvgInvoiceValue.ToString("N3") د.ك</div>
        </div>
        <div class="dp-card">
            <div class="card-pct">@Model.CashPercent.ToString("N1")%</div>
            <div class="card-icon"><i class="fas fa-money-bill-wave"></i></div>
            <div class="card-lbl">كاش</div>
            <div class="card-val green">@Model.CashTotal.ToString("N3")</div>
            <div class="card-cur">د.ك</div>
            <div class="card-sub" style="color:#1d4ed8;">كي نت: @Model.KNetTotal.ToString("N3") د.ك (@Model.KNetPercent.ToString("N1")%)</div>
        </div>
        <div class="dp-card">
            <div class="card-pct" style="background:#dc2626;">@Model.DebtPercent.ToString("N1")%</div>
            <div class="card-icon"><i class="fas fa-exclamation-circle"></i></div>
            <div class="card-lbl">الديون</div>
            <div class="card-val red">@Model.DebtTotal.ToString("N3")</div>
            <div class="card-cur">د.ك</div>
            <div class="card-sub" style="color:#d97706;">خصومات: @Model.TotalDiscount.ToString("N3") د.ك (@Model.DiscountPercent.ToString("N1")%)</div>
        </div>
        <div class="dp-card">
            <div class="card-icon"><i class="fas fa-building"></i></div>
            <div class="card-lbl">صافي المحل</div>
            <div class="card-val blue">@totalShopNet.ToString("N3")</div>
            <div class="card-cur">د.ك</div>
            <div class="card-sub">عمولة الموظفين: @totalDue.ToString("N3") د.ك</div>
        </div>
    </div>

    <!-- Tips -->
    @if (Model.TipsTotal > 0 || true)
    {
        <div class="dp-tips-bar">
            <div class="dp-tips-cell">
                <div class="t-lbl"><i class="fas fa-hand-holding-heart me-1"></i>إجمالي الإكراميات</div>
                <div class="t-val" style="color:#d97706;">@Model.TipsTotal.ToString("N3")</div>
                <div class="t-cur">د.ك</div>
            </div>
            <div class="dp-tips-cell">
                <div class="t-lbl">تم التسليم للموظفين</div>
                <div class="t-val" style="color:#16a34a;">@Model.TipsDelivered.ToString("N3")</div>
                <div class="t-cur">د.ك</div>
                @if (Model.TipsDelivered > 0)
                {
                    <span class="tips-badge badge-delivered">✓ تم التسليم</span>
                }
            </div>
            <div class="dp-tips-cell">
                <div class="t-lbl">المتبقي للتسليم</div>
                <div class="t-val" style="color:@(Model.TipsRemaining > 0 ? "#dc2626" : "#16a34a");">@Model.TipsRemaining.ToString("N3")</div>
                <div class="t-cur">د.ك</div>
                @if (Model.TipsRemaining > 0)
                {
                    <span class="tips-badge badge-remaining">⚠ لم يُسلَّم بعد</span>
                }
                else if (Model.TipsTotal > 0)
                {
                    <span class="tips-badge badge-delivered">✓ تم التسليم الكامل</span>
                }
            </div>
        </div>
    }

    <!-- Cash Register -->
    @if (!User.IsInRole("Employee"))
    {
        <div class="dp-cash-box">
            <div class="dp-cash-title"><i class="fas fa-safe me-1"></i> حركة الصندوق اليوم</div>
            <div class="dp-cash-flow">
                <div class="dp-cf-item">
                    <div class="cf-icon" style="color:#555;"><i class="fas fa-box-open"></i></div>
                    <div class="cf-lbl">رصيد البداية</div>
                    <div class="cf-val">@Model.OpeningBalance.ToString("N3")</div>
                </div>
                <div class="dp-cf-op">+</div>
                <div class="dp-cf-item">
                    <div class="cf-icon" style="color:#16a34a;"><i class="fas fa-money-bill-wave"></i></div>
                    <div class="cf-lbl">إيرادات كاش</div>
                    <div class="cf-val" style="color:#16a34a;">@Model.CashRevenue.ToString("N3")</div>
                </div>
                @if (Model.TotalDeposits > 0)
                {
                    <div class="dp-cf-op">+</div>
                    <div class="dp-cf-item">
                        <div class="cf-icon" style="color:#1d4ed8;"><i class="fas fa-arrow-down"></i></div>
                        <div class="cf-lbl">إيداعات</div>
                        <div class="cf-val" style="color:#1d4ed8;">@Model.TotalDeposits.ToString("N3")</div>
                    </div>
                }
                @if (Model.TotalExpensesAmount > 0)
                {
                    <div class="dp-cf-op">−</div>
                    <div class="dp-cf-item">
                        <div class="cf-icon" style="color:#dc2626;"><i class="fas fa-receipt"></i></div>
                        <div class="cf-lbl">مصروفات (@Model.ExpenseCount)</div>
                        <div class="cf-val" style="color:#dc2626;">@Model.TotalExpensesAmount.ToString("N3")</div>
                    </div>
                }
                @if (Model.TotalAdvancesAmount > 0)
                {
                    <div class="dp-cf-op">−</div>
                    <div class="dp-cf-item">
                        <div class="cf-icon" style="color:#d97706;"><i class="fas fa-hand-holding-usd"></i></div>
                        <div class="cf-lbl">سلف موظفين</div>
                        <div class="cf-val" style="color:#d97706;">@Model.TotalAdvancesAmount.ToString("N3")</div>
                    </div>
                }
                @if (Model.TotalWithdrawals > 0)
                {
                    <div class="dp-cf-op">−</div>
                    <div class="dp-cf-item">
                        <div class="cf-icon" style="color:#dc2626;"><i class="fas fa-arrow-up"></i></div>
                        <div class="cf-lbl">سحوبات</div>
                        <div class="cf-val" style="color:#dc2626;">@Model.TotalWithdrawals.ToString("N3")</div>
                    </div>
                }
                <div class="dp-cf-op">=</div>
                <div class="dp-cf-item" style="background:#f0fdf4;border-radius:6px;border:1px solid #bbf7d0;">
                    <div class="cf-icon" style="color:#16a34a;"><i class="fas fa-safe"></i></div>
                    <div class="cf-lbl" style="color:#166534;">الرصيد الحالي</div>
                    <div class="cf-val" style="color:#16a34a;font-size:16px;">@Model.CurrentCashBalance.ToString("N3")</div>
                </div>
            </div>
        </div>
    }

    <!-- Employee Performance Table -->
    <div class="dp-table-wrap">
        <div class="dp-section-title">
            <i class="fas fa-chart-bar me-1"></i>
            أداء الموظفين اليوم
            @if (Model.SelectedDept != null){ <span>— @Model.SelectedDept</span> }
        </div>

        <!-- Dept filter (no-print) -->
        <div class="dept-filter-bar no-print">
            <span class="dept-filter-label">فلتر:</span>
            <a href="?date=@selectedDate" class="dept-btn @(Model.SelectedDept == null ? "active" : "")" data-dept="all">
                الكل (@allRows.Count)
            </a>
            <a href="?date=@selectedDate&dept=حلاقة" class="dept-btn @(Model.SelectedDept == "حلاقة" ? "active" : "")" data-dept="حلاقة">
                ✂ حلاقة (@Model.BarberRows.Count)
            </a>
            <a href="?date=@selectedDate&dept=مساج" class="dept-btn @(Model.SelectedDept == "مساج" ? "active" : "")" data-dept="مساج">
                🌿 مساج (@Model.MassageRows.Count)
            </a>
        </div>

        <table class="dp-table">
            <thead>
                <tr>
                    <th>#</th>
                    @if (showDeptCol){ <th>القسم</th> }
                    <th>الموظف</th>
                    <th>الفواتير<br /><small>#</small></th>
                    <th>إجمالي الشغل<br /><small>د.ك</small></th>
                    <th>كاش<br /><small>د.ك</small></th>
                    <th>كي نت<br /><small>د.ك</small></th>
                    <th>الديون<br /><small>د.ك</small></th>
                    <th>السلف<br /><small>د.ك</small></th>
                    <th>نسبة<br />%</th>
                    <th>المستحق<br />للموظف<br /><small>د.ك</small></th>
                    <th>الإكرامية<br /><small>د.ك</small></th>
                    <th>المستحق<br />للمحل<br /><small>د.ك</small></th>
                </tr>
            </thead>
            <tbody>
                @if (!allRows.Any())
                {
                    <tr>
                        <td colspan="@(showDeptCol ? 13 : 12)" class="text-center text-muted py-4">
                            <i class="fas fa-inbox me-1"></i> لا يوجد موظفون أو لا توجد مبيعات لهذا اليوم
                        </td>
                    </tr>
                }
                @{ int seq = 1; }
                @foreach (var row in allRows)
                {
                    <tr>
                        <td>@(seq++)</td>
                        @if (showDeptCol)
                        {
                            <td>
                                @if (row.DepartmentName == "حلاقة")
                                {
                                    <span class="badge" style="background:#1a1a2e;">✂ حلاقة</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#0891b2;">🌿 مساج</span>
                                }
                            </td>
                        }
                        <td><strong>@row.Employee.FullName</strong></td>
                        <td>@row.InvoiceCount</td>
                        <td>@row.TotalSales.ToString("N3")</td>
                        <td>@row.Cash.ToString("N3")</td>
                        <td>@row.KNet.ToString("N3")</td>
                        <td class="@(row.Debts > 0 ? "text-danger" : "")">@row.Debts.ToString("N3")</td>
                        <td class="@(row.Advances > 0 ? "text-danger" : "")">@row.Advances.ToString("N3")</td>
                        <td><strong>@row.CommissionPercent.ToString("N0")%</strong></td>
                        <td style="color:#16a34a;font-weight:bold;">@row.DueAmount.ToString("N3")</td>
                        <td>
                            @if (row.Hadiya > 0)
                            {
                                <span style="color:#d97706;font-weight:bold;">@row.Hadiya.ToString("N3")</span>
                                <br /><span class="badge" style="background:#16a34a;font-size:10px;">✓ تم</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td style="color:#1d4ed8;font-weight:bold;">@row.ShopNet.ToString("N3")</td>
                    </tr>
                }
            </tbody>
            @if (allRows.Any())
            {
                <tfoot>
                    <tr>
                        <td colspan="@(showDeptCol ? 3 : 2)">الإجمالي</td>
                        <td>@totalInv</td>
                        <td>@totalWork.ToString("N3")</td>
                        <td>@totalCash.ToString("N3")</td>
                        <td>@totalKNet.ToString("N3")</td>
                        <td>@totalDebts.ToString("N3")</td>
                        <td>@totalAdv.ToString("N3")</td>
                        <td>@overallPct.ToString("N1")%</td>
                        <td>@totalDue.ToString("N3")</td>
                        <td style="color:#fbbf24;">@totalHadiya.ToString("N3")</td>
                        <td>@totalShopNet.ToString("N3")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <!-- Daily Notes -->
    @if (!string.IsNullOrWhiteSpace(Model.DailyNotes) || Model.ShiftId > 0)
    {
        <div class="dp-notes-box no-print">
            <div class="dp-notes-title"><i class="fas fa-sticky-note me-1"></i> ملاحظات اليوم</div>
            @if (!string.IsNullOrWhiteSpace(Model.DailyNotes))
            {
                <p class="mb-2" style="font-size:13px;">@Model.DailyNotes</p>
            }
            @if (Model.ShiftId > 0)
            {
                <form method="post" action="@Url.Action("SaveNote","BarberDaily")" class="d-flex gap-2">
                    <input type="hidden" name="shiftId" value="@Model.ShiftId" />
                    <input type="hidden" name="date" value="@selectedDate" />
                    <input type="text" name="notes" class="form-control form-control-sm" placeholder="أضف ملاحظة..." value="@Model.DailyNotes" style="max-width:400px;" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">حفظ</button>
                </form>
            }
        </div>
    }

    <div class="dp-footer">
        ملاحظة: جميع المبالغ بالدينار الكويتي (د.ك)
    </div>

</div>
