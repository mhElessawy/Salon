@model Salon.Models.Service
@{
    ViewData["Title"] = "إضافة خدمة";
}

<div class="page-header">
    <h1><i class="fas fa-plus-circle me-2"></i>إضافة خدمة جديدة</h1>
</div>
<div class="card" style="max-width:700px">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ServiceCategoryId" class="form-label"></label>
                    <select asp-for="ServiceCategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- اختر الفئة --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" type="number" step="0.001" min="0" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="DurationMinutes" class="form-label"></label>
                    <input asp-for="DurationMinutes" type="number" min="0" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="CommissionPercentage" class="form-label"></label>
                    <input asp-for="CommissionPercentage" type="number" step="0.01" min="0" max="100" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>
