@model IEnumerable<Salon.Models.Service>
@{
    ViewData["Title"] = "الخدمات";
    var currentFilter  = ViewBag.Filter as string ?? "all";
    var invoiceCounts  = ViewBag.InvoiceCounts  as Dictionary<int, int>     ?? new Dictionary<int, int>();
    var totalSales     = ViewBag.TotalSales     as Dictionary<int, decimal>  ?? new Dictionary<int, decimal>();
    var last30Invoices = ViewBag.Last30Invoices as Dictionary<int, int>     ?? new Dictionary<int, int>();
    var last30Sales    = ViewBag.Last30Sales    as Dictionary<int, decimal>  ?? new Dictionary<int, decimal>();
    var ranks          = ViewBag.Ranks          as Dictionary<int, int>     ?? new Dictionary<int, int>();
    var statusText     = ViewBag.StatusText     as Dictionary<int, string>  ?? new Dictionary<int, string>();
    var statusClass    = ViewBag.StatusClass    as Dictionary<int, string>  ?? new Dictionary<int, string>();
}

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">إدارة الخدمات</h1>
        <p class="mb-0">إضافة وتعديل الخدمات المقدمة في الصالون</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a href="@Url.Action("Index", "Packages")" class="btn btn-outline-secondary d-flex align-items-center gap-1">
            <i class="fas fa-box-open"></i> باقات الجلسات
        </a>
        <a href="@Url.Action("Create")" class="btn btn-primary d-flex align-items-center gap-1">
            <i class="fas fa-plus"></i> إضافة خدمة جديدة
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter tabs -->
<div class="d-flex gap-2 mb-3 flex-wrap">
    <a href="@Url.Action("Index", new { filter = "all", search = ViewBag.Search })"
       class="btn btn-sm @(currentFilter == "all" ? "btn-dark" : "btn-outline-secondary")">الكل</a>
    <a href="@Url.Action("Index", new { filter = "مساج", search = ViewBag.Search })"
       class="btn btn-sm @(currentFilter == "مساج" ? "btn-dark" : "btn-outline-secondary")">مساج</a>
    <a href="@Url.Action("Index", new { filter = "حلاقة", search = ViewBag.Search })"
       class="btn btn-sm @(currentFilter == "حلاقة" ? "btn-dark" : "btn-outline-secondary")">حلاقة</a>
</div>

<!-- Search bar -->
<div class="mb-4 position-relative">
    <form method="get" id="searchForm">
        <input type="hidden" name="filter" value="@currentFilter" />
        <input type="text" name="search" value="@ViewBag.Search" id="searchInput"
               class="form-control pe-5" placeholder="ابحث عن خدمة..." />
        <button type="submit" class="btn btn-link position-absolute top-50 translate-middle-y"
                style="left: 10px; right: auto; color: #adb5bd;">
            <i class="fas fa-search"></i>
        </button>
    </form>
</div>

<!-- Cards grid -->
@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="fas fa-cut fa-3x mb-3 d-block" style="color:#dee2e6"></i>
        لا توجد خدمات مسجلة
    </div>
}
else
{
    <div class="row g-3" id="servicesGrid">
        @foreach (var s in Model)
        {
            var categoryName = s.ServiceCategory?.Name ?? "";
            var dept = s.ServiceCategory?.Department ?? "";
            <div class="col-xl-3 col-lg-4 col-md-6 service-card-col" data-dept="@dept" data-name="@s.Name.ToLower()">
                <div class="card service-card h-100">
                    <div class="card-body p-3">
                        @{
                            var svcRank    = ranks.ContainsKey(s.Id)         ? ranks[s.Id]          : 0;
                            var svcCnt     = invoiceCounts.ContainsKey(s.Id) ? invoiceCounts[s.Id]  : 0;
                            var svcTotal   = totalSales.ContainsKey(s.Id)    ? totalSales[s.Id]     : 0m;
                            var svc30Inv   = last30Invoices.ContainsKey(s.Id)? last30Invoices[s.Id] : 0;
                            var svc30Sale  = last30Sales.ContainsKey(s.Id)   ? last30Sales[s.Id]    : 0m;
                            var svcStText  = statusText.ContainsKey(s.Id)    ? statusText[s.Id]     : "متوقفة";
                            var svcStClass = statusClass.ContainsKey(s.Id)   ? statusClass[s.Id]    : "svc-status-stopped";
                        }

                        <!-- Top row: actions + icon + rank -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex gap-2">
                                <button type="button" class="svc-action-btn svc-action-delete"
                                        onclick="confirmDelete(@s.Id, '@Html.Raw(s.Name.Replace("'", "\\'"))')"
                                        title="حذف">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                                <a href="@Url.Action("Edit", new { id = s.Id })" class="svc-action-btn svc-action-edit" title="تعديل">
                                    <i class="fas fa-credit-card"></i>
                                </a>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (svcRank > 0)
                                {
                                    <span class="svc-rank-badge @(svcRank == 1 ? "svc-rank-gold" : svcRank == 2 ? "svc-rank-silver" : svcRank == 3 ? "svc-rank-bronze" : "svc-rank-default")">#@svcRank</span>
                                }
                                <div class="svc-icon-box" style="@(s.ServiceCategory?.Color != null ? $"background:{s.ServiceCategory.Color}" : "background:#F7941D")">
                                    <i class="@(string.IsNullOrEmpty(s.ServiceCategory?.Icon) ? (dept == "مساج" ? "fas fa-spa" : "fas fa-cut") : s.ServiceCategory!.Icon)"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Service name -->
                        <div class="svc-name mb-1">@s.Name</div>

                        <!-- Category badge -->
                        @if (s.ServiceCategory != null)
                        {
                            <div class="mb-3">
                                <span class="svc-category-badge">@s.ServiceCategory.Name</span>
                            </div>
                        }

                        <!-- Details rows -->
                        <div class="svc-details">
                            <div class="svc-detail-row">
                                <span class="svc-detail-label">السعر</span>
                                <span class="svc-detail-value svc-price">د.ك @s.Price.ToString("N3")</span>
                            </div>
                            <div class="svc-detail-row">
                                <span class="svc-detail-label">المدة</span>
                                <span class="svc-detail-value">@(s.DurationMinutes.HasValue ? $"{s.DurationMinutes} دقيقة" : "-")</span>
                            </div>
                            <div class="svc-detail-row">
                                <span class="svc-detail-label">عدد الفواتير</span>
                                <span class="svc-detail-value svc-invoice-val">@svcCnt فاتورة</span>
                            </div>
                            <div class="svc-detail-row">
                                <span class="svc-detail-label">إجمالي المبيعات</span>
                                <span class="svc-detail-value svc-total-val">د.ك @svcTotal.ToString("N3")</span>
                            </div>
                            <div class="svc-detail-divider"></div>
                            <div class="svc-detail-row">
                                <span class="svc-detail-label">فواتير آخر 30 يوم</span>
                                <span class="svc-detail-value svc-30-inv">@svc30Inv فاتورة</span>
                            </div>
                            <div class="svc-detail-row">
                                <span class="svc-detail-label">مبيعات آخر 30 يوم</span>
                                <span class="svc-detail-value svc-30-sale">د.ك @svc30Sale.ToString("N3")</span>
                            </div>
                        </div>

                        <!-- Status badge -->
                        <div class="mt-3">
                            <span class="svc-status-badge @svcStClass">@svcStText</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف الخدمة:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .service-card {
        border: 1px solid #e9ecef;
        border-radius: 14px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .service-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        }

    .svc-icon-box {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 20px;
    }

    .svc-action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

    .svc-action-delete {
        color: #dc3545;
    }

        .svc-action-delete:hover {
            background: #dc3545;
            color: #fff;
            border-color: #dc3545;
        }

    .svc-action-edit {
        color: #6c757d;
    }

        .svc-action-edit:hover {
            background: #6c757d;
            color: #fff;
            border-color: #6c757d;
        }

    .svc-name {
        font-weight: 700;
        font-size: 15px;
        color: #1a1a2e;
        text-align: right;
    }

    .svc-category-badge {
        background: #e3f2fd;
        color: #1565c0;
        border-radius: 20px;
        padding: 3px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .svc-details {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .svc-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
    }

    .svc-detail-label {
        color: #6c757d;
    }

    .svc-detail-value {
        font-weight: 600;
        color: #1a1a2e;
    }

    .svc-price {
        color: #F7941D;
    }

    .svc-status-badge {
        display: inline-block;
        border-radius: 20px;
        padding: 3px 14px;
        font-size: 12px;
        font-weight: 600;
    }

    /* Status badges */
    .svc-status-excellent {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .svc-status-good {
        background: #fff9c4;
        color: #f57f17;
    }

    .svc-status-needs {
        background: #fff3e0;
        color: #e65100;
    }

    .svc-status-stopped {
        background: #fce4ec;
        color: #c62828;
    }

    /* Rank badge */
    .svc-rank-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 22px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 800;
        padding: 0 6px;
    }

    .svc-rank-gold    { background: #fff8e1; color: #f9a825; border: 1px solid #f9a825; }
    .svc-rank-silver  { background: #f5f5f5; color: #757575; border: 1px solid #bdbdbd; }
    .svc-rank-bronze  { background: #fbe9e7; color: #bf360c; border: 1px solid #ff8a65; }
    .svc-rank-default { background: #f3f4f6; color: #6c757d; border: 1px solid #dee2e6; }

    .svc-invoice-val  { color: #28a745; }
    .svc-total-val    { color: #1565c0; }
    .svc-30-inv       { color: #6c3483; }
    .svc-30-sale      { color: #0d6efd; font-weight: 700; }

    .svc-detail-divider {
        border-top: 1px dashed #e9ecef;
        margin: 4px 0;
    }
</style>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}