@model  IEnumerable<Salon.Models.Custody>
@{
    ViewData["Title"] = "تقرير العهد";
    decimal totalAll = Model.Sum(c => c.Amount);
    decimal totalCash = Model.Where(c => c.PaymentMethod == "نقدي").Sum(c => c.Amount);
    decimal totalLink = Model.Where(c => c.PaymentMethod == "لينك").Sum(c => c.Amount);
    decimal totalRemaining = Model.Sum(c => c.RemainingAmount);
    decimal totalSettled = Model.Sum(c => c.SettledAmount);
    decimal totalSettledCash = Model.SelectMany(c => c.Settlements).Where(s => s.Status == "موافق عليها" && s.PaymentMethod == "نقدي").Sum(s => s.Amount);
    decimal totalSettledLink = Model.SelectMany(c => c.Settlements).Where(s => s.Status == "موافق عليها" && s.PaymentMethod == "لينك").Sum(s => s.Amount);
    decimal totalPending = Model.Sum(c => c.PendingSettlementAmount);
    var grouped = Model.GroupBy(c => c.Employee?.FullName ?? "-").OrderBy(g => g.Key);
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-file-invoice-dollar me-2"></i>تقرير العهد</h1>
        <p>عهد الموظفين المسلَّمة نقداً أو عن طريق لينك</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary">
        <i class="fas fa-print me-1"></i> طباعة
    </button>
</div>

<div class="card mb-3 no-print">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-1">من تاريخ</label>
                <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1">إلى تاريخ</label>
                <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1">الموظف</label>
                <select name="employeeId" class="form-select">
                    <option value="">-- الكل --</option>
                    @foreach (SelectListItem emp in ViewBag.Employees)
                    {
                        var selected = emp.Value == (ViewBag.EmployeeId?.ToString() ?? "");
                        <option value="@emp.Value" selected="@(selected ? "selected" : null)">@emp.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1">طريقة التسليم</label>
                <select name="paymentMethod" class="form-select">
                    <option value="">-- الكل --</option>
                    <option value="نقدي" selected="@(ViewBag.PaymentMethod == "نقدي" ? "selected" : null)">نقدي</option>
                    <option value="لينك" selected="@(ViewBag.PaymentMethod == "لينك" ? "selected" : null)">لينك</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> بحث</button>
                <a href="@Url.Action("Report")" class="btn btn-outline-secondary ms-1">إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card border-danger">
            <div class="card-body text-center">
                <div class="text-muted small mb-1"><i class="fas fa-money-bill-wave text-danger me-1"></i> عهد نقدية</div>
                <div class="fs-4 fw-bold text-danger">@totalCash.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card" style="border-color:#0ea5e9;">
            <div class="card-body text-center">
                <div class="text-muted small mb-1"><i class="fas fa-link me-1" style="color:#0ea5e9;"></i> عهد عن طريق لينك</div>
                <div class="fs-4 fw-bold" style="color:#0ea5e9;">@totalLink.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card" style="border-color:#6f42c1;">
            <div class="card-body text-center">
                <div class="text-muted small mb-1"><i class="fas fa-hand-holding me-1" style="color:#6f42c1;"></i> إجمالي العهد</div>
                <div class="fs-4 fw-bold" style="color:#6f42c1;">@totalAll.ToString("N3") <small>د.ك</small></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card" style="border-color:#16a34a;">
            <div class="card-body text-center">
                <div class="text-muted small mb-1"><i class="fas fa-undo me-1" style="color:#16a34a;"></i> إجمالي المسدد / المرتجع من العهد</div>
                <div class="fs-4 fw-bold" style="color:#16a34a;">@totalSettled.ToString("N3") <small>د.ك</small></div>
                <div class="small text-muted mt-1">
                    نقدي (يُضاف للصندوق): <strong class="text-success">@totalSettledCash.ToString("N3")</strong> —
                    لينك: <strong style="color:#0ea5e9;">@totalSettledLink.ToString("N3")</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card" style="border-color:#d97706;">
            <div class="card-body text-center">
                <div class="text-muted small mb-1"><i class="fas fa-clock me-1" style="color:#d97706;"></i> إجمالي المتبقي (غير مسدد)</div>
                <div class="fs-4 fw-bold" style="color:#d97706;">@totalRemaining.ToString("N3") <small>د.ك</small></div>
                @if (totalPending > 0)
                {
                    <div class="small mt-1" style="color:#b45309;"><i class="fas fa-hourglass-half me-1"></i><span>منها قيد المراجعة:</span> @totalPending.ToString("N3") د.ك</div>
                }
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-muted py-5">لا توجد عهد في هذه الفترة</div></div>
}
else
{
    @foreach (var group in grouped)
    {
        decimal gAll = group.Sum(c => c.Amount);
        decimal gCash = group.Where(c => c.PaymentMethod == "نقدي").Sum(c => c.Amount);
        decimal gLink = group.Where(c => c.PaymentMethod == "لينك").Sum(c => c.Amount);
        decimal gSettled = group.Sum(c => c.SettledAmount);
        decimal gRemaining = group.Sum(c => c.RemainingAmount);

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong><i class="fas fa-user me-2"></i>@group.Key</strong>
                <div class="d-flex gap-3 small">
                    <span class="text-danger">نقدي: <strong>@gCash.ToString("N3")</strong> د.ك</span>
                    <span style="color:#0ea5e9;">لينك: <strong>@gLink.ToString("N3")</strong> د.ك</span>
                    <span style="color:#6f42c1;">الإجمالي: <strong>@gAll.ToString("N3")</strong> د.ك</span>
                    <span style="color:#16a34a;">المسدد: <strong>@gSettled.ToString("N3")</strong> د.ك</span>
                    <span style="color:#d97706;">المتبقي: <strong>@gRemaining.ToString("N3")</strong> د.ك</span>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>تاريخ التسليم</th>
                            <th>المبلغ المسلَّم</th>
                            <th>طريقة التسليم</th>
                            <th>السبب</th>
                            <th>ملاحظات</th>
                            <th>المسدد</th>
                            <th>المتبقي</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in group)
                        {
                            var statusBadge = c.Status == "مسددة" ? "bg-success" : c.Status == "مسددة جزئياً" ? "bg-info text-dark" : "bg-warning text-dark";
                            <tr>
                                <td>@c.CustodyDate.ToString("yyyy/MM/dd")</td>
                                <td class="text-danger fw-bold">@c.Amount.ToString("N3") د.ك</td>
                                <td>
                                    @if (c.PaymentMethod == "نقدي")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">نقدي</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:rgba(14,165,233,0.12); color:#0ea5e9;">لينك</span>
                                    }
                                </td>
                                <td>@(c.Reason ?? "-")</td>
                                <td class="text-muted small">@(c.Notes ?? "-")</td>
                                <td class="@(c.SettledAmount > 0 ? "text-success fw-bold" : "text-muted")">@c.SettledAmount.ToString("N3") د.ك</td>
                                <td class="@(c.RemainingAmount > 0 ? "text-warning fw-bold" : "text-muted")">@c.RemainingAmount.ToString("N3") د.ك</td>
                                <td><span class="badge @statusBadge">@c.Status</span></td>
                            </tr>
                            @if (c.Settlements.Any())
                            {
                                <tr class="table-light">
                                    <td colspan="8" class="py-2 px-3">
                                        <div class="small fw-bold text-muted mb-1"><i class="fas fa-undo me-1"></i>تفاصيل التسويات / الإرجاع:</div>
                                        <table class="table table-sm table-borderless mb-0" style="background:transparent;">
                                            <thead>
                                                <tr class="text-muted small">
                                                    <th style="width:120px;">التاريخ</th>
                                                    <th style="width:140px;">المبلغ</th>
                                                    <th style="width:120px;">طريقة الإرجاع</th>
                                                    <th style="width:110px;">الحالة</th>
                                                    <th>ملاحظات</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var s in c.Settlements.OrderBy(s => s.SettlementDate))
                                                {
                                                    <tr>
                                                        <td>@s.SettlementDate.ToString("yyyy/MM/dd")</td>
                                                        <td class="text-success fw-bold">@s.Amount.ToString("N3") د.ك</td>
                                                        <td>
                                                            @if (s.PaymentMethod == "نقدي")
                                                            {
                                                                <span class="badge bg-success bg-opacity-10 text-success">نقدي</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge" style="background:rgba(14,165,233,0.12); color:#0ea5e9;">لينك</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (s.Status == "موافق عليها")
                                                            {
                                                                <span class="badge bg-success">موافق عليها</span>
                                                            }
                                                            else if (s.Status == "مرفوضة")
                                                            {
                                                                <span class="badge bg-danger">مرفوضة</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning text-dark">معلق</span>
                                                            }
                                                        </td>
                                                        <td class="text-muted">
                                                            @(s.Notes ?? "-")
                                                            @if (s.Status == "مرفوضة" && !string.IsNullOrEmpty(s.RejectionReason))
                                                            {
                                                                <div class="text-danger small mt-1"><i class="fas fa-comment-slash me-1"></i><span>سبب الرفض:</span> @s.RejectionReason</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>الإجمالي</td>
                            <td class="text-danger">@gAll.ToString("N3") د.ك</td>
                            <td colspan="3"></td>
                            <td class="text-success">@gSettled.ToString("N3") د.ك</td>
                            <td class="text-warning">@gRemaining.ToString("N3") د.ك</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

@section Styles {
    <style>
        @@media print {
            .no-print, nav, .sidebar, .topbar {
                display: none !important;
            }

            .card {
                break-inside: avoid;
            }
        }
    </style>
}