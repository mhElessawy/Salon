@using Salon.Controllers
@model IEnumerable<Salon.Models.Custody>
@{
    ViewData["Title"] = "العهد";
    bool isManager = (bool)(ViewBag.IsManager ?? false);
    decimal totalCash = (decimal)ViewBag.TotalCash;
    decimal totalLink = (decimal)ViewBag.TotalLink;
    decimal total = (decimal)ViewBag.Total;
    decimal totalSpent = (decimal)ViewBag.TotalSpent;
    decimal totalReserved = (decimal)ViewBag.TotalReserved;
    decimal totalRemaining = (decimal)ViewBag.TotalRemaining;
    var summaries = (List<EmployeeCustodySummary>)ViewBag.EmployeeSummaries;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-hand-holding me-2"></i>عهد الموظفين</h1>
        <p>رصيد عهدة كل موظف موحَّد من كل إيداعاته معاً — العهدة مبلغ مخصص للموظف ولا يخصم من رصيد الصندوق إلا عند اعتماد المصروف الفعلي.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "PurchaseRequests")" class="btn btn-outline-primary">
            <i class="fas fa-shopping-cart me-1"></i> طلبات الشراء
        </a>
        <a href="@Url.Action("Report")" class="btn btn-outline-secondary">
            <i class="fas fa-file-invoice-dollar me-1"></i> تقرير العهد
        </a>
        @if (isManager)
        {
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i> تسليم عهدة
            </a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #dc2626 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-money-bill-wave me-1 text-danger"></i>عهد نقدية</div>
                <div class="fw-bold fs-4 text-danger">@totalCash.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #0ea5e9 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-link me-1" style="color:#0ea5e9;"></i>عهد عن طريق لينك</div>
                <div class="fw-bold fs-4" style="color:#0ea5e9;">@totalLink.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #6f42c1 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-hand-holding me-1" style="color:#6f42c1;"></i>إجمالي العهد</div>
                <div class="fw-bold fs-4" style="color:#6f42c1;">@total.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #198754 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-shopping-cart me-1 text-success"></i>مصروف (طلبات شراء معتمدة)</div>
                <div class="fw-bold fs-4 text-success">@totalSpent.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #d97706 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1"><i class="fas fa-clock me-1" style="color:#d97706;"></i>إجمالي المتبقي (موحَّد لكل موظف)</div>
                <div class="fw-bold fs-4" style="color:#d97706;">@totalRemaining.ToString("N3") <small class="text-muted">د.ك</small></div>
                @if (totalReserved > 0)
                {
                    <div class="small mt-1" style="color:#b45309;"><i class="fas fa-hourglass-half me-1"></i><span>محجوز لطلبات قيد المعالجة:</span> @totalReserved.ToString("N3") د.ك</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white">
        <strong><i class="fas fa-users me-2"></i>رصيد العهدة الموحَّد لكل موظف</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الموظف</th>
                        <th>عدد الإيداعات المفتوحة</th>
                        <th>إجمالي المودَع</th>
                        <th>المصروف</th>
                        <th>محجوز</th>
                        <th>المتاح لطلب جديد</th>
                        <th>الرصيد المتبقي</th>
                        @if (isManager)
                        {
                            <th>الإجراءات</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!summaries.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد عهد مسجلة</td></tr>
                    }
                    @foreach (var s in summaries)
                    {
                        <tr>
                            <td>@s.EmployeeName</td>
                            <td>@s.OpenDepositsCount</td>
                            <td>@s.TotalDeposited.ToString("N3") د.ك</td>
                            <td class="@(s.TotalSpent > 0 ? "text-success fw-bold" : "text-muted")">@s.TotalSpent.ToString("N3") د.ك</td>
                            <td class="@(s.TotalReserved > 0 ? "text-warning fw-bold" : "text-muted")">@s.TotalReserved.ToString("N3") د.ك</td>
                            <td class="fw-bold" style="color:#16a34a;">@s.AvailableForRequest.ToString("N3") د.ك</td>
                            <td class="@(s.RemainingAmount > 0 ? "text-warning fw-bold" : "text-muted")">@s.RemainingAmount.ToString("N3") د.ك</td>
                            @if (isManager)
                            {
                                <td class="text-nowrap">
                                    <a href="@Url.Action("Ledger", new { employeeId = s.EmployeeId })" class="btn btn-sm btn-outline-primary" title="تفاصيل / كشف حساب">
                                        <i class="fas fa-list"></i> تفاصيل
                                    </a>
                                    @if (s.RemainingAmount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning js-settle-btn" title="تسوية العهدة"
                                                data-settle-emp="@s.EmployeeId" data-settle-name="@s.EmployeeName"
                                                data-settle-remaining="@s.RemainingAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                                            <i class="fas fa-scale-balanced"></i> تسوية
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">الموظف:</label>
            <select name="employeeId" class="form-select" style="max-width:220px;" onchange="this.form.submit()">
                <option value="">-- الكل --</option>
                @foreach (SelectListItem emp in ViewBag.Employees)
                {
                    var selected = emp.Value == (ViewBag.EmployeeId?.ToString() ?? "");
                    <option value="@emp.Value" selected="@(selected ? "selected" : null)">@emp.Text</option>
                }
            </select>
            @if (ViewBag.EmployeeId != null)
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">إعادة تعيين</a>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <strong><i class="fas fa-history me-2"></i>سجل الإيداعات (للمراجعة)</strong>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الموظف</th>
                        <th>المبلغ</th>
                        <th>طريقة التسليم</th>
                        <th>تاريخ التسليم</th>
                        <th>السبب / البيان</th>
                        <th>المتبقي من هذا الإيداع</th>
                        <th>الحالة</th>
                        <th>ملاحظات</th>
                        @if (isManager)
                        {
                            <th>الإجراءات</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">لا توجد عهد مسجلة</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@(c.Employee?.FullName ?? "-")</td>
                            <td><strong class="text-danger">@c.Amount.ToString("N3") د.ك</strong></td>
                            <td>
                                @if (c.PaymentMethod == "نقدي")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger"><i class="fas fa-money-bill-wave me-1"></i>نقدي</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:rgba(14,165,233,0.12); color:#0ea5e9;"><i class="fas fa-link me-1"></i>لينك</span>
                                }
                            </td>
                            <td>@c.CustodyDate.ToString("yyyy/MM/dd")</td>
                            <td>@(c.Reason ?? "-") @(c.IsOpeningBalance ? " (رصيد مرحّل)" : "")</td>
                            <td>
                                <span class="@(c.RemainingAmount > 0 ? "text-warning fw-bold" : "text-muted")">@c.RemainingAmount.ToString("N3") د.ك</span>
                            </td>
                            <td>
                                @if (c.SettlementType == null)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">نشطة</span>
                                }
                                else if (c.SettlementType == Salon.Models.Custody.SettlementTypes.RolledOver)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info" title="@c.SettledAt?.ToString("yyyy/MM/dd HH:mm")">مرحَّلة</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary" title="@c.SettledAt?.ToString("yyyy/MM/dd HH:mm")">مقفلة</span>
                                }
                            </td>
                            <td class="text-muted">@(c.Notes ?? "-")</td>
                            @if (isManager)
                            {
                                <td class="text-nowrap">
                                    @if (c.SettlementType == null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                                onclick="confirmDelete(@c.Id, '@Html.Raw((c.Employee?.FullName ?? "").Replace("'", "\\'"))')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2" class="text-end">الإجمالي</td>
                            <td class="text-danger">@total.ToString("N3") د.ك</td>
                            <td colspan="4"></td>
                            <td colspan="@(isManager ? 3 : 2)"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@if (isManager)
{
    <!-- Modal تأكيد حذف العهدة -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="mb-3">
                    <i class="fas fa-trash-alt text-danger" style="font-size:3rem;"></i>
                </div>
                <h4 class="fw-bold mb-2">تأكيد الحذف</h4>
                <p class="text-muted mb-1">هل تريد حذف عهدة الموظف:</p>
                <p class="fw-bold fs-5 mb-4" id="deleteEmpName"></p>
                <p class="text-danger small mb-4">لا يمكن التراجع عن هذا الإجراء</p>
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                    <form id="deleteForm" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fas fa-trash me-1"></i> حذف
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal تسوية العهدة -->
    <div class="modal fade" id="settleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#d97706;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-scale-balanced me-2"></i>تسوية العهدة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="settleForm" method="post" asp-action="Settle">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="employeeId" id="settleEmployeeId" />
                    <div class="modal-body">
                        <div class="mb-3 p-3 rounded" style="background:#fffbeb;border:1px solid #fde68a;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">الموظف</span>
                                <strong id="settleEmpName" class="fs-6"></strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted">الرصيد المتبقي</span>
                                <strong id="settleRemaining" class="fs-6 text-warning"></strong>
                                <span class="text-muted small">د.ك</span>
                            </div>
                        </div>
                        <label class="form-label fw-bold">نوع التسوية <span class="text-danger">*</span></label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="settlementType" id="settleRollover" value="@Salon.Models.Custody.SettlementTypes.RolledOver" checked>
                            <label class="form-check-label" for="settleRollover">
                                ترحيل الرصيد للشهر القادم — يبقى الرصيد كما هو كرصيد افتتاحي جديد، ولا يتغير رصيد الصندوق
                            </label>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="radio" name="settlementType" id="settleClose" value="@Salon.Models.Custody.SettlementTypes.Closed">
                            <label class="form-check-label" for="settleClose">
                                إقفال / تصفية العهدة — يصبح الرصيد صفراً نهائياً، ولا يتغير رصيد الصندوق (لأن المتبقي لم يُخصم منه أصلاً)
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-warning px-4"><i class="fas fa-check me-1"></i> تأكيد التسوية</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function confirmDelete(id, empName) {
                document.getElementById('deleteEmpName').textContent = empName;
                document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            }

            document.querySelectorAll('.js-settle-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('settleEmployeeId').value = btn.dataset.settleEmp;
                    document.getElementById('settleEmpName').textContent = btn.dataset.settleName;
                    document.getElementById('settleRemaining').textContent = parseFloat(btn.dataset.settleRemaining).toFixed(3);
                    new bootstrap.Modal(document.getElementById('settleModal')).show();
                });
            });
        </script>
    }
}