@model Salon.Controllers.CustodyLedgerViewModel
@{
    ViewData["Title"] = "كشف حساب العهدة";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-list me-2"></i>كشف حساب عهدة: @(Model.Employee?.FullName ?? "-")</h1>
        <p>كل إيداع وكل صرف بتاريخه ووقته، مع الرصيد بعد كل حركة</p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع لكل العهد</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #6f42c1 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1">إجمالي الإيداعات المفتوحة</div>
                <div class="fw-bold fs-5" style="color:#6f42c1;">@Model.TotalDeposited.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #198754 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1">المصروف</div>
                <div class="fw-bold fs-5 text-success">@Model.TotalSpent.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #d97706 !important;">
            <div class="card-body">
                <div class="text-muted small mb-1">محجوز لطلبات قيد المعالجة</div>
                <div class="fw-bold fs-5" style="color:#d97706;">@Model.TotalReserved.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-right:4px solid #16a34a !important;">
            <div class="card-body">
                <div class="text-muted small mb-1">المتاح لطلب شراء جديد</div>
                <div class="fw-bold fs-5" style="color:#16a34a;">@Model.AvailableForRequest.ToString("N3") <small class="text-muted">د.ك</small></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white">
        <strong><i class="fas fa-coins me-2"></i>الرصيد الحالي (@Model.RemainingAmount.ToString("N3") د.ك) ناتج من @(Model.OpenDeposits.Count(d => d.RemainingAmount > 0.0005m)) إيداع@(Model.OpenDeposits.Count(d => d.RemainingAmount > 0.0005m) == 1 ? "" : "ات")</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>تاريخ الإيداع</th>
                        <th>المبلغ الأصلي</th>
                        <th>المتبقي منه</th>
                        <th>البيان</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.OpenDeposits.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">لا توجد إيداعات مفتوحة حالياً</td></tr>
                    }
                    @foreach (var d in Model.OpenDeposits)
                    {
                        <tr>
                            <td>@d.CustodyDate.ToString("yyyy/MM/dd")</td>
                            <td>@d.Amount.ToString("N3") د.ك</td>
                            <td class="@(d.RemainingAmount > 0 ? "text-warning fw-bold" : "text-muted")">@d.RemainingAmount.ToString("N3") د.ك</td>
                            <td class="text-muted">@(d.Reason ?? "-") @(d.IsOpeningBalance ? " (رصيد مرحّل)" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <strong><i class="fas fa-receipt me-2"></i>سجل الحركات بالتفصيل</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>التاريخ والوقت</th>
                        <th>النوع</th>
                        <th>البيان</th>
                        <th>إيداع</th>
                        <th>صرف</th>
                        <th>الرصيد بعد الحركة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Entries.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">لا توجد حركات مسجلة</td></tr>
                    }
                    @foreach (var e in Model.Entries)
                    {
                        <tr>
                            <td>@e.Date.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>@e.Type</td>
                            <td class="text-muted">@e.Description</td>
                            <td class="text-success">@(e.InAmount > 0 ? e.InAmount.ToString("N3") : "-")</td>
                            <td class="text-danger">@(e.OutAmount > 0 ? e.OutAmount.ToString("N3") : "-")</td>
                            <td class="fw-bold">@e.Balance.ToString("N3") د.ك</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
