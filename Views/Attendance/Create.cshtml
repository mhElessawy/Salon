@model Salon.Models.Attendance
@{
    ViewData["Title"] = "تسجيل حضور";
}

<div class="page-header">
    <h1><i class="fas fa-calendar-plus me-2"></i>تسجيل حضور موظف</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">الموظف</label>
                    @if (ViewBag.IsEmployee == true)
                    {
                        <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />
                        <input type="text" class="form-control" value="@ViewBag.EmployeeName" readonly />
                    }
                    else
                    {
                        <select name="EmployeeId" asp-items="@ViewBag.Employees" class="form-select">
                            <option value="">-- اختر الموظف --</option>
                        </select>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">التاريخ</label>
                    <input type="date" name="AttendanceDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">وقت الحضور</label>
                    @if (ViewBag.IsEmployee == true)
                    {
                        <div class="form-control bg-light d-flex align-items-center gap-2">
                            <i class="fas fa-clock text-success"></i>
                            <span id="currentTimeDisplay" class="fw-bold"></span>
                            <small class="text-muted">(يُسجَّل تلقائياً)</small>
                        </div>
                    }
                    else
                    {
                        <input type="time" name="CheckIn" id="checkInInput" class="form-control" />
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">وقت الانصراف <small class="text-muted">(اختياري)</small></label>
                    @if (ViewBag.IsEmployee == true)
                    {
                        <div class="form-control bg-light text-muted">يُسجَّل عند الانصراف</div>
                    }
                    else
                    {
                        <input type="time" name="CheckOut" class="form-control" />
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label">الحالة</label>
                    <select name="Status" class="form-select">
                        <option>حاضر</option>
                        <option>غائب</option>
                        <option>إجازة</option>
                        <option>تأخر</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">ملاحظات</label>
                    <textarea name="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const now = new Date();
        const hh = String(now.getHours()).padStart(2, '0');
        const mm = String(now.getMinutes()).padStart(2, '0');
        const timeStr = hh + ':' + mm;

        @if (ViewBag.IsEmployee == true)
        {
            // Show live clock for employee (read-only)
            <text>
            function updateClock() {
                const d = new Date();
                const h = String(d.getHours()).padStart(2, '0');
                const m = String(d.getMinutes()).padStart(2, '0');
                const el = document.getElementById('currentTimeDisplay');
                if (el) el.textContent = h + ':' + m;
            }
            updateClock();
            setInterval(updateClock, 1000);
            </text>
        }
        else
        {
            <text>
            const inp = document.getElementById('checkInInput');
            if (inp) inp.value = timeStr;
            </text>
        }
    </script>
}
