@model IEnumerable<Salon.Models.AttendanceIndexRow>
@{
    ViewData["Title"] = "الحضور والانصراف";
    bool isToday = (bool)(ViewBag.IsToday ?? false);

    string FmtDuration(TimeSpan t)
    {
        if (t <= TimeSpan.Zero) return "-";
        var h = (int)t.TotalHours;
        var m = t.Minutes;
        if (h > 0 && m > 0) return $"{h}س {m}د";
        if (h > 0) return $"{h}س";
        return $"{m}د";
    }
}

<style>
    .attendance-table { font-size: 0.80rem; table-layout: fixed; width: 100%; }
    .attendance-table th { font-size: 0.75rem; padding: 5px 5px; white-space: nowrap; text-align: center; }
    .attendance-table td { padding: 4px 5px; vertical-align: middle; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .attendance-table td.emp-name { text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .attendance-table .btn-sm { font-size: 0.70rem; padding: 2px 6px; }
    .attendance-table .badge { font-size: 0.70rem; }
    .no-attend-row { background-color: #fff8f0; }
    .checkin-btn { min-width: 75px; }
</style>

<div class="d-flex justify-content-between align-items-center mb-2 mt-1">
    <h5 class="mb-0 fw-bold"><i class="fas fa-calendar-alt me-2 text-primary"></i>الحضور والانصراف</h5>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input type="date" name="date" value="@ViewBag.FilterDate" class="form-control form-control-sm" style="max-width:145px;" />
        <button type="submit" class="btn btn-primary btn-sm px-2"><i class="fas fa-search"></i></button>
        @if (!isToday)
        {
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">اليوم</a>
        }
    </form>
</div>

<div class="card">
    <div class="card-body p-1">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle attendance-table mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:34px">الدور</th>
                        <th style="width:110px; text-align:right">الموظف</th>
                        <th style="width:58px">القسم</th>
                        <th style="width:68px">حضور</th>
                        <th style="width:80px">انصراف</th>
                        <th style="width:88px">استئذان</th>
                        <th style="width:68px">عودة</th>
                        <th style="width:48px">مدة</th>
                        <th style="width:52px">فعلي</th>
                        <th style="width:56px">الحالة</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-4">لا يوجد موظفون</td></tr>
                    }
                    @foreach (var row in Model)
                    {
                        var emp = row.Employee;
                        var a = row.Record;
                        var dept = emp.DepartmentNav?.Name;
                        var deptColor = dept == "مساج" ? "bg-info" : "bg-warning text-dark";

                        if (!row.HasAttendance)
                        {
                            <tr class="no-attend-row">
                                <td><span class="text-muted">-</span></td>
                                <td class="emp-name"><strong>@emp.FullName</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(dept))
                                    {
                                        <span class="badge @deptColor">@dept</span>
                                    }
                                </td>
                                <td colspan="7">
                                    @if (isToday && !(bool)(ViewBag.IsEmployee ?? false))
                                    {
                                        <form method="post" action="@Url.Action("QuickCheckIn")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="employeeId" value="@emp.Id" />
                                            <input type="hidden" name="date" value="@ViewBag.FilterDate" />
                                            <button type="submit" class="btn btn-sm btn-success checkin-btn">
                                                <i class="fas fa-sign-in-alt me-1"></i> تسجيل حضور
                                            </button>
                                        </form>
                                    }
                                    else if (isToday && (bool)(ViewBag.IsEmployee ?? false))
                                    {
                                        <form method="post" action="@Url.Action("QuickCheckIn")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="employeeId" value="@emp.Id" />
                                            <input type="hidden" name="date" value="@ViewBag.FilterDate" />
                                            <button type="submit" class="btn btn-sm btn-success checkin-btn">
                                                <i class="fas fa-sign-in-alt me-1"></i> تسجيل حضوري
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">غائب</span>
                                    }
                                </td>
                                <td></td>
                            </tr>
                        }
                        else
                        {
                            var allPerms = a!.Permissions.OrderBy(p => p.LeaveTime).ToList();
                            var openPerm = allPerms.FirstOrDefault(p => p.ReturnTime == null);
                            var closedPerms = allPerms.Where(p => p.ReturnTime != null).ToList();

                            var totalPermTime = closedPerms.Aggregate(TimeSpan.Zero,
                                (acc, p) => acc + (p.ReturnTime!.Value - p.LeaveTime));

                            TimeSpan? actualWork = null;
                            if (a.CheckIn.HasValue && a.CheckOut.HasValue)
                            {
                                var raw = a.CheckOut.Value - a.CheckIn.Value - totalPermTime;
                                actualWork = raw < TimeSpan.Zero ? TimeSpan.Zero : raw;
                            }
                            <tr>
                                <td>
                                    @if (!a!.CheckOut.HasValue && a.QueuePosition.HasValue)
                                    {
                                        <span class="badge bg-primary px-2">@a.QueuePosition.Value</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="emp-name"><strong>@emp.FullName</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(dept))
                                    {
                                        <span class="badge @deptColor">@dept</span>
                                    }
                                </td>
                                <!-- وقت الحضور -->
                                <td>
                                    @if (a.CheckIn.HasValue)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-sign-in-alt me-1"></i>@a.CheckIn.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                                <!-- وقت الانصراف -->
                                <td>
                                    @if (a.CheckOut.HasValue)
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-sign-out-alt me-1"></i>@a.CheckOut.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else if (a.CheckIn.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning"
                                                onclick="confirmCheckOut(@a.Id, '@Html.Raw((emp.FullName).Replace("'", "\\'"))')">
                                            <i class="fas fa-sign-out-alt me-1"></i> انصراف
                                        </button>
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                                <!-- الاستئذان -->
                                <td>
                                    @foreach (var p in allPerms)
                                    {
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <span class="badge text-white" style="background-color:#fd7e14">
                                                <i class="fas fa-door-open me-1"></i>@p.LeaveTime.ToString(@"hh\:mm")
                                            </span>
                                            <form method="post" action="@Url.Action("DeletePermission", new { id = p.Id })" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger py-0 px-1" style="font-size:10px" title="حذف">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    @if (openPerm == null && a.CheckIn.HasValue && !a.CheckOut.HasValue)
                                    {
                                        <form method="post" action="@Url.Action("RequestPermission", new { id = a.Id })" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                                <i class="fas fa-door-open me-1"></i> استئذان
                                            </button>
                                        </form>
                                    }
                                    @if (!allPerms.Any() && !(a.CheckIn.HasValue && !a.CheckOut.HasValue))
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <!-- عودة من الاستئذان -->
                                <td>
                                    @foreach (var cp in closedPerms)
                                    {
                                        <div class="mb-1">
                                            <span class="badge bg-success">
                                                <i class="fas fa-undo me-1"></i>@cp.ReturnTime!.Value.ToString(@"hh\:mm")
                                            </span>
                                        </div>
                                    }
                                    @if (openPerm != null)
                                    {
                                        <form method="post" action="@Url.Action("ReturnFromPermission", new { id = a.Id })" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fas fa-undo me-1"></i> عودة
                                            </button>
                                        </form>
                                    }
                                    @if (!allPerms.Any())
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <!-- مدة الاستئذان -->
                                <td>
                                    @if (totalPermTime > TimeSpan.Zero)
                                    {
                                        <span class="badge text-white" style="background-color:#fd7e14">@FmtDuration(totalPermTime)</span>
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                                <!-- وقت العمل الفعلي -->
                                <td>
                                    @if (actualWork.HasValue)
                                    {
                                        <span class="badge bg-primary">@FmtDuration(actualWork.Value)</span>
                                    }
                                    else { <span class="text-muted">-</span> }
                                </td>
                                <!-- الحالة -->
                                <td>
                                    <span class="badge @(a.Status == "حاضر" ? "bg-success" : a.Status == "غائب" ? "bg-danger" : "bg-warning text-dark")">
                                        @a.Status
                                    </span>
                                </td>
                                <!-- حذف -->
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                            onclick="confirmDelete(@a.Id, '@Html.Raw((emp.FullName).Replace("'", "\\'"))')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CheckOut Modal -->
<div class="modal fade" id="checkOutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title fw-bold"><i class="fas fa-sign-out-alt me-2"></i>تسجيل الانصراف</h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <p class="mb-2 small">انصراف: <strong id="checkOutEmployeeName"></strong></p>
                <form id="checkOutForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="checkOutTimeHidden" name="checkOutTime" />
                    <div class="mb-2">
                        <label class="form-label fw-bold small">وقت الانصراف</label>
                        @if (User.IsInRole("Employee"))
                        {
                            <div class="form-control form-control-sm bg-light d-flex align-items-center gap-2">
                                <i class="fas fa-clock text-warning"></i>
                                <span id="checkOutTimeDisplay" class="fw-bold"></span>
                                <small class="text-muted">(تلقائي)</small>
                            </div>
                        }
                        else
                        {
                            <input type="time" id="checkOutTimeEditable" class="form-control form-control-sm" required />
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning btn-sm fw-bold px-3"><i class="fas fa-save me-1"></i> تأكيد</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">إلغاء</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-4">
                <div class="delete-icon-wrap mb-3"><i class="fas fa-times"></i></div>
                <h5 class="fw-bold mb-1 text-white">تأكيد الحذف</h5>
                <p class="fw-bold mb-3 text-white" id="deleteItemName"></p>
                <div class="d-flex justify-content-center gap-2">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-3 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-3 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        @if (User.IsInRole("Employee"))
        {
            <text>
            let checkOutClockInterval = null;
            function updateCheckOutClock() {
                const d = new Date();
                const h = String(d.getHours()).padStart(2, '0');
                const m = String(d.getMinutes()).padStart(2, '0');
                const val = h + ':' + m;
                const disp = document.getElementById('checkOutTimeDisplay');
                if (disp) disp.textContent = val;
                document.getElementById('checkOutTimeHidden').value = val;
            }
            function confirmCheckOut(id, name) {
                document.getElementById('checkOutEmployeeName').textContent = name;
                document.getElementById('checkOutForm').action = '@Url.Action("CheckOut")/' + id;
                updateCheckOutClock();
                if (checkOutClockInterval) clearInterval(checkOutClockInterval);
                checkOutClockInterval = setInterval(updateCheckOutClock, 1000);
                new bootstrap.Modal(document.getElementById('checkOutModal')).show();
            }
            document.getElementById('checkOutModal').addEventListener('hidden.bs.modal', function () {
                if (checkOutClockInterval) { clearInterval(checkOutClockInterval); checkOutClockInterval = null; }
            });
            </text>
        }
        else
        {
            <text>
            function confirmCheckOut(id, name) {
                document.getElementById('checkOutEmployeeName').textContent = name;
                document.getElementById('checkOutForm').action = '@Url.Action("CheckOut")/' + id;
                const now = new Date();
                const hh = String(now.getHours()).padStart(2, '0');
                const mm = String(now.getMinutes()).padStart(2, '0');
                const val = hh + ':' + mm;
                document.getElementById('checkOutTimeEditable').value = val;
                document.getElementById('checkOutTimeHidden').value = val;
                document.getElementById('checkOutTimeEditable').oninput = function () {
                    document.getElementById('checkOutTimeHidden').value = this.value;
                };
                new bootstrap.Modal(document.getElementById('checkOutModal')).show();
            }
            </text>
        }
    </script>
}
