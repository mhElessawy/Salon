@model IEnumerable<Salon.Models.AttendanceIndexRow>
@{
    ViewData["Title"] = "الحضور والانصراف";
    bool isToday = (bool)(ViewBag.IsToday ?? false);
    bool isEmployee = (bool)(ViewBag.IsEmployee ?? false);

    string FmtDuration(TimeSpan t)
    {
        if (t <= TimeSpan.Zero) return "--";
        var h = (int)t.TotalHours;
        var m = t.Minutes;
        if (h > 0 && m > 0) return $"{h}س {m}د";
        if (h > 0) return $"{h}س";
        return $"{m}د";
    }

    string GetEmpCode(Salon.Models.Employee e)
    {
        var dept = e.DepartmentNav?.Name ?? "";
        var prefix = dept == "مساج" ? "MAS" : dept == "حلاقة" ? "BAR" : "EMP";
        return $"{prefix}-{e.Id:D3}";
    }

    string[] avatarColors = { "#4e73df", "#1cc88a", "#36b9cc", "#e74a3b", "#fd7e14", "#6f42c1", "#20c9a6", "#f6c23e" };
    string AvatarColor(int id) => avatarColors[id % avatarColors.Length];
    string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name.Trim()[0].ToString().ToUpper();

    var rows = Model.ToList();
    int total        = rows.Count;
    int presentAvail = rows.Count(r => r.HasAttendance && r.Record!.CheckIn.HasValue && !r.Record!.CheckOut.HasValue && !r.Record!.Permissions.Any(p => p.ReturnTime == null));
    int onPermission = rows.Count(r => r.HasAttendance && r.Record!.CheckIn.HasValue && !r.Record!.CheckOut.HasValue &&  r.Record!.Permissions.Any(p => p.ReturnTime == null));
    int checkedOut   = rows.Count(r => r.HasAttendance && r.Record!.CheckOut.HasValue);
    int notReg       = rows.Count(r => !r.HasAttendance);
}

<style>
    /* ======= Header ======= */
    .att-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; }
    .att-header h4 { font-size:1.35rem; font-weight:700; margin:0; }
    .att-header .subtitle { color:#6c757d; font-size:.83rem; }
    .clock-box { text-align:center; min-width:80px; }
    .clock-box .lbl { font-size:.72rem; color:#6c757d; }
    .clock-box .val { font-size:1.25rem; font-weight:700; color:#1a1a2e; }

    /* ======= Stat Cards ======= */
    .stat-cards { display:flex; gap:.6rem; margin-bottom:1rem; flex-wrap:wrap; }
    .stat-card  { flex:1; min-width:130px; border-radius:12px; padding:.65rem .9rem; display:flex; align-items:center; justify-content:space-between; }
    .stat-card .info .num  { font-size:1.6rem; font-weight:800; line-height:1; }
    .stat-card .info .lbl  { font-size:.72rem; margin-top:2px; opacity:.85; }
    .stat-card .ico        { width:42px; height:42px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.1rem; opacity:.85; }
    .sc-green  { background:#e8f8f0; color:#198754; } .sc-green  .ico { background:#d1f2e2; }
    .sc-orange { background:#fff3e6; color:#fd7e14; } .sc-orange .ico { background:#ffe5c8; }
    .sc-blue   { background:#e8f0ff; color:#0d6efd; } .sc-blue   .ico { background:#cfe2ff; }
    .sc-red    { background:#fdecea; color:#dc3545; } .sc-red    .ico { background:#f8d7da; }
    .sc-yellow { background:#fffbe6; color:#d4a017; } .sc-yellow .ico { background:#fff0c2; }

    /* ======= Search ======= */
    .search-wrap { position:relative; margin-bottom:.85rem; }
    .search-wrap input { padding-right:2.4rem; border-radius:8px; font-size:.88rem; }
    .search-wrap .ico  { position:absolute; right:.8rem; top:50%; transform:translateY(-50%); color:#aaa; }

    /* ======= Table ======= */
    .att-table { font-size:.80rem; width:100%; table-layout:fixed; }
    .att-table thead th { font-size:.73rem; font-weight:600; color:#6c757d; padding:6px 8px; white-space:nowrap; text-align:center; background:#f8f9fc; border-bottom:2px solid #e3e6f0; }
    .att-table tbody td { padding:7px 8px; vertical-align:middle; text-align:center; border-bottom:1px solid #f0f0f0; }
    .att-table tbody tr:hover { background:#f8f9fc; }
    .att-table .emp-cell  { text-align:right; display:flex; align-items:center; gap:9px; overflow:hidden; }
    .att-table td.emp-td  { text-align:right; overflow:hidden; }
    .avatar { width:36px; height:36px; border-radius:50%; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-weight:700; font-size:.92rem; flex-shrink:0; }
    .emp-info .name  { font-weight:600; font-size:.82rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:130px; }
    .emp-info .title { font-size:.70rem; color:#aaa; }
    .emp-code        { font-size:.70rem; color:#6c757d; }
    .no-reg-row td   { background:#fffbf5; }

    /* time cell */
    .t-cell { display:inline-flex; align-items:center; gap:4px; color:#444; }
    .t-cell i { color:#bbb; font-size:.72rem; }

    /* action btn group */
    .act-group { display:flex; gap:4px; align-items:center; flex-wrap:nowrap; justify-content:flex-end; }
    .btn-checkin   { background:#198754; color:#fff; border:none; border-radius:7px; font-size:.76rem; padding:4px 10px; cursor:pointer; white-space:nowrap; }
    .btn-checkin:hover { background:#157347; color:#fff; }
    .btn-perm      { background:#fd7e14; color:#fff; border:none; border-radius:7px; font-size:.76rem; padding:4px 10px; cursor:pointer; white-space:nowrap; }
    .btn-perm:hover { background:#e8720c; color:#fff; }
    .btn-checkout  { background:#fff; color:#0d6efd; border:1.5px solid #0d6efd; border-radius:7px; font-size:.76rem; padding:3px 10px; cursor:pointer; white-space:nowrap; }
    .btn-checkout:hover { background:#0d6efd; color:#fff; }
    .btn-return    { background:#198754; color:#fff; border:none; border-radius:7px; font-size:.76rem; padding:4px 10px; cursor:pointer; }
    .btn-del       { background:transparent; border:none; color:#dc3545; font-size:.80rem; padding:3px 5px; cursor:pointer; }

    /* perm badge inside time cell */
    .perm-time  { font-size:.72rem; color:#fd7e14; display:inline-flex; align-items:center; gap:3px; }
    .ret-time   { font-size:.72rem; color:#198754; display:inline-flex; align-items:center; gap:3px; }
</style>

<!-- ===== HEADER ===== -->
<div class="att-header">
    <div>
        <h4>الحضور والانصراف</h4>
        <span class="subtitle">إدارة حضور وانصراف الموظفين</span>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="clock-box">
            <div class="lbl">الوقت الحالي</div>
            <div class="val" id="liveClock">--:--</div>
        </div>
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="date" name="date" value="@ViewBag.FilterDate"
                   class="form-control form-control-sm" style="max-width:148px;" />
            @if (!isToday)
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">اليوم</a>
            }
        </form>
    </div>
</div>

<!-- ===== STAT CARDS ===== -->
<div class="stat-cards">
    <div class="stat-card sc-green">
        <div class="info"><div class="num">@presentAvail</div><div class="lbl">حاضر - متاح</div></div>
        <div class="ico"><i class="fas fa-user-check"></i></div>
    </div>
    <div class="stat-card sc-orange">
        <div class="info"><div class="num">@onPermission</div><div class="lbl">استئذان</div></div>
        <div class="ico"><i class="fas fa-coffee"></i></div>
    </div>
    <div class="stat-card sc-blue">
        <div class="info"><div class="num">@checkedOut</div><div class="lbl">انصرف</div></div>
        <div class="ico"><i class="fas fa-sign-out-alt"></i></div>
    </div>
    <div class="stat-card sc-red">
        <div class="info"><div class="num">@notReg</div><div class="lbl">لم يسجل</div></div>
        <div class="ico"><i class="fas fa-user-times"></i></div>
    </div>
    <div class="stat-card sc-yellow">
        <div class="info"><div class="num">@total</div><div class="lbl">الإجمالي</div></div>
        <div class="ico"><i class="fas fa-users"></i></div>
    </div>
</div>

<!-- ===== SEARCH ===== -->
<div class="search-wrap">
    <i class="fas fa-search ico"></i>
    <input type="text" id="empSearch" class="form-control" placeholder="البحث عن موظف..." />
</div>

<!-- ===== TABLE ===== -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table att-table mb-0">
                <thead>
                    <tr>
                        <th style="width:160px; text-align:right">الإجراءات</th>
                        <th style="width:170px; text-align:right">الموظف</th>
                        <th style="width:65px">كود</th>
                        <th style="width:62px">القسم</th>
                        <th style="width:68px">الحالة</th>
                        <th style="width:72px">وقت الحضور</th>
                        <th style="width:72px">وقت الاستئذان</th>
                        <th style="width:72px">وقت العودة</th>
                        <th style="width:56px">مدة الاستئذان</th>
                        <th style="width:72px">وقت الانصراف</th>
                        <th style="width:60px">ساعات العمل</th>
                    </tr>
                </thead>
                <tbody id="attBody">
                    @if (!rows.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-5">لا يوجد موظفون</td></tr>
                    }
                    @foreach (var row in rows)
                    {
                        var emp  = row.Employee;
                        var a    = row.Record;
                        var dept = emp.DepartmentNav?.Name ?? "";
                        var deptBadge = dept == "مساج" ? "badge bg-info text-white" : dept == "حلاقة" ? "badge bg-warning text-dark" : "badge bg-secondary";
                        var avatarBg  = AvatarColor(emp.Id);
                        var initial   = Initial(emp.FullName);
                        var empCode   = GetEmpCode(emp);

                        if (!row.HasAttendance)
                        {
                            <tr class="no-reg-row" data-name="@emp.FullName.ToLower()">
                                <!-- إجراءات -->
                                <td style="text-align:right">
                                    @if (isToday)
                                    {
                                        <form method="post" action="@Url.Action("QuickCheckIn")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="employeeId" value="@emp.Id" />
                                            <input type="hidden" name="date" value="@ViewBag.FilterDate" />
                                            <button type="submit" class="btn-checkin">
                                                <i class="fas fa-user-check me-1"></i>@(isEmployee ? "تسجيل حضوري" : "حضور")
                                            </button>
                                        </form>
                                    }
                                </td>
                                <!-- الموظف -->
                                <td class="emp-td">
                                    <div class="emp-cell">
                                        <div class="avatar" style="background:@avatarBg">@initial</div>
                                        <div class="emp-info">
                                            <div class="name">@emp.FullName</div>
                                            <div class="title">@(emp.JobTitle ?? dept)</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="emp-code">@empCode</span></td>
                                <td><span class="@deptBadge">@dept</span></td>
                                <td><span class="badge bg-secondary" style="font-size:.70rem">لم يسجل</span></td>
                                <td><span class="text-muted">----</span></td>
                                <td><span class="text-muted">----</span></td>
                                <td><span class="text-muted">----</span></td>
                                <td><span class="text-muted">--</span></td>
                                <td><span class="text-muted">----</span></td>
                                <td><span class="text-muted">--</span></td>
                            </tr>
                        }
                        else
                        {
                            var allPerms     = a!.Permissions.OrderBy(p => p.LeaveTime).ToList();
                            var openPerm     = allPerms.FirstOrDefault(p => p.ReturnTime == null);
                            var closedPerms  = allPerms.Where(p => p.ReturnTime != null).ToList();
                            var totalPermTime = closedPerms.Aggregate(TimeSpan.Zero, (acc, p) => acc + (p.ReturnTime!.Value - p.LeaveTime));

                            TimeSpan? actualWork = null;
                            if (a.CheckIn.HasValue && a.CheckOut.HasValue)
                            {
                                var raw = a.CheckOut.Value - a.CheckIn.Value - totalPermTime;
                                actualWork = raw < TimeSpan.Zero ? TimeSpan.Zero : raw;
                            }

                            string statusLabel, statusCss;
                            if (a.CheckOut.HasValue)                                              { statusLabel = "انصرف";       statusCss = "badge bg-secondary"; }
                            else if (openPerm != null)                                            { statusLabel = "استئذان";     statusCss = "badge text-white"; }
                            else if (a.CheckIn.HasValue)                                          { statusLabel = "حاضر - متاح"; statusCss = "badge bg-success"; }
                            else                                                                  { statusLabel = a.Status;      statusCss = "badge bg-warning text-dark"; }
                            string permCss = "background:#fd7e14";

                            <tr data-name="@emp.FullName.ToLower()">
                                <!-- إجراءات -->
                                <td style="text-align:right">
                                    <div class="act-group">
                                        @if (!a.CheckOut.HasValue && a.CheckIn.HasValue)
                                        {
                                            @if (openPerm == null)
                                            {
                                                <form method="post" action="@Url.Action("RequestPermission", new { id = a.Id })" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-perm">
                                                        <i class="fas fa-coffee me-1"></i>استئذان
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" action="@Url.Action("ReturnFromPermission", new { id = a.Id })" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-return">
                                                        <i class="fas fa-undo me-1"></i>عودة
                                                    </button>
                                                </form>
                                            }
                                            <button type="button" class="btn-checkout"
                                                    onclick="confirmCheckOut(@a.Id, '@Html.Raw(emp.FullName.Replace("'","\\\'"))')">
                                                <i class="fas fa-sign-out-alt me-1"></i>انصراف
                                            </button>
                                        }
                                        @if (!isEmployee)
                                        {
                                            <button type="button" class="btn-del" title="حذف"
                                                    onclick="confirmDelete(@a.Id, '@Html.Raw(emp.FullName.Replace("'","\\\'"))')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                                <!-- الموظف -->
                                <td class="emp-td">
                                    <div class="emp-cell">
                                        <div class="avatar" style="background:@avatarBg">@initial</div>
                                        <div class="emp-info">
                                            <div class="name">@emp.FullName</div>
                                            <div class="title">@(emp.JobTitle ?? dept)</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="emp-code">@empCode</span></td>
                                <td><span class="@deptBadge">@dept</span></td>
                                <td>
                                    <span class="@statusCss" style="@(openPerm!=null?"background:#fd7e14":"")" >@statusLabel</span>
                                </td>
                                <!-- وقت الحضور -->
                                <td>
                                    @if (a.CheckIn.HasValue)
                                    {
                                        <span class="t-cell"><i class="fas fa-clock"></i>@a.CheckIn.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else { <span class="text-muted">----</span> }
                                </td>
                                <!-- وقت الاستئذان -->
                                <td>
                                    @if (allPerms.Any())
                                    {
                                        foreach (var p in allPerms)
                                        {
                                            <div class="perm-time"><i class="fas fa-door-open"></i>@p.LeaveTime.ToString(@"hh\:mm")
                                                @if (!isEmployee)
                                                {
                                                    <form method="post" action="@Url.Action("DeletePermission", new { id = p.Id })" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn-del" style="font-size:.65rem;padding:0 2px" title="حذف">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    }
                                    else { <span class="text-muted">----</span> }
                                </td>
                                <!-- وقت العودة -->
                                <td>
                                    @if (closedPerms.Any())
                                    {
                                        foreach (var cp in closedPerms)
                                        {
                                            <div class="ret-time"><i class="fas fa-undo"></i>@cp.ReturnTime!.Value.ToString(@"hh\:mm")</div>
                                        }
                                    }
                                    else { <span class="text-muted">----</span> }
                                </td>
                                <!-- مدة الاستئذان -->
                                <td>
                                    @if (totalPermTime > TimeSpan.Zero)
                                    {
                                        <span style="color:#fd7e14;font-size:.75rem"><i class="fas fa-hourglass-half me-1"></i>@FmtDuration(totalPermTime)</span>
                                    }
                                    else { <span class="text-muted">--</span> }
                                </td>
                                <!-- وقت الانصراف -->
                                <td>
                                    @if (a.CheckOut.HasValue)
                                    {
                                        <span class="t-cell" style="color:#dc3545"><i class="fas fa-clock"></i>@a.CheckOut.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else { <span class="text-muted">----</span> }
                                </td>
                                <!-- ساعات العمل -->
                                <td>
                                    @if (actualWork.HasValue)
                                    {
                                        <span style="color:#0d6efd;font-size:.75rem;font-weight:600">@FmtDuration(actualWork.Value)</span>
                                    }
                                    else { <span class="text-muted">--</span> }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===== CheckOut Modal ===== -->
<div class="modal fade" id="checkOutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:360px">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2" style="background:#fd7e14">
                <h6 class="modal-title fw-bold text-white"><i class="fas fa-sign-out-alt me-2"></i>تسجيل الانصراف</h6>
                <button type="button" class="btn-close btn-close-white btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <p class="mb-2 small">انصراف: <strong id="checkOutEmployeeName"></strong></p>
                <form id="checkOutForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="checkOutTimeHidden" name="checkOutTime" />
                    <div class="mb-3">
                        <label class="form-label fw-bold small">وقت الانصراف</label>
                        @if (User.IsInRole("Employee"))
                        {
                            <div class="form-control form-control-sm bg-light d-flex align-items-center gap-2">
                                <i class="fas fa-clock text-warning"></i>
                                <span id="checkOutTimeDisplay" class="fw-bold"></span>
                                <small class="text-muted">(تلقائي)</small>
                            </div>
                        }
                        else
                        {
                            <input type="time" id="checkOutTimeEditable" class="form-control form-control-sm" required />
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm fw-bold px-4" style="background:#fd7e14;color:#fff">
                            <i class="fas fa-save me-1"></i>تأكيد
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm px-4" data-bs-dismiss="modal">إلغاء</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== Delete Modal ===== -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow delete-modal-red">
            <div class="modal-body text-center p-4">
                <div class="delete-icon-wrap mb-3"><i class="fas fa-times"></i></div>
                <h5 class="fw-bold mb-1 text-white">تأكيد الحذف</h5>
                <p class="fw-bold mb-3 text-white" id="deleteItemName"></p>
                <div class="d-flex justify-content-center gap-2">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-3 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-3 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ساعة حية
    function updateClock() {
        const d = new Date();
        const h = String(d.getHours()).padStart(2,'0');
        const m = String(d.getMinutes()).padStart(2,'0');
        const el = document.getElementById('liveClock');
        if (el) el.textContent = h + ':' + m;
    }
    updateClock();
    setInterval(updateClock, 30000);

    // بحث
    document.getElementById('empSearch').addEventListener('input', function() {
        const q = this.value.trim().toLowerCase();
        document.querySelectorAll('#attBody tr').forEach(tr => {
            const name = tr.dataset.name || '';
            tr.style.display = (!q || name.includes(q)) ? '' : 'none';
        });
    });

    // حذف
    function confirmDelete(id, name) {
        document.getElementById('deleteItemName').textContent = name;
        document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    @if (User.IsInRole("Employee"))
    {
        <text>
        let coInterval = null;
        function updateCoTime() {
            const d = new Date();
            const val = String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
            const disp = document.getElementById('checkOutTimeDisplay');
            if (disp) disp.textContent = val;
            document.getElementById('checkOutTimeHidden').value = val;
        }
        function confirmCheckOut(id, name) {
            document.getElementById('checkOutEmployeeName').textContent = name;
            document.getElementById('checkOutForm').action = '@Url.Action("CheckOut")/' + id;
            updateCoTime();
            if (coInterval) clearInterval(coInterval);
            coInterval = setInterval(updateCoTime, 1000);
            new bootstrap.Modal(document.getElementById('checkOutModal')).show();
        }
        document.getElementById('checkOutModal').addEventListener('hidden.bs.modal', () => {
            if (coInterval) { clearInterval(coInterval); coInterval = null; }
        });
        </text>
    }
    else
    {
        <text>
        function confirmCheckOut(id, name) {
            document.getElementById('checkOutEmployeeName').textContent = name;
            document.getElementById('checkOutForm').action = '@Url.Action("CheckOut")/' + id;
            const now = new Date();
            const val = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
            document.getElementById('checkOutTimeEditable').value = val;
            document.getElementById('checkOutTimeHidden').value = val;
            document.getElementById('checkOutTimeEditable').oninput = function() {
                document.getElementById('checkOutTimeHidden').value = this.value;
            };
            new bootstrap.Modal(document.getElementById('checkOutModal')).show();
        }
        </text>
    }
</script>
}
