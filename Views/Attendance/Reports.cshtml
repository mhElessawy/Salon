@model IEnumerable<Salon.Models.Attendance>
@{
    ViewData["Title"] = "تقارير الحضور";
}

<div class="page-header">
    <h1><i class="fas fa-file-alt me-2"></i>تقارير الحضور</h1>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0">الشهر:</label>
            <input type="month" name="month" value="@ViewBag.FilterMonth" class="form-control" style="max-width:200px;" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>التاريخ</th>
                        <th>الحضور</th>
                        <th>الانصراف</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@(a.Employee?.FullName ?? "-")</td>
                            <td>@a.AttendanceDate.ToString("yyyy/MM/dd")</td>
                            <td>@(a.CheckIn?.ToString(@"hh\:mm") ?? "-")</td>
                            <td>@(a.CheckOut?.ToString(@"hh\:mm") ?? "-")</td>
                            <td>
                                <span class="badge @(a.Status == "حاضر" ? "bg-success" : a.Status == "غائب" ? "bg-danger" : "bg-warning text-dark")">
                                    @a.Status
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">لا توجد سجلات في هذا الشهر</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
