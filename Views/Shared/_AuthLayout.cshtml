<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام معهد موس</title>
    <link id="bootstrap-css" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/salon.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var BOOTSTRAP_RTL = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css';
            var BOOTSTRAP_LTR = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css';

            function applyLanguage(lang) {
                var html = document.documentElement;
                var bootstrapCss = document.getElementById('bootstrap-css');
                var langTextEl = document.getElementById('auth-lang-text');

                document.querySelectorAll('[data-i18n-en]').forEach(function (el) {
                    if (lang === 'en') {
                        if (!el.dataset.i18nAr) el.dataset.i18nAr = el.textContent.trim();
                        el.textContent = el.dataset.i18nEn;
                    } else {
                        if (el.dataset.i18nAr) el.textContent = el.dataset.i18nAr;
                    }
                });

                if (lang === 'en') {
                    html.lang = 'en';
                    html.dir = 'ltr';
                    if (bootstrapCss) bootstrapCss.href = BOOTSTRAP_LTR;
                    if (langTextEl) langTextEl.textContent = 'العربية';
                } else {
                    html.lang = 'ar';
                    html.dir = 'rtl';
                    if (bootstrapCss) bootstrapCss.href = BOOTSTRAP_RTL;
                    if (langTextEl) langTextEl.textContent = 'English';
                }

                localStorage.setItem('lang', lang);
            }

            document.addEventListener('DOMContentLoaded', function () {
                var saved = localStorage.getItem('lang') || 'ar';
                if (saved === 'en') applyLanguage('en');

                var btn = document.getElementById('auth-lang-btn');
                if (btn) {
                    btn.addEventListener('click', function () {
                        var current = localStorage.getItem('lang') || 'ar';
                        applyLanguage(current === 'ar' ? 'en' : 'ar');
                    });
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
