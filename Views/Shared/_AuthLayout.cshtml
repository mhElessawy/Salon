<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام معهد موس</title>
    <script>
        if (localStorage.getItem('lang') === 'en') {
            document.documentElement.setAttribute('dir', 'ltr');
            document.documentElement.setAttribute('lang', 'en');
        }
    </script>
    <link id="bootstrap-css" rel="stylesheet" href="~/lib/bootstrap5/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <script>
        if (localStorage.getItem('lang') === 'en') {
            document.getElementById('bootstrap-css').href = '@Url.Content("~/lib/bootstrap5/css/bootstrap.min.css")';
        }
    </script>
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/salon.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script src="~/lib/bootstrap5/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script>
        var BOOTSTRAP_RTL = '@Url.Content("~/lib/bootstrap5/css/bootstrap.rtl.min.css")';
        var BOOTSTRAP_LTR = '@Url.Content("~/lib/bootstrap5/css/bootstrap.min.css")';

        function applyLanguage(lang) {
            var html = document.documentElement;
            var bootstrapCss = document.getElementById('bootstrap-css');
            var langTextEl = document.getElementById('auth-lang-text');

            document.querySelectorAll('[data-i18n-en]').forEach(function (el) {
                if (lang === 'en') {
                    if (!el.getAttribute('data-i18n-ar')) {
                        el.setAttribute('data-i18n-ar', el.textContent.trim());
                    }
                    el.textContent = el.getAttribute('data-i18n-en');
                } else {
                    var ar = el.getAttribute('data-i18n-ar');
                    if (ar) el.textContent = ar;
                }
            });

            if (lang === 'en') {
                html.setAttribute('lang', 'en');
                html.setAttribute('dir', 'ltr');
                if (bootstrapCss) bootstrapCss.setAttribute('href', BOOTSTRAP_LTR);
                if (langTextEl) langTextEl.textContent = 'العربية';
            } else {
                html.setAttribute('lang', 'ar');
                html.setAttribute('dir', 'rtl');
                if (bootstrapCss) bootstrapCss.setAttribute('href', BOOTSTRAP_RTL);
                if (langTextEl) langTextEl.textContent = 'English';
            }

            localStorage.setItem('lang', lang);
        }

        function toggleAuthLang() {
            var current = localStorage.getItem('lang') || 'ar';
            applyLanguage(current === 'ar' ? 'en' : 'ar');
        }

        // Apply text translations now (dir+css already set in <head> script above)
        if (localStorage.getItem('lang') === 'en') applyLanguage('en');
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>