@inject Microsoft.AspNetCore.Identity.UserManager<Salon.Models.ApplicationUser> LayoutUserManager
@{
    var layoutUser = await LayoutUserManager.GetUserAsync(User);
    var layoutFullName = layoutUser?.FullName ?? User.Identity?.Name?.Split('@').FirstOrDefault() ?? "المستخدم";
    var layoutRoles = layoutUser != null ? await LayoutUserManager.GetRolesAsync(layoutUser) : new List<string>();
    var layoutRole = layoutRoles.FirstOrDefault() ?? "";
    var layoutRoleAr = layoutRole switch
    {
        "Admin" => "مدير النظام",
        "Manager" => "مدير",
        "Cashier" => "كاشير",
        "Employee" => "موظف",
        _ => layoutRole
    };
    var layoutRoleEn = layoutRole switch
    {
        "Admin" => "System Admin",
        "Manager" => "Manager",
        "Cashier" => "Cashier",
        "Employee" => "Employee",
        _ => layoutRole
    };
    var layoutInitial = layoutFullName.FirstOrDefault().ToString().ToUpper();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام معهد موس</title>
    <script>
        // Set direction BEFORE any CSS loads to prevent layout flash
        if (localStorage.getItem('lang') === 'en') {
            document.documentElement.setAttribute('dir', 'ltr');
            document.documentElement.setAttribute('lang', 'en');
            // Force mobile margin to 0 immediately (overrides any cached CSS)
            var s = document.createElement('style');
            s.id = 'lang-mobile-fix';
            s.textContent = '@@media(max-width:991px){.main-content{margin-left:0!important;margin-right:0!important}}';
            document.head.appendChild(s);
        }
    </script>
    <link id="bootstrap-css" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <script>
        // Load the correct Bootstrap (RTL or LTR) before browser renders
        if (localStorage.getItem('lang') === 'en') {
            document.getElementById('bootstrap-css').href = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css';
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/salon.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Overlay for mobile sidebar -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <!-- Close button: outside sidebar to avoid transform stacking context -->
    <button id="sidebarCloseBtn" onclick="closeSidebar()" style="display:none;position:fixed;z-index:9999;top:12px;width:44px;height:44px;background:#dc3545;border:none;color:#fff;font-size:22px;border-radius:50%;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(220,53,69,.5);cursor:pointer;touch-action:manipulation;">
        <i class="fas fa-times"></i>
    </button>
    <div class="app-wrapper">
        @await Html.PartialAsync("_Sidebar")

        <div class="main-content">
            <header class="topbar">
                <div class="topbar-right">
                    <!-- Hamburger button (mobile only) -->
                    <button class="hamburger-btn d-lg-none" onclick="toggleSidebar()" title="القائمة">
                        <i class="fas fa-bars"></i>
                    </button>

                    <!-- Sidebar toggle button (desktop only) -->
                    <button class="sidebar-toggle-btn d-none d-lg-flex" id="sidebarToggleBtn" onclick="toggleSidebarDesktop()" title="إخفاء القائمة">
                        <i class="fas fa-chevron-right" id="sidebarToggleIcon"></i>
                    </button>

                    <!-- Logout button -->
                    <a href="@Url.Action("Logout", "Account")" class="logout-btn" title="تسجيل الخروج">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>

                    @* قائمة المستخدم المنسدلة *@
                    <div class="dropdown">
                        <div class="topbar-user" role="button"
                             data-bs-toggle="dropdown" data-bs-offset="0,4"
                             aria-expanded="false">
                            <div>
                                <div style="font-size:13px; font-weight:600; line-height:1.2">@layoutFullName</div>
                                <div class="user-role" data-i18n-en="@layoutRoleEn">@layoutRoleAr</div>
                            </div>
                            <div class="user-avatar">@layoutInitial</div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-1" style="min-width:200px">
                            <li>
                                <a class="dropdown-item py-2" href="@Url.Action("ChangePassword", "Account")">
                                    <i class="fas fa-key me-2" style="color:#F7941D"></i> <span data-i18n-en="Change Password">تغيير كلمة المرور</span>
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("Index", "Users")">
                                        <i class="fas fa-user-shield me-2 text-danger"></i> <span data-i18n-en="Manage Users">إدارة المستخدمين</span>
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-2 text-danger" href="@Url.Action("Logout", "Account")">
                                    <i class="fas fa-sign-out-alt me-2"></i> <span data-i18n-en="Logout">تسجيل الخروج</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Notification bell -->
                    <div class="notif-btn" id="notif-btn" onclick="toggleNotifPanel()" title="الإشعارات" style="cursor:pointer;">
                        <i class="fas fa-bell"></i>
                        <span class="notif-badge" id="notif-count" style="display:none;">0</span>
                    </div>

                    <!-- Language switch -->
                    <button class="lang-switch-btn" id="lang-btn" onclick="toggleLang()">EN</button>
                </div>

                <div class="topbar-left">
                    <div class="topbar-greeting">
                        <span data-i18n-en="Hello,">مرحباً،</span> <strong>@layoutFullName</strong>
                    </div>

                    <div style="font-size:15px; font-weight:700; color:#1a1a2e;">
                        <i class="fas fa-wifi" style="color:var(--primary); margin-left:6px;"></i>
                        <span data-i18n-en="Mus Institute System">نظام معهد موس</span>
                    </div>

                    <button class="connected-btn">
                        <i class="fas fa-signal me-1"></i> <span data-i18n-en="Connected">متصل</span>
                    </button>
                </div>
            </header>

            <div class="page-content">
                @if (TempData["SuccessTitle"] != null)
                {
                    <div id="successOverlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.55);z-index:9998;display:flex;align-items:center;justify-content:center;animation:fadeInOverlay .25s ease;">
                        <div style="background:linear-gradient(150deg,#00c9a7 0%,#00897b 100%);border-radius:22px;padding:2.8rem 2.2rem 2.2rem;text-align:center;max-width:380px;width:90%;box-shadow:0 24px 60px rgba(0,0,0,0.32);animation:popIn .3s cubic-bezier(.34,1.56,.64,1);">
                            <div style="width:78px;height:78px;border-radius:50%;border:3px solid rgba(255,255,255,0.75);display:flex;align-items:center;justify-content:center;margin:0 auto 1.4rem;">
                                <i class="fas fa-check" style="color:white;font-size:2.1rem;"></i>
                            </div>
                            <h5 style="color:white;font-weight:800;margin-bottom:.55rem;font-size:1.2rem;">@TempData["SuccessTitle"]</h5>
                            @if (TempData["SuccessDetail"] != null)
                            {
                                <p style="color:rgba(255,255,255,0.88);font-size:.88rem;margin-bottom:1.7rem;line-height:1.6;">@TempData["SuccessDetail"]</p>
                            }
                            else
                            {
                                <div style="margin-bottom:1.7rem;"></div>
                            }
                            <button onclick="document.getElementById('successOverlay').style.display='none'"
                                    style="background:rgba(255,255,255,0.22);border:1.5px solid rgba(255,255,255,0.5);color:white;padding:.5rem 2.4rem;border-radius:10px;font-size:.95rem;font-weight:600;cursor:pointer;backdrop-filter:blur(6px);transition:background .2s;"
                                    onmouseover="this.style.background='rgba(255,255,255,0.35)'"
                                    onmouseout="this.style.background='rgba(255,255,255,0.22)'">
                                حسناً
                            </button>
                        </div>
                    </div>
                    <style>
                        @@keyframes fadeInOverlay {
                            from {
                                opacity: 0
                            }

                            to {
                                opacity: 1
                            }
                        }

                        @@keyframes popIn {
                            from {
                                transform: scale(.7);
                                opacity: 0
                            }

                            to {
                                transform: scale(1);
                                opacity: 1
                            }
                        }
                    </style>
                }
                else if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/translations.js" asp-append-version="true"></script>
    <script>
        var BOOTSTRAP_RTL = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css';
        var BOOTSTRAP_LTR = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css';

        function applyLanguage(lang) {
            var html = document.documentElement;
            var bootstrapCss = document.getElementById('bootstrap-css');
            var langBtn = document.getElementById('lang-btn');
            var mc = document.querySelector('.main-content');

            document.querySelectorAll('[data-i18n-en]').forEach(function (el) {
                if (lang === 'en') {
                    if (!el.getAttribute('data-i18n-ar')) el.setAttribute('data-i18n-ar', el.textContent.trim());
                    el.textContent = el.getAttribute('data-i18n-en');
                } else {
                    var ar = el.getAttribute('data-i18n-ar');
                    if (ar) el.textContent = ar;
                }
            });

            if (lang === 'en') {
                html.setAttribute('lang', 'en');
                html.setAttribute('dir', 'ltr');
                if (bootstrapCss) bootstrapCss.setAttribute('href', BOOTSTRAP_LTR);
                if (langBtn) langBtn.textContent = 'AR';
                document.querySelectorAll('.sidebar-menu .arrow-icon').forEach(function (i) {
                    i.classList.replace('fa-chevron-left', 'fa-chevron-right');
                });
                var isCollapsed = document.body.classList.contains('sidebar-collapsed');
                if (mc) {
                    mc.style.marginRight = '0';
                    mc.style.marginLeft = (!isCollapsed && window.innerWidth >= 992) ? 'var(--sidebar-width)' : '0';
                }
                var sb = document.getElementById('sidebar');
                if (window.innerWidth >= 992) {
                    if (sb) sb.style.transform = isCollapsed ? 'translateX(-100%)' : 'translateX(0)';
                } else {
                    // على المحمول: أمسح inline style وخلي CSS يتحكم (translateX(-100%) مخفي بالـ CSS)
                    if (sb) { sb.style.transform = ''; sb.classList.remove('show'); }
                    var _ov = document.getElementById('sidebarOverlay');
                    if (_ov) _ov.classList.remove('show');
                    var _cb = document.getElementById('sidebarCloseBtn');
                    if (_cb) _cb.removeAttribute('style');
                    document.body.classList.remove('sidebar-open');
                }
            } else {
                html.setAttribute('lang', 'ar');
                html.setAttribute('dir', 'rtl');
                if (bootstrapCss) bootstrapCss.setAttribute('href', BOOTSTRAP_RTL);
                if (langBtn) langBtn.textContent = 'EN';
                document.querySelectorAll('.sidebar-menu .arrow-icon').forEach(function (i) {
                    i.classList.replace('fa-chevron-right', 'fa-chevron-left');
                });
                if (mc) {
                    mc.style.marginRight = '';
                    mc.style.marginLeft = '';
                }
                var sb = document.getElementById('sidebar');
                if (sb) sb.style.transform = '';
            }

            localStorage.setItem('lang', lang);

            if (typeof translatePageContent === 'function') {
                translatePageContent(lang);
            }

            // Reload notification panel in new language
            _notifLoaded = false;
            var notifPanel = document.getElementById('notif-panel');
            if (notifPanel && notifPanel.classList.contains('show')) {
                loadNotifPanel();
            }
        }

        function toggleLang() {
            var current = localStorage.getItem('lang') || 'ar';
            applyLanguage(current === 'ar' ? 'en' : 'ar');
        }

        // Apply text translations now (dir+css already set in <head> script above)
        if (localStorage.getItem('lang') === 'en') applyLanguage('en');

        // Fix margin on screen resize (e.g. phone rotation)
        window.addEventListener('resize', function () {
            if (localStorage.getItem('lang') === 'en') {
                var mc = document.querySelector('.main-content');
                if (mc) {
                    var isCollapsed = document.body.classList.contains('sidebar-collapsed');
                    mc.style.marginLeft = (!isCollapsed && window.innerWidth >= 992) ? 'var(--sidebar-width)' : '0';
                }
            }
        });
    </script>
    <script>
        // Mobile sidebar
        var sidebar = document.getElementById('sidebar');
        var overlay  = document.getElementById('sidebarOverlay');
        var closeBtn = document.getElementById('sidebarCloseBtn');

        function toggleSidebar() {
            var isOpen = sidebar.classList.toggle('show');
            overlay.classList.toggle('show', isOpen);
            if (isOpen) {
                var ltr = document.documentElement.getAttribute('dir') === 'ltr';
                closeBtn.style.cssText =
                    'display:flex;position:fixed;z-index:9999;top:12px;' +
                    'width:44px;height:44px;background:#dc3545;border:none;color:#fff;' +
                    'font-size:22px;border-radius:50%;align-items:center;justify-content:center;' +
                    'box-shadow:0 3px 10px rgba(220,53,69,.5);cursor:pointer;touch-action:manipulation;' +
                    (ltr ? 'right:12px;left:auto;' : 'left:12px;right:auto;');
            } else {
                closeBtn.style.cssText = 'display:none;';
            }
            document.body.classList.toggle('sidebar-open', isOpen);
        }
        function closeSidebar() {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
            closeBtn.style.cssText = 'display:none;';
            document.body.classList.remove('sidebar-open');
        }

        if (overlay) overlay.addEventListener('click', closeSidebar);

        // Close sidebar when tapping a real nav link on mobile (not submenu toggles)
        document.querySelectorAll('.sidebar-menu a[href]:not(.submenu-toggle)').forEach(function(link) {
            link.addEventListener('click', function() {
                if (window.innerWidth < 992) closeSidebar();
            });
        });

        // Desktop sidebar collapse/expand
        function updateToggleIcon(collapsed) {
            var icon = document.getElementById('sidebarToggleIcon');
            var btn = document.getElementById('sidebarToggleBtn');
            if (!icon) return;
            if (collapsed) {
                icon.classList.remove('fa-chevron-right');
                icon.classList.add('fa-chevron-left');
                if (btn) btn.title = 'إظهار القائمة';
            } else {
                icon.classList.remove('fa-chevron-left');
                icon.classList.add('fa-chevron-right');
                if (btn) btn.title = 'إخفاء القائمة';
            }
        }

        function toggleSidebarDesktop() {
            var collapsed = document.body.classList.toggle('sidebar-collapsed');
            var mc = document.querySelector('.main-content');
            var sb = document.getElementById('sidebar');
            var lang = localStorage.getItem('lang') || 'ar';
            if (lang === 'en') {
                if (mc) mc.style.marginLeft = collapsed ? '0' : (window.innerWidth >= 992 ? 'var(--sidebar-width)' : '0');
                if (sb) sb.style.transform = collapsed ? 'translateX(-100%)' : 'translateX(0)';
            }
            localStorage.setItem('sidebarCollapsed', collapsed ? '1' : '0');
            updateToggleIcon(collapsed);
        }

        // Restore sidebar state on page load
        (function () {
            if (localStorage.getItem('sidebarCollapsed') === '1') {
                document.body.classList.add('sidebar-collapsed');
                updateToggleIcon(true);
                var mc = document.querySelector('.main-content');
                var sb = document.getElementById('sidebar');
                var lang = localStorage.getItem('lang') || 'ar';
                if (lang === 'en') {
                    if (mc) mc.style.marginLeft = '0';
                    if (sb) sb.style.transform = 'translateX(-100%)';
                }
            }
        })();

        // Dropdown submenu
        function toggleMenu(el) {
            const li = el.closest('.has-submenu');
            const submenu = li.querySelector('.submenu');
            const isOpen = li.classList.contains('open');

            // أغلق باقي القوائم
            document.querySelectorAll('.has-submenu.open').forEach(function(item) {
                if (item !== li) {
                    item.classList.remove('open');
                    item.querySelector('.submenu').classList.remove('show');
                }
            });

            // افتح / أغلق الحالية
            li.classList.toggle('open', !isOpen);
            submenu.classList.toggle('show', !isOpen);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Notifications Panel -->
    <div id="notif-overlay" onclick="closeNotifPanel()"></div>
    <div id="notif-panel">
        <div id="notif-panel-loading">
            <i class="fas fa-spinner fa-spin"></i> جار التحميل...
        </div>
    </div>

    <script>
        var _notifLoaded = false;

        function toggleNotifPanel() {
            var panel = document.getElementById('notif-panel');
            var overlay = document.getElementById('notif-overlay');
            var btn = document.getElementById('notif-btn');
            if (panel.classList.contains('show')) {
                closeNotifPanel();
            } else {
                panel.classList.add('show');
                overlay.classList.add('show');
                btn.classList.add('active');
                if (!_notifLoaded) loadNotifPanel();
            }
        }

        function closeNotifPanel() {
            document.getElementById('notif-panel').classList.remove('show');
            document.getElementById('notif-overlay').classList.remove('show');
            var btn = document.getElementById('notif-btn');
            if (btn) btn.classList.remove('active');
        }

        function loadNotifPanel() {
            var lang = localStorage.getItem('lang') || 'ar';
            fetch('/Notifications/Panel?lang=' + lang, { credentials: 'same-origin' })
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    var panel = document.getElementById('notif-panel');
                    panel.innerHTML = html;
                    panel.querySelectorAll('script').forEach(function (oldScript) {
                        var s = document.createElement('script');
                        s.textContent = oldScript.textContent;
                        document.body.appendChild(s);
                        s.remove();
                    });
                    _notifLoaded = true;
                })
                .catch(function () {
                    var errMsg = localStorage.getItem('lang') === 'en'
                        ? 'Failed to load notifications'
                        : 'تعذّر تحميل الإشعارات';
                    document.getElementById('notif-panel').innerHTML =
                        '<div style="padding:30px;text-align:center;color:#adb5bd;">' + errMsg + '</div>';
                });
        }

        // ===== Appointment Audio Alert System =====
        var _apptAudioCtx = null;
        var _apptAlertedIds = {};

        function _apptGetAudioCtx() {
            if (!_apptAudioCtx) {
                _apptAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            return _apptAudioCtx;
        }

        // Unlock audio on first user interaction
        document.addEventListener('click', function unlockAudio() {
            try { _apptGetAudioCtx(); } catch (e) { }
            document.removeEventListener('click', unlockAudio);
        }, { once: true });

        function _apptPlaySound() {
            try {
                var ctx = _apptGetAudioCtx();
                if (ctx.state === 'suspended') ctx.resume();
                function beep(freq, start, dur) {
                    var o = ctx.createOscillator();
                    var g = ctx.createGain();
                    o.connect(g); g.connect(ctx.destination);
                    o.type = 'sine'; o.frequency.value = freq;
                    g.gain.setValueAtTime(0, ctx.currentTime + start);
                    g.gain.linearRampToValueAtTime(0.7, ctx.currentTime + start + 0.05);
                    g.gain.linearRampToValueAtTime(0, ctx.currentTime + start + dur);
                    o.start(ctx.currentTime + start);
                    o.stop(ctx.currentTime + start + dur + 0.1);
                }
                beep(880, 0, 0.25);
                beep(1100, 0.35, 0.25);
                beep(1320, 0.7, 0.4);
            } catch (e) { console.warn('appt sound error', e); }
        }

        function _apptShowOverlay(appt) {
            var old = document.getElementById('appt-alert-overlay');
            if (old) old.remove();

            if (!document.getElementById('appt-alert-style')) {
                var st = document.createElement('style');
                st.id = 'appt-alert-style';
                st.textContent = [
                    '@@keyframes apptFadeIn{from{opacity:0}to{opacity:1}}',
                    '@@keyframes apptSlideUp{from{transform:translateY(50px) scale(0.95);opacity:0}to{transform:translateY(0) scale(1);opacity:1}}',
                    '#appt-alert-overlay{position:fixed;top:0;left:0;right:0;bottom:0;z-index:999999;',
                    'background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;',
                    'animation:apptFadeIn 0.3s ease;}',
                    '#appt-alert-card{background:#fff;border-radius:24px;padding:44px 52px;text-align:center;',
                    'max-width:500px;width:92%;box-shadow:0 25px 70px rgba(0,0,0,0.5);',
                    'animation:apptSlideUp 0.4s cubic-bezier(0.34,1.56,0.64,1);}'
                ].join('');
                document.head.appendChild(st);
            }

            var overlay = document.createElement('div');
            overlay.id = 'appt-alert-overlay';

            var minutesText = appt.minutesLeft <= 1 ? 'دقيقة واحدة' : appt.minutesLeft + ' دقائق';

            overlay.innerHTML =
                '<div id="appt-alert-card">' +
                '<div style="width:90px;height:90px;background:linear-gradient(135deg,#F7941D,#d4690e);border-radius:50%;' +
                'display:flex;align-items:center;justify-content:center;margin:0 auto 20px;' +
                'box-shadow:0 8px 24px rgba(247,148,29,0.5);">' +
                '<i class="fas fa-bell" style="font-size:40px;color:#fff;animation:apptFadeIn 0.5s;"></i>' +
                '</div>' +
                '<h2 style="font-size:2rem;font-weight:900;color:#1a1a2e;margin:0 0 6px;">تنبيه موعد قادم</h2>' +
                '<p style="color:#888;margin:0 0 20px;font-size:0.95rem;">الموعد القادم خلال دقائق</p>' +
                '<div style="background:linear-gradient(135deg,#fff8f0,#fff3e0);border:2px solid #F7941D;' +
                'border-radius:16px;padding:22px;margin-bottom:24px;">' +
                '<div style="font-size:2.2rem;font-weight:900;color:#c0392b;margin-bottom:14px;">⏰ بعد ' + minutesText + '</div>' +
                '<div style="display:flex;flex-direction:column;gap:10px;">' +
                '<div style="font-size:1.25rem;color:#2c3e50;padding:8px 16px;background:rgba(255,255,255,0.7);border-radius:10px;">' +
                '<span style="color:#888;font-size:0.9rem;">العميل</span><br>' +
                '<strong style="font-size:1.35rem;">' + appt.customerName + '</strong></div>' +
                (appt.employeeName && appt.employeeName !== '—' ?
                '<div style="font-size:1.25rem;color:#2c3e50;padding:8px 16px;background:rgba(255,255,255,0.7);border-radius:10px;">' +
                '<span style="color:#888;font-size:0.9rem;">الموظف</span><br>' +
                '<strong style="font-size:1.35rem;">' + appt.employeeName + '</strong></div>' : '') +
                '<div style="font-size:1.5rem;font-weight:800;color:#155724;padding:10px 16px;background:rgba(255,255,255,0.7);border-radius:10px;">' +
                '🕐 ' + appt.time + '</div>' +
                '</div></div>' +
                '<button id="appt-dismiss-btn" style="background:linear-gradient(135deg,#F7941D,#d4690e);color:#fff;border:none;' +
                'padding:15px 56px;font-size:1.15rem;font-weight:800;border-radius:50px;cursor:pointer;' +
                'box-shadow:0 6px 20px rgba(247,148,29,0.45);transition:transform 0.15s;">' +
                'حسناً، فهمت</button>' +
                '</div>';

            document.body.appendChild(overlay);

            document.getElementById('appt-dismiss-btn').addEventListener('click', function () {
                overlay.style.animation = 'apptFadeIn 0.2s ease reverse';
                setTimeout(function () { overlay.remove(); }, 200);
            });

            _apptPlaySound();
            setTimeout(_apptPlaySound, 1800);
        }

        function _apptCheck() {
            fetch('/Appointments/GetUpcomingAlerts', { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (list) {
                    list.forEach(function (appt) {
                        if (!_apptAlertedIds[appt.id]) {
                            _apptAlertedIds[appt.id] = true;
                            _apptShowOverlay(appt);
                        }
                    });
                })
                .catch(function () { });
        }

        _apptCheck();
        setInterval(_apptCheck, 60000);
        // ===== End Appointment Alert System =====

        // Load notification count on page load
        (function loadNotifCount() {
            fetch('/Notifications/Count', { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var badge = document.getElementById('notif-count');
                    if (badge && data.total > 0) {
                        badge.textContent = data.total > 99 ? '99+' : data.total;
                        badge.style.display = '';
                        badge.style.background = data.important > 0 ? '#dc3545' : '#F7941D';
                    }
                })
                .catch(function () { });
        })();
    </script>
</body>
</html>