<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام معهد موس</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/salon.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@inject Microsoft.AspNetCore.Identity.UserManager<Salon.Models.ApplicationUser> LayoutUserManager
<body>
@{
    var layoutUser = await LayoutUserManager.GetUserAsync(User);
    var layoutFullName = layoutUser?.FullName ?? User.Identity?.Name?.Split('@').FirstOrDefault() ?? "المستخدم";
    var layoutRoles = layoutUser != null ? await LayoutUserManager.GetRolesAsync(layoutUser) : new List<string>();
    var layoutRole = layoutRoles.FirstOrDefault() ?? "";
    var layoutRoleAr = layoutRole switch
    {
        "Admin"    => "مدير النظام",
        "Manager"  => "مدير",
        "Cashier"  => "كاشير",
        "Employee" => "موظف",
        _          => layoutRole
    };
    var layoutInitial = layoutFullName.FirstOrDefault().ToString().ToUpper();
}
    <!-- Overlay for mobile sidebar -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="app-wrapper">
        @await Html.PartialAsync("_Sidebar")

        <div class="main-content">
            <header class="topbar">
                <div class="topbar-right">
                    <!-- Hamburger button (mobile only) -->
                    <button class="hamburger-btn d-lg-none" onclick="toggleSidebar()" title="القائمة">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="topbar-greeting">
                        مرحباً، <strong>@layoutFullName</strong>
                    </div>
                </div>
                <div class="topbar-left">
                    <a href="@Url.Action("Logout", "Account")" class="logout-btn" title="تسجيل الخروج">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                    <div class="notif-btn">
                        <i class="fas fa-bell"></i>
                        <span class="notif-badge">9</span>
                    </div>
                    <div class="dropdown">
                        <div class="topbar-user" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="cursor:pointer">
                            <div>
                                <div style="font-size:13px; font-weight:600;">@layoutFullName</div>
                                <div class="user-role">@layoutRoleAr</div>
                            </div>
                            <div class="user-avatar">@layoutInitial</div>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-start shadow">
                            <li>
                                <a class="dropdown-item" href="@Url.Action("ChangePassword","Account")">
                                    <i class="fas fa-key me-2 text-warning"></i> تغيير كلمة المرور
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Index","Users")">
                                        <i class="fas fa-user-shield me-2 text-danger"></i> إدارة المستخدمين
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="@Url.Action("Logout","Account")">
                                    <i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div style="font-size:15px; font-weight:700; color:#1a1a2e;">
                        <i class="fas fa-wifi" style="color:var(--primary); margin-left:6px;"></i>
                        نظام معهد موس
                    </div>
                </div>
            </header>

            <div class="page-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Mobile sidebar
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('show');
            document.getElementById('sidebarOverlay').classList.remove('show');
        }

        // Dropdown submenu
        function toggleMenu(el) {
            const li = el.closest('.has-submenu');
            const submenu = li.querySelector('.submenu');
            const isOpen = li.classList.contains('open');

            // أغلق باقي القوائم
            document.querySelectorAll('.has-submenu.open').forEach(function(item) {
                if (item !== li) {
                    item.classList.remove('open');
                    item.querySelector('.submenu').classList.remove('show');
                }
            });

            // افتح / أغلق الحالية
            li.classList.toggle('open', !isOpen);
            submenu.classList.toggle('show', !isOpen);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
