<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام معهد موس</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/salon.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-wrapper">
        @await Html.PartialAsync("_Sidebar")

        <div class="main-content">
            <header class="topbar">
                <div class="topbar-right">
                    <div class="topbar-greeting">
                        مرحباً، <strong>@(User.Identity?.Name?.Split('@').FirstOrDefault() ?? "المستخدم")</strong>
                    </div>
                </div>
                <div class="topbar-left">
                    <a href="@Url.Action("Logout", "Account")" class="logout-btn" title="تسجيل الخروج">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                    <div class="notif-btn">
                        <i class="fas fa-bell"></i>
                        <span class="notif-badge">9</span>
                    </div>
                    <button class="lang-switch-btn">EN</button>
                    <div class="topbar-user">
                        <div>
                            <div style="font-size:13px; font-weight:600;">@(User.Identity?.Name?.Split('@').FirstOrDefault())</div>
                            <div class="user-role">admin</div>
                        </div>
                        <div class="user-avatar">
                            @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "A")
                        </div>
                    </div>
                    <div style="font-size:15px; font-weight:700; color:#1a1a2e;">
                        <i class="fas fa-wifi" style="color:var(--primary); margin-left:6px;"></i>
                        نظام معهد موس
                    </div>
                </div>
            </header>

            <div class="page-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <a href="#" class="whatsapp-btn">
        <i class="fab fa-whatsapp fa-lg"></i>
        <span>متصل</span>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
