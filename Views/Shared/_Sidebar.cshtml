@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();

    string IsActive(string controller, string? action = null)
    {
        if (action != null)
            return currentController == controller.ToLower() && currentAction == action.ToLower() ? "active" : "";
        return currentController == controller.ToLower() ? "active" : "";
    }
}

