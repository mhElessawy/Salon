@inject Salon.Services.IPermissionService PermSvc
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower();
    var act = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();

    // تحميل الصلاحيات مرة واحدة لهذا الطلب
    var accessibleModules = await PermSvc.GetAccessibleModulesAsync();
    bool canSee(string m) => accessibleModules.Contains(m);

    string IsActive(string controller, string? action = null)
    {
        if (action != null)
            return ctrl == controller.ToLower() && act == action.ToLower() ? "active" : "";
        return ctrl == controller.ToLower() ? "active" : "";
    }

    bool IsGroupOpen(params string[] controllers)
        => controllers.Any(c => ctrl == c.ToLower());

    bool customersOpen = IsGroupOpen("customers", "messages");
    bool shiftsOpen = IsGroupOpen("shifts", "dailyclosure");
    bool salesOpen = IsGroupOpen("sales", "appointments", "packages");
    bool defsOpen = IsGroupOpen("services", "servicecategories", "departments", "packages", "inventory");
    bool inventoryOpen = IsGroupOpen("inventory", "suppliers", "purchaserequests", "supplierinvoices");
    bool hrOpen = IsGroupOpen("employees", "salaries", "advances", "custody", "attendance");
    bool cashOpen = IsGroupOpen("expenses", "deposits", "withdrawals");
    bool reportsOpen = IsGroupOpen("reports", "barberdaily")
        || (ctrl == "attendance" && act == "reports")
        || (ctrl == "shifts" && act == "reports")
        || (ctrl == "advances" && act == "report")
        || (ctrl == "custody" && act == "report")
        || (ctrl == "inventory" && act == "consumereport");
    bool settingsOpen = IsGroupOpen("settings", "users");
}

