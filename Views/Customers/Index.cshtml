@model IEnumerable<Salon.Models.Customer>
@{
    ViewData["Title"] = "العملاء";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-users text-primary me-2"></i>العملاء</h1>
        <p>إدارة بيانات العملاء</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة عميل
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="search-bar mb-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو الهاتف..." />
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-search"></i> بحث
            </button>
        </form>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الاسم الكامل</th>
                        <th>الهاتف</th>
                        <th>البريد الإلكتروني</th>
                        <th>تاريخ الميلاد</th>
                        <th>تاريخ الإضافة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">لا توجد بيانات</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td><strong>@c.FullName</strong></td>
                            <td>@(c.Phone ?? "-")</td>
                            <td>@(c.Email ?? "-")</td>
                            <td>@(c.BirthDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>@c.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = c.Id })" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = c.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('هل تريد حذف هذا العميل؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
