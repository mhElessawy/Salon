@model IEnumerable<Salon.Models.Customer>
@{
    ViewData["Title"] = "العملاء";
    var userDept = ViewBag.UserDepartment as string;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-users text-primary me-2"></i>العملاء</h1>
        <p>إدارة بيانات العملاء</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة عميل
    </a>
</div>

<div class="card mb-4">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="max-width:260px" placeholder="بحث بالاسم أو الهاتف..." />
            @if (string.IsNullOrEmpty(userDept))
            {
                <select name="dept" class="form-select" style="max-width:160px">
                    <option value="">-- كل الأقسام --</option>
                    <option value="حلاقة" selected="@(ViewBag.Dept == "حلاقة" ? "selected" : null)">✂ حلاقة</option>
                    <option value="مساج" selected="@(ViewBag.Dept == "مساج" ? "selected" : null)">💆 مساج</option>
                </select>
            }
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-search"></i> بحث
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">إلغاء الفلتر</a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="fas fa-users fa-3x mb-3 opacity-50 d-block"></i>
        <p class="fs-5">لا توجد بيانات</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card h-100 customer-card shadow-sm">
                    <div class="card-body text-center pt-4">
                        <div class="customer-avatar mx-auto mb-3">
                            @c.FullName.Substring(0, 1)
                        </div>
                        <h5 class="card-title mb-1 fw-bold">@c.FullName</h5>
                        @if (!string.IsNullOrEmpty(c.FullNameEn))
                        {
                            <div class="text-muted small mb-1" dir="ltr">@c.FullNameEn</div>
                        }
                        <div class="d-flex justify-content-center gap-1 flex-wrap mb-2">
                            @if (!string.IsNullOrEmpty(c.Department))
                            {
                                var deptColor = c.Department == "حلاقة" ? "#F7941D" : "#17a2b8";
                                <span class="badge rounded-pill" style="background-color:@deptColor">
                                    @(c.Department == "حلاقة" ? "✂" : "💆") @c.Department
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(c.Gender))
                            {
                                <span class="badge rounded-pill"
                                      style="background-color: var(--primary-light); color: var(--primary);">
                                    @c.Gender
                                </span>
                            }
                        </div>
                        <div class="customer-info mt-3">
                            @if (!string.IsNullOrEmpty(c.Phone))
                            {
                                <div class="info-item">
                                    <i class="fas fa-phone"></i>
                                    <span>@c.Phone</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(c.Email))
                            {
                                <div class="info-item">
                                    <i class="fas fa-envelope"></i>
                                    <span class="text-truncate" style="max-width:150px">@c.Email</span>
                                </div>
                            }
                            @if (c.BirthDate.HasValue)
                            {
                                <div class="info-item">
                                    <i class="fas fa-birthday-cake"></i>
                                    <span>@c.BirthDate.Value.ToString("yyyy/MM/dd")</span>
                                </div>
                            }
                            <div class="info-item text-muted">
                                <i class="fas fa-calendar-plus"></i>
                                <span>@c.CreatedAt.ToString("yyyy/MM/dd")</span>
                            </div>
                        </div>

                        @{
                            var completedSales = c.Sales.Where(s => s.Status == "مكتمل").ToList();
                            var visitCount   = completedSales.Count;
                            var totalPaid    = completedSales.Sum(s => s.NetAmount);
                            var lastSale     = completedSales.OrderByDescending(s => s.SaleDate).FirstOrDefault();
                        }
                        <div class="border-top mt-3 pt-3 d-flex justify-content-around text-center">
                            <div>
                                <div class="fw-bold text-primary fs-5">@visitCount</div>
                                <div class="text-muted" style="font-size:0.75rem">زيارة</div>
                            </div>
                            <div>
                                <div class="fw-bold text-success fs-5">@totalPaid.ToString("N3")</div>
                                <div class="text-muted" style="font-size:0.75rem">د.ك مدفوع</div>
                            </div>
                            <div>
                                @if (lastSale != null)
                                {
                                    <div class="fw-bold text-dark" style="font-size:0.82rem">@lastSale.SaleDate.ToString("yyyy/MM/dd")</div>
                                    <div class="text-muted" style="font-size:0.75rem">@lastSale.InvoiceNumber</div>
                                }
                                else
                                {
                                    <div class="text-muted" style="font-size:0.82rem">—</div>
                                    <div class="text-muted" style="font-size:0.75rem">لا توجد</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-center gap-2 pb-3">
                        <a href="@Url.Action("Details", new { id = c.Id })" class="btn btn-sm btn-outline-primary" title="التفاصيل">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("Edit", new { id = c.Id })" class="btn btn-sm btn-outline-warning" title="تعديل">
                            <i class="fas fa-edit"></i>
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                onclick="confirmDelete(@c.Id, '@Html.Raw(c.FullName.Replace("'", "\\'"))')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف العميل:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteCustomerName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">
                            تأكيد
                        </button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">
                        إلغاء
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteCustomerName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}