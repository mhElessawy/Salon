@model IEnumerable<Salon.Models.Customer>
@{
    ViewData["Title"] = "العملاء";
    var userDept = ViewBag.UserDepartment as string;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-users text-primary me-2"></i>العملاء</h1>
        <p>إدارة بيانات العملاء</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة عميل
    </a>
</div>

<div class="card mb-4">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" style="max-width:260px" placeholder="بحث بالاسم أو الهاتف..." />
            @if (string.IsNullOrEmpty(userDept))
            {
                <select name="dept" class="form-select" style="max-width:160px">
                    <option value="">-- كل الأقسام --</option>
                    <option value="حلاقة" selected="@(ViewBag.Dept == "حلاقة" ? "selected" : null)">✂ حلاقة</option>
                    <option value="مساج" selected="@(ViewBag.Dept == "مساج" ? "selected" : null)">💆 مساج</option>
                </select>
            }
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-search"></i> بحث
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">إلغاء الفلتر</a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="fas fa-users fa-3x mb-3 opacity-50 d-block"></i>
        <p class="fs-5">لا توجد بيانات</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model)
        {
            var completedSales = c.Sales.Where(s => s.Status == "مكتمل").ToList();
            var visitCount = completedSales.Count;
            var totalPaid = completedSales.Sum(s => s.NetAmount);
            var lastSale = completedSales.OrderByDescending(s => s.SaleDate).FirstOrDefault();
            var customerType = totalPaid >= 300 ? "VIP" : totalPaid >= 100 ? "ذهبي" : "عادي";
            var customerTypeColor = totalPaid >= 300 ? "#9c27b0" : totalPaid >= 100 ? "#F7941D" : "#6c757d";
            var customerTypeIcon = totalPaid >= 300 ? "⭐" : totalPaid >= 100 ? "🏆" : "";
            var distinctEmployeeCount = completedSales
            .Where(s => s.Employee != null)
            .Select(s => s.EmployeeId)
            .Distinct()
            .Count();
            var interactionStyle = distinctEmployeeCount == 0 ? "—" :
            distinctEmployeeCount == 1 ? "ثابت مع موظف واحد" : "متعدد الموظفين";
            var deptColor = c.Department == "حلاقة" ? "#F7941D" : c.Department == "مساج" ? "#17a2b8" : "#0d6efd";
            var deptIcon = c.Department == "حلاقة" ? "✂" : c.Department == "مساج" ? "💆" : "🌐";
            var deptLabel = c.Department == "الكل" ? "الكل" : c.Department;
            var showWallet = c.Department == "مساج" || c.Department == "الكل";
            var openingPkg = c.CustomerPackages
            .Where(p => p.RegistrationType == Salon.Models.CustomerPackage.RegistrationTypes.OpeningBalance && p.IsActive && p.CurrentBalance > 0)
            .OrderByDescending(p => p.CurrentBalance).FirstOrDefault();
            var activePackages = c.CustomerPackages.Where(cp => cp.IsActive && cp.RemainingSessions > 0).ToList();
            var primaryPkg = activePackages.OrderByDescending(p => p.PurchaseDate).FirstOrDefault();
            var lastUsedText = primaryPkg == null ? "—" :
            (primaryPkg.Transactions.Any()
            ? primaryPkg.Transactions.OrderByDescending(t => t.UsedDate).First().UsedDate.ToString("yyyy/MM/dd")
            : primaryPkg.PurchaseDate.ToString("yyyy/MM/dd"));
            var canManageBalance = User.IsInRole("Admin") || User.IsInRole("Manager");
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm" style="border-radius:14px; overflow:hidden;">
                    <!-- Header -->
                    <div class="p-3" style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:54px;height:54px;border-radius:50%;background:#F7941D;display:flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:700;color:#fff;flex-shrink:0;">
                                @c.FullName.Substring(0, 1)
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-white text-truncate text-uppercase" style="font-size:1rem;">@c.FullName</div>
                                <div class="text-white-50 small mt-1">
                                    <i class="fas fa-phone me-1" style="font-size:0.7rem;"></i>@(c.Phone ?? "—")
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-1 flex-wrap mt-2">
                            @if (c.AssignedEmployee != null)
                            {
                                <span class="badge rounded-pill" style="background:#0f172a;font-size:0.7rem;">
                                    <i class="fas fa-user-tie me-1" style="font-size:0.65rem;"></i>@c.AssignedEmployee.FullName
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(c.Gender))
                            {
                                <span class="badge rounded-pill bg-secondary" style="font-size:0.7rem;">@c.Gender</span>
                            }
                            @if (!string.IsNullOrEmpty(c.Department))
                            {
                                <span class="badge rounded-pill" style="background:@deptColor;font-size:0.7rem;">
                                    @deptIcon @deptLabel
                                </span>
                            }
                        </div>
                    </div>

                    @if (openingPkg != null)
                    {
                        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="background:#198754;color:#fff;font-size:0.8rem;font-weight:600;">
                            <span><i class="fas fa-wallet me-1"></i>رصيد افتتاحي</span>
                            <span>@openingPkg.CurrentBalance.ToString("N3") د.ك</span>
                        </div>
                    }

                    <div class="card-body p-3">
                        <!-- 2×2 info grid -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="rounded p-2 text-center" style="background:#f8f9fa;border:1px solid #e9ecef;">
                                    <div class="text-muted mb-1" style="font-size:0.68rem;">حالة العميل</div>
                                    <div class="fw-bold text-success" style="font-size:0.82rem;">
                                        <i class="fas fa-check-circle me-1"></i>مسجل
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded p-2 text-center" style="background:#f8f9fa;border:1px solid #e9ecef;">
                                    <div class="text-muted mb-1" style="font-size:0.68rem;">تصنيف العميل</div>
                                    <div class="fw-bold" style="color:@customerTypeColor;font-size:0.82rem;">@customerTypeIcon @customerType</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded p-2 text-center" style="background:#f8f9fa;border:1px solid #e9ecef;">
                                    <div class="text-muted mb-1" style="font-size:0.68rem;">طريقة التعامل</div>
                                    <div class="fw-bold" style="font-size:0.75rem;">@interactionStyle</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rounded p-2 text-center" style="background:#f8f9fa;border:1px solid #e9ecef;">
                                    <div class="text-muted mb-1" style="font-size:0.68rem;">الموظف المسؤول</div>
                                    <div class="fw-bold text-truncate" style="font-size:0.82rem;" title="@(c.AssignedEmployee?.FullName ?? "—")">@(c.AssignedEmployee?.FullName ?? "—")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Stats row -->
                        <div class="d-flex justify-content-between text-center py-2 mb-3" style="border-top:1px solid #e9ecef;border-bottom:1px solid #e9ecef;">
                            <div>
                                <div class="text-success mb-1"><i class="fas fa-wallet"></i></div>
                                <div class="text-muted" style="font-size:0.65rem;">إجمالي المدفوع</div>
                                <div class="fw-bold text-success" style="font-size:0.8rem;">@totalPaid.ToString("N3") KD</div>
                            </div>
                            <div>
                                <div class="text-primary mb-1"><i class="fas fa-users"></i></div>
                                <div class="text-muted" style="font-size:0.65rem;">عدد الزيارات</div>
                                <div class="fw-bold text-primary">@visitCount</div>
                            </div>
                            <div>
                                <div class="text-muted mb-1"><i class="fas fa-calendar-alt"></i></div>
                                <div class="text-muted" style="font-size:0.65rem;">آخر زيارة</div>
                                <div class="fw-bold" style="font-size:0.78rem;">@(lastSale != null ? lastSale.SaleDate.ToString("yyyy/MM/dd") : "—")</div>
                            </div>
                        </div>

                        <!-- Notes -->
                        @if (!string.IsNullOrEmpty(c.Notes))
                        {
                            <div class="p-2 rounded mb-2" style="background:#fff8e1;border:1px solid #ffe082;font-size:0.78rem;color:#5a4a00;">
                                <i class="fas fa-sticky-note text-warning me-1"></i>@c.Notes
                            </div>
                        }

                        <!-- محفظة العميل (الباقات المدفوعة مسبقاً) -->
                        @if (showWallet && primaryPkg != null)
                        {
                            <div class="rounded p-3 mt-2" style="background:#fff8ec;border:1px solid #fcd9a8;">
                                <div class="fw-bold mb-2" style="color:#c2680b;font-size:0.82rem;">
                                    <i class="fas fa-wallet me-1"></i>محفظة العميل (الباقات المدفوعة مسبقاً)
                                </div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted"><i class="fas fa-calendar-check me-1"></i>تاريخ آخر استخدام</span>
                                    <span class="fw-semibold">@lastUsedText</span>
                                </div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted"><i class="fas fa-layer-group me-1"></i>الجلسات المتبقية</span>
                                    <span class="fw-semibold">@primaryPkg.RemainingSessions / @primaryPkg.TotalSessions جلسات</span>
                                </div>
                                <div class="d-flex justify-content-between small mb-2">
                                    <span class="text-muted"><i class="fas fa-coins me-1"></i>رصيد الباقة المتبقي</span>
                                    <span class="fw-bold" style="color:#c2680b;">@primaryPkg.CurrentBalance.ToString("N3") د.ك</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Details", new { id = c.Id })" class="btn btn-outline-secondary btn-sm flex-fill" style="font-size:0.72rem;">
                                        <i class="fas fa-eye me-1"></i>عرض المحفظة
                                    </a>
                                    @if (canManageBalance)
                                    {
                                        <a href="@Url.Action("Details", new { id = c.Id, openBalance = 1 })" class="btn btn-outline-warning btn-sm flex-fill" style="font-size:0.72rem;">
                                            <i class="fas fa-plus me-1"></i>إضافة رصيد
                                        </a>
                                    }
                                </div>
                                <div class="text-muted mt-2" style="font-size:0.65rem;">
                                    يتم خصم قيمة الجلسة من رصيد العميل عند تقديم الخدمة ولا يتم تحصيل أي مبلغ من العميل
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Action buttons -->
                    <div class="px-3 pb-3 d-flex gap-2">
                        <a href="@Url.Action("Details", new { id = c.Id })" class="btn flex-fill btn-sm fw-semibold"
                           style="background:#1a1a2e;color:#fff;border-color:#1a1a2e;">
                            <i class="fas fa-eye me-1"></i>عرض
                        </a>
                        <a href="@Url.Action("Edit", new { id = c.Id })" class="btn flex-fill btn-sm fw-semibold"
                           style="background:#F7941D;color:#fff;border-color:#F7941D;">
                            <i class="fas fa-edit me-1"></i>تعديل
                        </a>
                        <button type="button" class="btn btn-danger btn-sm fw-semibold" style="width:42px;flex:0 0 auto;"
                                onclick="confirmDelete(@c.Id, '@Html.Raw(c.FullName.Replace("'", "\\'"))')" title="حذف">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف العميل:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteCustomerName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">
                            تأكيد
                        </button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">
                        إلغاء
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteCustomerName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}