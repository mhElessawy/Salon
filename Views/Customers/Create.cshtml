@model Salon.Models.Customer
@{
    ViewData["Title"] = "إضافة عميل";
    var userDept = ViewBag.UserDepartment as string;
}

<div class="page-header">
    <h1><i class="fas fa-user-plus me-2"></i>إضافة عميل جديد</h1>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="الاسم بالعربية" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullNameEn" class="form-label"></label>
                    <input asp-for="FullNameEn" class="form-control" placeholder="Name in English" dir="ltr" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Department" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(userDept))
                    {
                        <input type="hidden" asp-for="Department" />
                        <input type="text" class="form-control" value="@userDept" disabled />
                    }
                    else
                    {
                        <select asp-for="Department" class="form-select">
                            <option value="">-- اختر القسم --</option>
                            <option value="حلاقة">✂ حلاقة</option>
                            <option value="مساج">💆 مساج</option>
                        </select>
                    }
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="BirthDate" class="form-label"></label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">-- اختر --</option>
                        <option>ذكر</option>
                        <option>أنثى</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="fas fa-save me-1"></i> حفظ
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-right me-1"></i> رجوع
                </a>
            </div>
        </form>
    </div>
</div>