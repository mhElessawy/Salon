@model Salon.Models.DashboardViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "لوحة التحكم";
}

@functions {
    // يرجع القيمة المناسبة لنطاق العرض الحالي: قيمة القسم لسكرتير القسم، أو الإجمالي للأدمن
    decimal ScopedValue(string scope, decimal haircut, decimal massage, decimal total)
        => scope == "Haircut" ? haircut : scope == "Massage" ? massage : total;

    // يعرض قيمة واحدة (نطاق سكرتير قسم/موظف) أو 3 أعمدة (نطاق الأدمن: حلاقة/مساج/الإجمالي)
    IHtmlContent DeptColumns(string scope, decimal haircut, decimal massage, decimal total, bool isMoney)
    {
        string Fmt(decimal v) => isMoney ? v.ToString("N3") + " د.ك" : v.ToString("N0");
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"dash-columns\">");
        if (scope == "All")
        {
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{Fmt(haircut)}</div><div class=\"dash-col-label\">✂ حلاقة</div></div>");
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{Fmt(massage)}</div><div class=\"dash-col-label\">🌿 مساج</div></div>");
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{Fmt(total)}</div><div class=\"dash-col-label\">الإجمالي</div></div>");
        }
        else
        {
            var val = scope == "Haircut" ? haircut : scope == "Massage" ? massage : total;
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{Fmt(val)}</div><div class=\"dash-col-label\">اليوم</div></div>");
        }
        sb.Append("</div>");
        return new HtmlString(sb.ToString());
    }

    IHtmlContent AttendanceColumns(string scope, int hp, int ht, int mp, int mt, int ap, int at)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"dash-columns\">");
        if (scope == "All")
        {
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{hp} / {ht}</div><div class=\"dash-col-label\">✂ حلاقة</div></div>");
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{mp} / {mt}</div><div class=\"dash-col-label\">🌿 مساج</div></div>");
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{ap} / {at}</div><div class=\"dash-col-label\">الإجمالي</div></div>");
        }
        else
        {
            var present = scope == "Haircut" ? hp : mp;
            var totalCount = scope == "Haircut" ? ht : mt;
            sb.Append($"<div class=\"dash-col\"><div class=\"dash-col-value\">{present} / {totalCount}</div><div class=\"dash-col-label\">حاضر / إجمالي</div></div>");
        }
        sb.Append("</div>");
        return new HtmlString(sb.ToString());
    }
}

@if (Model.InvoicesWithNotes.Any())
{
    <!-- Modal تنبيه الفواتير التي بها ملاحظات -->
    <div class="modal fade" id="invoiceNotesModal" tabindex="-1" aria-labelledby="invoiceNotesModalLabel" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:420px;">
            <div class="modal-content" style="border-radius:16px; overflow:hidden; border:none;">
                <!-- Header -->
                <div class="modal-header" style="background:#fff3cd; border-bottom:1px solid #ffc107; padding:14px 18px;">
                    <div style="display:flex;align-items:center;gap:10px;flex:1;">
                        <span style="background:#ff4444;color:#fff;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">
                            <i class="fas fa-bell"></i>
                        </span>
                        <div>
                            <div style="font-weight:700;font-size:15px;color:#333;">تنبيه مهم</div>
                            <div style="font-size:12px;color:#666;">
                                لديك <strong>@Model.InvoicesWithNotes.Count فاتورة</strong> عليها ملاحظات يجب الاطلاع عليها
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>

                <!-- Warning Banner -->
                <div style="background:#fff8e1;padding:10px 16px;border-bottom:1px solid #ffe082;font-size:12px;color:#7a5c00;display:flex;align-items:flex-start;gap:8px;">
                    <i class="fas fa-exclamation-triangle" style="color:#f59e0b;margin-top:2px;flex-shrink:0;"></i>
                    <span>يرجى مراجعة الملاحظات التالية والضغط على (تم الاطلاع) لضمان عدم تكرار الأخطاء وتحسين جودة العمل.</span>
                </div>

                <!-- Body: قائمة الفواتير -->
                <div class="modal-body" style="padding:12px 14px;background:#f8f9fa;max-height:420px;overflow-y:auto;">
                    @foreach (var inv in Model.InvoicesWithNotes)
                    {
                        <div class="invoice-note-card" style="background:#fff;border-radius:10px;border:1px solid #e0e0e0;margin-bottom:10px;padding:12px 14px;">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                                <span style="font-weight:700;color:#333;font-size:14px;">
                                    <i class="fas fa-file-invoice" style="color:#6c757d;margin-left:4px;"></i>
                                    @inv.InvoiceNumber
                                </span>
                                <div style="display:flex;gap:12px;font-size:12px;color:#555;">
                                    <span><i class="fas fa-calendar-alt" style="margin-left:3px;color:#6c757d;"></i>@inv.SaleDate.ToString("dd/MM/yyyy")</span>
                                    <span><i class="fas fa-money-bill-wave" style="margin-left:3px;color:#6c757d;"></i>@inv.NetAmount.ToString("N3") د.ك</span>
                                </div>
                            </div>
                            <div style="background:#fff8e1;border-right:3px solid #f59e0b;padding:8px 10px;border-radius:6px;font-size:13px;color:#555;margin-bottom:10px;">
                                <div style="font-weight:600;font-size:11px;color:#888;margin-bottom:3px;">الملاحظة:</div>
                                @inv.Notes
                            </div>
                            <a href="/Sales/Details/@inv.Id" class="btn btn-sm w-100" style="background:#198754;color:#fff;border-radius:8px;font-size:13px;padding:6px;">
                                <i class="fas fa-check-circle me-1"></i> تم الاطلاع
                            </a>
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="modal-footer" style="background:#fff;border-top:1px solid #eee;padding:10px 14px;justify-content:space-between;align-items:center;">
                    <div style="background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:8px 12px;font-size:11px;color:#7a5c00;flex:1;margin-left:10px;">
                        <i class="fas fa-shield-alt" style="margin-left:4px;color:#f59e0b;"></i>
                        <strong>التزامنا بالجودة:</strong> مراجعة الفواتير في وقت المناسب يكفل احترافيتك وتضمن حقوقك وحقوق المنشأة. شكراً للحرص على الجودة والالتزام.
                    </div>
                    <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
                        <a href="/Sales/Index" class="btn btn-sm" style="background:#0d6efd;color:#fff;border-radius:8px;font-size:12px;white-space:nowrap;">
                            <i class="fas fa-list me-1"></i> عرض جميع فواتيري
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal" style="border-radius:8px;font-size:12px;">
                            <i class="fas fa-clock me-1"></i> تذكيري لاحقاً
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = new bootstrap.Modal(document.getElementById('invoiceNotesModal'), { backdrop: 'static', keyboard: false });
            modal.show();
        });
    </script>
}

<div class="page-header">
    <h1>
        <span data-i18n-en="Dashboard">لوحة التحكم</span>
        -
        @if (Model.ViewScope == "Haircut")
        {
            <span data-i18n-en="Barber">الحلاقة</span>
        }
        else if (Model.ViewScope == "Massage")
        {
            <span data-i18n-en="Massage">المساج</span>
        }
        else if (Model.ViewScope == "Personal")
        {
            <span data-i18n-en="My Data">بياناتي</span>
        }
        else
        {
            <span data-i18n-en="All">الإدارة</span>
        }
    </h1>
    <p data-i18n-en="Overview of today's salon performance">نظرة عامة على أداء الصالون والمعاهد في الوقت الحالي</p>
</div>

@if (!Model.HasAccess)
{
    <div style="text-align:center; padding:60px 20px; color:#adb5bd;">
        <i class="fas fa-lock fa-3x mb-3" style="display:block; margin-bottom:16px;"></i>
        <h4 style="color:#6c757d;">ليس لديك صلاحية لعرض بيانات لوحة التحكم</h4>
    </div>
}
else
{
    @if (Model.ViewScope != "Personal")
    {
        <!-- الصف الأول: الحضور + يوميات بانتظار الاعتماد -->
        <div class="dash-row-top">
            <div class="dash-card purple">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Staff Attendance Today">حضور الموظفين اليوم</span>
                    <div class="dash-card-icon purple"><i class="fas fa-user-clock"></i></div>
                </div>
                @AttendanceColumns(Model.ViewScope, Model.Attendance.HaircutPresent, Model.Attendance.HaircutTotal,
                Model.Attendance.MassagePresent, Model.Attendance.MassageTotal,
                Model.Attendance.AllPresent, Model.Attendance.AllTotal)
    </div>

    @{
                var closuresByDept = Model.UnapprovedClosures.GroupBy(c => c.Department).ToDictionary(g => g.Key, g => g.Count());
                int ClosureCount(string dept) => closuresByDept.TryGetValue(dept, out var c) ? c : 0;
                var closureHaircut = ClosureCount(Salon.Models.Shift.ClosureDepartments.Haircut);
                var closureMassage = ClosureCount(Salon.Models.Shift.ClosureDepartments.Massage);
                var closureTotal = Model.UnapprovedClosures.Count;
            }
            <a asp-controller="Reports" asp-action="Closures" class="dash-card amber">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Pending Closure Approvals">يوميات بانتظار الاعتماد والإغلاق</span>
                    <div class="dash-card-icon amber"><i class="fas fa-exclamation-triangle"></i></div>
                </div>
                @DeptColumns(Model.ViewScope, closureHaircut, closureMassage, closureTotal, false)
            </a>
        </div>

        <!-- الصف الثاني: مبيعات / عملاء / فواتير ملغاة / فواتير مسترجعة -->
        <div class="dash-grid-4">
            <a asp-controller="Reports" asp-action="Sales" class="dash-card green">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Sales Today">مبيعات اليوم</span>
                    <div class="dash-card-icon green"><i class="fas fa-dollar-sign"></i></div>
                </div>
                <div class="stat-value mb-2">@ScopedValue(Model.ViewScope, Model.Sales.Haircut, Model.Sales.Massage, Model.Sales.Total).ToString("N3") د.ك</div>
                @DeptColumns(Model.ViewScope, Model.Sales.Haircut, Model.Sales.Massage, Model.Sales.Total, true)
                <span class="dash-card-link" data-i18n-en="View Details">عرض التفاصيل ‹</span>
            </a>

            <a asp-controller="Customers" asp-action="Index" class="dash-card blue">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Customers Today">عملاء اليوم</span>
                    <div class="dash-card-icon blue"><i class="fas fa-users"></i></div>
                </div>
                <div class="stat-value mb-2">@ScopedValue(Model.ViewScope, Model.Customers.Haircut, Model.Customers.Massage, Model.Customers.Total).ToString("N0")</div>
                @DeptColumns(Model.ViewScope, Model.Customers.Haircut, Model.Customers.Massage, Model.Customers.Total, false)
                <span class="dash-card-link" data-i18n-en="View Details">عرض التفاصيل ‹</span>
            </a>

            <a asp-controller="Reports" asp-action="Sales" class="dash-card red">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Cancelled Invoices">فواتير ملغاة</span>
                    <div class="dash-card-icon red"><i class="fas fa-ban"></i></div>
                </div>
                <div class="stat-value mb-2" style="color:#dc2626;">@ScopedValue(Model.ViewScope, Model.CancelledSalesCount.Haircut, Model.CancelledSalesCount.Massage, Model.CancelledSalesCount.Total).ToString("N0") فاتورة</div>
                @DeptColumns(Model.ViewScope, Model.CancelledSalesCount.Haircut, Model.CancelledSalesCount.Massage, Model.CancelledSalesCount.Total, false)
                <span class="dash-card-link" data-i18n-en="View Details">عرض التفاصيل ‹</span>
            </a>

            <a asp-controller="Reports" asp-action="Refunds" class="dash-card gray">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Refunded Invoices">فواتير مسترجعة</span>
                    <div class="dash-card-icon gray"><i class="fas fa-undo"></i></div>
                </div>
                <div class="stat-value mb-2">@ScopedValue(Model.ViewScope, Model.RefundedSalesCount.Haircut, Model.RefundedSalesCount.Massage, Model.RefundedSalesCount.Total).ToString("N0") فاتورة</div>
                @DeptColumns(Model.ViewScope, Model.RefundedSalesCount.Haircut, Model.RefundedSalesCount.Massage, Model.RefundedSalesCount.Total, false)
                <span class="dash-card-link" data-i18n-en="View Details">عرض التفاصيل ‹</span>
            </a>
        </div>

        <!-- الصف الثالث: مصروفات / سلف / صافي الربح -->
        <div class="dash-grid-3">
            <div class="dash-card orange">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Expenses Today">مصروفات اليوم</span>
                    <div class="dash-card-icon orange"><i class="fas fa-shopping-bag"></i></div>
                </div>
                <div class="stat-value mb-2">@ScopedValue(Model.ViewScope, Model.Expenses.Haircut, Model.Expenses.Massage, Model.Expenses.Total).ToString("N3") د.ك</div>
                @DeptColumns(Model.ViewScope, Model.Expenses.Haircut, Model.Expenses.Massage, Model.Expenses.Total, true)
            </div>

            <div class="dash-card rose">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Advances Today">سلف اليوم</span>
                    <div class="dash-card-icon rose"><i class="fas fa-hand-holding-usd"></i></div>
                </div>
                <div class="stat-value mb-2" style="color:#9f1239;">@ScopedValue(Model.ViewScope, Model.Advances.Haircut, Model.Advances.Massage, Model.Advances.Total).ToString("N3") د.ك</div>
                @DeptColumns(Model.ViewScope, Model.Advances.Haircut, Model.Advances.Massage, Model.Advances.Total, true)
            </div>

            <div class="dash-card green">
                <div class="dash-card-header">
                    <span class="dash-card-title" data-i18n-en="Net Profit Today">صافي الربح اليوم</span>
                    <div class="dash-card-icon green"><i class="fas fa-arrow-up"></i></div>
                </div>
                <div class="stat-value mb-2">@ScopedValue(Model.ViewScope, Model.NetProfit.Haircut, Model.NetProfit.Massage, Model.NetProfit.Total).ToString("N3") د.ك</div>
                @DeptColumns(Model.ViewScope, Model.NetProfit.Haircut, Model.NetProfit.Massage, Model.NetProfit.Total, true)
            </div>
        </div>

        <!-- تنبيهات مهمة -->
        <div class="dash-notices-bar">
            <span class="dash-notices-title"><i class="fas fa-bell" style="color:var(--primary);"></i> <span data-i18n-en="Important Notices">تنبيهات مهمة</span></span>
            <div class="dash-notices-items">
                <a asp-controller="Inventory" asp-action="Index" class="dash-notice-item text-decoration-none">
                    <div class="dash-notice-icon" style="background:#f59e0b;"><i class="fas fa-box"></i></div>
                    <div>
                        <div class="dash-notice-value">@Model.ExpiringProducts.Count</div>
                        <div class="dash-notice-label" data-i18n-en="Products near expiry (30 days)">منتجات قريبة الانتهاء / خلال 30 يوم</div>
                    </div>
                </a>
                <a asp-controller="Customers" asp-action="Index" class="dash-notice-item text-decoration-none">
                    <div class="dash-notice-icon" style="background:#7c3aed;"><i class="fas fa-birthday-cake"></i></div>
                    <div>
                        <div class="dash-notice-value">@Model.UpcomingBirthdays.Count</div>
                        <div class="dash-notice-label" data-i18n-en="Upcoming birthdays (7 days)">أعياد ميلاد قريبة / خلال 7 أيام</div>
                    </div>
                </a>
                <a asp-controller="Employees" asp-action="Index" class="dash-notice-item text-decoration-none">
                    <div class="dash-notice-icon" style="background:#2563eb;"><i class="fas fa-id-card"></i></div>
                    <div>
                        <div class="dash-notice-value">@Model.ExpiringResidencies.Count</div>
                        <div class="dash-notice-label" data-i18n-en="Residencies expiring soon (30 days)">إقامات تنتهي قريباً / خلال 30 يوم</div>
                    </div>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- نطاق الموظف: بياناته الشخصية فقط -->
        <div class="stat-cards">
            <div class="stat-card green">
                <div class="stat-card-header">
                    <span class="stat-label">مبيعاتي اليوم</span>
                    <div class="stat-icon green"><i class="fas fa-dollar-sign"></i></div>
                </div>
                <div class="stat-value">@Model.Sales.Total.ToString("N3") د.ك</div>
                <div class="stat-sub">إجمالي مبيعاتي اليوم (الفعّالة)</div>
            </div>

            <div class="stat-card blue">
                <div class="stat-card-header">
                    <span class="stat-label">عملائي اليوم</span>
                    <div class="stat-icon blue"><i class="fas fa-users"></i></div>
                </div>
                <div class="stat-value">@Model.Customers.Total.ToString("N0")</div>
                <div class="stat-sub">عملاء تمت خدمتهم اليوم</div>
            </div>

            <div class="stat-card" style="border-top:4px solid #9f1239;">
                <div class="stat-card-header">
                    <span class="stat-label">سلفي اليوم</span>
                    <div class="stat-icon" style="background:#fde8ef;color:#9f1239;"><i class="fas fa-hand-holding-usd"></i></div>
                </div>
                <div class="stat-value" style="color:#9f1239;">@Model.Advances.Total.ToString("N3") د.ك</div>
                <div class="stat-sub">سلفي اليوم</div>
            </div>

            <div class="stat-card orange">
                <div class="stat-card-header">
                    <span class="stat-label">صافي ربحي اليوم</span>
                    <div class="stat-icon orange"><i class="fas fa-arrow-up"></i></div>
                </div>
                <div class="stat-value">@Model.NetProfit.Total.ToString("N3") د.ك</div>
                <div class="stat-sub">ربح</div>
            </div>
        </div>
    }
}