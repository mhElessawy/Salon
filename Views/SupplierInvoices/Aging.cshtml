@model Salon.Controllers.AgingReportViewModel
@{
    ViewData["Title"] = "تقرير أعمار الديون";

    string BucketColor(string key) => key switch
    {
        "current" => "#0d6efd",
        "b1_30" => "#d97706",
        "b31_60" => "#f97316",
        "b61_90" => "#dc2626",
        _ => "#7f1d1d"
    };

    string StatusBadge(string status) => status switch
    {
        "غير مدفوعة" => "bg-light text-dark border",
        "مدفوعة جزئيًا" => "bg-warning text-dark",
        "متأخرة" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-hourglass-half me-2"></i>تقرير أعمار الديون</h1>
        <p>تصنيف المستحقات على الموردين حسب عدد أيام التأخير عن الاستحقاق</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع للفواتير</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="fas fa-print me-1"></i> طباعة</button>
    </div>
</div>

<div class="row g-3 mb-3">
    @foreach (var b in Model.Buckets)
    {
        <div class="col-6 col-md-4 col-xl">
            <div class="card border-0 shadow-sm h-100" style="border-right:4px solid @(BucketColor(b.Key)) !important;">
                <div class="card-body">
                    <div class="text-muted small mb-1">@b.Label</div>
                    <div class="fw-bold fs-5" style="color:@(BucketColor(b.Key));">@b.TotalAmount.ToString("N3")</div>
                    <div class="text-muted small">د.ك — @b.Count فاتورة — @b.Percentage.ToString("N1")%</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold mb-0">تفاصيل الفواتير المستحقة</h6>
            <div class="text-muted">الإجمالي: <strong>@Model.GrandTotal.ToString("N3")</strong> د.ك</div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle table-sm">
                <thead>
                    <tr>
                        <th>المورد</th>
                        <th>رقم الفاتورة</th>
                        <th>تاريخ الاستحقاق</th>
                        <th>عدد أيام التأخير</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">لا توجد ديون مستحقة على الموردين</td></tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.SupplierName</td>
                            <td>@r.InvoiceNumber</td>
                            <td>@(r.DueDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>@(r.OverdueDays > 0 ? r.OverdueDays.ToString() : "-")</td>
                            <td class="fw-bold">@r.RemainingAmount.ToString("N3")</td>
                            <td><span class="badge @StatusBadge(r.Status)">@r.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
