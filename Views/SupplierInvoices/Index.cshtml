@model IEnumerable<Salon.Models.SupplierInvoice>
@{
    ViewData["Title"] = "فواتير الموردين الآجلة";
    bool canPay = (bool)(ViewBag.CanPay ?? false);
    bool isManager = (bool)(ViewBag.IsManager ?? false);

    string StatusBadge(string status) => status switch
    {
        "مسودة" => "bg-secondary",
        "غير مدفوعة" => "bg-light text-dark border",
        "مدفوعة جزئيًا" => "bg-warning text-dark",
        "مدفوعة بالكامل" => "bg-success",
        "متأخرة" => "bg-danger",
        "ملغاة" => "bg-dark",
        _ => "bg-secondary"
    };

    (string icon, string color) StatusIconColor(string status) => status switch
    {
        "مسودة" => ("fa-pen", "#6c757d"),
        "غير مدفوعة" => ("fa-exclamation-circle", "#dc2626"),
        "مدفوعة جزئيًا" => ("fa-exclamation-circle", "#d97706"),
        "مدفوعة بالكامل" => ("fa-check-circle", "#198754"),
        "متأخرة" => ("fa-exclamation-triangle", "#dc2626"),
        "ملغاة" => ("fa-ban", "#343a40"),
        _ => ("fa-info-circle", "#6c757d")
    };
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-file-invoice-dollar me-2"></i>فواتير الموردين الآجلة</h1>
        <p>جميع فواتير الموردين المسجلة بنظام الدفع الآجل، مع متابعة المبالغ المستحقة والمدفوعة والمتأخرة</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Statement")" class="btn btn-outline-secondary">
            <i class="fas fa-file-invoice me-1"></i> كشف حساب الموردين
        </a>
        <a href="@Url.Action("Aging")" class="btn btn-outline-secondary">
            <i class="fas fa-hourglass-half me-1"></i> تقرير أعمار الديون
        </a>
        <a href="@Url.Action("Index", "PurchaseRequests")" class="btn btn-outline-secondary">
            <i class="fas fa-shopping-cart me-1"></i> طلبات شراء الموظفين
        </a>
        @if (canPay)
        {
            <button type="button" class="btn btn-primary" onclick="openCreateInvoicePopup()">
                <i class="fas fa-plus me-1"></i> فاتورة مورد جديدة
            </button>
        }
    </div>
</div>

<!-- بطاقات الملخص -->
<div class="row g-3 mb-3 si-summary-cards">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #0d6efd !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">إجمالي عدد الفواتير</div>
                        <div class="fw-bold fs-5" style="color:#0d6efd;">@ViewBag.SummaryTotalCount</div>
                    </div>
                    <i class="fas fa-file-invoice fa-lg" style="color:#0d6efd;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #9a3412 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">إجمالي المبلغ المستحق</div>
                        <div class="fw-bold fs-5" style="color:#9a3412;">@(((decimal)ViewBag.SummaryTotalOutstanding).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryTotalCount فاتورة</div>
                    </div>
                    <i class="fas fa-hand-holding-usd fa-lg" style="color:#9a3412;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #d97706 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">المستحق هذا الشهر</div>
                        <div class="fw-bold fs-5" style="color:#d97706;">@(((decimal)ViewBag.SummaryDueThisMonthAmount).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryDueThisMonthCount فاتورة</div>
                    </div>
                    <i class="fas fa-calendar-day fa-lg" style="color:#d97706;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #dc2626 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">الفواتير المتأخرة</div>
                        <div class="fw-bold fs-5" style="color:#dc2626;">@(((decimal)ViewBag.SummaryOverdueAmount).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryOverdueCount فاتورة</div>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-lg" style="color:#dc2626;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #198754 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">المدفوع هذا الشهر</div>
                        <div class="fw-bold fs-5" style="color:#198754;">@(((decimal)ViewBag.SummaryPaidThisMonthAmount).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryPaidThisMonthCount فاتورة</div>
                    </div>
                    <i class="fas fa-check-circle fa-lg" style="color:#198754;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- الفلترة -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filtersPanel">
                <i class="fas fa-filter me-1"></i> خيارات الفلترة
            </button>
        </div>
        <div class="collapse show" id="filtersPanel">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">المورد</label>
                    <select name="supplierId" class="form-select form-select-sm">
                        <option value="">-- الكل --</option>
                        @foreach (SelectListItem sup in (IEnumerable<SelectListItem>)ViewBag.Suppliers)
                        {
                            <option value="@sup.Value" selected="@(sup.Selected ? "selected" : null)">@sup.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">حالة الفاتورة</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- الكل --</option>
                        @foreach (var s in new[] { "غير مدفوعة", "مدفوعة جزئيًا", "مدفوعة بالكامل", "متأخرة", "مسودة", "ملغاة" })
                        {
                            <option value="@s" selected="@(ViewBag.Status == s ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">من تاريخ</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">إلى تاريخ</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">تاريخ الاستحقاق</label>
                    <input type="date" name="dueDate" class="form-control form-control-sm" value="@(ViewBag.DueDate != null ? ((DateTime)ViewBag.DueDate).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">رقم الفاتورة</label>
                    <input type="text" name="invoiceNumber" class="form-control form-control-sm" value="@ViewBag.InvoiceNumber" />
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search me-1"></i> بحث</button>
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">مسح الفلاتر</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- الجدول (كمبيوتر / تابلت) -->
<div class="card d-none d-md-block">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم المورد</th>
                        <th>رقم الفاتورة</th>
                        <th>تاريخ الفاتورة</th>
                        <th>تاريخ الاستحقاق</th>
                        <th>قيمة الفاتورة</th>
                        <th>المدفوع</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">لا توجد فواتير موردين آجلة</td></tr>
                    }
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td>@inv.Id</td>
                            <td>@(inv.Supplier?.Name ?? "-")</td>
                            <td>
                                @inv.InvoiceNumber
                                @if (!string.IsNullOrEmpty(inv.Reference))
                                {
                                    <div class="text-muted small">@inv.Reference</div>
                                }
                            </td>
                            <td>@inv.InvoiceDate.ToString("yyyy/MM/dd")</td>
                            <td>@(inv.NextDueDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>@inv.TotalAmount.ToString("N3") د.ك</td>
                            <td class="text-success">@inv.PaidAmount.ToString("N3") د.ك</td>
                            <td class="@(inv.RemainingAmount > 0 ? "text-danger fw-bold" : "text-muted")">@inv.RemainingAmount.ToString("N3") د.ك</td>
                            <td><span class="badge @StatusBadge(inv.Status)">@inv.Status</span></td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-xs btn-outline-primary" title="عرض تفاصيل الفاتورة"
                                        data-bs-toggle="modal" data-bs-target="#viewInvoiceModal-@inv.Id">
                                    <i class="fas fa-eye"></i>
                                </button>
                                @if (canPay && inv.IsDraft)
                                {
                                    <form method="post" asp-action="ConfirmDraft" style="display:inline;" onsubmit="return confirm('اعتماد هذه الفاتورة؟ سيتم تحديث المخزون فوراً.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@inv.Id" />
                                        <button type="submit" class="btn btn-xs btn-success" title="اعتماد المسودة"><i class="fas fa-check"></i> اعتماد</button>
                                    </form>
                                }
                                @if (canPay && !inv.IsDraft && !inv.IsCancelled && inv.RemainingAmount > 0)
                                {
                                    <button type="button" class="btn btn-xs btn-primary js-pay-btn" title="تسجيل دفعة"
                                            data-invoice-id="@inv.Id"
                                            data-invoice-supplier="@(inv.Supplier?.Name ?? "-")"
                                            data-invoice-number="@inv.InvoiceNumber"
                                            data-invoice-remaining="@inv.RemainingAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                                        <i class="fas fa-money-bill-wave"></i> دفعة
                                    </button>
                                }
                                @if (isManager && !inv.IsCancelled && !inv.Payments.Any())
                                {
                                    <button type="button" class="btn btn-xs btn-outline-danger js-cancel-btn" title="إلغاء الفاتورة"
                                            data-invoice-id="@inv.Id" data-invoice-number="@inv.InvoiceNumber">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- عرض البطاقات (الجوال) -->
<div class="d-md-none">
    @if (!Model.Any())
    {
        <div class="card"><div class="card-body text-center text-muted py-4">لا توجد فواتير موردين آجلة</div></div>
    }
    @foreach (var inv in Model)
    {
        <div class="card mb-2 si-mobile-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <div class="fw-bold">@(inv.Supplier?.Name ?? "-")</div>
                        <div class="text-muted small">@inv.InvoiceNumber @(!string.IsNullOrEmpty(inv.Reference) ? $"— {inv.Reference}" : "")</div>
                    </div>
                    <span class="badge @StatusBadge(inv.Status)">@inv.Status</span>
                </div>
                <div class="row g-2 small">
                    <div class="col-6"><span class="text-muted">تاريخ الفاتورة:</span> @inv.InvoiceDate.ToString("yyyy/MM/dd")</div>
                    <div class="col-6"><span class="text-muted">الاستحقاق:</span> @(inv.NextDueDate?.ToString("yyyy/MM/dd") ?? "-")</div>
                    <div class="col-6"><span class="text-muted">القيمة:</span> @inv.TotalAmount.ToString("N3") د.ك</div>
                    <div class="col-6"><span class="text-muted">المدفوع:</span> <span class="text-success">@inv.PaidAmount.ToString("N3")</span></div>
                    <div class="col-12"><span class="text-muted">المتبقي:</span> <span class="@(inv.RemainingAmount > 0 ? "text-danger fw-bold" : "text-muted")">@inv.RemainingAmount.ToString("N3") د.ك</span></div>
                </div>
                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <button type="button" class="btn btn-xs btn-outline-primary" title="عرض تفاصيل الفاتورة"
                            data-bs-toggle="modal" data-bs-target="#viewInvoiceModal-@inv.Id">
                        <i class="fas fa-eye"></i> عرض
                    </button>
                    @if (canPay && inv.IsDraft)
                    {
                        <form method="post" asp-action="ConfirmDraft" onsubmit="return confirm('اعتماد هذه الفاتورة؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@inv.Id" />
                            <button type="submit" class="btn btn-xs btn-success"><i class="fas fa-check"></i> اعتماد</button>
                        </form>
                    }
                    @if (canPay && !inv.IsDraft && !inv.IsCancelled && inv.RemainingAmount > 0)
                    {
                        <button type="button" class="btn btn-xs btn-primary js-pay-btn"
                                data-invoice-id="@inv.Id" data-invoice-supplier="@(inv.Supplier?.Name ?? "-")"
                                data-invoice-number="@inv.InvoiceNumber"
                                data-invoice-remaining="@inv.RemainingAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                            <i class="fas fa-money-bill-wave"></i> تسجيل دفعة
                        </button>
                    }
                    @if (isManager && !inv.IsCancelled && !inv.Payments.Any())
                    {
                        <button type="button" class="btn btn-xs btn-outline-danger js-cancel-btn"
                                data-invoice-id="@inv.Id" data-invoice-number="@inv.InvoiceNumber">
                            <i class="fas fa-ban"></i> إلغاء
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Modals: عرض تفاصيل الفاتورة -->
@foreach (var inv in Model)
{
    var (statusIcon, statusColor) = StatusIconColor(inv.Status);
    var orderedInstallments = inv.Installments.OrderBy(i => i.DueDate).ToList();
    <div class="modal fade" id="viewInvoiceModal-@inv.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-file-invoice me-2"></i>
                        فاتورة @inv.InvoiceNumber — @(inv.Supplier?.Name ?? "-")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- بطاقات الملخص -->
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-0 shadow-sm si-view-card">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="text-muted small mb-1">حالة الفاتورة</div>
                                        <span class="badge @StatusBadge(inv.Status)">@inv.Status</span>
                                    </div>
                                    <i class="fas @statusIcon fa-lg" style="color:@statusColor;"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-0 shadow-sm si-view-card">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="text-muted small mb-1">المتبقي</div>
                                        <div class="fw-bold fs-6 @(inv.RemainingAmount > 0 ? "text-danger" : "text-muted")">@inv.RemainingAmount.ToString("N3") د.ك</div>
                                    </div>
                                    <i class="fas fa-chart-pie fa-lg text-primary"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-0 shadow-sm si-view-card">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="text-muted small mb-1">المدفوع</div>
                                        <div class="fw-bold fs-6 text-success">@inv.PaidAmount.ToString("N3") د.ك</div>
                                    </div>
                                    <i class="fas fa-wallet fa-lg text-success"></i>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-0 shadow-sm si-view-card">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="text-muted small mb-1">إجمالي الفاتورة</div>
                                        <div class="fw-bold fs-6">@inv.TotalAmount.ToString("N3") د.ك</div>
                                    </div>
                                    <i class="fas fa-file-invoice fa-lg text-secondary"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- المنتجات -->
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header bg-white fw-bold"><i class="fas fa-boxes me-1 text-muted"></i> المنتجات</div>
                                <div class="card-body p-2">
                                    @if (!inv.Items.Any())
                                    {
                                        <div class="text-muted small text-center py-2">لا توجد منتجات مسجَّلة</div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm mb-0 small">
                                                <thead>
                                                    <tr>
                                                        <th>المنتج</th>
                                                        <th>الكمية</th>
                                                        <th>سعر الوحدة</th>
                                                        <th>الإجمالي</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var it in inv.Items)
                                                    {
                                                        <tr>
                                                            <td>@it.ProductName</td>
                                                            <td>@it.Quantity @it.Unit</td>
                                                            <td>@it.UnitPrice.ToString("N3") د.ك</td>
                                                            <td class="fw-bold">@it.Total.ToString("N3") د.ك</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr>
                                                        <th colspan="3">الإجمالي</th>
                                                        <th>@inv.TotalAmount.ToString("N3") د.ك</th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    }
                                    @if (inv.DiscountAmount > 0)
                                    {
                                        <div class="small mt-1">خصم إجمالي: @inv.DiscountAmount.ToString("N3") د.ك</div>
                                    }
                                    @if (inv.ExtraExpenses > 0)
                                    {
                                        <div class="small mt-1">مصاريف إضافية: @inv.ExtraExpenses.ToString("N3") د.ك</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- معلومات الفاتورة -->
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header bg-white fw-bold"><i class="fas fa-info-circle me-1 text-muted"></i> معلومات الفاتورة</div>
                                <div class="card-body p-2 small">
                                    <div class="d-flex justify-content-between border-bottom py-1"><span class="text-muted">أنشأها</span><span>@inv.CreatedByName</span></div>
                                    <div class="d-flex justify-content-between border-bottom py-1"><span class="text-muted">تاريخ الإنشاء</span><span>@inv.CreatedAt.ToString("yyyy/MM/dd")</span></div>
                                    <div class="d-flex justify-content-between border-bottom py-1"><span class="text-muted">الوقت</span><span>@inv.CreatedAt.ToString("HH:mm")</span></div>
                                    <div class="d-flex justify-content-between border-bottom py-1"><span class="text-muted">رقم الفاتورة</span><span>@inv.InvoiceNumber</span></div>
                                    @if (!string.IsNullOrEmpty(inv.Reference))
                                    {
                                        <div class="d-flex justify-content-between border-bottom py-1"><span class="text-muted">رقم المرجع</span><span>@inv.Reference</span></div>
                                    }
                                    @if (inv.PurchaseRequest != null)
                                    {
                                        <div class="d-flex justify-content-between border-bottom py-1"><span class="text-muted">طلب شراء</span><span>#@inv.PurchaseRequest.Id — @(inv.PurchaseRequest.Employee?.FullName ?? "-")</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(inv.AttachmentPath))
                                    {
                                        <div class="d-flex justify-content-between border-bottom py-1"><span class="text-muted">مرفق</span><a href="@inv.AttachmentPath" target="_blank"><i class="fas fa-paperclip me-1"></i>عرض المرفق</a></div>
                                    }
                                    @if (!string.IsNullOrEmpty(inv.Notes))
                                    {
                                        <div class="py-1"><span class="text-muted d-block">ملاحظات</span>@inv.Notes</div>
                                    }
                                    @if (inv.IsCancelled)
                                    {
                                        <div class="py-1 text-danger"><span class="d-block"><strong>ملغاة:</strong> @inv.CancelledByName — @(inv.CancelledAt?.ToString("yyyy/MM/dd HH:mm"))</span>@(!string.IsNullOrEmpty(inv.CancelReason) ? $"سبب الإلغاء: {inv.CancelReason}" : "")</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- خطة السداد -->
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header bg-white fw-bold"><i class="fas fa-calendar-check me-1 text-muted"></i> خطة السداد</div>
                                <div class="card-body p-2">
                                    @if (!orderedInstallments.Any())
                                    {
                                        <div class="text-muted small text-center py-2">لا توجد خطة سداد مسجَّلة</div>
                                    }
                                    else
                                    {
                                        decimal runningPaid = inv.PaidAmount;
                                        <ul class="list-unstyled si-payment-timeline mb-0">
                                            @foreach (var inst in orderedInstallments)
                                            {
                                                string instIcon; string instColor; string instLabel;
                                                if (runningPaid >= inst.Amount - 0.001m)
                                                {
                                                    instIcon = "fa-check"; instColor = "#198754"; instLabel = "مدفوعة";
                                                }
                                                else if (inst.DueDate.Date < DateTime.Today)
                                                {
                                                    instIcon = "fa-exclamation"; instColor = "#dc2626"; instLabel = "متأخرة";
                                                }
                                                else
                                                {
                                                    instIcon = "fa-clock"; instColor = "#d97706"; instLabel = "مستحقة";
                                                }
                                                runningPaid = Math.Max(0, runningPaid - inst.Amount);
                                                <li class="d-flex align-items-start mb-3">
                                                    <span class="si-timeline-icon me-2" style="background:@instColor;"><i class="fas @instIcon"></i></span>
                                                    <div>
                                                        <div class="fw-bold">@inst.DueDate.ToString("yyyy/MM/dd") — @inst.Amount.ToString("N3") د.ك</div>
                                                        <div class="small" style="color:@instColor;">@instLabel</div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (inv.Payments.Any())
                    {
                        <div class="card mt-3">
                            <div class="card-header bg-white fw-bold"><i class="fas fa-money-check-alt me-1 text-muted"></i> الدفعات المسجَّلة</div>
                            <div class="card-body p-2">
                                <ul class="mb-0 small">
                                    @foreach (var p in inv.Payments.OrderByDescending(p => p.PaymentDate).ThenByDescending(p => p.CreatedAt))
                                    {
                                        <li>
                                            @p.Amount.ToString("N3") د.ك — @p.Source — @p.PaymentDate.ToString("yyyy/MM/dd")
                                            @if (!string.IsNullOrEmpty(p.ReferenceNumber))
                                            {
                                                <text> — مرجع: @p.ReferenceNumber</text>
                                            }
                                            @if (!string.IsNullOrEmpty(p.AttachmentPath))
                                            {
                                                <a href="@p.AttachmentPath" target="_blank" class="ms-1"><i class="fas fa-paperclip"></i></a>
                                            }
                                            <span class="text-muted">(@p.PaidByName — @p.CreatedAt.ToString("HH:mm"))</span>
                                            @if (isManager)
                                            {
                                                <form method="post" asp-action="DeletePayment" asp-controller="SupplierInvoices" style="display:inline;"
                                                      onsubmit="return confirm('حذف هذه الدفعة؟');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@p.Id" />
                                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-1" title="حذف الدفعة"><i class="fas fa-trash"></i></button>
                                                </form>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

@if (canPay)
{
    <!-- Modal تسجيل دفعة -->
    <div class="modal fade" id="payModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#0d6efd;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-money-bill-wave me-2"></i>تسجيل دفعة للمورد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="payForm" method="post" asp-action="RegisterPayment" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="invoiceId" id="payInvoiceId" />
                    <div class="modal-body">
                        <div class="mb-3 p-3 rounded" style="background:#f0f9ff;border:1px solid #bae6fd;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">المورد</span>
                                <strong id="paySupplierName" class="fs-6"></strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted">رقم الفاتورة</span>
                                <strong id="payInvoiceNumber" class="fs-6"></strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted">المتبقي</span>
                                <strong id="payRemaining" class="fs-6 text-danger"></strong>
                                <span class="text-muted small">د.ك</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">مبلغ الدفعة <span class="text-danger">*</span></label>
                            <input type="number" step="0.001" min="0.001" name="amount" id="payAmount" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">تاريخ الدفع</label>
                            <input type="date" name="paymentDate" id="payDate" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">مصدر الدفع <span class="text-danger">*</span></label>
                            <select name="source" id="paySource" class="form-select" required>
                                <option value="الصندوق">الصندوق</option>
                                <option value="البنك">البنك</option>
                                <option value="عهدة">عهدة موظف</option>
                            </select>
                        </div>
                        <div class="mb-3 d-none" id="payCustodyRow">
                            <label class="form-label fw-bold">العهدة <span class="text-danger">*</span></label>
                            <select name="custodyId" id="payCustodyId" class="form-select">
                                <option value="">-- اختر العهدة --</option>
                                @foreach (var c in (IEnumerable<Salon.Models.Custody>)ViewBag.Custodies)
                                {
                                    <option value="@c.Id" data-remaining="@c.RemainingAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                                        @(c.Employee?.FullName ?? "-") — متبقي @c.RemainingAmount.ToString("N3") د.ك
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم المرجع</label>
                            <input type="text" name="referenceNumber" class="form-control" placeholder="رقم التحويل / الإيصال (اختياري)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">مرفق الإيصال</label>
                            <input type="file" name="attachment" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label fw-bold">ملاحظات</label>
                            <textarea name="notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-check me-1"></i> تسجيل الدفعة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal إلغاء فاتورة -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#dc3545;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-ban me-2"></i>إلغاء فاتورة مورد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="CancelInvoice">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="cancelInvoiceId" />
                    <div class="modal-body">
                        <p>سيتم إلغاء الفاتورة رقم <strong id="cancelInvoiceNumber"></strong> وعكس أثرها على المخزون (لو كانت معتمدة). هذا الإجراء غير قابل للتراجع.</p>
                        <label class="form-label fw-bold">سبب الإلغاء</label>
                        <textarea name="reason" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">تراجع</button>
                        <button type="submit" class="btn btn-danger px-4"><i class="fas fa-ban me-1"></i> تأكيد الإلغاء</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

}

@section Scripts {
    <script>
        // ===== فاتورة مورد جديدة (نافذة منبثقة مستقلة) =====
        function openCreateInvoicePopup() {
            var w = 1100, h = 850;
            var left = Math.max(0, (screen.width - w) / 2);
            var top = Math.max(0, (screen.height - h) / 2);
            window.open('@Url.Action("Create")', 'createSupplierInvoicePopup',
                'width=' + w + ',height=' + h + ',left=' + left + ',top=' + top +
                ',resizable=yes,scrollbars=yes,status=no,toolbar=no,menubar=no,location=no');
        }

        // ===== تسجيل دفعة =====
        function openPayModal(id, supplierName, invoiceNumber, remaining) {
            document.getElementById('payInvoiceId').value = id;
            document.getElementById('paySupplierName').textContent = supplierName;
            document.getElementById('payInvoiceNumber').textContent = invoiceNumber;
            document.getElementById('payRemaining').textContent = remaining.toFixed(3);
            document.getElementById('payAmount').max = remaining;
            document.getElementById('payAmount').value = '';
            document.getElementById('paySource').value = 'الصندوق';
            document.getElementById('payCustodyRow').classList.add('d-none');
            document.getElementById('payDate').valueAsDate = new Date();
            new bootstrap.Modal(document.getElementById('payModal')).show();
        }

        document.querySelectorAll('.js-pay-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openPayModal(
                    parseInt(btn.dataset.invoiceId, 10),
                    btn.dataset.invoiceSupplier,
                    btn.dataset.invoiceNumber,
                    parseFloat(btn.dataset.invoiceRemaining)
                );
            });
        });

        var paySourceEl = document.getElementById('paySource');
        if (paySourceEl) {
            paySourceEl.addEventListener('change', function () {
                var isCustody = this.value === 'عهدة';
                document.getElementById('payCustodyRow').classList.toggle('d-none', !isCustody);
            });
        }

        document.querySelectorAll('.js-cancel-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('cancelInvoiceId').value = btn.dataset.invoiceId;
                document.getElementById('cancelInvoiceNumber').textContent = btn.dataset.invoiceNumber;
                new bootstrap.Modal(document.getElementById('cancelModal')).show();
            });
        });

    </script>
    <style>
        .btn-xs {
            padding: 0.15rem 0.4rem;
            font-size: 0.75rem;
        }

        .si-card .card-body {
            padding: 0.9rem 1rem;
        }

        .si-view-card .card-body {
            padding: 0.85rem 1rem;
        }

        .si-payment-timeline {
            position: relative;
        }

        .si-payment-timeline li:not(:last-child) {
            position: relative;
        }

        .si-payment-timeline li:not(:last-child)::before {
            content: "";
            position: absolute;
            top: 26px;
            right: 13px;
            width: 2px;
            height: calc(100% - 6px);
            background: #dee2e6;
        }

        .si-timeline-icon {
            flex-shrink: 0;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 0.7rem;
            z-index: 1;
        }
    </style>
}