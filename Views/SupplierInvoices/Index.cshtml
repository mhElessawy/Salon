@model IEnumerable<Salon.Models.SupplierInvoice>
@using System.Text.Json
@{
    ViewData["Title"] = "فواتير الموردين الآجلة";
    bool canPay = (bool)(ViewBag.CanPay ?? false);
    bool isManager = (bool)(ViewBag.IsManager ?? false);
    var products = ViewBag.Products as List<Salon.Models.Product> ?? new();
    var productsJson = JsonSerializer.Serialize(products.Select(p => new
    {
        id = p.Id,
        name = p.Name,
        unit = p.Unit ?? "",
        purchasePrice = p.PurchasePrice
    }));

    string StatusBadge(string status) => status switch
    {
        "مسودة" => "bg-secondary",
        "غير مدفوعة" => "bg-light text-dark border",
        "مدفوعة جزئيًا" => "bg-warning text-dark",
        "مدفوعة بالكامل" => "bg-success",
        "متأخرة" => "bg-danger",
        "ملغاة" => "bg-dark",
        _ => "bg-secondary"
    };
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-file-invoice-dollar me-2"></i>فواتير الموردين الآجلة</h1>
        <p>جميع فواتير الموردين المسجلة بنظام الدفع الآجل، مع متابعة المبالغ المستحقة والمدفوعة والمتأخرة</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Statement")" class="btn btn-outline-secondary">
            <i class="fas fa-file-invoice me-1"></i> كشف حساب الموردين
        </a>
        <a href="@Url.Action("Aging")" class="btn btn-outline-secondary">
            <i class="fas fa-hourglass-half me-1"></i> تقرير أعمار الديون
        </a>
        <a href="@Url.Action("Index", "PurchaseRequests")" class="btn btn-outline-secondary">
            <i class="fas fa-shopping-cart me-1"></i> طلبات شراء الموظفين
        </a>
        @if (canPay)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createInvoiceModal">
                <i class="fas fa-plus me-1"></i> فاتورة مورد جديدة
            </button>
        }
    </div>
</div>

<!-- بطاقات الملخص -->
<div class="row g-3 mb-3 si-summary-cards">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #0d6efd !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">إجمالي عدد الفواتير</div>
                        <div class="fw-bold fs-5" style="color:#0d6efd;">@ViewBag.SummaryTotalCount</div>
                    </div>
                    <i class="fas fa-file-invoice fa-lg" style="color:#0d6efd;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #9a3412 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">إجمالي المبلغ المستحق</div>
                        <div class="fw-bold fs-5" style="color:#9a3412;">@(((decimal)ViewBag.SummaryTotalOutstanding).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryTotalCount فاتورة</div>
                    </div>
                    <i class="fas fa-hand-holding-usd fa-lg" style="color:#9a3412;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #d97706 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">المستحق هذا الشهر</div>
                        <div class="fw-bold fs-5" style="color:#d97706;">@(((decimal)ViewBag.SummaryDueThisMonthAmount).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryDueThisMonthCount فاتورة</div>
                    </div>
                    <i class="fas fa-calendar-day fa-lg" style="color:#d97706;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #dc2626 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">الفواتير المتأخرة</div>
                        <div class="fw-bold fs-5" style="color:#dc2626;">@(((decimal)ViewBag.SummaryOverdueAmount).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryOverdueCount فاتورة</div>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-lg" style="color:#dc2626;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100 si-card" style="border-right:4px solid #198754 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small mb-1">المدفوع هذا الشهر</div>
                        <div class="fw-bold fs-5" style="color:#198754;">@(((decimal)ViewBag.SummaryPaidThisMonthAmount).ToString("N3"))</div>
                        <div class="text-muted small">د.ك — @ViewBag.SummaryPaidThisMonthCount فاتورة</div>
                    </div>
                    <i class="fas fa-check-circle fa-lg" style="color:#198754;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- الفلترة -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filtersPanel">
                <i class="fas fa-filter me-1"></i> خيارات الفلترة
            </button>
        </div>
        <div class="collapse show" id="filtersPanel">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">المورد</label>
                    <select name="supplierId" class="form-select form-select-sm">
                        <option value="">-- الكل --</option>
                        @foreach (SelectListItem sup in (IEnumerable<SelectListItem>)ViewBag.Suppliers)
                        {
                            <option value="@sup.Value" selected="@(sup.Selected ? "selected" : null)">@sup.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">حالة الفاتورة</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- الكل --</option>
                        @foreach (var s in new[] { "غير مدفوعة", "مدفوعة جزئيًا", "مدفوعة بالكامل", "متأخرة", "مسودة", "ملغاة" })
                        {
                            <option value="@s" selected="@(ViewBag.Status == s ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">من تاريخ</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">إلى تاريخ</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">تاريخ الاستحقاق</label>
                    <input type="date" name="dueDate" class="form-control form-control-sm" value="@(ViewBag.DueDate != null ? ((DateTime)ViewBag.DueDate).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label mb-1 small">رقم الفاتورة</label>
                    <input type="text" name="invoiceNumber" class="form-control form-control-sm" value="@ViewBag.InvoiceNumber" />
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search me-1"></i> بحث</button>
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">مسح الفلاتر</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- الجدول (كمبيوتر / تابلت) -->
<div class="card d-none d-md-block">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم المورد</th>
                        <th>رقم الفاتورة</th>
                        <th>تاريخ الفاتورة</th>
                        <th>تاريخ الاستحقاق</th>
                        <th>قيمة الفاتورة</th>
                        <th>المدفوع</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">لا توجد فواتير موردين آجلة</td></tr>
                    }
                    @foreach (var inv in Model)
                    {
                        var rowId = "inv-" + inv.Id;
                        <tr>
                            <td>@inv.Id</td>
                            <td>@(inv.Supplier?.Name ?? "-")</td>
                            <td>
                                <a href="javascript:void(0)" onclick="toggleDetails('@rowId')" class="text-decoration-none">
                                    @inv.InvoiceNumber <i class="fas fa-chevron-down small text-muted"></i>
                                </a>
                                @if (!string.IsNullOrEmpty(inv.Reference))
                                {
                                    <div class="text-muted small">@inv.Reference</div>
                                }
                            </td>
                            <td>@inv.InvoiceDate.ToString("yyyy/MM/dd")</td>
                            <td>@(inv.NextDueDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>@inv.TotalAmount.ToString("N3") د.ك</td>
                            <td class="text-success">@inv.PaidAmount.ToString("N3") د.ك</td>
                            <td class="@(inv.RemainingAmount > 0 ? "text-danger fw-bold" : "text-muted")">@inv.RemainingAmount.ToString("N3") د.ك</td>
                            <td><span class="badge @StatusBadge(inv.Status)">@inv.Status</span></td>
                            <td class="text-nowrap">
                                @if (canPay && inv.IsDraft)
                                {
                                    <form method="post" asp-action="ConfirmDraft" style="display:inline;" onsubmit="return confirm('اعتماد هذه الفاتورة؟ سيتم تحديث المخزون فوراً.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@inv.Id" />
                                        <button type="submit" class="btn btn-xs btn-success" title="اعتماد المسودة"><i class="fas fa-check"></i> اعتماد</button>
                                    </form>
                                }
                                @if (canPay && !inv.IsDraft && !inv.IsCancelled && inv.RemainingAmount > 0)
                                {
                                    <button type="button" class="btn btn-xs btn-primary js-pay-btn" title="تسجيل دفعة"
                                            data-invoice-id="@inv.Id"
                                            data-invoice-supplier="@(inv.Supplier?.Name ?? "-")"
                                            data-invoice-number="@inv.InvoiceNumber"
                                            data-invoice-remaining="@inv.RemainingAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                                        <i class="fas fa-money-bill-wave"></i> دفعة
                                    </button>
                                }
                                @if (isManager && !inv.IsCancelled && !inv.Payments.Any())
                                {
                                    <button type="button" class="btn btn-xs btn-outline-danger js-cancel-btn" title="إلغاء الفاتورة"
                                            data-invoice-id="@inv.Id" data-invoice-number="@inv.InvoiceNumber">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                        <tr class="d-none" id="@rowId">
                            <td colspan="10" class="bg-light">
                                <div class="p-2">
                                    <div class="row g-3 small">
                                        <div class="col-md-6">
                                            @if (inv.PurchaseRequest != null)
                                            {
                                                <div><strong>نشأت من طلب شراء رقم:</strong> #@inv.PurchaseRequest.Id — @(inv.PurchaseRequest.Employee?.FullName ?? "-")</div>
                                            }
                                            @if (inv.Items.Any())
                                            {
                                                <div class="mt-1">
                                                    <strong>المنتجات:</strong>
                                                    <ul class="mb-0 mt-1">
                                                        @foreach (var it in inv.Items)
                                                        {
                                                            <li>@it.ProductName — @it.Quantity @it.Unit × @it.UnitPrice.ToString("N3") = @it.Total.ToString("N3") د.ك</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            @if (inv.DiscountAmount > 0 || inv.ExtraExpenses > 0)
                                            {
                                                <div class="mt-1">
                                                    @if (inv.DiscountAmount > 0)
                                                    {
                                                        <div>خصم إجمالي: @inv.DiscountAmount.ToString("N3") د.ك</div>
                                                    }
                                                    @if (inv.ExtraExpenses > 0)
                                                    {
                                                        <div>مصاريف إضافية: @inv.ExtraExpenses.ToString("N3") د.ك</div>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(inv.AttachmentPath))
                                            {
                                                <div class="mt-1"><a href="@inv.AttachmentPath" target="_blank"><i class="fas fa-paperclip me-1"></i>مرفق الفاتورة</a></div>
                                            }
                                            @if (!string.IsNullOrEmpty(inv.Notes))
                                            {
                                                <div class="mt-1"><strong>ملاحظات:</strong> @inv.Notes</div>
                                            }
                                            @if (inv.IsCancelled)
                                            {
                                                <div class="mt-1 text-danger"><strong>ملغاة:</strong> @inv.CancelledByName — @(inv.CancelledAt?.ToString("yyyy/MM/dd HH:mm")) @(!string.IsNullOrEmpty(inv.CancelReason) ? $"— {inv.CancelReason}" : "")</div>
                                            }
                                            <div class="mt-1"><strong>أنشأها:</strong> @inv.CreatedByName — @inv.CreatedAt.ToString("HH:mm  yyyy/MM/dd")</div>
                                            @if (inv.Installments.Count > 1)
                                            {
                                                <div class="mt-2">
                                                    <strong>جدول الدفعات المخطَّط:</strong>
                                                    <ul class="mb-0 mt-1">
                                                        @foreach (var inst in inv.Installments.OrderBy(i => i.DueDate))
                                                        {
                                                            <li>@inst.Amount.ToString("N3") د.ك — استحقاق @inst.DueDate.ToString("yyyy/MM/dd")</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-6">
                                            <strong>الدفعات المسجَّلة:</strong>
                                            @if (!inv.Payments.Any())
                                            {
                                                <div class="text-muted mt-1">لا توجد دفعات مسجَّلة بعد</div>
                                            }
                                            else
                                            {
                                                <ul class="mb-0 mt-1">
                                                    @foreach (var p in inv.Payments.OrderByDescending(p => p.PaymentDate).ThenByDescending(p => p.CreatedAt))
                                                    {
                                                        <li>
                                                            @p.Amount.ToString("N3") د.ك — @p.Source — @p.PaymentDate.ToString("yyyy/MM/dd")
                                                            @if (!string.IsNullOrEmpty(p.ReferenceNumber))
                                                            {
                                                                <text> — مرجع: @p.ReferenceNumber</text>
                                                            }
                                                            @if (!string.IsNullOrEmpty(p.AttachmentPath))
                                                            {
                                                                <a href="@p.AttachmentPath" target="_blank" class="ms-1"><i class="fas fa-paperclip"></i></a>
                                                            }
                                                            <span class="text-muted">(@p.PaidByName — @p.CreatedAt.ToString("HH:mm"))</span>
                                                            @if (isManager)
                                                            {
                                                                <form method="post" asp-action="DeletePayment" asp-controller="SupplierInvoices" style="display:inline;"
                                                                      onsubmit="return confirm('حذف هذه الدفعة؟');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@p.Id" />
                                                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-1" title="حذف الدفعة"><i class="fas fa-trash"></i></button>
                                                                </form>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- عرض البطاقات (الجوال) -->
<div class="d-md-none">
    @if (!Model.Any())
    {
        <div class="card"><div class="card-body text-center text-muted py-4">لا توجد فواتير موردين آجلة</div></div>
    }
    @foreach (var inv in Model)
    {
        <div class="card mb-2 si-mobile-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <div class="fw-bold">@(inv.Supplier?.Name ?? "-")</div>
                        <div class="text-muted small">@inv.InvoiceNumber @(!string.IsNullOrEmpty(inv.Reference) ? $"— {inv.Reference}" : "")</div>
                    </div>
                    <span class="badge @StatusBadge(inv.Status)">@inv.Status</span>
                </div>
                <div class="row g-2 small">
                    <div class="col-6"><span class="text-muted">تاريخ الفاتورة:</span> @inv.InvoiceDate.ToString("yyyy/MM/dd")</div>
                    <div class="col-6"><span class="text-muted">الاستحقاق:</span> @(inv.NextDueDate?.ToString("yyyy/MM/dd") ?? "-")</div>
                    <div class="col-6"><span class="text-muted">القيمة:</span> @inv.TotalAmount.ToString("N3") د.ك</div>
                    <div class="col-6"><span class="text-muted">المدفوع:</span> <span class="text-success">@inv.PaidAmount.ToString("N3")</span></div>
                    <div class="col-12"><span class="text-muted">المتبقي:</span> <span class="@(inv.RemainingAmount > 0 ? "text-danger fw-bold" : "text-muted")">@inv.RemainingAmount.ToString("N3") د.ك</span></div>
                </div>
                <div class="d-flex gap-2 mt-2 flex-wrap">
                    @if (canPay && inv.IsDraft)
                    {
                        <form method="post" asp-action="ConfirmDraft" onsubmit="return confirm('اعتماد هذه الفاتورة؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@inv.Id" />
                            <button type="submit" class="btn btn-xs btn-success"><i class="fas fa-check"></i> اعتماد</button>
                        </form>
                    }
                    @if (canPay && !inv.IsDraft && !inv.IsCancelled && inv.RemainingAmount > 0)
                    {
                        <button type="button" class="btn btn-xs btn-primary js-pay-btn"
                                data-invoice-id="@inv.Id" data-invoice-supplier="@(inv.Supplier?.Name ?? "-")"
                                data-invoice-number="@inv.InvoiceNumber"
                                data-invoice-remaining="@inv.RemainingAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                            <i class="fas fa-money-bill-wave"></i> تسجيل دفعة
                        </button>
                    }
                    @if (isManager && !inv.IsCancelled && !inv.Payments.Any())
                    {
                        <button type="button" class="btn btn-xs btn-outline-danger js-cancel-btn"
                                data-invoice-id="@inv.Id" data-invoice-number="@inv.InvoiceNumber">
                            <i class="fas fa-ban"></i> إلغاء
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (canPay)
{
    <!-- Modal تسجيل دفعة -->
    <div class="modal fade" id="payModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#0d6efd;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-money-bill-wave me-2"></i>تسجيل دفعة للمورد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="payForm" method="post" asp-action="RegisterPayment" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="invoiceId" id="payInvoiceId" />
                    <div class="modal-body">
                        <div class="mb-3 p-3 rounded" style="background:#f0f9ff;border:1px solid #bae6fd;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">المورد</span>
                                <strong id="paySupplierName" class="fs-6"></strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted">رقم الفاتورة</span>
                                <strong id="payInvoiceNumber" class="fs-6"></strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted">المتبقي</span>
                                <strong id="payRemaining" class="fs-6 text-danger"></strong>
                                <span class="text-muted small">د.ك</span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">مبلغ الدفعة <span class="text-danger">*</span></label>
                            <input type="number" step="0.001" min="0.001" name="amount" id="payAmount" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">تاريخ الدفع</label>
                            <input type="date" name="paymentDate" id="payDate" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">مصدر الدفع <span class="text-danger">*</span></label>
                            <select name="source" id="paySource" class="form-select" required>
                                <option value="الصندوق">الصندوق</option>
                                <option value="البنك">البنك</option>
                                <option value="عهدة">عهدة موظف</option>
                            </select>
                        </div>
                        <div class="mb-3 d-none" id="payCustodyRow">
                            <label class="form-label fw-bold">العهدة <span class="text-danger">*</span></label>
                            <select name="custodyId" id="payCustodyId" class="form-select">
                                <option value="">-- اختر العهدة --</option>
                                @foreach (var c in (IEnumerable<Salon.Models.Custody>)ViewBag.Custodies)
                                {
                                    <option value="@c.Id" data-remaining="@c.RemainingAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)">
                                        @(c.Employee?.FullName ?? "-") — متبقي @c.RemainingAmount.ToString("N3") د.ك
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم المرجع</label>
                            <input type="text" name="referenceNumber" class="form-control" placeholder="رقم التحويل / الإيصال (اختياري)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">مرفق الإيصال</label>
                            <input type="file" name="attachment" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label fw-bold">ملاحظات</label>
                            <textarea name="notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-check me-1"></i> تسجيل الدفعة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal إلغاء فاتورة -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#dc3545;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-ban me-2"></i>إلغاء فاتورة مورد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="CancelInvoice">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="cancelInvoiceId" />
                    <div class="modal-body">
                        <p>سيتم إلغاء الفاتورة رقم <strong id="cancelInvoiceNumber"></strong> وعكس أثرها على المخزون (لو كانت معتمدة). هذا الإجراء غير قابل للتراجع.</p>
                        <label class="form-label fw-bold">سبب الإلغاء</label>
                        <textarea name="reason" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">تراجع</button>
                        <button type="submit" class="btn btn-danger px-4"><i class="fas fa-ban me-1"></i> تأكيد الإلغاء</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal فاتورة مورد آجلة جديدة -->
    <div class="modal fade" id="createInvoiceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header" style="background:#198754;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-file-invoice-dollar me-2"></i>فاتورة مورد آجلة جديدة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="createInvoiceForm" method="post" asp-action="Create" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isDraft" id="isDraftField" value="false" />
                    <div class="modal-body">

                        <!-- القسم 1: بيانات المورد والفاتورة -->
                        <h6 class="fw-bold text-success"><i class="fas fa-truck me-1"></i> 1. بيانات المورد والفاتورة</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-5">
                                <label class="form-label fw-bold">المورد <span class="text-danger">*</span></label>
                                <div class="d-flex gap-2">
                                    <select name="supplierId" id="createSupplierSelect" class="form-select" required>
                                        <option value="">-- اختر المورد --</option>
                                        @foreach (SelectListItem sup in (IEnumerable<SelectListItem>)ViewBag.Suppliers)
                                        {
                                            <option value="@sup.Value">@sup.Text</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-success text-nowrap" id="btnQuickSupplier" title="إضافة مورد جديد">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                                <div class="d-none mt-2 p-2 border rounded" id="quickSupplierBox">
                                    <input type="text" id="quickSupplierName" class="form-control form-control-sm mb-1" placeholder="اسم المورد" />
                                    <input type="text" id="quickSupplierPhone" class="form-control form-control-sm mb-1" placeholder="رقم الهاتف (اختياري)" />
                                    <button type="button" class="btn btn-success btn-sm" id="btnQuickSupplierSave">حفظ المورد</button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">رقم فاتورة المورد <span class="text-danger">*</span></label>
                                <input type="text" name="invoiceNumber" class="form-control" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">تاريخ الفاتورة</label>
                                <input type="date" name="invoiceDate" id="createInvoiceDate" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">تاريخ الاستحقاق</label>
                                <input type="date" name="dueDate" id="createDueDate" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">المرجع الداخلي</label>
                                <input type="text" class="form-control" value="سيُنشأ تلقائياً بعد الحفظ" disabled />
                            </div>
                        </div>

                        <div class="mb-3 p-3 rounded" style="background:#fff7ed;border:1px solid #fed7aa;">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="splitInstallmentsToggle">
                                <label class="form-check-label fw-bold" for="splitInstallmentsToggle">
                                    تقسيم الفاتورة على أكثر من دفعة مستحقة (كل دفعة بتاريخ استحقاق مستقل)
                                </label>
                            </div>
                            <div class="d-none" id="splitInstallmentsBox">
                                <div id="createInstallmentsRows"></div>
                                <button type="button" class="btn btn-sm btn-outline-warning" id="createAddInstallmentBtn">
                                    <i class="fas fa-plus me-1"></i> إضافة دفعة
                                </button>
                                <div class="small mt-2 d-flex justify-content-between">
                                    <span>إجمالي الدفعات: <strong id="createInstallmentsTotal">0.000</strong> د.ك — قيمة الفاتورة: <strong id="createInstallmentsTarget">0.000</strong> د.ك</span>
                                    <span id="createInstallmentsWarning" class="text-danger d-none">مجموع الدفعات لا يساوي قيمة الفاتورة</span>
                                </div>
                            </div>
                        </div>

                        <!-- القسم 2: تفاصيل المنتجات -->
                        <h6 class="fw-bold text-success"><i class="fas fa-boxes me-1"></i> 2. تفاصيل المنتجات</h6>
                        <div class="table-responsive mb-2">
                            <table class="table table-sm align-middle" id="itemsTable">
                                <thead>
                                    <tr>
                                        <th style="min-width:220px;">المنتج</th>
                                        <th style="width:90px;">الكمية</th>
                                        <th style="width:110px;">الوحدة</th>
                                        <th style="width:120px;">سعر الشراء</th>
                                        <th style="width:110px;">الخصم</th>
                                        <th style="width:110px;">الإجمالي</th>
                                        <th style="width:40px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsBody"></tbody>
                            </table>
                        </div>
                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-success" id="btnAddItemRow"><i class="fas fa-plus me-1"></i> إضافة منتج</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnQuickProduct"><i class="fas fa-box me-1"></i> إضافة منتج جديد للمخزون</button>
                        </div>
                        <div class="d-none p-2 border rounded mb-3" id="quickProductBox">
                            <div class="row g-2">
                                <div class="col-md-3"><input type="text" id="quickProductName" class="form-control form-control-sm" placeholder="اسم المنتج" /></div>
                                <div class="col-md-2"><input type="text" id="quickProductUnit" class="form-control form-control-sm" placeholder="الوحدة" /></div>
                                <div class="col-md-2"><input type="number" step="0.001" id="quickProductPurchase" class="form-control form-control-sm" placeholder="سعر الشراء" /></div>
                                <div class="col-md-2"><input type="number" step="0.001" id="quickProductSale" class="form-control form-control-sm" placeholder="سعر البيع" /></div>
                                <div class="col-md-3"><button type="button" class="btn btn-primary btn-sm w-100" id="btnQuickProductSave">حفظ المنتج وإضافته للجدول</button></div>
                            </div>
                        </div>

                        <!-- القسم 3: ملخص الفاتورة -->
                        <h6 class="fw-bold text-success"><i class="fas fa-calculator me-1"></i> 3. ملخص الفاتورة</h6>
                        <div class="row g-3 mb-2 p-3 rounded" style="background:#f8fafc;border:1px solid #e2e8f0;">
                            <div class="col-6 col-md-3">
                                <label class="form-label small mb-1">إجمالي المنتجات</label>
                                <div class="fw-bold" id="sumItemsSubtotal">0.000 د.ك</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small mb-1">الخصم الإجمالي</label>
                                <input type="number" step="0.001" min="0" name="discountAmount" id="sumDiscountAmount" class="form-control form-control-sm" value="0" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small mb-1">مصاريف إضافية</label>
                                <input type="number" step="0.001" min="0" name="extraExpenses" id="sumExtraExpenses" class="form-control form-control-sm" value="0" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small mb-1">الإجمالي النهائي</label>
                                <div class="fw-bold fs-6 text-success" id="sumFinalTotal">0.000 د.ك</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small mb-1">المدفوع الآن</label>
                                <div class="fw-bold" id="sumPaidNow">0.000 د.ك</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small mb-1">المتبقي</label>
                                <div class="fw-bold text-danger" id="sumRemaining">0.000 د.ك</div>
                            </div>
                            <input type="hidden" name="totalAmount" id="hiddenTotalAmount" value="0" />
                        </div>

                        <!-- القسم 4: طريقة الدفع -->
                        <h6 class="fw-bold text-success"><i class="fas fa-money-check-alt me-1"></i> 4. طريقة الدفع</h6>
                        <div class="mb-2">
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="paymentOption" id="payOptNone" value="none" checked>
                                <label class="btn btn-outline-secondary" for="payOptNone">لم يتم الدفع الآن</label>
                                <input type="radio" class="btn-check" name="paymentOption" id="payOptPartial" value="partial">
                                <label class="btn btn-outline-warning" for="payOptPartial">دفع جزئي الآن</label>
                                <input type="radio" class="btn-check" name="paymentOption" id="payOptFull" value="full">
                                <label class="btn btn-outline-success" for="payOptFull">دفع كامل الآن</label>
                            </div>
                        </div>
                        <div class="row g-3 mb-3 d-none" id="paymentFieldsBox">
                            <div class="col-md-3">
                                <label class="form-label small mb-1">قيمة الدفعة</label>
                                <input type="number" step="0.001" min="0" name="paymentAmount" id="createPaymentAmount" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-1">مصدر الدفع</label>
                                <select name="paymentSource" id="createPaymentSource" class="form-select">
                                    <option value="الصندوق">الصندوق</option>
                                    <option value="البنك">البنك</option>
                                    <option value="عهدة">عهدة موظف</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-none" id="createPaymentCustodyRow">
                                <label class="form-label small mb-1">العهدة</label>
                                <select name="paymentCustodyId" class="form-select">
                                    <option value="">-- اختر العهدة --</option>
                                    @foreach (var c in (IEnumerable<Salon.Models.Custody>)ViewBag.Custodies)
                                    {
                                        <option value="@c.Id">@(c.Employee?.FullName ?? "-") — متبقي @c.RemainingAmount.ToString("N3") د.ك</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-1">تاريخ الدفع</label>
                                <input type="date" name="paymentDate" id="createPaymentDate" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-1">رقم المرجع / إيصال الدفع</label>
                                <input type="text" name="paymentReference" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-1">مرفق إيصال الدفع</label>
                                <input type="file" name="paymentAttachment" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-1">ملاحظات الدفع</label>
                                <input type="text" name="paymentNotes" class="form-control" />
                            </div>
                        </div>

                        <!-- القسم 5: الملاحظات -->
                        <h6 class="fw-bold text-success"><i class="fas fa-sticky-note me-1"></i> 5. ملاحظات عامة</h6>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-outline-success px-3" onclick="document.getElementById('isDraftField').value='true';">
                            <i class="fas fa-save me-1"></i> حفظ كمسودة
                        </button>
                        <button type="submit" class="btn btn-success px-4" onclick="document.getElementById('isDraftField').value='false';">
                            <i class="fas fa-check me-1"></i> حفظ الفاتورة
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var PRODUCTS = @Html.Raw(productsJson);
        var itemRowCounter = 0;

        function toggleDetails(rowId) {
            document.getElementById(rowId).classList.toggle('d-none');
        }

        // ===== تسجيل دفعة =====
        function openPayModal(id, supplierName, invoiceNumber, remaining) {
            document.getElementById('payInvoiceId').value = id;
            document.getElementById('paySupplierName').textContent = supplierName;
            document.getElementById('payInvoiceNumber').textContent = invoiceNumber;
            document.getElementById('payRemaining').textContent = remaining.toFixed(3);
            document.getElementById('payAmount').max = remaining;
            document.getElementById('payAmount').value = '';
            document.getElementById('paySource').value = 'الصندوق';
            document.getElementById('payCustodyRow').classList.add('d-none');
            document.getElementById('payDate').valueAsDate = new Date();
            new bootstrap.Modal(document.getElementById('payModal')).show();
        }

        document.querySelectorAll('.js-pay-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openPayModal(
                    parseInt(btn.dataset.invoiceId, 10),
                    btn.dataset.invoiceSupplier,
                    btn.dataset.invoiceNumber,
                    parseFloat(btn.dataset.invoiceRemaining)
                );
            });
        });

        var paySourceEl = document.getElementById('paySource');
        if (paySourceEl) {
            paySourceEl.addEventListener('change', function () {
                var isCustody = this.value === 'عهدة';
                document.getElementById('payCustodyRow').classList.toggle('d-none', !isCustody);
            });
        }

        document.querySelectorAll('.js-cancel-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('cancelInvoiceId').value = btn.dataset.invoiceId;
                document.getElementById('cancelInvoiceNumber').textContent = btn.dataset.invoiceNumber;
                new bootstrap.Modal(document.getElementById('cancelModal')).show();
            });
        });

        // ===== فاتورة مورد جديدة =====
        var createInvoiceModalEl = document.getElementById('createInvoiceModal');
        if (createInvoiceModalEl) {

            createInvoiceModalEl.addEventListener('show.bs.modal', function () {
                document.getElementById('createInvoiceForm').reset();
                document.getElementById('itemsBody').innerHTML = '';
                document.getElementById('createInstallmentsRows').innerHTML = '';
                document.getElementById('splitInstallmentsBox').classList.add('d-none');
                document.getElementById('createInvoiceDate').valueAsDate = new Date();
                document.getElementById('createDueDate').valueAsDate = new Date();
                document.getElementById('createPaymentDate').valueAsDate = new Date();
                document.getElementById('quickSupplierBox').classList.add('d-none');
                document.getElementById('quickProductBox').classList.add('d-none');
                document.getElementById('paymentFieldsBox').classList.add('d-none');
                addItemRow();
                recalcInvoice();
            });

            document.getElementById('splitInstallmentsToggle').addEventListener('change', function () {
                document.getElementById('splitInstallmentsBox').classList.toggle('d-none', !this.checked);
                if (this.checked && document.querySelectorAll('#createInstallmentsRows tr').length === 0) {
                    addInstallmentRow();
                    addInstallmentRow();
                }
                updateInstallmentsTotal();
            });

            function addInstallmentRow() {
                var row = document.createElement('div');
                row.className = 'row g-2 mb-2 align-items-center';
                row.innerHTML =
                    '<div class="col-5"><input type="number" step="0.001" min="0.001" name="installmentAmount" class="form-control form-control-sm installment-amount" placeholder="المبلغ" /></div>' +
                    '<div class="col-5"><input type="date" name="installmentDueDate" class="form-control form-control-sm" /></div>' +
                    '<div class="col-2"><button type="button" class="btn btn-sm btn-outline-danger installment-remove"><i class="fas fa-times"></i></button></div>';
                document.getElementById('createInstallmentsRows').appendChild(row);
                row.querySelector('.installment-amount').addEventListener('input', updateInstallmentsTotal);
                row.querySelector('.installment-remove').addEventListener('click', function () {
                    row.remove();
                    updateInstallmentsTotal();
                });
            }

            document.getElementById('createAddInstallmentBtn').addEventListener('click', addInstallmentRow);

            function updateInstallmentsTotal() {
                var total = 0;
                document.querySelectorAll('#createInstallmentsRows .installment-amount').forEach(function (input) {
                    total += parseFloat(input.value) || 0;
                });
                var target = parseFloat(document.getElementById('hiddenTotalAmount').value) || 0;
                document.getElementById('createInstallmentsTotal').textContent = total.toFixed(3);
                document.getElementById('createInstallmentsTarget').textContent = target.toFixed(3);
                var mismatch = document.getElementById('splitInstallmentsToggle').checked && Math.abs(total - target) > 0.001;
                document.getElementById('createInstallmentsWarning').classList.toggle('d-none', !mismatch);
            }

            function buildDatalistOptions() {
                return PRODUCTS.map(function (p) { return '<option value="' + p.name.replace(/"/g, '&quot;') + '">'; }).join('');
            }

            // يضيف قائمة تلقائية واحدة للمنتجات (تُستخدم من كل صفوف الجدول)
            if (!document.getElementById('productsDatalist')) {
                var dl = document.createElement('datalist');
                dl.id = 'productsDatalist';
                dl.innerHTML = buildDatalistOptions();
                document.body.appendChild(dl);
            }

            function addItemRow() {
                itemRowCounter++;
                var rowId = 'itemRow' + itemRowCounter;
                var tr = document.createElement('tr');
                tr.id = rowId;
                tr.innerHTML =
                    '<td><input type="hidden" name="itemProductId" class="item-product-id" />' +
                    '<input type="text" name="itemProductName" list="productsDatalist" class="form-control form-control-sm item-product-name" placeholder="اسم المنتج" /></td>' +
                    '<td><input type="number" step="1" min="1" name="itemQuantity" value="1" class="form-control form-control-sm item-qty" /></td>' +
                    '<td><input type="text" name="itemUnit" class="form-control form-control-sm item-unit" /></td>' +
                    '<td><input type="number" step="0.001" min="0" name="itemUnitPrice" value="0" class="form-control form-control-sm item-price" /></td>' +
                    '<td><input type="number" step="0.001" min="0" name="itemDiscount" value="0" class="form-control form-control-sm item-discount" /></td>' +
                    '<td class="item-total fw-bold">0.000</td>' +
                    '<td><button type="button" class="btn btn-sm btn-outline-danger item-remove"><i class="fas fa-times"></i></button></td>';
                document.getElementById('itemsBody').appendChild(tr);

                var nameInput = tr.querySelector('.item-product-name');
                nameInput.addEventListener('input', function () {
                    var match = PRODUCTS.find(function (p) { return p.name === nameInput.value; });
                    if (match) {
                        tr.querySelector('.item-product-id').value = match.id;
                        tr.querySelector('.item-unit').value = match.unit || '';
                        tr.querySelector('.item-price').value = match.purchasePrice.toFixed(3);
                    } else {
                        tr.querySelector('.item-product-id').value = '';
                    }
                    recalcInvoice();
                });

                tr.querySelectorAll('.item-qty, .item-price, .item-discount').forEach(function (input) {
                    input.addEventListener('input', recalcInvoice);
                });

                tr.querySelector('.item-remove').addEventListener('click', function () {
                    tr.remove();
                    recalcInvoice();
                });

                recalcInvoice();
            }

            document.getElementById('btnAddItemRow').addEventListener('click', addItemRow);

            function recalcInvoice() {
                var subtotal = 0;
                document.querySelectorAll('#itemsBody tr').forEach(function (tr) {
                    var qty = parseFloat(tr.querySelector('.item-qty').value) || 0;
                    var price = parseFloat(tr.querySelector('.item-price').value) || 0;
                    var discount = parseFloat(tr.querySelector('.item-discount').value) || 0;
                    var total = Math.max(0, (qty * price) - discount);
                    tr.querySelector('.item-total').textContent = total.toFixed(3);
                    subtotal += total;
                });

                var invDiscount = parseFloat(document.getElementById('sumDiscountAmount').value) || 0;
                var extra = parseFloat(document.getElementById('sumExtraExpenses').value) || 0;
                var finalTotal = Math.max(0, subtotal - invDiscount + extra);

                document.getElementById('sumItemsSubtotal').textContent = subtotal.toFixed(3) + ' د.ك';
                document.getElementById('sumFinalTotal').textContent = finalTotal.toFixed(3) + ' د.ك';
                document.getElementById('hiddenTotalAmount').value = finalTotal.toFixed(3);
                updateInstallmentsTotal();

                var paidNow = 0;
                var opt = document.querySelector('input[name="paymentOption"]:checked').value;
                if (opt === 'full') {
                    paidNow = finalTotal;
                    document.getElementById('createPaymentAmount').value = finalTotal.toFixed(3);
                    document.getElementById('createPaymentAmount').readOnly = true;
                } else if (opt === 'partial') {
                    document.getElementById('createPaymentAmount').readOnly = false;
                    paidNow = parseFloat(document.getElementById('createPaymentAmount').value) || 0;
                } else {
                    document.getElementById('createPaymentAmount').value = '';
                }

                document.getElementById('sumPaidNow').textContent = paidNow.toFixed(3) + ' د.ك';
                document.getElementById('sumRemaining').textContent = Math.max(0, finalTotal - paidNow).toFixed(3) + ' د.ك';
            }

            document.getElementById('sumDiscountAmount').addEventListener('input', recalcInvoice);
            document.getElementById('sumExtraExpenses').addEventListener('input', recalcInvoice);
            document.getElementById('createPaymentAmount').addEventListener('input', recalcInvoice);

            document.querySelectorAll('input[name="paymentOption"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    var opt = this.value;
                    document.getElementById('paymentFieldsBox').classList.toggle('d-none', opt === 'none');
                    recalcInvoice();
                });
            });

            document.getElementById('createPaymentSource').addEventListener('change', function () {
                document.getElementById('createPaymentCustodyRow').classList.toggle('d-none', this.value !== 'عهدة');
            });

            // إضافة مورد جديد من داخل النافذة
            document.getElementById('btnQuickSupplier').addEventListener('click', function () {
                document.getElementById('quickSupplierBox').classList.toggle('d-none');
            });

            document.getElementById('btnQuickSupplierSave').addEventListener('click', function () {
                var name = document.getElementById('quickSupplierName').value.trim();
                if (!name) { alert('اسم المورد مطلوب'); return; }
                var phone = document.getElementById('quickSupplierPhone').value.trim();
                var token = document.querySelector('#createInvoiceForm input[name="__RequestVerificationToken"]').value;
                var body = new URLSearchParams();
                body.append('name', name);
                body.append('phone', phone);
                body.append('__RequestVerificationToken', token);
                fetch('@Url.Action("QuickAddSupplier")', { method: 'POST', body: body })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) { alert(data.message || 'تعذَّر إضافة المورد'); return; }
                        var opt = document.createElement('option');
                        opt.value = data.id;
                        opt.textContent = data.name;
                        opt.selected = true;
                        document.getElementById('createSupplierSelect').appendChild(opt);
                        document.getElementById('quickSupplierBox').classList.add('d-none');
                        document.getElementById('quickSupplierName').value = '';
                        document.getElementById('quickSupplierPhone').value = '';
                    });
            });

            // إضافة منتج جديد من داخل النافذة
            document.getElementById('btnQuickProduct').addEventListener('click', function () {
                document.getElementById('quickProductBox').classList.toggle('d-none');
            });

            document.getElementById('btnQuickProductSave').addEventListener('click', function () {
                var name = document.getElementById('quickProductName').value.trim();
                if (!name) { alert('اسم المنتج مطلوب'); return; }
                var unit = document.getElementById('quickProductUnit').value.trim();
                var purchase = parseFloat(document.getElementById('quickProductPurchase').value) || 0;
                var sale = parseFloat(document.getElementById('quickProductSale').value) || 0;
                var token = document.querySelector('#createInvoiceForm input[name="__RequestVerificationToken"]').value;
                var body = new URLSearchParams();
                body.append('name', name);
                body.append('unit', unit);
                body.append('purchasePrice', purchase);
                body.append('salePrice', sale);
                body.append('__RequestVerificationToken', token);
                fetch('@Url.Action("QuickAddProduct")', { method: 'POST', body: body })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) { alert(data.message || 'تعذَّر إضافة المنتج'); return; }
                        PRODUCTS.push({ id: data.id, name: data.name, unit: data.unit || '', purchasePrice: data.purchasePrice });
                        var dl = document.getElementById('productsDatalist');
                        var opt = document.createElement('option');
                        opt.value = data.name;
                        dl.appendChild(opt);

                        addItemRow();
                        var rows = document.querySelectorAll('#itemsBody tr');
                        var lastRow = rows[rows.length - 1];
                        lastRow.querySelector('.item-product-id').value = data.id;
                        lastRow.querySelector('.item-product-name').value = data.name;
                        lastRow.querySelector('.item-unit').value = data.unit || '';
                        lastRow.querySelector('.item-price').value = data.purchasePrice.toFixed(3);
                        recalcInvoice();

                        document.getElementById('quickProductBox').classList.add('d-none');
                        document.getElementById('quickProductName').value = '';
                        document.getElementById('quickProductUnit').value = '';
                        document.getElementById('quickProductPurchase').value = '';
                        document.getElementById('quickProductSale').value = '';
                    });
            });

            document.getElementById('createInvoiceForm').addEventListener('submit', function (e) {
                var opt = document.querySelector('input[name="paymentOption"]:checked').value;
                if (opt !== 'none') {
                    var total = parseFloat(document.getElementById('hiddenTotalAmount').value) || 0;
                    var amount = parseFloat(document.getElementById('createPaymentAmount').value) || 0;
                    if (amount <= 0) {
                        e.preventDefault();
                        alert('يرجى إدخال قيمة الدفعة');
                        return;
                    }
                    if (amount > total + 0.001) {
                        e.preventDefault();
                        alert('لا يمكن أن تكون الدفعة أكبر من قيمة الفاتورة');
                        return;
                    }
                }

                if (document.getElementById('splitInstallmentsToggle').checked) {
                    var target = parseFloat(document.getElementById('hiddenTotalAmount').value) || 0;
                    var rows = document.querySelectorAll('#createInstallmentsRows .installment-amount');
                    if (rows.length === 0) {
                        e.preventDefault();
                        alert('يرجى إضافة دفعة واحدة على الأقل عند تفعيل التقسيم على دفعات');
                        return;
                    }
                    var sum = 0;
                    rows.forEach(function (input) { sum += parseFloat(input.value) || 0; });
                    if (Math.abs(sum - target) > 0.001) {
                        e.preventDefault();
                        alert('مجموع الدفعات (' + sum.toFixed(3) + ') يجب أن يساوي قيمة الفاتورة (' + target.toFixed(3) + ')');
                        return;
                    }
                }
            });
        }
    </script>
    <style>
        .btn-xs {
            padding: 0.15rem 0.4rem;
            font-size: 0.75rem;
        }

        .si-card .card-body {
            padding: 0.9rem 1rem;
        }
    </style>
}