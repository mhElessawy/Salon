@model Salon.Models.SupplierInvoiceCreateViewModel
@using System.Text.Json
@{
    Layout = null;
    var products = ViewBag.Products as List<Salon.Models.Product> ?? new();
    var productsJson = JsonSerializer.Serialize(products.Select(p => new
    {
        id = p.Id,
        name = p.Name,
        unit = p.Unit ?? "",
        purchasePrice = p.PurchasePrice
    }));
    bool splitOn = Model.Installments.Any();
    bool showPaymentFields = Model.PaymentOption != "none";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>فاتورة مورد آجلة جديدة</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/salon.css" asp-append-version="true" />
    <style>
        body {
            background: #f1f3f5;
        }

        .popup-header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #198754;
            color: #fff;
            padding: 14px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .popup-footer {
            position: sticky;
            bottom: 0;
            background: #fff;
            border-top: 1px solid #dee2e6;
            padding: 12px 20px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .popup-body {
            padding: 20px;
            max-width: 1100px;
            margin: 0 auto;
        }
    </style>
</head>
<body>
    <div class="popup-header">
        <h5 class="mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>فاتورة مورد آجلة جديدة</h5>
        <button type="button" class="btn-close btn-close-white" onclick="window.close();" aria-label="إغلاق"></button>
    </div>

    <div class="popup-body">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <form id="createInvoiceForm" method="post" asp-action="Create" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="isDraft" id="isDraftField" value="@(Model.IsDraft ? "true" : "false")" />

            <!-- القسم 1: بيانات المورد والفاتورة -->
            <h6 class="fw-bold text-success"><i class="fas fa-truck me-1"></i> 1. بيانات المورد والفاتورة</h6>
            <div class="row g-3 mb-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold">المورد <span class="text-danger">*</span></label>
                    <div class="d-flex gap-2">
                        <select name="supplierId" id="createSupplierSelect" class="form-select" required>
                            <option value="">-- اختر المورد --</option>
                            @foreach (SelectListItem sup in (IEnumerable<SelectListItem>)ViewBag.Suppliers)
                            {
                                <option value="@sup.Value" selected="@(sup.Selected ? "selected" : null)">@sup.Text</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-success text-nowrap" id="btnQuickSupplier" title="إضافة مورد جديد">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <div class="d-none mt-2 p-2 border rounded" id="quickSupplierBox">
                        <input type="text" id="quickSupplierName" class="form-control form-control-sm mb-1" placeholder="اسم المورد" />
                        <input type="text" id="quickSupplierPhone" class="form-control form-control-sm mb-1" placeholder="رقم الهاتف (اختياري)" />
                        <button type="button" class="btn btn-success btn-sm" id="btnQuickSupplierSave">حفظ المورد</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">رقم فاتورة المورد <span class="text-danger">*</span></label>
                    <input type="text" name="invoiceNumber" class="form-control" value="@Model.InvoiceNumber" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">تاريخ الفاتورة</label>
                    <input type="date" name="invoiceDate" id="createInvoiceDate" class="form-control" value="@Model.InvoiceDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">تاريخ الاستحقاق</label>
                    <input type="date" name="dueDate" id="createDueDate" class="form-control" value="@Model.DueDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">المرجع الداخلي</label>
                    <input type="text" class="form-control" value="سيُنشأ تلقائياً بعد الحفظ" disabled />
                </div>
            </div>

            <div class="mb-3 p-3 rounded" style="background:#fff7ed;border:1px solid #fed7aa;">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="splitInstallmentsToggle" checked="@(splitOn ? "checked" : null)">
                    <label class="form-check-label fw-bold" for="splitInstallmentsToggle">
                        تقسيم الفاتورة على أكثر من دفعة مستحقة (كل دفعة بتاريخ استحقاق مستقل)
                    </label>
                </div>
                <div class="@(splitOn ? "" : "d-none")" id="splitInstallmentsBox">
                    <div id="createInstallmentsRows">
                        @foreach (var inst in Model.Installments)
                        {
                            <div class="row g-2 mb-2 align-items-center installment-row">
                                <div class="col-5"><input type="number" step="0.001" min="0.001" name="installmentAmount" class="form-control form-control-sm installment-amount" placeholder="المبلغ" value="@inst.Amount.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)" /></div>
                                <div class="col-5"><input type="date" name="installmentDueDate" class="form-control form-control-sm" value="@(inst.DueDate?.ToString("yyyy-MM-dd"))" /></div>
                                <div class="col-2"><button type="button" class="btn btn-sm btn-outline-danger installment-remove"><i class="fas fa-times"></i></button></div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-warning" id="createAddInstallmentBtn">
                        <i class="fas fa-plus me-1"></i> إضافة دفعة
                    </button>
                    <div class="small mt-2 d-flex justify-content-between">
                        <span>إجمالي الدفعات: <strong id="createInstallmentsTotal">0.000</strong> د.ك — قيمة الفاتورة: <strong id="createInstallmentsTarget">0.000</strong> د.ك</span>
                        <span id="createInstallmentsWarning" class="text-danger d-none">مجموع الدفعات لا يساوي قيمة الفاتورة</span>
                    </div>
                </div>
            </div>

            <!-- القسم 2: تفاصيل المنتجات -->
            <h6 class="fw-bold text-success"><i class="fas fa-boxes me-1"></i> 2. تفاصيل المنتجات</h6>
            <div class="table-responsive mb-2">
                <table class="table table-sm align-middle" id="itemsTable">
                    <thead>
                        <tr>
                            <th style="min-width:220px;">المنتج</th>
                            <th style="width:140px;">الكمية</th>
                            <th style="width:110px;">الوحدة</th>
                            <th style="width:120px;">سعر الشراء</th>
                            <th style="width:110px;">الخصم</th>
                            <th style="width:110px;">الإجمالي</th>
                            <th style="width:40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" name="itemProductId" class="item-product-id" value="@item.ProductId" />
                                    <input type="text" name="itemProductName" list="productsDatalist" class="form-control form-control-sm item-product-name" placeholder="اسم المنتج" value="@item.ProductName" />
                                </td>
                                <td><input type="number" step="1" min="1" name="itemQuantity" value="@item.Quantity" class="form-control form-control-sm item-qty" /></td>
                                <td><input type="text" name="itemUnit" class="form-control form-control-sm item-unit" value="@item.Unit" /></td>
                                <td><input type="number" step="0.001" min="0" name="itemUnitPrice" value="@item.UnitPrice.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm item-price" /></td>
                                <td><input type="number" step="0.001" min="0" name="itemDiscount" value="@item.Discount.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm item-discount" /></td>
                                <td class="item-total fw-bold">0.000</td>
                                <td><button type="button" class="btn btn-sm btn-outline-danger item-remove"><i class="fas fa-times"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 mb-3">
                <button type="button" class="btn btn-sm btn-outline-success" id="btnAddItemRow"><i class="fas fa-plus me-1"></i> إضافة منتج</button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnQuickProduct"><i class="fas fa-box me-1"></i> إضافة منتج جديد للمخزون</button>
            </div>
            <div class="d-none p-2 border rounded mb-3" id="quickProductBox">
                <div class="row g-2">
                    <div class="col-md-3"><input type="text" id="quickProductName" class="form-control form-control-sm" placeholder="اسم المنتج" /></div>
                    <div class="col-md-2"><input type="text" id="quickProductUnit" class="form-control form-control-sm" placeholder="الوحدة" /></div>
                    <div class="col-md-2"><input type="number" step="0.001" id="quickProductPurchase" class="form-control form-control-sm" placeholder="سعر الشراء" /></div>
                    <div class="col-md-2"><input type="number" step="0.001" id="quickProductSale" class="form-control form-control-sm" placeholder="سعر البيع" /></div>
                    <div class="col-md-3"><button type="button" class="btn btn-primary btn-sm w-100" id="btnQuickProductSave">حفظ المنتج وإضافته للجدول</button></div>
                </div>
            </div>

            <!-- القسم 3: ملخص الفاتورة -->
            <h6 class="fw-bold text-success"><i class="fas fa-calculator me-1"></i> 3. ملخص الفاتورة</h6>
            <div class="row g-3 mb-2 p-3 rounded" style="background:#f8fafc;border:1px solid #e2e8f0;">
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">إجمالي المنتجات</label>
                    <div class="fw-bold" id="sumItemsSubtotal">0.000 د.ك</div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">الخصم الإجمالي</label>
                    <input type="number" step="0.001" min="0" name="discountAmount" id="sumDiscountAmount" class="form-control form-control-sm" value="@Model.DiscountAmount.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">مصاريف إضافية</label>
                    <input type="number" step="0.001" min="0" name="extraExpenses" id="sumExtraExpenses" class="form-control form-control-sm" value="@Model.ExtraExpenses.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">الإجمالي النهائي</label>
                    <div class="fw-bold fs-6 text-success" id="sumFinalTotal">0.000 د.ك</div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">المدفوع الآن</label>
                    <div class="fw-bold" id="sumPaidNow">0.000 د.ك</div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">المتبقي</label>
                    <div class="fw-bold text-danger" id="sumRemaining">0.000 د.ك</div>
                </div>
                <input type="hidden" name="totalAmount" id="hiddenTotalAmount" value="0" />
            </div>

            <!-- القسم 4: طريقة الدفع -->
            <h6 class="fw-bold text-success"><i class="fas fa-money-check-alt me-1"></i> 4. طريقة الدفع</h6>
            <div class="mb-2">
                <div class="btn-group w-100" role="group">
                    <input type="radio" class="btn-check" name="paymentOption" id="payOptNone" value="none" checked="@(Model.PaymentOption == "none" ? "checked" : null)">
                    <label class="btn btn-outline-secondary" for="payOptNone">لم يتم الدفع الآن</label>
                    <input type="radio" class="btn-check" name="paymentOption" id="payOptPartial" value="partial" checked="@(Model.PaymentOption == "partial" ? "checked" : null)">
                    <label class="btn btn-outline-warning" for="payOptPartial">دفع جزئي الآن</label>
                    <input type="radio" class="btn-check" name="paymentOption" id="payOptFull" value="full" checked="@(Model.PaymentOption == "full" ? "checked" : null)">
                    <label class="btn btn-outline-success" for="payOptFull">دفع كامل الآن</label>
                </div>
            </div>
            <div class="row g-3 mb-3 @(showPaymentFields ? "" : "d-none")" id="paymentFieldsBox">
                <div class="col-md-3">
                    <label class="form-label small mb-1">قيمة الدفعة</label>
                    <input type="number" step="0.001" min="0" name="paymentAmount" id="createPaymentAmount" class="form-control" value="@Model.PaymentAmount" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">مصدر الدفع</label>
                    <select name="paymentSource" id="createPaymentSource" class="form-select">
                        <option value="الصندوق" selected="@(Model.PaymentSource == "الصندوق" ? "selected" : null)">الصندوق</option>
                        <option value="البنك" selected="@(Model.PaymentSource == "البنك" ? "selected" : null)">البنك</option>
                        <option value="عهدة" selected="@(Model.PaymentSource == "عهدة" ? "selected" : null)">عهدة موظف</option>
                    </select>
                </div>
                <div class="col-md-3 @(Model.PaymentSource == "عهدة" ? "" : "d-none")" id="createPaymentCustodyRow">
                    <label class="form-label small mb-1">العهدة</label>
                    <select name="paymentCustodyId" class="form-select">
                        <option value="">-- اختر العهدة --</option>
                        @foreach (var c in (IEnumerable<Salon.Models.Custody>)ViewBag.Custodies)
                        {
                            <option value="@c.Id" selected="@(Model.PaymentCustodyId == c.Id ? "selected" : null)">@(c.Employee?.FullName ?? "-") — متبقي @c.RemainingAmount.ToString("N3") د.ك</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">تاريخ الدفع</label>
                    <input type="date" name="paymentDate" id="createPaymentDate" class="form-control" value="@(Model.PaymentDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">رقم المرجع / إيصال الدفع</label>
                    <input type="text" name="paymentReference" class="form-control" value="@Model.PaymentReference" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">مرفق إيصال الدفع</label>
                    <input type="file" name="paymentAttachment" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">ملاحظات الدفع</label>
                    <input type="text" name="paymentNotes" class="form-control" value="@Model.PaymentNotes" />
                </div>
            </div>

            <!-- القسم 5: الملاحظات -->
            <h6 class="fw-bold text-success"><i class="fas fa-sticky-note me-1"></i> 5. ملاحظات عامة</h6>
            <textarea name="notes" class="form-control mb-3" rows="2">@Model.Notes</textarea>

            <div class="popup-footer">
                <button type="button" class="btn btn-secondary" onclick="window.close();">إلغاء</button>
                <button type="submit" class="btn btn-outline-success px-3" onclick="document.getElementById('isDraftField').value='true';">
                    <i class="fas fa-save me-1"></i> حفظ كمسودة
                </button>
                <button type="submit" class="btn btn-success px-4" onclick="document.getElementById('isDraftField').value='false';">
                    <i class="fas fa-check me-1"></i> حفظ الفاتورة
                </button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        var PRODUCTS = @Html.Raw(productsJson);
        var itemRowCounter = 0;

        function buildDatalistOptions() {
            return PRODUCTS.map(function (p) { return '<option value="' + p.name.replace(/"/g, '&quot;') + '">'; }).join('');
        }

        if (!document.getElementById('productsDatalist')) {
            var dl = document.createElement('datalist');
            dl.id = 'productsDatalist';
            dl.innerHTML = buildDatalistOptions();
            document.body.appendChild(dl);
        }

        function attachItemRowHandlers(tr) {
            var nameInput = tr.querySelector('.item-product-name');
            nameInput.addEventListener('input', function () {
                var match = PRODUCTS.find(function (p) { return p.name === nameInput.value; });
                if (match) {
                    tr.querySelector('.item-product-id').value = match.id;
                    tr.querySelector('.item-unit').value = match.unit || '';
                    tr.querySelector('.item-price').value = match.purchasePrice.toFixed(3);
                } else {
                    tr.querySelector('.item-product-id').value = '';
                }
                recalcInvoice();
            });

            tr.querySelectorAll('.item-qty, .item-price, .item-discount').forEach(function (input) {
                input.addEventListener('input', recalcInvoice);
            });

            tr.querySelector('.item-remove').addEventListener('click', function () {
                tr.remove();
                recalcInvoice();
            });
        }

        function addItemRow() {
            itemRowCounter++;
            var rowId = 'itemRow' + itemRowCounter;
            var tr = document.createElement('tr');
            tr.id = rowId;
            tr.innerHTML =
                '<td><input type="hidden" name="itemProductId" class="item-product-id" />' +
                '<input type="text" name="itemProductName" list="productsDatalist" class="form-control form-control-sm item-product-name" placeholder="اسم المنتج" /></td>' +
                '<td><input type="number" step="1" min="1" name="itemQuantity" value="1" class="form-control form-control-sm item-qty" /></td>' +
                '<td><input type="text" name="itemUnit" class="form-control form-control-sm item-unit" /></td>' +
                '<td><input type="number" step="0.001" min="0" name="itemUnitPrice" value="0" class="form-control form-control-sm item-price" /></td>' +
                '<td><input type="number" step="0.001" min="0" name="itemDiscount" value="0" class="form-control form-control-sm item-discount" /></td>' +
                '<td class="item-total fw-bold">0.000</td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger item-remove"><i class="fas fa-times"></i></button></td>';
            document.getElementById('itemsBody').appendChild(tr);
            attachItemRowHandlers(tr);
            recalcInvoice();
        }

        document.getElementById('btnAddItemRow').addEventListener('click', addItemRow);

        function attachInstallmentRowHandlers(row) {
            row.querySelector('.installment-amount').addEventListener('input', updateInstallmentsTotal);
            row.querySelector('.installment-remove').addEventListener('click', function () {
                row.remove();
                updateInstallmentsTotal();
            });
        }

        function addInstallmentRow() {
            var row = document.createElement('div');
            row.className = 'row g-2 mb-2 align-items-center installment-row';
            row.innerHTML =
                '<div class="col-5"><input type="number" step="0.001" min="0.001" name="installmentAmount" class="form-control form-control-sm installment-amount" placeholder="المبلغ" /></div>' +
                '<div class="col-5"><input type="date" name="installmentDueDate" class="form-control form-control-sm" /></div>' +
                '<div class="col-2"><button type="button" class="btn btn-sm btn-outline-danger installment-remove"><i class="fas fa-times"></i></button></div>';
            document.getElementById('createInstallmentsRows').appendChild(row);
            attachInstallmentRowHandlers(row);
        }

        document.getElementById('createAddInstallmentBtn').addEventListener('click', addInstallmentRow);

        document.getElementById('splitInstallmentsToggle').addEventListener('change', function () {
            document.getElementById('splitInstallmentsBox').classList.toggle('d-none', !this.checked);
            if (this.checked && document.querySelectorAll('#createInstallmentsRows .installment-row').length === 0) {
                addInstallmentRow();
                addInstallmentRow();
            }
            updateInstallmentsTotal();
        });

        function updateInstallmentsTotal() {
            var total = 0;
            document.querySelectorAll('#createInstallmentsRows .installment-amount').forEach(function (input) {
                total += parseFloat(input.value) || 0;
            });
            var target = parseFloat(document.getElementById('hiddenTotalAmount').value) || 0;
            document.getElementById('createInstallmentsTotal').textContent = total.toFixed(3);
            document.getElementById('createInstallmentsTarget').textContent = target.toFixed(3);
            var mismatch = document.getElementById('splitInstallmentsToggle').checked && Math.abs(total - target) > 0.001;
            document.getElementById('createInstallmentsWarning').classList.toggle('d-none', !mismatch);
        }

        function recalcInvoice() {
            var subtotal = 0;
            document.querySelectorAll('#itemsBody tr').forEach(function (tr) {
                var qty = parseFloat(tr.querySelector('.item-qty').value) || 0;
                var price = parseFloat(tr.querySelector('.item-price').value) || 0;
                var discount = parseFloat(tr.querySelector('.item-discount').value) || 0;
                var total = Math.max(0, (qty * price) - discount);
                tr.querySelector('.item-total').textContent = total.toFixed(3);
                subtotal += total;
            });

            var invDiscount = parseFloat(document.getElementById('sumDiscountAmount').value) || 0;
            var extra = parseFloat(document.getElementById('sumExtraExpenses').value) || 0;
            var finalTotal = Math.max(0, subtotal - invDiscount + extra);

            document.getElementById('sumItemsSubtotal').textContent = subtotal.toFixed(3) + ' د.ك';
            document.getElementById('sumFinalTotal').textContent = finalTotal.toFixed(3) + ' د.ك';
            document.getElementById('hiddenTotalAmount').value = finalTotal.toFixed(3);
            updateInstallmentsTotal();

            var paidNow = 0;
            var opt = document.querySelector('input[name="paymentOption"]:checked').value;
            if (opt === 'full') {
                paidNow = finalTotal;
                document.getElementById('createPaymentAmount').value = finalTotal.toFixed(3);
                document.getElementById('createPaymentAmount').readOnly = true;
            } else if (opt === 'partial') {
                document.getElementById('createPaymentAmount').readOnly = false;
                paidNow = parseFloat(document.getElementById('createPaymentAmount').value) || 0;
            } else {
                document.getElementById('createPaymentAmount').readOnly = false;
            }

            document.getElementById('sumPaidNow').textContent = paidNow.toFixed(3) + ' د.ك';
            document.getElementById('sumRemaining').textContent = Math.max(0, finalTotal - paidNow).toFixed(3) + ' د.ك';
        }

        document.getElementById('sumDiscountAmount').addEventListener('input', recalcInvoice);
        document.getElementById('sumExtraExpenses').addEventListener('input', recalcInvoice);
        document.getElementById('createPaymentAmount').addEventListener('input', recalcInvoice);

        document.querySelectorAll('input[name="paymentOption"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                var opt = this.value;
                document.getElementById('paymentFieldsBox').classList.toggle('d-none', opt === 'none');
                recalcInvoice();
            });
        });

        document.getElementById('createPaymentSource').addEventListener('change', function () {
            document.getElementById('createPaymentCustodyRow').classList.toggle('d-none', this.value !== 'عهدة');
        });

        // إضافة مورد جديد من داخل النافذة
        document.getElementById('btnQuickSupplier').addEventListener('click', function () {
            document.getElementById('quickSupplierBox').classList.toggle('d-none');
        });

        document.getElementById('btnQuickSupplierSave').addEventListener('click', function () {
            var name = document.getElementById('quickSupplierName').value.trim();
            if (!name) { alert('اسم المورد مطلوب'); return; }
            var phone = document.getElementById('quickSupplierPhone').value.trim();
            var token = document.querySelector('#createInvoiceForm input[name="__RequestVerificationToken"]').value;
            var body = new URLSearchParams();
            body.append('name', name);
            body.append('phone', phone);
            body.append('__RequestVerificationToken', token);
            fetch('@Url.Action("QuickAddSupplier")', { method: 'POST', body: body })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data.success) { alert(data.message || 'تعذَّر إضافة المورد'); return; }
                    var opt = document.createElement('option');
                    opt.value = data.id;
                    opt.textContent = data.name;
                    opt.selected = true;
                    document.getElementById('createSupplierSelect').appendChild(opt);
                    document.getElementById('quickSupplierBox').classList.add('d-none');
                    document.getElementById('quickSupplierName').value = '';
                    document.getElementById('quickSupplierPhone').value = '';
                });
        });

        // إضافة منتج جديد من داخل النافذة
        document.getElementById('btnQuickProduct').addEventListener('click', function () {
            document.getElementById('quickProductBox').classList.toggle('d-none');
        });

        document.getElementById('btnQuickProductSave').addEventListener('click', function () {
            var name = document.getElementById('quickProductName').value.trim();
            if (!name) { alert('اسم المنتج مطلوب'); return; }
            var unit = document.getElementById('quickProductUnit').value.trim();
            var purchase = parseFloat(document.getElementById('quickProductPurchase').value) || 0;
            var sale = parseFloat(document.getElementById('quickProductSale').value) || 0;
            var token = document.querySelector('#createInvoiceForm input[name="__RequestVerificationToken"]').value;
            var body = new URLSearchParams();
            body.append('name', name);
            body.append('unit', unit);
            body.append('purchasePrice', purchase);
            body.append('salePrice', sale);
            body.append('__RequestVerificationToken', token);
            fetch('@Url.Action("QuickAddProduct")', { method: 'POST', body: body })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data.success) { alert(data.message || 'تعذَّر إضافة المنتج'); return; }
                    PRODUCTS.push({ id: data.id, name: data.name, unit: data.unit || '', purchasePrice: data.purchasePrice });
                    var dl = document.getElementById('productsDatalist');
                    var opt = document.createElement('option');
                    opt.value = data.name;
                    dl.appendChild(opt);

                    addItemRow();
                    var rows = document.querySelectorAll('#itemsBody tr');
                    var lastRow = rows[rows.length - 1];
                    lastRow.querySelector('.item-product-id').value = data.id;
                    lastRow.querySelector('.item-product-name').value = data.name;
                    lastRow.querySelector('.item-unit').value = data.unit || '';
                    lastRow.querySelector('.item-price').value = data.purchasePrice.toFixed(3);
                    recalcInvoice();

                    document.getElementById('quickProductBox').classList.add('d-none');
                    document.getElementById('quickProductName').value = '';
                    document.getElementById('quickProductUnit').value = '';
                    document.getElementById('quickProductPurchase').value = '';
                    document.getElementById('quickProductSale').value = '';
                });
        });

        document.getElementById('createInvoiceForm').addEventListener('submit', function (e) {
            var opt = document.querySelector('input[name="paymentOption"]:checked').value;
            if (opt !== 'none') {
                var total = parseFloat(document.getElementById('hiddenTotalAmount').value) || 0;
                var amount = parseFloat(document.getElementById('createPaymentAmount').value) || 0;
                if (amount <= 0) {
                    e.preventDefault();
                    alert('يرجى إدخال قيمة الدفعة');
                    return;
                }
                if (amount > total + 0.001) {
                    e.preventDefault();
                    alert('لا يمكن أن تكون الدفعة أكبر من قيمة الفاتورة');
                    return;
                }
            }

            if (document.getElementById('splitInstallmentsToggle').checked) {
                var target = parseFloat(document.getElementById('hiddenTotalAmount').value) || 0;
                var rows = document.querySelectorAll('#createInstallmentsRows .installment-amount');
                if (rows.length === 0) {
                    e.preventDefault();
                    alert('يرجى إضافة دفعة واحدة على الأقل عند تفعيل التقسيم على دفعات');
                    return;
                }
                var sum = 0;
                rows.forEach(function (input) { sum += parseFloat(input.value) || 0; });
                if (Math.abs(sum - target) > 0.001) {
                    e.preventDefault();
                    alert('مجموع الدفعات (' + sum.toFixed(3) + ') يجب أن يساوي قيمة الفاتورة (' + target.toFixed(3) + ')');
                    return;
                }
            }
        });

        // تهيئة أولية عند فتح الصفحة
        document.querySelectorAll('#itemsBody tr').forEach(attachItemRowHandlers);
        document.querySelectorAll('#createInstallmentsRows .installment-row').forEach(attachInstallmentRowHandlers);
        if (document.querySelectorAll('#itemsBody tr').length === 0) {
            addItemRow();
        }
        recalcInvoice();
    </script>
</body>
</html>
