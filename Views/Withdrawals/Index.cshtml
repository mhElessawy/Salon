@model IEnumerable<Salon.Models.Withdrawal>
@{
    ViewData["Title"] = "السحوبات";
    var userDept = ViewBag.UserDepartment as string;
    var filterDept = ViewBag.FilterDept as string;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-hand-holding-usd me-2" style="color:#dc2626;"></i>السحوبات</h1>
        <p>إجمالي: <strong class="text-danger">@ViewBag.Total?.ToString("N3") د.ك</strong></p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-danger">
        <i class="fas fa-plus me-1"></i> إضافة سحب
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">من:</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:180px;" />
            <label class="form-label mb-0">إلى:</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:180px;" />
            @if (userDept != "حلاقة" && userDept != "مساج")
            {
                <label class="form-label mb-0">القسم:</label>
                <select name="dept" class="form-select" style="max-width:160px;">
                    <option value="">الكل</option>
                    <option value="حلاقة" selected="@(filterDept == "حلاقة" ? "selected" : null)">حلاقة</option>
                    <option value="مساج" selected="@(filterDept == "مساج" ? "selected" : null)">مساج</option>
                </select>
            }
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-undo"></i></a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>القسم</th>
                        <th>البيان</th>
                        <th>السبب</th>
                        <th>المبلغ</th>
                        <th>التاريخ</th>
                        <th>ملاحظات</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد سحوبات في هذا اليوم</td></tr>
                    }
                    @foreach (var w in Model)
                    {
                        <tr>
                            <td>@w.Id</td>
                            <td>
                                @if (w.Department == "حلاقة")
                                {
                                    <span class="badge" style="background:#F7941D">حلاقة</span>
                                }
                                else if (w.Department == "مساج")
                                {
                                    <span class="badge bg-info">مساج</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>@w.Description</td>
                            <td>@(w.Reason ?? "-")</td>
                            <td><strong class="text-danger">@w.Amount.ToString("N3") د.ك</strong></td>
                            <td>@w.WithdrawalDate.ToString("yyyy/MM/dd")</td>
                            <td class="text-muted small">@w.Notes</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = w.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        onclick="confirmDelete(@w.Id, '@Html.Raw(w.Description.Replace("'", "\\'"))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">الإجمالي</td>
                            <td class="text-danger">@ViewBag.Total?.ToString("N3") د.ك</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف السحب:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}