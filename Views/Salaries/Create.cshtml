@{
    ViewData["Title"] = "إضافة راتب";
}

<div class="page-header">
    <h1><i class="fas fa-plus-circle me-2"></i>إضافة راتب موظف</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">الموظف</label>
                    <select name="EmployeeId" asp-items="@ViewBag.Employees" class="form-select" onchange="loadSalary(this)">
                        <option value="">-- اختر الموظف --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">الشهر</label>
                    <select name="Month" class="form-select">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == DateTime.Today.Month)">@m</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">السنة</label>
                    <input type="number" name="Year" value="@DateTime.Today.Year" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">الراتب الأساسي</label>
                    <input type="number" name="BasicSalary" id="basicSalary" step="0.001" class="form-control" value="0" oninput="calcNet()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">العمولة (%)</label>
                    <input type="number" id="commissionDisplay" step="0.01" class="form-control" value="0" readonly style="background:#fff8e1;" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">البدلات</label>
                    <input type="number" name="Allowances" step="0.001" class="form-control" value="0" oninput="calcNet()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">الخصومات</label>
                    <input type="number" name="Deductions" step="0.001" class="form-control" value="0" oninput="calcNet()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">السلف المخصومة <span id="maxAdvanceLabel" class="text-muted small"></span></label>
                    <input type="number" name="AdvanceDeducted" id="advanceDeducted" step="0.001" class="form-control" value="0" oninput="validateAndCalc()" />
                    <div id="advanceError" class="text-danger small d-none">لا يمكن أن تتجاوز إجمالي السلف</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">الصافي</label>
                    <input type="number" name="NetSalary" id="netSalary" step="0.001" class="form-control" value="0" readonly style="background:#f0fff0; font-weight:bold;" />
                </div>
                <div class="col-12">
                    <label class="form-label">ملاحظات</label>
                    <textarea name="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let maxAdvances = 0;

        function calcNet() {
            const basic = parseFloat(document.querySelector('[name="BasicSalary"]').value) || 0;
            const allow = parseFloat(document.querySelector('[name="Allowances"]').value) || 0;
            const ded = parseFloat(document.querySelector('[name="Deductions"]').value) || 0;
            const adv = parseFloat(document.querySelector('[name="AdvanceDeducted"]').value) || 0;
            document.getElementById('netSalary').value = (basic + allow - ded - adv).toFixed(3);
        }

        function validateAndCalc() {
            const advInput = document.getElementById('advanceDeducted');
            const advErr = document.getElementById('advanceError');
            const submitBtn = document.querySelector('[type="submit"]');
            const val = parseFloat(advInput.value) || 0;

            if (val > maxAdvances) {
                advErr.classList.remove('d-none');
                submitBtn.disabled = true;
            } else {
                advErr.classList.add('d-none');
                submitBtn.disabled = false;
            }
            calcNet();
        }

        function loadSalary(select) {
            const empId = select.value;
            if (!empId) {
                document.querySelector('[name="BasicSalary"]').value = 0;
                document.getElementById('commissionDisplay').value = 0;
                document.getElementById('advanceDeducted').value = 0;
                document.getElementById('maxAdvanceLabel').textContent = '';
                maxAdvances = 0;
                calcNet();
                return;
            }
            fetch('/Salaries/GetEmployeeDetails?id=' + empId)
                .then(r => r.json())
                .then(data => {
                    maxAdvances = data.advances;
                    document.querySelector('[name="BasicSalary"]').value = data.salary;
                    document.getElementById('commissionDisplay').value = data.commission;
                    document.getElementById('advanceDeducted').value = data.advances;
                    document.getElementById('maxAdvanceLabel').textContent = '(الحد الأقصى: ' + data.advances.toFixed(3) + ')';
                    document.getElementById('advanceError').classList.add('d-none');
                    document.querySelector('[type="submit"]').disabled = false;
                    calcNet();
                });
        }
    </script>
}