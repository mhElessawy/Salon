@{
    ViewData["Title"] = "تسوية راتب";
    string[] arabicMonths = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
                               "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var currentMonth = DateTime.Today.Month;
}

<div class="page-header">
    <h1><i class="fas fa-plus-circle me-2"></i>تسوية راتب موظف</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">الموظف</label>
                    <select name="EmployeeId" asp-items="@ViewBag.Employees" class="form-select" id="employeeSelect" onchange="loadSalary(true)">
                        <option value="">-- اختر الموظف --</option>
                    </select>
                    <div id="alreadyPaidAlert" class="alert alert-danger mt-2 py-2 d-none"></div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">الشهر</label>
                    <select name="Month" id="monthSelect" class="form-select" onchange="loadSalary(true)">
                        @for (int m = 1; m <= 12; m++)
                        {
                            if (m == currentMonth)
                            {
                                <option value="@m" selected>@arabicMonths[m]</option>
                            }
                            else
                            {
                                <option value="@m">@arabicMonths[m]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">السنة</label>
                    <input type="number" name="Year" id="yearInput" value="@DateTime.Today.Year" class="form-control" onchange="loadSalary(true)" />
                </div>

                <div id="targetStatusCard" class="col-12 d-none">
                    <div id="targetStatusInner"></div>
                </div>

                @* ─────────────────────────── أولاً: الاستحقاقات ─────────────────────────── *@
                <div class="col-12">
                    <h6 class="fw-bold text-success mb-0"><i class="fas fa-plus-circle me-1"></i> أولاً: الاستحقاقات</h6>
                </div>
                <div class="col-md-3">
                    <label class="form-label">الراتب الأساسي</label>
                    <input type="number" name="BasicSalary" id="basicSalary" step="0.001" class="form-control" value="0" oninput="onEditableInputChanged()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        عمولة الفواتير
                        <small class="text-muted fw-normal" id="commissionPctLabel"></small>
                    </label>
                    <input type="number" id="commissionAmount" step="0.001" class="form-control" value="0" readonly style="background:#eee;" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">البدلات</label>
                    <input type="number" name="Allowances" id="allowances" step="0.001" class="form-control" value="0" oninput="onEditableInputChanged()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        إجمالي خدمات الموظف
                        <small class="text-muted fw-normal">(من الفواتير)</small>
                    </label>
                    <input type="number" id="giftAmount" step="0.001" class="form-control" value="0" readonly style="background:#eee;" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" style="color:#c0392b;">
                        <i class="fas fa-gift me-1"></i>إكرامية الموظف
                        <small class="text-muted fw-normal">(من الفواتير)</small>
                    </label>
                    <input type="number" id="hadiyaAmount" step="0.001" class="form-control" value="0" readonly style="background:#fdf2f2;border-color:#e74c3c;" />
                </div>
                <div class="col-md-9">
                    <div class="d-flex align-items-center justify-content-between bg-light rounded p-2 h-100">
                        <strong>إجمالي الاستحقاقات</strong>
                        <strong class="text-success fs-5" id="totalEntitlementsDisplay">0.000 د.ك</strong>
                    </div>
                </div>

                @* حقول مخفية ترسل القيم المحسوبة فعلياً من الخادم (مصدرها العمولة/الفواتير) *@
                <input type="hidden" name="CommissionAmount" id="commissionAmountHidden" value="0" />
                <input type="hidden" name="GiftAmount" id="giftAmountHidden" value="0" />
                <input type="hidden" name="HadiyaAmount" id="hadiyaAmountHidden" value="0" />

                @* ─────────────────────────── ثانياً: الخصومات والالتزامات ─────────────────────────── *@
                <div class="col-12 mt-4">
                    <h6 class="fw-bold text-danger mb-0"><i class="fas fa-minus-circle me-1"></i> ثانياً: الخصومات والالتزامات</h6>
                </div>
                <div class="col-md-4">
                    <label class="form-label">الخصومات</label>
                    <input type="number" name="Deductions" id="deductions" step="0.001" class="form-control" value="0" oninput="onEditableInputChanged()" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">
                        دين على الموظف <small class="text-muted fw-normal">(من الفواتير)</small>
                    </label>
                    <input type="number" id="employeeDebtDeducted" step="0.001" class="form-control" value="0" readonly style="background:#fff3cd;" />
                    <input type="hidden" name="EmployeeDebtDeducted" id="employeeDebtDeductedHidden" value="0" />
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center justify-content-between bg-light rounded p-2 h-100">
                        <span class="text-muted">المبلغ المتاح لسداد السلف</span>
                        <strong id="availableForAdvanceDisplay">0.000 د.ك</strong>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card border-warning border-opacity-50 mt-2">
                        <div class="card-header bg-warning bg-opacity-10">
                            <i class="fas fa-hand-holding-usd me-1 text-warning"></i><strong>رصيد السلف</strong>
                            <small class="text-muted">— أرصدة السلف مرتبطة مباشرة بسجل سلف الموظف ولا تُدخل يدوياً، أما المبلغ المخصوم هذا الشهر فيمكن تعديله</small>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small text-muted">سلف مرحّلة من أشهر سابقة</label>
                                    <input type="text" id="carriedAdvanceBalance" class="form-control" value="0.000" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small text-muted">سلف جديدة هذا الشهر</label>
                                    <input type="text" id="newAdvancesAmount" class="form-control" value="0.000" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">إجمالي رصيد السلف المستحق</label>
                                    <input type="text" id="totalAdvanceDue" class="form-control fw-bold" value="0.000" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold text-danger">المطلوب خصمه من السلف هذا الشهر</label>
                                    <div class="input-group">
                                        <input type="number" name="AdvanceDeducted" id="advanceDeducted" step="0.001" min="0"
                                               class="form-control fw-bold text-danger" value="0"
                                               oninput="onEditableInputChanged()" onblur="clampAdvanceDeducted()" />
                                        <button type="button" class="btn btn-outline-secondary" onclick="useMaxAdvanceDeducted()" title="استخدام أقصى مبلغ ممكن">
                                            <i class="fas fa-angle-double-up"></i> الأقصى
                                        </button>
                                    </div>
                                    <small class="text-muted">الحد الأقصى الممكن خصمه الآن: <strong id="maxAdvanceDeductibleDisplay">0.000</strong> د.ك — أي مبلغ أقل يُرحَّل الباقي للشهر القادم</small>
                                </div>
                            </div>
                            <div class="alert alert-light border mt-3 mb-0 d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-forward me-1"></i> رصيد السلف المتبقي المرحّل للشهر القادم</span>
                                <strong id="remainingAdvanceCarried">0.000 د.ك</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <input type="hidden" name="CarriedAdvanceBalance" id="carriedAdvanceBalanceHidden" value="0" />
                <input type="hidden" name="NewAdvancesAmount" id="newAdvancesAmountHidden" value="0" />
                <input type="hidden" name="TotalAdvanceDue" id="totalAdvanceDueHidden" value="0" />
                <input type="hidden" name="AvailableForAdvanceRepayment" id="availableForAdvanceRepaymentHidden" value="0" />
                <input type="hidden" name="RemainingAdvanceCarried" id="remainingAdvanceCarriedHidden" value="0" />

                @* ─────────────────────────── ثالثاً: تسوية الراتب ─────────────────────────── *@
                <div class="col-12 mt-4">
                    <h6 class="fw-bold text-primary mb-0"><i class="fas fa-balance-scale me-1"></i> ثالثاً: تسوية الراتب</h6>
                </div>
                <div class="col-12">
                    <div class="card border-primary">
                        <div class="card-body">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr>
                                        <td>إجمالي الاستحقاقات</td>
                                        <td class="text-end fw-bold text-success" id="summaryEntitlements">0.000 د.ك</td>
                                    </tr>
                                    <tr>
                                        <td>إجمالي الخصومات الأخرى (خصومات + دين الموظف)</td>
                                        <td class="text-end fw-bold text-danger" id="summaryOtherDeductions">0.000 د.ك</td>
                                    </tr>
                                    <tr>
                                        <td>المبلغ المتاح لسداد السلف</td>
                                        <td class="text-end fw-bold" id="summaryAvailable">0.000 د.ك</td>
                                    </tr>
                                    <tr>
                                        <td>السلف المخصومة فعلياً</td>
                                        <td class="text-end fw-bold text-danger" id="summaryAdvanceDeducted">0.000 د.ك</td>
                                    </tr>
                                    <tr>
                                        <td>رصيد السلف المتبقي للترحيل للشهر القادم</td>
                                        <td class="text-end fw-bold" id="summaryRemainingAdvance">0.000 د.ك</td>
                                    </tr>
                                </tbody>
                                <tfoot class="table-success">
                                    <tr>
                                        <td class="fw-bold fs-5">صافي الراتب المستحق للصرف</td>
                                        <td class="text-end fw-bold fs-5" id="netSalary">0.000 د.ك</td>
                                    </tr>
                                </tfoot>
                            </table>
                            <div id="zeroNetAlert" class="alert alert-info mt-3 mb-0 d-none py-2">
                                <i class="fas fa-info-circle me-1"></i>
                                صافي الراتب <strong>صفر</strong> — لن يتم إنشاء أي حركة صرف كاش أو تحويل بنكي، وستكون حالة العملية
                                <strong>«تمت تسوية الراتب – لا يوجد مبلغ للصرف»</strong>.
                            </div>
                            <div id="negativeNetAlert" class="alert alert-danger mt-3 mb-0 d-none py-2">
                                <i class="fas fa-exclamation-triangle me-1"></i> الخصومات والالتزامات أكبر من الاستحقاقات — لا يمكن حفظ التسوية.
                            </div>
                        </div>
                    </div>
                </div>

                <input type="hidden" name="NetSalary" id="netSalaryHidden" value="0" />
                <input type="hidden" name="AutoNote" id="autoNoteHidden" value="" />

                @* ─────────────────────────── رابعاً: الصرف الفعلي ─────────────────────────── *@
                <div class="col-12 mt-4" id="actualPaymentSection">
                    <h6 class="fw-bold text-dark mb-0"><i class="fas fa-money-check-alt me-1"></i> رابعاً: الصرف الفعلي</h6>
                    <small class="text-muted">يتعلق فقط بالمبلغ الذي سيُدفع فعلياً للموظف</small>
                </div>
                <div class="col-md-4" id="paidDateWrap">
                    <label class="form-label">تاريخ الصرف <small class="text-muted fw-normal">(اختياري - إذا تم الصرف الآن)</small></label>
                    <input type="date" name="PaidDate" id="paidDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4" id="paymentMethodWrap">
                    <label class="form-label">وسيلة الدفع</label>
                    <select name="PaymentMethod" id="paymentMethod" class="form-select">
                        <option value="كاش">💵 كاش</option>
                        <option value="تحويل بنكي للموظف">🏦 تحويل بنكي للموظف</option>
                        <option value="تحويل بنكي لينك">🔗 تحويل بنكي لينك</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">ملاحظات</label>
                    <textarea name="Notes" class="form-control" rows="2" placeholder="ملاحظة المستخدم (منفصلة عن الملاحظة الآلية التي يولّدها النظام)"></textarea>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
                </div>

                <div class="col-12 d-none" id="salesCard">
                    <div class="card border-info">
                        <div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-receipt me-2 text-info"></i><strong>فواتير الشهر (المكتملة)</strong></span>
                            <span class="badge bg-info" id="salesCountBadge">0 فاتورة</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>رقم الفاتورة</th>
                                            <th>التاريخ</th>
                                            <th>طريقة الدفع</th>
                                            <th class="text-end">صافي الفاتورة</th>
                                            <th class="text-end" style="color:#c0392b;"><i class="fas fa-gift me-1"></i>إكرامية للموظف</th>
                                        </tr>
                                    </thead>
                                    <tbody id="salesTableBody">
                                        <tr><td colspan="5" class="text-center text-muted py-3">لا توجد فواتير لهذا الشهر</td></tr>
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="3">إجمالي الفواتير</td>
                                            <td class="text-end" id="totalSalesDisplay">0.000</td>
                                            <td class="text-end" style="color:#c0392b;" id="totalHadiyaTableDisplay">-</td>
                                        </tr>
                                        <tr class="table-success">
                                            <td colspan="3">
                                                حق الموظف
                                                <span class="text-muted fw-normal">(<span id="commissionPctDisplay">0</span>%)</span>
                                            </td>
                                            <td class="text-end fw-bold" id="commissionAmountDisplay">0.000</td>
                                        </tr>
                                        <tr class="border-top">
                                            <td colspan="4" class="py-2">
                                                <div class="d-flex flex-wrap gap-3">
                                                    <span class="badge bg-success fs-6 px-3 py-2">
                                                        💵 نقدي: <strong id="cashTotalDisplay">0.000</strong> د.ك
                                                    </span>
                                                    <span class="badge bg-info text-dark fs-6 px-3 py-2">
                                                        💳 كي نت: <strong id="knetTotalDisplay">0.000</strong> د.ك
                                                    </span>
                                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                                        👷 دين موظف: <strong id="employeeDebtDisplay">0.000</strong> د.ك
                                                    </span>
                                                    <span class="badge bg-secondary fs-6 px-3 py-2">
                                                        👤 دين عميل: <strong id="customerDebtDisplay">0.000</strong> د.ك
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 d-none" id="cancelledCard">
                    <div class="card border-danger border-opacity-50">
                        <div class="card-header bg-danger bg-opacity-10 d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-ban me-2 text-danger"></i><strong>الفواتير الملغاة</strong> <small class="text-muted fw-normal">(لا تُحسب في المرتب ولا التارجت)</small></span>
                            <span class="badge bg-danger" id="cancelledCountBadge">0 فاتورة</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>رقم الفاتورة</th>
                                            <th>التاريخ</th>
                                            <th>طريقة الدفع</th>
                                            <th class="text-end">المبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody id="cancelledTableBody"></tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="3" class="text-danger">إجمالي الملغاة</td>
                                            <td class="text-end text-danger" id="totalCancelledDisplay">0.000</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let debounceTimer = null;

        function onEditableInputChanged() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () { loadSalary(false); }, 350);
        }

        function clampAdvanceDeducted() {
            const field = document.getElementById('advanceDeducted');
            const max = parseFloat(field.dataset.max || field.max || 0);
            let val = parseFloat(field.value) || 0;
            if (val < 0) val = 0;
            if (val > max) val = max;
            field.value = val.toFixed(3);
            onEditableInputChanged();
        }

        function useMaxAdvanceDeducted() {
            const field = document.getElementById('advanceDeducted');
            field.value = parseFloat(field.dataset.max || field.max || 0).toFixed(3);
            onEditableInputChanged();
        }

        function applyBreakdown(data) {
            // الاستحقاقات
            document.getElementById('commissionAmount').value = data.commissionAmount.toFixed(3);
            document.getElementById('commissionAmountHidden').value = data.commissionAmount.toFixed(3);
            document.getElementById('giftAmount').value = data.totalGifts.toFixed(3);
            document.getElementById('giftAmountHidden').value = data.totalGifts.toFixed(3);
            document.getElementById('hadiyaAmount').value = (data.totalHadiya || 0).toFixed(3);
            document.getElementById('hadiyaAmountHidden').value = (data.totalHadiya || 0).toFixed(3);
            document.getElementById('totalEntitlementsDisplay').textContent = data.totalEntitlements.toFixed(3) + ' د.ك';

            // الخصومات والالتزامات
            document.getElementById('employeeDebtDeducted').value = (data.employeeDebtTotal || 0).toFixed(3);
            document.getElementById('employeeDebtDeductedHidden').value = (data.employeeDebtTotal || 0).toFixed(3);
            document.getElementById('availableForAdvanceDisplay').textContent = data.availableForAdvanceRepayment.toFixed(3) + ' د.ك';

            // رصيد السلف
            document.getElementById('carriedAdvanceBalance').value = data.carriedAdvanceBalance.toFixed(3);
            document.getElementById('newAdvancesAmount').value = data.newAdvancesAmount.toFixed(3);
            document.getElementById('totalAdvanceDue').value = data.totalAdvanceDue.toFixed(3);
            document.getElementById('advanceDeducted').value = data.advanceDeducted.toFixed(3);
            document.getElementById('advanceDeducted').max = data.maxAdvanceDeductible.toFixed(3);
            document.getElementById('advanceDeducted').dataset.max = data.maxAdvanceDeductible.toFixed(3);
            document.getElementById('maxAdvanceDeductibleDisplay').textContent = data.maxAdvanceDeductible.toFixed(3);
            document.getElementById('remainingAdvanceCarried').textContent = data.remainingAdvanceCarried.toFixed(3) + ' د.ك';

            document.getElementById('carriedAdvanceBalanceHidden').value = data.carriedAdvanceBalance.toFixed(3);
            document.getElementById('newAdvancesAmountHidden').value = data.newAdvancesAmount.toFixed(3);
            document.getElementById('totalAdvanceDueHidden').value = data.totalAdvanceDue.toFixed(3);
            document.getElementById('availableForAdvanceRepaymentHidden').value = data.availableForAdvanceRepayment.toFixed(3);
            document.getElementById('remainingAdvanceCarriedHidden').value = data.remainingAdvanceCarried.toFixed(3);

            // ملخص التسوية
            const otherDeductions = (parseFloat(document.getElementById('deductions').value) || 0) + (data.employeeDebtTotal || 0);
            document.getElementById('summaryEntitlements').textContent = data.totalEntitlements.toFixed(3) + ' د.ك';
            document.getElementById('summaryOtherDeductions').textContent = otherDeductions.toFixed(3) + ' د.ك';
            document.getElementById('summaryAvailable').textContent = data.availableForAdvanceRepayment.toFixed(3) + ' د.ك';
            document.getElementById('summaryAdvanceDeducted').textContent = data.advanceDeducted.toFixed(3) + ' د.ك';
            document.getElementById('summaryRemainingAdvance').textContent = data.remainingAdvanceCarried.toFixed(3) + ' د.ك';
            document.getElementById('netSalary').textContent = data.netSalary.toFixed(3) + ' د.ك';
            document.getElementById('netSalaryHidden').value = data.netSalary.toFixed(3);
            document.getElementById('autoNoteHidden').value = data.autoNote || '';

            const zeroAlert = document.getElementById('zeroNetAlert');
            const negAlert = document.getElementById('negativeNetAlert');
            const submitBtn = document.querySelector('button[type="submit"]');
            const paidDateWrap = document.getElementById('paidDateWrap');
            const paymentMethodWrap = document.getElementById('paymentMethodWrap');
            const alreadyPaid = !document.getElementById('alreadyPaidAlert').classList.contains('d-none');

            if (data.netSalary < -0.0005) {
                negAlert.classList.remove('d-none');
                zeroAlert.classList.add('d-none');
                submitBtn.disabled = true;
                paidDateWrap.classList.add('d-none');
                paymentMethodWrap.classList.add('d-none');
            } else if (data.netSalary <= 0.0005) {
                negAlert.classList.add('d-none');
                zeroAlert.classList.remove('d-none');
                submitBtn.disabled = alreadyPaid;
                paidDateWrap.classList.add('d-none');
                paymentMethodWrap.classList.add('d-none');
            } else {
                negAlert.classList.add('d-none');
                zeroAlert.classList.add('d-none');
                submitBtn.disabled = alreadyPaid;
                paidDateWrap.classList.remove('d-none');
                paymentMethodWrap.classList.remove('d-none');
            }
        }

        // reset=true (عند اختيار موظف/شهر/سنة جديد): يعيد اقتراح الراتب الأساسي من بيانات الموظف
        // ويصفّر البدلات/الخصومات. reset=false (عند تعديل المستخدم لأي من الحقول القابلة للتعديل):
        // يرسل القيم الحالية كما هي ويعيد حساب كل شيء آخر (عمولة/دين/سلف/صافي) من مصادرها فقط.
        async function loadSalary(reset) {
            const empId = document.getElementById('employeeSelect').value;
            const month = document.getElementById('monthSelect').value;
            const year  = document.getElementById('yearInput').value;
            const alertEl   = document.getElementById('alreadyPaidAlert');

            if (!empId) {
                alertEl.classList.add('d-none');
                document.getElementById('salesCard').classList.add('d-none');
                return;
            }

            let url = `/Salaries/GetEmployeeInfo?employeeId=${empId}&month=${month}&year=${year}`;
            if (!reset) {
                const basicSalary = document.getElementById('basicSalary').value || 0;
                const allowances  = document.getElementById('allowances').value || 0;
                const deductions  = document.getElementById('deductions').value || 0;
                const advanceDeducted = document.getElementById('advanceDeducted').value || 0;
                url += `&basicSalary=${basicSalary}&allowances=${allowances}&deductions=${deductions}&advanceDeducted=${advanceDeducted}`;
            }

            try {
                const res = await fetch(url);
                if (!res.ok) return;
                const data = await res.json();

                if (reset) {
                    document.getElementById('basicSalary').value = data.basicSalary.toFixed(3);
                    document.getElementById('allowances').value = '0.000';
                    document.getElementById('deductions').value = '0.000';
                }

                // تحديث تسمية العمولة
                const pct = data.commission || 0;
                document.getElementById('commissionPctLabel').textContent = pct > 0 ? `(${pct}%)` : '';

                applyBreakdown(data);

                // عرض حالة التارجت
                const targetCard = document.getElementById('targetStatusCard');
                const targetInner = document.getElementById('targetStatusInner');
                if (data.salesTarget && data.salesTarget > 0) {
                    targetCard.classList.remove('d-none');
                    if (data.targetReached) {
                        targetInner.innerHTML = `
                            <div class="alert alert-success py-2 mb-0 d-flex align-items-center gap-2">
                                <i class="fas fa-trophy text-warning fs-5"></i>
                                <span>
                                    <strong>تم تحقيق التارجت!</strong>
                                    التارجت: <strong>${data.salesTarget.toFixed(3)} د.ك</strong> —
                                    المبيعات: <strong>${data.totalSalesAmount.toFixed(3)} د.ك</strong> —
                                    العمولة المطبقة: <strong>${data.commissionAfterTarget}%</strong>
                                    <span class="text-muted">(بدل ${data.normalCommission}%)</span>
                                </span>
                            </div>`;
                    } else {
                        const remaining = (data.salesTarget - data.totalSalesAmount).toFixed(3);
                        targetInner.innerHTML = `
                            <div class="alert alert-warning py-2 mb-0 d-flex align-items-center gap-2">
                                <i class="fas fa-bullseye text-danger fs-5"></i>
                                <span>
                                    <strong>لم يتحقق التارجت بعد</strong> —
                                    التارجت: <strong>${data.salesTarget.toFixed(3)} د.ك</strong> —
                                    المبيعات: <strong>${data.totalSalesAmount.toFixed(3)} د.ك</strong> —
                                    المتبقي: <strong>${remaining} د.ك</strong> —
                                    العمولة المطبقة: <strong>${data.normalCommission}%</strong>
                                </span>
                            </div>`;
                    }
                } else {
                    targetCard.classList.add('d-none');
                }

                // بطاقة الفواتير
                const salesCard = document.getElementById('salesCard');
                document.getElementById('commissionPctDisplay').textContent = pct;
                document.getElementById('totalSalesDisplay').textContent    = data.totalSalesAmount.toFixed(3) + ' د.ك';
                document.getElementById('commissionAmountDisplay').textContent = data.commissionAmount.toFixed(3) + ' د.ك';
                document.getElementById('salesCountBadge').textContent = data.sales.length + ' فاتورة';
                document.getElementById('cashTotalDisplay').textContent     = (data.cashTotal || 0).toFixed(3);
                document.getElementById('knetTotalDisplay').textContent     = (data.knetTotal || 0).toFixed(3);
                document.getElementById('employeeDebtDisplay').textContent  = (data.employeeDebtTotal || 0).toFixed(3);
                document.getElementById('customerDebtDisplay').textContent  = (data.customerDebtTotal || 0).toFixed(3);

                const tbody = document.getElementById('salesTableBody');
                function paymentBadge(method) {
                    if (!method) return '<span class="badge bg-success">نقدي</span>';
                    if (method === 'كاش' || method === 'نقدي')
                        return `<span class="badge bg-success"><i class="fas fa-money-bill-wave me-1"></i>${method}</span>`;
                    if (method.includes('كي نت') && method.includes('كاش'))
                        return `<span class="badge bg-warning text-dark"><i class="fas fa-exchange-alt me-1"></i>${method}</span>`;
                    if (method.includes('كي نت') || method.includes('بطاقة'))
                        return `<span class="badge bg-info text-dark"><i class="fas fa-credit-card me-1"></i>${method}</span>`;
                    if (method.includes('دين'))
                        return `<span class="badge bg-danger"><i class="fas fa-user-tag me-1"></i>${method}</span>`;
                    return `<span class="badge bg-secondary">${method}</span>`;
                }

                if (data.sales.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">لا توجد فواتير لهذا الشهر</td></tr>';
                    salesCard.classList.add('d-none');
                } else {
                    tbody.innerHTML = data.sales.map(s =>
                        `<tr>
                            <td>${s.invoiceNumber}</td>
                            <td>${s.saleDate}</td>
                            <td>${paymentBadge(s.paymentMethod)}</td>
                            <td class="text-end">${s.netAmount.toFixed(3)} د.ك</td>
                            <td class="text-end">${s.giftForEmployee > 0
                                ? `<span class="badge" style="background:#c0392b;"><i class="fas fa-gift me-1"></i>${s.giftForEmployee.toFixed(3)} د.ك</span>`
                                : '<span class="text-muted">-</span>'
                            }</td>
                        </tr>`
                    ).join('');
                    const totalHadiyaVal = data.totalHadiya || 0;
                    const hadiyaDisplay = document.getElementById('totalHadiyaTableDisplay');
                    if (hadiyaDisplay) {
                        hadiyaDisplay.innerHTML = totalHadiyaVal > 0
                            ? `<span class="badge" style="background:#c0392b;">${totalHadiyaVal.toFixed(3)} د.ك</span>`
                            : '-';
                    }
                    salesCard.classList.remove('d-none');
                }

                const cancelledCard  = document.getElementById('cancelledCard');
                const cancelledTbody = document.getElementById('cancelledTableBody');
                const cancelled = data.cancelledSales || [];
                if (cancelled.length > 0) {
                    cancelledTbody.innerHTML = cancelled.map(s =>
                        `<tr style="background:#fff5f5;">
                            <td><span class="text-decoration-line-through text-muted">${s.invoiceNumber}</span></td>
                            <td>${s.saleDate}</td>
                            <td>${paymentBadge(s.paymentMethod)}</td>
                            <td class="text-end text-danger">${s.netAmount.toFixed(3)} د.ك</td>
                        </tr>`
                    ).join('');
                    const totalCancelled = cancelled.reduce((sum, s) => sum + s.netAmount, 0);
                    document.getElementById('totalCancelledDisplay').textContent = totalCancelled.toFixed(3) + ' د.ك';
                    document.getElementById('cancelledCountBadge').textContent   = cancelled.length + ' فاتورة';
                    cancelledCard.classList.remove('d-none');
                } else {
                    cancelledCard.classList.add('d-none');
                }

                if (data.alreadyExists) {
                    let msg = 'تم تسجيل راتب هذا الموظف لهذا الشهر مسبقاً';
                    if (data.existingStatus === 'مصروف') {
                        msg = 'تم صرف راتب هذا الموظف لهذا الشهر مسبقاً';
                    } else if (data.existingStatus === 'تمت تسوية الراتب - لا يوجد مبلغ للصرف') {
                        msg = 'تمت تسوية راتب هذا الموظف لهذا الشهر مسبقاً — بدون صرف أي مبلغ';
                    } else if (data.existingStatus === 'معلق') {
                        msg = 'تم تسجيل راتب هذا الموظف لهذا الشهر مسبقاً — بانتظار الصرف';
                    }
                    alertEl.innerHTML = `<i class="fas fa-exclamation-triangle me-1"></i><strong>تنبيه:</strong> ${msg}`;
                    alertEl.classList.remove('d-none');
                } else {
                    alertEl.classList.add('d-none');
                }

                applyBreakdown(data);
            } catch (e) {
                console.error('خطأ في جلب بيانات الموظف', e);
            }
        }
    </script>
}
