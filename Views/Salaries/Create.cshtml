@{
    ViewData["Title"] = "إضافة راتب";
    string[] arabicMonths = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
                               "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
}

<div class="page-header">
    <h1><i class="fas fa-plus-circle me-2"></i>إضافة راتب موظف</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">الموظف</label>
                    <select name="EmployeeId" asp-items="@ViewBag.Employees" class="form-select" id="employeeSelect" onchange="loadSalary()">
                        <option value="">-- اختر الموظف --</option>
                    </select>
                    <div id="alreadyPaidAlert" class="alert alert-danger mt-2 py-2 d-none">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        <strong>تنبيه:</strong> تم صرف راتب هذا الموظف لهذا الشهر مسبقاً
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">الشهر</label>
                    <select name="Month" id="monthSelect" class="form-select" onchange="loadSalary()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" @(m == DateTime.Today.Month ? "selected" : "")>@arabicMonths[m]</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">السنة</label>
                    <input type="number" name="Year" id="yearInput" value="@DateTime.Today.Year" class="form-control" onchange="loadSalary()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">الراتب الأساسي</label>
                    <input type="number" name="BasicSalary" id="basicSalary" step="0.001" class="form-control" value="0" oninput="calcNet()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">البدلات</label>
                    <input type="number" name="Allowances" id="allowances" step="0.001" class="form-control" value="0" oninput="calcNet()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">الخصومات</label>
                    <input type="number" name="Deductions" id="deductions" step="0.001" class="form-control" value="0" oninput="calcNet()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">السلف المخصومة</label>
                    <input type="number" name="AdvanceDeducted" id="advanceDeducted" step="0.001" class="form-control" value="0" oninput="calcNet()" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">الصافي</label>
                    <input type="number" name="NetSalary" id="netSalary" step="0.001" class="form-control" value="0" readonly style="background:#f0fff0; font-weight:bold;" />
                </div>
                <div class="col-12">
                    <label class="form-label">ملاحظات</label>
                    <textarea name="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function calcNet() {
    const basic = parseFloat(document.getElementById('basicSalary').value) || 0;
    const allow = parseFloat(document.getElementById('allowances').value) || 0;
    const ded   = parseFloat(document.getElementById('deductions').value) || 0;
    const adv   = parseFloat(document.getElementById('advanceDeducted').value) || 0;
    document.getElementById('netSalary').value = (basic + allow - ded - adv).toFixed(3);
}

async function loadSalary() {
    const empId = document.getElementById('employeeSelect').value;
    const month = document.getElementById('monthSelect').value;
    const year  = document.getElementById('yearInput').value;
    const alert = document.getElementById('alreadyPaidAlert');
    const submitBtn = document.querySelector('button[type="submit"]');

    if (!empId) {
        alert.classList.add('d-none');
        return;
    }

    try {
        const res = await fetch(`/Salaries/GetEmployeeInfo?employeeId=${empId}&month=${month}&year=${year}`);
        if (!res.ok) return;
        const data = await res.json();

        document.getElementById('basicSalary').value     = data.basicSalary.toFixed(3);
        document.getElementById('advanceDeducted').value = data.advanceDeducted.toFixed(3);
        calcNet();

        // إظهار تحذير إذا الشهر مدفوع مسبقاً
        if (data.alreadyPaid) {
            alert.classList.remove('d-none');
            submitBtn.disabled = true;
        } else {
            alert.classList.add('d-none');
            submitBtn.disabled = false;
        }
    } catch (e) {
        console.error('خطأ في جلب بيانات الموظف', e);
    }
}
</script>
}
