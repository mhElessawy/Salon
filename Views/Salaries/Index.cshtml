@model IEnumerable<Salon.Models.Salary>
@{
    ViewData["Title"] = "صرف الرواتب";
    string[] arabicMonths = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
                               "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    string[] englishMonths = { "", "January", "February", "March", "April", "May", "June",
                                "July", "August", "September", "October", "November", "December" };
    int currentYear = (int)ViewBag.Year;
    int? currentMonth = ViewBag.Month as int?;
    int? currentEmployee = ViewBag.EmployeeId as int?;
    bool showMonthCol = !currentMonth.HasValue;

    string headerLabelAr = currentMonth.HasValue
        ? "رواتب شهر " + arabicMonths[currentMonth.Value] + " " + currentYear
        : "رواتب سنة " + currentYear;
    string headerLabelEn = currentMonth.HasValue
        ? "Salaries of " + englishMonths[currentMonth.Value] + " " + currentYear
        : "Salaries of Year " + currentYear;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-dollar-sign me-2"></i>صرف الرواتب</h1>
        <p>إدارة رواتب الموظفين</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة راتب
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-1">السنة</label>
                <select name="year" class="form-select" style="min-width:110px;">
                    @foreach (int y in ViewBag.Years)
                    {
                        <option value="@y" selected="@(y == currentYear ? "selected" : null)">@y</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">الشهر</label>
                <select name="month" class="form-select" style="min-width:140px;">
                    <option value="" selected="@(currentMonth.HasValue ? null : "selected")">-- كل الأشهر --</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(currentMonth == m ? "selected" : null)">@arabicMonths[m]</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">الموظف</label>
                <select name="employeeId" class="form-select" style="min-width:180px;">
                    <option value="" selected="@(currentEmployee.HasValue ? null : "selected")">-- الكل --</option>
                    @foreach (SelectListItem emp in ViewBag.Employees)
                    {
                        <option value="@emp.Value" selected="@(emp.Value == currentEmployee?.ToString() ? "selected" : null)">@emp.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> بحث</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-1">إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-calendar-alt me-2 text-primary"></i>
            <strong class="text-primary" data-i18n-en="@headerLabelEn">@headerLabelAr</strong>
        </h5>
        <span class="badge bg-secondary fs-6">@Model.Count() <span data-i18n-en="Record">سجل</span></span>
    </div>
    <style>
        #salariesTableScroll table { font-size: 0.82rem; }
        #salariesTableScroll .sal-sticky-name {
            position: sticky;
            right: 0;
            z-index: 2;
            background: #fff;
            box-shadow: -2px 0 4px rgba(0,0,0,0.08);
        }
        #salariesTableScroll thead .sal-sticky-name {
            z-index: 3;
            background: #f8f9fa;
        }
    </style>
    <div class="card-body p-0">
        <div class="table-responsive" id="salariesTableScroll" style="width: 0; min-width: 100%;">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        @if (showMonthCol)
                        {
                            <th>الشهر</th>
                        }
                        <th class="sal-sticky-name">الموظف</th>
                        <th>إجمالي الاستحقاقات</th>
                        <th>الخصومات</th>
                        <th>دين الموظف</th>
                        <th>رصيد السلف المستحق</th>
                        <th>المخصوم من السلف</th>
                        <th>السلف المرحلة للشهر القادم</th>
                        <th>صافي الراتب</th>
                        <th>المصروف فعلياً</th>
                        <th>طريقة الدفع</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="@(showMonthCol ? 13 : 12)" class="text-center text-muted py-4">لا توجد رواتب مسجلة</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        decimal actuallyPaid = s.Status == Salon.Models.Salary.Statuses.Paid ? s.NetSalary : 0m;
                        <tr>
                            @if (showMonthCol)
                            {
                                <td><span class="badge bg-light text-dark border">@arabicMonths[s.Month]</span></td>
                            }
                            <td class="sal-sticky-name"><strong>@(s.Employee?.FullName ?? "-")</strong></td>
                            <td>@s.TotalEntitlements.ToString("N3") د.ك</td>
                            <td>@s.Deductions.ToString("N3") د.ك</td>
                            <td>@s.EmployeeDebtDeducted.ToString("N3") د.ك</td>
                            <td>@s.TotalAdvanceDue.ToString("N3") د.ك</td>
                            <td>@s.AdvanceDeducted.ToString("N3") د.ك</td>
                            <td>@s.RemainingAdvanceCarried.ToString("N3") د.ك</td>
                            <td><strong>@s.NetSalary.ToString("N3") د.ك</strong></td>
                            <td><strong class="@(actuallyPaid > 0 ? "text-success" : "text-muted")">@actuallyPaid.ToString("N3") د.ك</strong></td>
                            <td>
                                @if (s.Status != Salon.Models.Salary.Statuses.Paid)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else if (s.PaymentMethod == "كي نت")
                                {
                                    <span class="badge bg-info text-dark"><i class="fas fa-credit-card me-1"></i>كي نت</span>
                                }
                                else if (s.PaymentMethod != null && s.PaymentMethod.Contains("تحويل بنكي"))
                                {
                                    <span class="badge bg-primary"><i class="fas fa-university me-1"></i>@s.PaymentMethod</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="fas fa-money-bill-wave me-1"></i>@(string.IsNullOrEmpty(s.PaymentMethod) ? "نقدي" : s.PaymentMethod)</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(s.Status == Salon.Models.Salary.Statuses.Paid ? "bg-success" : s.Status == Salon.Models.Salary.Statuses.SettledNoPayment ? "bg-info text-dark" : "bg-warning text-dark")">
                                    @s.Status
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = s.Id })" class="btn btn-sm btn-info text-white me-1" title="تفاصيل">
                                    <i class="fas fa-eye me-1"></i> تفاصيل
                                </a>
                                @if (s.Status == Salon.Models.Salary.Statuses.Pending)
                                {
                                    <form asp-action="Pay" asp-route-id="@s.Id" method="post" style="display:inline"
                                          onsubmit="return confirm('تأكيد صرف الراتب؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            <i class="fas fa-check me-1"></i> صرف
                                        </button>
                                    </form>
                                }
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        onclick="confirmDelete(@s.Id, '@Html.Raw((s.Employee != null ? s.Employee.FullName : "-").Replace("'", "\\'"))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف راتب الموظف:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}