@model IEnumerable<Salon.Models.Salary>
@{
    ViewData["Title"] = "صرف الرواتب";
}

@{
    string[] arabicMonths = { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
                               "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    string monthName = arabicMonths[(int)ViewBag.Month];
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-dollar-sign me-2"></i>صرف الرواتب</h1>
        <p class="mb-0 text-muted">@monthName - @ViewBag.Year</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة راتب
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="year" class="form-select" style="max-width:120px;">
                @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 3; y--)
                {
                    <option value="@y" selected="@(y == (int)ViewBag.Year)">@y</option>
                }
            </select>
            <select name="month" class="form-select" style="max-width:120px;">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == (int)ViewBag.Month)">@m</option>
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>الموظف</th>
                        <th>الراتب الأساسي</th>
                        <th>البدلات</th>
                        <th>الخصومات</th>
                        <th>السلف</th>
                        <th>الصافي</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد رواتب مسجلة لهذا الشهر</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@(s.Employee?.FullName ?? "-")</strong></td>
                            <td>@s.BasicSalary.ToString("N3") د.ك</td>
                            <td>@s.Allowances.ToString("N3") د.ك</td>
                            <td>@s.Deductions.ToString("N3") د.ك</td>
                            <td>@s.AdvanceDeducted.ToString("N3") د.ك</td>
                            <td><strong>@s.NetSalary.ToString("N3") د.ك</strong></td>
                            <td>
                                <span class="badge @(s.Status == "مصروف" ? "bg-success" : "bg-warning text-dark")">
                                    @s.Status
                                </span>
                            </td>
                            <td>
                                @if (s.Status == "معلق")
                                {
                                    <form asp-action="Pay" asp-route-id="@s.Id" method="post" style="display:inline"
                                          onsubmit="return confirm('تأكيد صرف الراتب؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            <i class="fas fa-check me-1"></i> صرف
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('هل تريد حذف هذا السجل؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
