@model IEnumerable<Salon.Models.Expense>
@{
    ViewData["Title"] = "المصروفات";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-dollar-sign me-2"></i>المصروفات</h1>
        <p>إجمالي اليوم: <strong>@ViewBag.Total?.ToString("N3") د.ك</strong></p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة مصروف
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0">التاريخ:</label>
            <input type="date" name="date" value="@ViewBag.FilterDate" class="form-control" style="max-width:200px;" />
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>البيان</th>
                        <th>الفئة</th>
                        <th>المبلغ</th>
                        <th>طريقة الدفع</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">لا توجد مصروفات في هذا اليوم</td></tr>
                    }
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.Id</td>
                            <td>@e.Description</td>
                            <td>@(e.Category ?? "-")</td>
                            <td><strong>@e.Amount.ToString("N3") د.ك</strong></td>
                            <td>@e.PaymentMethod</td>
                            <td>@e.ExpenseDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = e.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@e.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('هل تريد حذف هذا المصروف؟')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
