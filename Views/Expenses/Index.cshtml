@model IEnumerable<Salon.Models.Expense>
@{
    ViewData["Title"] = "المصروفات";
    var userDept = ViewBag.UserDept as string;
    var selectedDept = ViewBag.Department as string;
    bool seesAllDepts = userDept != "حلاقة" && userDept != "مساج";
    string deptLabel = userDept == "حلاقة" ? " - الحلاقة" :
                       userDept == "مساج" ? " - المساج" : "";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-dollar-sign me-2"></i>المصروفات</h1>
        <p>إجمالي الفترة: <strong>@ViewBag.Total?.ToString("N3") د.ك</strong></p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة مصروف
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2 align-items-center flex-wrap">
            <label class="form-label mb-0">من تاريخ:</label>
            <input type="date" name="from" value="@ViewBag.From" class="form-control" style="max-width:200px;" />
            <label class="form-label mb-0">إلى تاريخ:</label>
            <input type="date" name="to" value="@ViewBag.To" class="form-control" style="max-width:200px;" />
            <label class="form-label mb-0">القسم:</label>
            <select name="department" class="form-select" style="max-width:180px;">
                <option value="">الكل</option>
                @if (seesAllDepts || userDept == "حلاقة")
                {
                    <option value="حلاقة" selected="@(selectedDept == "حلاقة")">حلاقة</option>
                }
                @if (seesAllDepts || userDept == "مساج")
                {
                    <option value="مساج" selected="@(selectedDept == "مساج")">مساج</option>
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> بحث</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>البيان</th>
                        <th>الفئة</th>
                        <th>القسم</th>
                        <th>المبلغ</th>
                        <th>طريقة الدفع</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد مصروفات في هذه الفترة</td></tr>
                    }
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.Id</td>
                            <td>@e.Description</td>
                            <td>@(e.Category ?? "-")</td>
                            <td>
                                @if (e.Department == "حلاقة")
                                {
                                    <span class="badge" style="background:#3b82f6;">حلاقة</span>
                                }
                                else if (e.Department == "مساج")
                                {
                                    <span class="badge" style="background:#8b5cf6;">مساج</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">مشترك</span>
                                }
                            </td>
                            <td><strong>@e.Amount.ToString("N3") د.ك</strong></td>
                            <td>@e.PaymentMethod</td>
                            <td>@e.ExpenseDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = e.Id })" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="حذف"
                                        onclick="confirmDelete(@e.Id, '@Html.Raw(e.Description.Replace("'", "\\'"))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg delete-modal-red">
            <div class="modal-body text-center p-5">
                <div class="delete-icon-wrap mb-4">
                    <i class="fas fa-times"></i>
                </div>
                <h4 class="fw-bold mb-2 text-white">تأكيد الحذف</h4>
                <p class="text-white-50 mb-1">هل أنت متأكد من حذف المصروف:</p>
                <p class="fw-bold fs-5 mb-2 text-white" id="deleteItemName"></p>
                <p class="text-white-50 small mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    لا يمكن التراجع عن هذا الإجراء
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <form id="deleteForm" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn delete-confirm-btn px-4 fw-bold">تأكيد</button>
                    </form>
                    <button type="button" class="btn delete-cancel-btn px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteItemName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}