@model Salon.Models.Expense
@{
    ViewData["Title"] = "إضافة مصروف";
    var userDept = ViewBag.UserDept as string;
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
}

<div class="page-header">
    <h1><i class="fas fa-plus-circle me-2"></i>إضافة مصروف جديد</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" class="form-select">
                        <option value="">-- اختر الفئة --</option>
                        <option>إيجار</option>
                        <option>كهرباء وماء</option>
                        <option>مواد استهلاكية</option>
                        <option>صيانة</option>
                        <option>رواتب</option>
                        <option>تسويق</option>
                        <option>أخرى</option>
                    </select>
                </div>

                @* حقل القسم: يظهر للأدمن بشكل dropdown، موظفو القسم يُعيَّن لهم تلقائياً *@
                @if (isAdmin || string.IsNullOrEmpty(userDept))
                {
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label"></label>
                        <select asp-for="Department" class="form-select">
                            <option value="">-- مشترك (للكل) --</option>
                            <option value="حلاقة">حلاقة</option>
                            <option value="مساج">مساج</option>
                        </select>
                    </div>
                }
                else
                {
                    @* يُعيَّن القسم تلقائياً من خلال الـ Controller *@
                    <input type="hidden" asp-for="Department" value="@userDept" />
                    <div class="col-md-6">
                        <label class="form-label">القسم</label>
                        <input type="text" class="form-control" value="@userDept" disabled />
                    </div>
                }

                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" type="number" step="0.001" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpenseDate" class="form-label"></label>
                    <input asp-for="ExpenseDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" class="form-select">
                        <option>نقدي</option>
                        <option>بطاقة</option>
                        <option>تحويل بنكي</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary me-2"><i class="fas fa-save me-1"></i> حفظ</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fas fa-arrow-right me-1"></i> رجوع</a>
            </div>
        </form>
    </div>
</div>