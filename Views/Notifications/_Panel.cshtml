@model List<Salon.Models.NotificationItem>
@{
    var today = DateTime.Today;
    var yesterday = today.AddDays(-1);

    string DayLabelAr(DateTime d) =>
        d.Date == today ? $"اليوم {today:d MMMM yyyy}" :
        d.Date == yesterday ? $"أمس {yesterday:d MMMM yyyy}" :
        d.ToString("d MMMM yyyy");

    string DayLabelEn(DateTime d) =>
        d.Date == today ? $"Today {today:d MMMM yyyy}" :
        d.Date == yesterday ? $"Yesterday {yesterday:d MMMM yyyy}" :
        d.ToString("d MMMM yyyy");

    var grouped = Model.GroupBy(n => n.Date.Date).OrderByDescending(g => g.Key).ToList();
    int unreadCnt = Model.Count(n => !n.IsRead);
}

<div class="np-header">
    <div class="np-header-title">
        <i class="fas fa-bell np-bell-icon"></i>
        <span data-i18n-en="Notifications" data-i18n-ar="الإشعارات">الإشعارات</span>
        @if (unreadCnt > 0)
        {
            <span class="np-total-badge">@unreadCnt</span>
        }
    </div>
    <button class="np-settings-btn" onclick="toggleNpSettings()" title="إعدادات / Settings">
        <i class="fas fa-cog"></i>
    </button>
</div>

<!-- Filter Tabs -->
<div class="np-tabs">
    <button class="np-tab active" data-cat="all">
        <span data-i18n-en="All" data-i18n-ar="الكل">الكل</span> <span class="np-tab-cnt">@Model.Count(n => !n.IsRead)</span>
    </button>
    <button class="np-tab" data-cat="مهمة" style="--tab-color:#dc3545">
        <span data-i18n-en="Important" data-i18n-ar="مهمة">مهمة</span> <span class="np-tab-cnt">@Model.Count(n => n.Category == "مهمة" && !n.IsRead)</span>
    </button>
    <button class="np-tab" data-cat="appointment" style="--tab-color:#F7941D">
        <span data-i18n-en="Appointments" data-i18n-ar="مواعيد">مواعيد</span> <span class="np-tab-cnt">@Model.Count(n => n.Type == "appointment" && !n.IsRead)</span>
    </button>
    <button class="np-tab" data-cat="مالية" style="--tab-color:#0d6efd">
        <span data-i18n-en="Financial" data-i18n-ar="مالية">مالية</span> <span class="np-tab-cnt">@Model.Count(n => n.Category == "مالية" && !n.IsRead)</span>
    </button>
    <button class="np-tab" data-cat="advance" style="--tab-color:#7c3aed">
        <span data-i18n-en="Advances" data-i18n-ar="سلف">سلف</span> <span class="np-tab-cnt">@Model.Count(n => (n.Type == "advance-new" || n.Type == "advance-pending") && !n.IsRead)</span>
    </button>
</div>

<!-- Notifications list -->
<div class="np-list" id="np-list">
    @if (!Model.Any())
    {
        <div class="np-empty">
            <i class="fas fa-bell-slash"></i>
            <p data-i18n-en="No notifications" data-i18n-ar="لا توجد إشعارات">لا توجد إشعارات</p>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <div class="np-day-label"
                 data-i18n-en="@DayLabelEn(group.Key)"
                 data-i18n-ar="@DayLabelAr(group.Key)">@DayLabelAr(group.Key)</div>
            @foreach (var n in group.OrderByDescending(x => x.Date))
            {
                <div class="np-card @(n.IsRead ? "np-card-read" : "")"
                     data-cat="@n.Category"
                     data-type="@n.Type"
                     data-key="@n.Key"
                     data-read="@n.IsRead.ToString().ToLower()">
                    <div class="np-icon" style="background:@n.IconBg">
                        <i class="@n.IconClass"></i>
                    </div>
                    <div class="np-content">
                        <div class="np-card-header">
                            <span class="np-title"
                                  data-i18n-en="@n.TitleEn"
                                  data-i18n-ar="@n.Title">@n.Title</span>
                            <span class="np-time">@n.Date.ToString("HH:mm")</span>
                        </div>
                        <div class="np-subtitle"
                             data-i18n-en="@n.SubTitleEn"
                             data-i18n-ar="@n.SubTitle">@n.SubTitle</div>
                        <div class="np-body"
                             data-i18n-en="@n.BodyEn"
                             data-i18n-ar="@n.Body">@n.Body</div>
                        <div class="np-card-footer">
                            @if (n.IsRead)
                            {
                                <span class="np-read-badge">
                                    <i class="fas fa-check-circle me-1"></i><span data-i18n-en="Read" data-i18n-ar="تمت القراءة">تمت القراءة</span>
                                </span>
                            }
                            else
                            {
                                <button class="np-markread-btn" onclick="markNotifRead(this,'@n.Key')">
                                    <i class="fas fa-check me-1"></i><span data-i18n-en="Mark as Read" data-i18n-ar="تمت القراءة">تمت القراءة</span>
                                </button>
                                @if (!string.IsNullOrEmpty(n.ActionUrl))
                                {
                                    <a class="np-action-btn" href="@n.ActionUrl"
                                       data-i18n-en="@n.ActionTextEn"
                                       data-i18n-ar="@n.ActionText">@n.ActionText</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<!-- Settings Section -->
<div class="np-settings" id="np-settings" style="display:none;">
    <div class="np-settings-title"><i class="fas fa-sliders-h me-2"></i><span data-i18n-en="Notification Settings" data-i18n-ar="إعدادات الإشعارات">إعدادات الإشعارات</span></div>
    <div class="np-setting-row">
        <span data-i18n-en="Quick notifications" data-i18n-ar="إشعارات سريعة">إشعارات سريعة</span>
        <label class="np-toggle">
            <input type="checkbox" id="ns-quick" onchange="saveNpSettings()">
            <span class="np-slider"></span>
        </label>
    </div>
    <div class="np-setting-row">
        <span data-i18n-en="Advanced notifications from" data-i18n-ar="بدء الإشعارات المتقدمة من">بدء الإشعارات المتقدمة من</span>
        <input type="date" id="ns-from" class="np-date-input" onchange="saveNpSettings()" />
    </div>
    <div class="np-setting-row">
        <span data-i18n-en="Max daily notifications" data-i18n-ar="عدد الإشعارات المسموحة يومياً">عدد الإشعارات المسموحة يومياً</span>
        <input type="number" id="ns-max" class="np-num-input" min="1" max="100" value="20" onchange="saveNpSettings()" />
    </div>
    <div class="np-setting-row">
        <span data-i18n-en="Archive old notifications" data-i18n-ar="أرشفة جميع الإشعارات القديمة">أرشفة جميع الإشعارات القديمة</span>
        <label class="np-toggle">
            <input type="checkbox" id="ns-archive" onchange="saveNpSettings()">
            <span class="np-slider"></span>
        </label>
    </div>
    <div class="np-setting-row">
        <span data-i18n-en="Enable auto display" data-i18n-ar="تفعيل عرض تلقائي">تفعيل عرض تلقائي</span>
        <label class="np-toggle">
            <input type="checkbox" id="ns-auto" onchange="saveNpSettings()">
            <span class="np-slider"></span>
        </label>
    </div>
</div>

<script>
    (function () {
        // Apply current language to dynamically loaded panel content
        var _lang = localStorage.getItem('lang') || 'ar';
        if (_lang === 'en') {
            document.querySelectorAll('#notif-panel [data-i18n-en]').forEach(function (el) {
                var en = el.getAttribute('data-i18n-en');
                if (en) el.textContent = en;
            });
        }

        // Tab filtering — hides read cards when filtering
        document.querySelectorAll('.np-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                document.querySelectorAll('.np-tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                var cat = tab.dataset.cat;
                document.querySelectorAll('.np-card').forEach(function (card) {
                    var isAdvance = card.dataset.type === 'advance-new' || card.dataset.type === 'advance-pending';
                    var match = cat === 'all'
                        || card.dataset.cat === cat
                        || card.dataset.type === cat
                        || (cat === 'advance' && isAdvance);
                    card.style.display = match ? '' : 'none';
                });
                document.querySelectorAll('.np-day-label').forEach(function (label) {
                    var next = label.nextElementSibling;
                    var hasVisible = false;
                    while (next && !next.classList.contains('np-day-label')) {
                        if (next.classList.contains('np-card') && next.style.display !== 'none') hasVisible = true;
                        next = next.nextElementSibling;
                    }
                    label.style.display = hasVisible ? '' : 'none';
                });
            });
        });

        // Mark as read
        window.markNotifRead = function (btn, key) {
            var card = btn.closest('.np-card');
            var fd = new FormData();
            fd.append('key', key);
            fetch('/Notifications/MarkRead', { method: 'POST', body: fd })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    card.classList.add('np-card-read');
                    card.dataset.read = 'true';
                    var footer = btn.closest('.np-card-footer');
                    var _l = localStorage.getItem('lang') || 'ar';
                    var readTxt = _l === 'en' ? 'Read' : 'تمت القراءة';
                    footer.innerHTML = '<span class="np-read-badge"><i class="fas fa-check-circle me-1"></i>' + readTxt + '</span>';

                    var hdrBadge = document.querySelector('.np-total-badge');
                    if (hdrBadge) {
                        if (data.total > 0) hdrBadge.textContent = data.total;
                        else hdrBadge.remove();
                    }

                    var cardCat  = card.dataset.cat;
                    var cardType = card.dataset.type;
                    document.querySelectorAll('.np-tab').forEach(function (tab) {
                        var cnt = tab.querySelector('.np-tab-cnt');
                        if (!cnt) return;
                        var cur = parseInt(cnt.textContent) || 0;
                        if (tab.dataset.cat === 'all' ||
                            tab.dataset.cat === cardCat ||
                            tab.dataset.cat === cardType) {
                            cnt.textContent = Math.max(0, cur - 1);
                        }
                    });

                    var pgBadge = document.getElementById('notif-count');
                    if (pgBadge) {
                        pgBadge.textContent = data.total > 99 ? '99+' : data.total;
                        pgBadge.style.display = data.total > 0 ? '' : 'none';
                        pgBadge.style.background = data.important > 0 ? '#dc3545' : '#F7941D';
                    }
                })
                .catch(function () {});
        };

        // Settings persistence
        function loadNpSettings() {
            try {
                var s = JSON.parse(localStorage.getItem('npSettings') || '{}');
                if (document.getElementById('ns-quick'))   document.getElementById('ns-quick').checked   = !!s.quick;
                if (document.getElementById('ns-from'))    document.getElementById('ns-from').value       = s.from || '';
                if (document.getElementById('ns-max'))     document.getElementById('ns-max').value        = s.max  || 20;
                if (document.getElementById('ns-archive')) document.getElementById('ns-archive').checked  = !!s.archive;
                if (document.getElementById('ns-auto'))    document.getElementById('ns-auto').checked     = !!s.auto;
            } catch (e) {}
        }
        window.saveNpSettings = function () {
            localStorage.setItem('npSettings', JSON.stringify({
                quick:   document.getElementById('ns-quick')?.checked,
                from:    document.getElementById('ns-from')?.value,
                max:     document.getElementById('ns-max')?.value,
                archive: document.getElementById('ns-archive')?.checked,
                auto:    document.getElementById('ns-auto')?.checked
            }));
        };
        window.toggleNpSettings = function () {
            var el = document.getElementById('np-settings');
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
        };
        loadNpSettings();
    })();
</script>
