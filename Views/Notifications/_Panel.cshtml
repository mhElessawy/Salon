@model List<Salon.Models.NotificationItem>
@{
    var today = DateTime.Today;
    var yesterday = today.AddDays(-1);

    string DayLabel(DateTime d) =>
        d.Date == today ? $"اليوم {today:d MMMM yyyy}" :
        d.Date == yesterday ? $"أمس {yesterday:d MMMM yyyy}" :
        d.ToString("d MMMM yyyy");

    var grouped = Model
        .GroupBy(n => n.Date.Date)
        .OrderByDescending(g => g.Key)
        .ToList();
}

<div class="np-header">
    <div class="np-header-title">
        <i class="fas fa-bell np-bell-icon"></i>
        <span>الإشعارات</span>
        <span class="np-total-badge">@Model.Count</span>
    </div>
    <button class="np-settings-btn" onclick="toggleNpSettings()" title="الإعدادات">
        <i class="fas fa-cog"></i>
    </button>
</div>

<!-- Filter Tabs -->
<div class="np-tabs">
    <button class="np-tab active" data-cat="all">الكل <span class="np-tab-cnt">@Model.Count</span></button>
    <button class="np-tab" data-cat="مهمة" style="--tab-color:#dc3545">
        مهمة <span class="np-tab-cnt">@Model.Count(n => n.Category == "مهمة")</span>
    </button>
    <button class="np-tab" data-cat="تشغيلية" style="--tab-color:#fd7e14">
        تشغيلية <span class="np-tab-cnt">@Model.Count(n => n.Category == "تشغيلية")</span>
    </button>
    <button class="np-tab" data-cat="مالية" style="--tab-color:#0d6efd">
        مالية <span class="np-tab-cnt">@Model.Count(n => n.Category == "مالية")</span>
    </button>
</div>

<!-- Notifications list -->
<div class="np-list" id="np-list">
    @if (!Model.Any())
    {
        <div class="np-empty">
            <i class="fas fa-bell-slash"></i>
            <p>لا توجد إشعارات</p>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <div class="np-day-label">@DayLabel(group.Key)</div>
            @foreach (var n in group.OrderByDescending(x => x.Date))
            {
                <div class="np-card" data-cat="@n.Category">
                    <div class="np-icon" style="background:@n.IconBg">
                        <i class="@n.IconClass"></i>
                    </div>
                    <div class="np-content">
                        <div class="np-card-header">
                            <span class="np-title">@n.Title</span>
                            <span class="np-time">@n.Date.ToString("HH:mm")</span>
                        </div>
                        <div class="np-subtitle">@n.SubTitle</div>
                        <div class="np-body">@n.Body</div>
                        @if (n.ActionUrl != null)
                        {
                            <a href="@n.ActionUrl" class="np-action-btn">
                                @n.ActionText <i class="fas fa-arrow-left ms-1" style="font-size:0.65rem;"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

<!-- Settings Section -->
<div class="np-settings" id="np-settings" style="display:none;">
    <div class="np-settings-title"><i class="fas fa-sliders-h me-2"></i>إعدادات الإشعارات</div>
    <div class="np-setting-row">
        <span>إشعارات سريعة</span>
        <label class="np-toggle">
            <input type="checkbox" id="ns-quick" onchange="saveNpSettings()">
            <span class="np-slider"></span>
        </label>
    </div>
    <div class="np-setting-row">
        <span>بدء الإشعارات المتقدمة من</span>
        <input type="date" id="ns-from" class="np-date-input" onchange="saveNpSettings()" />
    </div>
    <div class="np-setting-row">
        <span>عدد الإشعارات المسموحة يومياً</span>
        <input type="number" id="ns-max" class="np-num-input" min="1" max="100" value="20" onchange="saveNpSettings()" />
    </div>
    <div class="np-setting-row">
        <span>أرشفة جميع الإشعارات القديمة</span>
        <label class="np-toggle">
            <input type="checkbox" id="ns-archive" onchange="saveNpSettings()">
            <span class="np-slider"></span>
        </label>
    </div>
    <div class="np-setting-row">
        <span>تفعيل عرض تلقائي</span>
        <label class="np-toggle">
            <input type="checkbox" id="ns-auto" onchange="saveNpSettings()">
            <span class="np-slider"></span>
        </label>
    </div>
</div>

<script>
(function () {
    // Tab filtering
    document.querySelectorAll('.np-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.np-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            var cat = tab.dataset.cat;
            document.querySelectorAll('.np-card').forEach(function (card) {
                card.style.display = (cat === 'all' || card.dataset.cat === cat) ? '' : 'none';
            });
        });
    });

    // Settings persistence
    function loadNpSettings() {
        try {
            var s = JSON.parse(localStorage.getItem('npSettings') || '{}');
            if (document.getElementById('ns-quick')) document.getElementById('ns-quick').checked = !!s.quick;
            if (document.getElementById('ns-from')) document.getElementById('ns-from').value = s.from || '';
            if (document.getElementById('ns-max')) document.getElementById('ns-max').value = s.max || 20;
            if (document.getElementById('ns-archive')) document.getElementById('ns-archive').checked = !!s.archive;
            if (document.getElementById('ns-auto')) document.getElementById('ns-auto').checked = !!s.auto;
        } catch (e) { }
    }
    window.saveNpSettings = function () {
        localStorage.setItem('npSettings', JSON.stringify({
            quick: document.getElementById('ns-quick')?.checked,
            from: document.getElementById('ns-from')?.value,
            max: document.getElementById('ns-max')?.value,
            archive: document.getElementById('ns-archive')?.checked,
            auto: document.getElementById('ns-auto')?.checked
        }));
    };
    window.toggleNpSettings = function () {
        var el = document.getElementById('np-settings');
        el.style.display = el.style.display === 'none' ? 'block' : 'none';
    };
    loadNpSettings();
})();
</script>
