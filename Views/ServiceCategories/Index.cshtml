@model IEnumerable<Salon.Models.ServiceCategory>
@{
    ViewData["Title"] = "فئات الخدمات";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="fas fa-tags me-2"></i>فئات الخدمات</h1>
        <p>إدارة تصنيفات خدمات الصالون</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> إضافة فئة
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center text-muted py-5">
                    <i class="fas fa-tags fa-3x mb-3 opacity-25"></i>
                    <p>لا توجد فئات مسجلة</p>
                </div>
            </div>
        </div>
    }
    @foreach (var cat in Model)
    {
        <div class="col-md-4 col-sm-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width:48px;height:48px;background-color:@(cat.Color ?? "#F7941D")20;color:@(cat.Color ?? "#F7941D");font-size:20px;">
                            <i class="@(cat.Icon ?? "fas fa-cut")"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">@cat.Name</h6>
                            <small class="text-muted">@cat.Services.Count خدمة</small>
                            @if (!string.IsNullOrEmpty(cat.Department))
                            {
                                <span class="badge rounded-pill mt-1 d-inline-block"
                                      style="background:@(cat.Department == "حلاقة" ? "#F7941D" : "#6f42c1");font-size:11px">
                                    @(cat.Department == "حلاقة" ? "✂️" : "💆") @cat.Department
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill mt-1 d-inline-block" style="font-size:11px">
                                    ⚠️ بدون قسم
                                </span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(cat.Description))
                    {
                        <p class="text-muted small mb-3">@cat.Description</p>
                    }
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Edit", new { id = cat.Id })" class="btn btn-sm btn-outline-warning flex-fill">
                            <i class="fas fa-edit me-1"></i> تعديل
                        </a>
                        <form asp-action="Delete" asp-route-id="@cat.Id" method="post" style="flex:1"
                              onsubmit="return confirm('هل تريد حذف هذه الفئة؟')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                <i class="fas fa-trash me-1"></i> حذف
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
